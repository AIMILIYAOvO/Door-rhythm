    <div class="panel-title">判定档位</div>
    <div style="font-size:14px;font-weight:700;color:#72D2F0;text-align:center" id="panelJudge">标准</div>
  </div>
</div>

<!-- HUD：只保留小型连击提示；分数与歌曲信息放入左右数据面板 -->
<div id="gameHUD">
  <div class="hud-pill-center hud-combo-only">
    <div class="hud-combo" id="hudCombo">0</div>
    <div class="hud-combo-label">COMBO</div>
  </div>
</div>

<div class="game-controls" id="gameControls" aria-label="游戏控制">
