  const open=!panel.classList.contains('active');
  panel.classList.toggle('active',open);
  panel.setAttribute('aria-hidden',String(!open));
  btn.setAttribute('aria-expanded',String(open));
  if(open)positionHudDetailsPanel();
}
function positionHudDetailsPanel(){
  const panel=$('hudDetailsPanel');if(!panel||!playArea)return;
  const pa=playArea;
  panel.style.left=(pa.x+pa.w/2)+'px';
  panel.style.width=Math.max(0,Math.min(470,pa.w-28))+'px';
}
function closeHudDetails(){
  const panel=$('hudDetailsPanel'),btn=$('hudDetailsBtn');if(panel){panel.classList.remove('active');panel.setAttribute('aria-hidden','true');}if(btn)btn.setAttribute('aria-expanded','false');
}

let expandedSong=-1;
function renderSongList(){
  const list=$('songList'); list.innerHTML='';
  if(songs.length===0){
    const empty=document.createElement('div');
    empty.className='empty-library';
    empty.innerHTML='<div class="empty-note">♫</div><b>曲库还是空的</b><p>选择本地谱面文件夹，Door 会递归识别其中的 osu!mania 4K 谱面；也可以导入单个 <strong>.osz</strong> 谱包。</p><span>只读取你主动选择的目录，不会扫描整个硬盘</span>';
    list.appendChild(empty);
    const count=$('songCount');if(count)count.textContent='0';
    return;
  }
  const count=$('songCount');if(count)count.textContent=String(songs.length);
  songs.forEach((song,idx)=>{
    const wrap=document.createElement('div');
    const card=document.createElement('div');
    card.className='song-card'+(idx===expandedSong?' selected expanded':'');
    const info=document.createElement('div');info.className='info';
    const title=document.createElement('div');title.className='title';title.textContent=String(song.title||'未命名');
    const artist=document.createElement('div');artist.className='artist';
    const diffs=Object.keys(song.difficulties);const values=diffs.map(d=>song.difficulties[d]);
    const noteCounts=values.map(d=>Array.isArray(d.notes)?d.notes.length:0);
    artist.textContent=`${String(song.artist||'未知')} · BPM ${Number(song.bpm)||120} · ${Math.min(...noteCounts)}~${Math.max(...noteCounts)} notes`;
    info.append(title,artist);
    const diffBox=document.createElement('div');diffBox.className='diff';
    diffs.forEach(d=>{const tag=document.createElement('span');tag.className='diff-tag diff-'+d;tag.textContent=`${d.toUpperCase()} ${song.difficulties[d].level}`;diffBox.appendChild(tag);});
    card.append(info,diffBox);
    card.onclick=()=>{selectedSong=idx;expandedSong=expandedSong===idx?-1:idx;selectedDiff=Object.keys(song.difficulties)[0]||'normal';renderSongList();};
    wrap.appendChild(card);
    if(idx===expandedSong){
      const dp=document.createElement('div');
      dp.className='song-difficulty-expand';
      const dnames={easy:'简单',normal:'普通',hard:'困难',expert:'专家'};
      Object.keys(song.difficulties).forEach(d=>{
        const b=document.createElement('button');
        b.className='diff-btn diff-btn-'+d;
        b.textContent=`${dnames[d]||d} Lv.${song.difficulties[d].level}`;
        b.onclick=()=>{unlockAudioGlobal();selectedSong=idx;selectedDiff=d;startGame();};
        dp.appendChild(b);
      });
      wrap.appendChild(dp);
    }
    list.appendChild(wrap);
  });
}

