  dbgPush(`JUDGE ${result.toUpperCase()} L${lane} note=${Math.round(noteTime)} at=${Math.round(judgedAt)} err=${Math.round(timingError)}`);
  if(result==='miss'){if(combo>0)comboBreaks++;combo=0;}
  else{
    combo++;maxCombo=Math.max(maxCombo,combo);
    score+=({perfect:1000,great:700,good:400,bad:100}[result])+combo*2;
    if(Number.isFinite(timingError)){timingSamples.push(timingError);offsetHistory.push(timingError);if(offsetHistory.length>60)offsetHistory.shift();}
    comboPulse=1;
  }
  laneFlash[lane]=1;spawnParticles(lane,result);
  if(SETTINGS.showJudgeText&&judgeFx.length<18)judgeFx.push({text:result.toUpperCase(),color:JC[result],life:1,lane,scale:1.3});
