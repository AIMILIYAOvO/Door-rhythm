/* Rounded loading portal: light mist washes into the deep playfield. */
.door-transition{position:fixed;inset:0;z-index:200;display:grid;place-items:center;overflow:hidden;visibility:hidden;opacity:0;pointer-events:none;clip-path:circle(0% at 50% 47%);background:radial-gradient(circle at 50% 42%,rgba(242,250,255,.96),rgba(206,228,242,.95) 28%,rgba(69,100,133,.97) 59%,#07101C 100%)}
.door-transition.active{visibility:visible;opacity:1;pointer-events:auto;animation:doorPortalSweep .82s cubic-bezier(.65,0,.22,1) forwards}
.door-transition:before{content:"";position:absolute;width:min(50vw,460px);height:min(70vh,600px);min-width:210px;min-height:280px;border:1px solid rgba(228,247,255,.55);border-radius:48% 48% 28% 28%;box-shadow:0 0 40px rgba(153,218,239,.25),inset 0 0 45px rgba(225,239,255,.12);transform:scale(.82);opacity:0;animation:none}
.door-transition.active:before{animation:doorRingBreath .82s ease-out forwards}
.door-transition-aura{position:absolute;width:120vmax;height:120vmax;border-radius:50%;background:conic-gradient(from 20deg,transparent,rgba(163,221,239,.22),transparent,rgba(224,164,200,.22),transparent);filter:blur(18px);animation:none}
.door-transition.active .door-transition-aura{animation:doorAuraRotate 1.2s linear infinite}
.door-transition-content{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:9px;color:#F2F7FF;text-shadow:0 2px 18px rgba(5,14,28,.24);opacity:0;transform:translateY(9px) scale(.96);animation:none}
.door-transition.active .door-transition-content{animation:doorTransitContent .82s .08s ease-out forwards}
.door-transition-mark{width:clamp(86px,12vw,128px);height:auto;filter:drop-shadow(0 0 20px rgba(151,220,241,.32))}
.door-transition-title{font-size:clamp(20px,3vw,30px);font-weight:800;letter-spacing:7px;max-width:80vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.door-transition-subtitle{font-size:9px;letter-spacing:2px;opacity:.78;text-align:center;max-width:80vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.door-transition-progress{width:110px;height:2px;border-radius:99px;overflow:hidden;background:rgba(231,243,255,.22);margin-top:8px}
.door-transition-progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,#A3E0F1,#D4C8F0,#E9BCD1);transform:scaleX(0);transform-origin:left;animation:none}
.door-transition.active .door-transition-progress i{animation:doorProgress .72s .04s ease-out forwards}
.door-transition-quote{position:absolute;bottom:max(22px,env(safe-area-inset-bottom));font-size:8px;letter-spacing:2px;color:rgba(221,237,249,.48);opacity:0;animation:none}
.door-transition.active .door-transition-quote{animation:doorQuoteIn .5s .2s forwards}
@keyframes doorPortalSweep{0%{clip-path:circle(0% at 50% 47%);opacity:0}18%{opacity:1}100%{clip-path:circle(150% at 50% 47%);opacity:1}}
@keyframes doorRingBreath{0%{transform:scale(.7) rotate(-7deg);opacity:0}45%{opacity:.95}100%{transform:scale(1.13) rotate(2deg);opacity:.15}}
@keyframes doorAuraRotate{to{transform:rotate(360deg)}}
@keyframes doorTransitContent{0%{opacity:0;transform:translateY(9px) scale(.96)}40%{opacity:1;transform:translateY(0) scale(1)}100%{opacity:0;transform:translateY(-3px) scale(1.025)}}
@keyframes doorProgress{to{transform:scaleX(1)}}
@keyframes doorQuoteIn{to{opacity:1}}
@media(prefers-reduced-motion:reduce){.door-transition.active{animation-duration:.01ms}.door-transition.active .door-transition-aura{animation:none}.door-transition.active:before,.door-transition.active .door-transition-content,.door-transition.active .door-transition-progress i,.door-transition.active .door-transition-quote{animation-duration:.01ms}}
body.reduce-motion .door-transition.active{animation-duration:.01ms}body.reduce-motion .door-transition.active .door-transition-aura{animation:none}body.reduce-motion .door-transition.active:before,body.reduce-motion .door-transition.active .door-transition-content,body.reduce-motion .door-transition.active .door-transition-progress i,body.reduce-motion .door-transition.active .door-transition-quote{animation-duration:.01ms}

</style>
