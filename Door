async function selectChartDirectory(){
  if(typeof window.showDirectoryPicker==='function'){
    try{
      const dir=await window.showDirectoryPicker({id:'door-chart-library',mode:'read'});
      await importChartDirectoryHandle(dir);
      return;
    }catch(err){
      if(err&&err.name==='AbortError')return;
      console.warn('原生目录选择器不可用，尝试兼容模式：',err);
      // If the native picker is present but blocked by this context, fall back to webkitdirectory.
      if(!folderInput){alert('此浏览器无法读取所选文件夹，请尝试在支持目录读取的浏览器中打开。');return;}
    }
  }
  if(folderInput)folderInput.click();
  else alert('当前浏览器不支持目录选择。请改用 .osz 文件导入。');
}
if(folderInput)folderInput.addEventListener('change',async e=>{
  const files=Array.from(e.target.files||[]);e.target.value='';
  if(files.length)await importChartDirectoryFiles(files.slice(0,12000).map(file=>({path:file.webkitRelativePath||file.name,file})),'所选文件夹',files.length>12000);
});
async function collectDirectoryFiles(handle,prefix='',output=[],depth=0){
  if(depth>12||output.length>=12000){output.limited=true;return output;}
  for await(const [name,entry] of handle.entries()){
    if(output.length>=12000){output.limited=true;break;}
    if(name==='__MACOSX'||name==='.git'||name==='System Volume Information'||name==='$RECYCLE.BIN'||name.startsWith('.'))continue;
    const path=prefix?prefix+'/'+name:name;
    if(entry.kind==='directory')await collectDirectoryFiles(entry,path,output,depth+1);
    else if(entry.kind==='file'){
      output.push({path,file:await entry.getFile()});
      if(output.length%80===0){const text=$('loadingText');if(text)text.textContent=`正在扫描所选文件夹… ${output.length} 个文件`;}
    }
  }
  return output;
}
async function importChartDirectoryHandle(dirHandle){
  showLoading('正在读取所选文件夹…');
  const status=$('libraryScanStatus');if(status)status.textContent='正在扫描已授权的文件夹…';
  try{
    const files=await collectDirectoryFiles(dirHandle,dirHandle.name||'');
    await importChartDirectoryFiles(files,dirHandle.name||'所选文件夹',!!files.limited);
  }catch(err){
    hideLoading();if(status)status.textContent='读取失败，请检查文件夹权限后重试。';
    console.error(err);alert('读取文件夹失败：'+(err&&err.message?err.message:String(err)));
  }
}
function normalizeChartPath(path){
  const parts=[];
  for(const part of String(path||'').replace(/\\/g,'/').split('/')){
    if(!part||part==='.')continue;
    if(part==='..'){parts.pop();continue;}
    parts.push(part);
  }
  return parts.join('/');
}
function directoryOfChartPath(path){const p=normalizeChartPath(path).split('/');p.pop();return p.join('/');}
async function importChartDirectoryFiles(fileEntries,displayName='所选文件夹',wasLimited=false){
  showLoading('正在识别 osu!mania 4K 谱面…');
  const status=$('libraryScanStatus');
  try{
    const entries=fileEntries.filter(x=>x&&x.file&&x.path).map(x=>({path:normalizeChartPath(x.path),file:x.file}));
    const fileMap=new Map(entries.map(x=>[x.path.toLowerCase(),x]));
    const osuFiles=entries.filter(x=>/\.osu$/i.test(x.path)).sort((a,b)=>a.path.localeCompare(b.path));
    if(!osuFiles.length){
      hideLoading();
      const msg='所选文件夹内未找到解压后的 .osu 文件。可选择包含谱面子文件夹的目录，或使用下方 .osz 导入。';
      if(status)status.textContent=msg;alert(msg);return;
    }
    const grouped=new Map();let scanned=0,valid=0;
    for(const item of osuFiles){
      scanned++;
      if(scanned%25===0){const lt=$('loadingText');if(lt)lt.textContent=`正在解析谱面… ${scanned}/${osuFiles.length}`;}
      let parsed;try{parsed=parseOsu(await item.file.text());}catch(e){continue;}
      if(!parsed||parsed.mode!==3||parsed.keys!==4||!Array.isArray(parsed.notes)||!parsed.notes.length)continue;
      valid++;
      const dir=directoryOfChartPath(item.path)||displayName;
      if(!grouped.has(dir))grouped.set(dir,[]);
      grouped.get(dir).push({path:item.path,file:item.file,parsed});
    }
    if(!valid){
      hideLoading();const msg='找到 .osu 文件，但没有识别到包含有效音符的 osu!mania 4K 谱面。';
      if(status)status.textContent=msg;alert(msg);return;
    }
    const audioExt=/\.(mp3|ogg|wav|m4a|aac|opus)$/i;
    const isHitSound=p=>/(hitnormal|hitwhistle|hitfinish|hitclap|hit-|drum-|soft-|normal-hit|slider(whistle|slide)|spinnerspin)/i.test(p);
    const basename=p=>normalizeChartPath(p).split('/').pop().toLowerCase();
    let added=0,merged=0,skipped=0,firstNew=-1;
    for(const [folder,maps] of grouped){
      const first=maps[0].parsed;
      const audioCandidates=entries.filter(x=>directoryOfChartPath(x.path).toLowerCase()===folder.toLowerCase()&&audioExt.test(x.path)&&!isHitSound(x.path));
      let audioEntry=null;
      const declared=normalizeChartPath((directoryOfChartPath(maps[0].path)?directoryOfChartPath(maps[0].path)+'/':'')+(first.audioFile||''));
      if(declared)audioEntry=fileMap.get(declared.toLowerCase())||null;
      if(!audioEntry&&first.audioFile)audioEntry=audioCandidates.find(x=>basename(x.path)===basename(first.audioFile))||null;
      if(!audioEntry)audioEntry=audioCandidates[0]||null;
      let audioUrl=null;if(audioEntry)audioUrl=URL.createObjectURL(audioEntry.file);
      const song={id:'folder_'+Date.now()+'_'+added,title:first.title||folder.split('/').pop()||'未命名',artist:first.artist||'未知',bpm:first.bpm||120,audio:audioUrl,difficulties:{},sourceKey:folder};
      const used=new Set();const diffPriority={easy:0,normal:1,hard:2,expert:3};
      maps.sort((a,b)=>(diffPriority[a.parsed.difficulty]??1)-(diffPriority[b.parsed.difficulty]??1));
      for(const {parsed} of maps){
        let diff=parsed.difficulty||'normal';
        if(used.has(diff)){const slots=['easy','normal','hard','expert'];diff=slots.find(x=>!used.has(x));if(!diff)continue;}
        used.add(diff);song.difficulties[diff]={level:parsed.level||5,notes:parsed.notes};
      }
      if(!Object.keys(song.difficulties).length){if(audioUrl)URL.revokeObjectURL(audioUrl);skipped++;continue;}
      const idx=songs.findIndex(old=>old.sourceKey===folder||(old.title===song.title&&old.artist===song.artist));
      if(idx>=0){
        const old=songs[idx];Object.assign(old.difficulties,song.difficulties);old.sourceKey=folder;
        if(audioUrl){if(old.audio&&old.audio.startsWith('blob:'))URL.revokeObjectURL(old.audio);old.audio=audioUrl;}
        selectedSong=idx;merged++;
      }else{songs.push(song);selectedSong=songs.length-1;added++;if(firstNew<0)firstNew=selectedSong;}
    }
    if(firstNew>=0)expandedSong=firstNew;else expandedSong=selectedSong;
    selectedDiff=Object.keys(songs[selectedSong]?.difficulties||{})[0]||'normal';
    hideLoading();renderSongList();
    const msg=`扫描完成：新增 ${added} 首，合并 ${merged} 首，跳过 ${skipped} 个无效项目；识别到 ${valid} 张有效 4K 谱面。${wasLimited?' 注意：目录深度或 12,000 个文件的扫描上限已触发，未处理其余文件。':''}`;
    if(status)status.textContent=msg;
    if(songs.length){requestAnimationFrame(()=>{const card=$('songList').querySelector('.song-card.selected');if(card)card.scrollIntoView({block:'nearest',behavior:SETTINGS.reduceMotion?'auto':'smooth'});});}
  }catch(err){
    console.error(err);hideLoading();const msg='扫描失败：'+(err&&err.message?err.message:String(err));
    if(status)status.textContent=msg;alert(msg);
  }
}

async function importOsz(file){
  showLoading('解析谱面...');
  try{
    if(!window.JSZip)throw new Error('压缩库未加载，请检查网络后刷新页面');
    const zip=await JSZip.loadAsync(file);
    const allEntries=Object.entries(zip.files).filter(([name,entry])=>!entry.dir);
    const osuEntries=allEntries.filter(([name])=>/\.osu$/i.test(name)).sort((a,b)=>a[0].localeCompare(b[0]));
    if(!osuEntries.length)throw new Error('压缩包中未找到 .osu 谱面文件');
    const parsedMaps=[];
    for(const [path,entry] of osuEntries){
      const parsed=parseOsu(await entry.async('string'));
      if(!parsed)continue;
      if(parsed.mode!==3)continue;
      if(parsed.keys!==4)continue;
      if(!parsed.notes.length)continue;
      parsedMaps.push({path,parsed});
    }
    if(!parsedMaps.length){
      const first=await osuEntries[0][1].async('string');const sample=parseOsu(first);
      if(sample.mode!==3)throw new Error('仅支持 osu!mania 模式谱面');
      if(sample.keys!==4)throw new Error('仅支持 4K，当前谱面为 '+sample.keys+'K');
      throw new Error('谱面没有可用音符');
    }
    // 背景音乐优先匹配谱面 AudioFilename，再回退到非 hitsound 音频。
    const audioExt=/\.(mp3|ogg|wav|m4a|aac|opus)$/i;
    const isHitSound=p=>/(hitnormal|hitwhistle|hitfinish|hitclap|hit-|drum-|soft-|normal-hit|slider(whistle|slide)|spinnerspin)/i.test(p);
    const basename=p=>p.split('/').pop().toLowerCase();
    let audioEntry=null;
    const preferred=parsedMaps.map(x=>basename(x.parsed.audioFile||'')).find(Boolean);
    if(preferred)audioEntry=allEntries.find(([path])=>basename(path)===preferred);
    if(!audioEntry)audioEntry=allEntries.find(([path])=>audioExt.test(path)&&!isHitSound(path))||allEntries.find(([path])=>audioExt.test(path));
    let audioUrl=null;
    if(audioEntry){const blob=await audioEntry[1].async('blob');audioUrl=URL.createObjectURL(blob);}
    const first=parsedMaps[0].parsed;
    const baseTitle=first.title||file.name.replace(/\.osz$/i,'')||'未命名';
    const song={id:'imp_'+Date.now(),title:baseTitle,artist:first.artist||'未知',bpm:first.bpm||120,audio:audioUrl,difficulties:{}};
    const used=new Set();
    const diffPriority={easy:0,normal:1,hard:2,expert:3};
    parsedMaps.sort((a,b)=>(diffPriority[a.parsed.difficulty]??1)-(diffPriority[b.parsed.difficulty]??1));
    for(const {parsed} of parsedMaps){
      let diff=parsed.difficulty||'normal';
      if(used.has(diff)){
        // 同类难度不互相覆盖，依次填入还未占用的难度槽。
        const slots=['easy','normal','hard','expert'];
        diff=slots.find(x=>!used.has(x));
        if(!diff)continue;
      }
      used.add(diff);
      song.difficulties[diff]={level:parsed.level||5,notes:parsed.notes};
    }
    const existIdx=songs.findIndex(s=>s.title===song.title&&s.artist===song.artist);
    if(existIdx>=0){
      Object.assign(songs[existIdx].difficulties,song.difficulties);
      if(audioUrl){if(songs[existIdx].audio&&songs[existIdx].audio.startsWith('blob:'))URL.revokeObjectURL(songs[existIdx].audio);songs[existIdx].audio=audioUrl;}
      selectedSong=existIdx;
    }else{songs.push(song);selectedSong=songs.length-1;}
    selectedDiff=Object.keys(song.difficulties)[0]||'normal';
    hideLoading();renderSongList();
    alert(`导入成功：${song.title}\n识别到 ${Object.keys(song.difficulties).length} 个 4K 难度。\n点击难度按钮开始游玩。`);
  }catch(e){console.error(e);hideLoading();alert('导入失败：'+(e&&e.message?e.message:String(e)));}
}

let songWheelDelta=0,lastSongWheelAt=0;
const songListScrollTarget=$('songList');
if(songListScrollTarget)songListScrollTarget.addEventListener('wheel',e=>{
  if(gameState!=='songselect'||!songs.length||Math.abs(e.deltaY)<4)return;
  e.preventDefault();
  const now=performance.now();if(now-lastSongWheelAt<115)return;lastSongWheelAt=now;
  songWheelDelta+=e.deltaY;
  if(Math.abs(songWheelDelta)<24)return;
  const direction=songWheelDelta>0?1:-1;songWheelDelta=0;
  const base=expandedSong>=0?expandedSong:(selectedSong||0);
  const next=Math.max(0,Math.min(songs.length-1,base+direction));
  selectedSong=next;expandedSong=next;selectedDiff=Object.keys(songs[next].difficulties)[0]||'normal';
  renderSongList();
  requestAnimationFrame(()=>{const card=$('songList').querySelector('.song-card.selected');if(card)card.scrollIntoView({block:'nearest',behavior:SETTINGS.reduceMotion?'auto':'smooth'});});
},{passive:false});

function parseOsu(text){
  const lines=text.split(/\r?\n/);
  const r={mode:0,keys:4,bpm:120,title:'',artist:'',audioFile:'',difficulty:'normal',level:5,notes:[]};
  let sec='', bpmFound=false;
  for(const raw of lines){
    const t=raw.trim();
    if(t.startsWith('[')&&t.endsWith(']')){sec=t.slice(1,-1);continue;}
    if(!t||t.startsWith('//'))continue;
    if(sec==='General'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='Mode')r.mode=Number(v);
      else if(k==='AudioFilename')r.audioFile=v;
    }else if(sec==='Metadata'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='Title')r.title=v;else if(k==='Artist')r.artist=v;
      else if(k==='Version'){
        const vl=v.toLowerCase();
        r.difficulty=vl.includes('easy')?'easy':(vl.includes('expert')||vl.includes('insane')||vl.includes('another'))?'expert':vl.includes('hard')?'hard':'normal';
      }
    }else if(sec==='Difficulty'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='CircleSize')r.keys=Number(v);
      else if(k==='OverallDifficulty')r.level=Math.max(1,Math.round(Number(v)*1.5));
    }else if(sec==='TimingPoints'&&!bpmFound){
      const p=t.split(',');const beatLength=Number(p[1]);
      if(p.length>=2&&beatLength>0&&Number.isFinite(beatLength)){r.bpm=Math.round(60000/beatLength);bpmFound=true;}
    }else if(sec==='HitObjects'){
      const p=t.split(',');if(p.length<5)continue;
      const x=Number(p[0]),time=Number(p[2]),type=Number(p[3]);
      if(!Number.isFinite(x)||!Number.isFinite(time)||!Number.isFinite(type))continue;
      const lane=Math.min(3,Math.max(0,Math.floor(x/512*4)));
      const isHold=(type&128)!==0;
      const n={time,lane,type:isHold?'hold':'tap'};
      if(isHold&&p[5]){const e=Number(p[5].split(':')[0]);if(Number.isFinite(e)&&e>=time)n.end=e;else n.end=time;}
      if(!isHold)n.end=time;
      r.notes.push(n);
    }
  }
  r.notes.sort((a,b)=>a.time-b.time||a.lane-b.lane);
  return r;
}

function playCrystalTap(base=1080,volumeScale=1){
  if(!audioCtx)return;
  const t=audioCtx.currentTime;
  const master=Math.max(0.0001,Math.min(1,SETTINGS.sfxVolume))*0.22*volumeScale;
  const voices=[
    {type:'sine',f0:base,f1:base*.68,level:.82,duration:.082},
    {type:'triangle',f0:base*1.49,f1:base*1.06,level:.22,duration:.058},
    {type:'sine',f0:base*.5,f1:base*.39,level:.12,duration:.095}
  ];
  for(const v of voices){
    const osc=audioCtx.createOscillator(),gain=audioCtx.createGain(),filter=audioCtx.createBiquadFilter();
    osc.type=v.type;osc.frequency.setValueAtTime(v.f0,t);osc.frequency.exponentialRampToValueAtTime(Math.max(40,v.f1),t+v.duration);
    filter.type='lowpass';filter.frequency.setValueAtTime(5200,t);filter.frequency.exponentialRampToValueAtTime(2100,t+v.duration);filter.Q.value=.35;
    gain.gain.setValueAtTime(.0001,t);gain.gain.linearRampToValueAtTime(master*v.level,t+.004);gain.gain.exponentialRampToValueAtTime(.0001,t+v.duration);
    osc.connect(filter);filter.connect(gain);gain.connect(audioCtx.destination);osc.start(t);osc.stop(t+v.duration+.01);
  }
}
function playKeySound(){
  if(!SETTINGS.sfxEnabled||SETTINGS.autoPlay)return;
  ensureAudioCtx();if(!audioCtx)return;
  // Fast, soft crystal pluck with a short two-harmonic shimmer; no samples or network assets.
  playCrystalTap(1080,.78);
}
function playHitSound(judge){
  if(!SETTINGS.sfxEnabled||!audioCtx||SETTINGS.autoPlay)return;
  const base=judge==='perfect'?1320:judge==='great'?1090:judge==='good'?840:judge==='bad'?510:360;
  playCrystalTap(base,judge==='miss'?.52:.7);
}
function previewHitSound(){
  ensureAudioCtx();if(!audioCtx){alert('当前浏览器无法创建音频上下文。');return;}
  if(audioCtx.state==='suspended'){const p=audioCtx.resume();if(p&&p.catch)p.catch(()=>{});}
  playCrystalTap(1080,1);
}

let doorTransitionBusy=false,doorTransitionToken=0;
function startGame(){
  const song=songs[selectedSong];if(!song)return;
  const dd=song.difficulties[selectedDiff];if(!dd||!Array.isArray(dd.notes)||!dd.notes.length){alert('当前难度没有有效音符');return;}
  if(doorTransitionBusy)return;
  if(SETTINGS.reduceMotion){startGameCore();return;}
  const overlay=$('doorTransition');if(!overlay){startGameCore();return;}
  doorTransitionBusy=true;const token=++doorTransitionToken;
  setText('doorTransitionTitle',String(song.title||'DOOR'));
  setText('doorTransitionSubtitle',`${String(song.artist||'UNKNOWN')} · ${String(selectedDiff).toUpperCase()}`);
  overlay.classList.remove('phase-flow');overlay.classList.add('active','phase-in');overlay.setAttribute('aria-hidden','false');
  const finish=()=>{if(token!==doorTransitionToken)return;overlay.classList.remove('active','phase-in','phase-flow');overlay.setAttribute('aria-hidden','true');doorTransitionBusy=false;startGameCore();};
  window.setTimeout(()=>{if(token===doorTransitionToken){overlay.classList.remove('phase-in');overlay.classList.add('phase-flow');}},260);
  window.setTimeout(finish,820);
}

function startGameCore(){
  const song=songs[selectedSong];if(!song)return;
  const dd=song.difficulties[selectedDiff];if(!dd||!Array.isArray(dd.notes)||!dd.notes.length){alert('当前难度没有有效音符');return;}
  if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}
  loopToken++;
  showLoading(SETTINGS.autoPlay?'准备自动演奏...':'准备谱面...');gameState='loading';
