  const fill=gctx.createLinearGradient(x,y,x,y+h);
  fill.addColorStop(0,'rgba(248,253,255,.98)');fill.addColorStop(.24,hexToRgba(color,.99));fill.addColorStop(1,hexToRgba(color,.92));
  gctx.fillStyle=fill;
  gctx.save();
  gctx.shadowColor=color;
  gctx.shadowBlur=SETTINGS.renderQuality==='high'?20:SETTINGS.renderQuality==='balanced'?14:8;
  gctx.fill();
  gctx.restore();
  gctx.strokeStyle='rgba(246,253,255,.98)';gctx.lineWidth=1.25;gctx.stroke();
  gctx.beginPath();gctx.moveTo(x+Math.max(8,w*.14),y+2.4);gctx.lineTo(x+w-Math.max(8,w*.14),y+2.4);
  gctx.strokeStyle='rgba(255,255,255,.98)';gctx.lineWidth=1.25;gctx.lineCap='round';gctx.stroke();
  gctx.beginPath();gctx.moveTo(x+Math.max(9,w*.12),y+h-2.2);gctx.lineTo(x+w-Math.max(9,w*.12),y+h-2.2);
