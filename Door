  </div>
  <div class="panel-section panel-offset-section" style="flex:1;display:flex;flex-direction:column">
    <div class="panel-title">时间偏差 (ms)</div>
    <canvas id="offsetCanvas"></canvas>
  </div>
  <div class="survival-hud" id="survivalHUD" aria-live="polite"><div class="survival-label"><span>✦ LIFE</span><b id="survivalValue">100%</b></div><div class="survival-track"><i id="survivalFill"></i></div></div>
