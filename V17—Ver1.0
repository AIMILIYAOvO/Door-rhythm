</script>
<script>
// ============================================================
//  Door v17.1 — Ver.1.0 transition build.
//  Visual renderer / environmental motion refined; gameplay contracts retained.
// ============================================================
const DEBUG_MODE=new URLSearchParams(location.search).has('debug');
const gameCanvas = document.getElementById('game');
const gctx = gameCanvas.getContext('2d');
const bgCanvas = document.getElementById('bgCanvas');
const bctx = bgCanvas.getContext('2d');
let CW=0, CH=0, vw=0, vh=0;

const SETTINGS = { speed:3.0, offset:0, volume:0.8, sfxVolume:0.6, autoPlay:false, multiPressHint:true, survivalGauge:false, showJudgeText:true, sfxEnabled:true, slideInput:false, reduceMotion:false, renderQuality:'low', layout:'auto', playTheme:'dark', uiTheme:'light', frameLimit:'unlimited', judgePreset:'normal', keys:['KeyD','KeyF','KeyJ','KeyK'], keyPreset:'dfjk' };
const songs = [];
let selectedSong=0, selectedDiff='hard', gameState='menu';
let audioCtx=null, audioSource=null, audioBuffer=null, musicStartAt=0, audioReady=false;
let audioEl=null, mediaNode=null, musicGain=null, audioMode='silent';
let musicStarted=false, musicSyncDone=false, audioHintShown=false, countdownStartWall=0;
let dbgArr=[];
let songStartWall=0, pauseWall=0;   // 权威主时钟（performance.now基准），暂停时补偿
const LEAD_IN_MS=1500;
let notes=[], laneNotes=[[],[],[],[]], lanePtr=[0,0,0,0], multiPressGroups=[];
let score=0, combo=0, maxCombo=0, judgedNotes=0, comboBreaks=0;
let survivalHP=100, survivalFailed=false, scoreCurve=[], lastCurveSample=-Infinity, bestRecordKey='';
let judges={perfect:0,great:0,good:0,bad:0,miss:0};
let offsetHistory=[];
let timingSamples=[];
let chartEndTime=1, lastStatsPaint=0, lastProgressPaint=0;
let frameStats={frames:0,totalMs:0,slowFrames:0,maxMs:0};
let renderFrameStats={frames:0,totalMs:0,slowFrames:0,maxMs:0};
let lastRenderWall=0,fpsWindowStart=0,fpsWindowFrames=0,currentRenderFPS=0;
let portalTransitionToken=0;
let deferHUDUpdate=false,hudUpdatePending=false;
const staticPlayfield=document.createElement('canvas');
const staticCtx=staticPlayfield.getContext('2d');
let keyDown=[false,false,false,false], holdActive=[null,null,null,null];
let inputQueue=[];
const sourceDown=new Set();                 // 已按下或已排队按下的物理来源
const sourceLane=new Map();                 // source -> lane，避免 keyup 时键位配置变化导致错轨
const laneSources=[new Set(),new Set(),new Set(),new Set()];
const activePointers=new Map();             // pointerId -> {lane,source}
let loopToken=0;
let particles=[], judgeFx=[], laneFlash=[0,0,0,0], comboPulse=0;
let lastFrame=0, rafId=null, bgParticles=[], bgAnimId=null;
let playArea={x:0,y:0,w:0,h:0,laneW:0,judgeY:0};

const JUDGE_PRESETS = {
  easy:    {perfect:60, great:110, good:160, bad:200, miss:240, label:'宽松'},
  normal:  {perfect:45, great:90,  good:140, bad:190, miss:220, label:'标准'},
  hard:    {perfect:30, great:65,  good:100, bad:140, miss:180, label:'严格'},
  extreme: {perfect:20, great:45,  good:70,  bad:110, miss:150, label:'极限'}
};
const J = {...JUDGE_PRESETS.normal};
function applyJudgePreset(name){
  const p = JUDGE_PRESETS[name] || JUDGE_PRESETS.normal;
  J.perfect = p.perfect; J.great = p.great; J.good = p.good;
  J.bad = p.bad; J.miss = p.miss;
}

const JC={perfect:'#C5A7F4',great:'#72D2F0',good:'#F1D17B',bad:'#F0A071',miss:'#F17899'};
const LC=['#D887BD','#AAA2F2','#75CDED','#78D5C5'];
const LN=['D','F','J','K'];

let globalAudioUnlocked = false;
function unlockAudioGlobal(){
  if(globalAudioUnlocked) return;
  globalAudioUnlocked = true;
  ensureAudioCtx();
  try{
    const a = new Audio();
    a.src = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQAAAAA=';
    a.volume = 0;
    const p = a.play();
    if(p && p.then) p.then(()=>{ try{a.pause();}catch(e){} }).catch(()=>{});
  }catch(e){}
}
window.addEventListener('pointerdown', unlockAudioGlobal, {once:true, capture:true});
window.addEventListener('touchstart',  unlockAudioGlobal, {once:true, capture:true});
window.addEventListener('keydown',     unlockAudioGlobal, {once:true, capture:true});

function resize(){
  const vv=window.visualViewport;
  vw=Math.max(1,Math.round(vv&&vv.width?vv.width:window.innerWidth));
  vh=Math.max(1,Math.round(vv&&vv.height?vv.height:window.innerHeight));
  const qualityCap=SETTINGS.renderQuality==='high'?1.75:SETTINGS.renderQuality==='balanced'?1.4:1.15;
  const dpr=Math.max(1,Math.min(qualityCap,window.devicePixelRatio||1,1.75));
  [bgCanvas,gameCanvas].forEach(c=>{c.width=Math.max(1,Math.round(vw*dpr));c.height=Math.max(1,Math.round(vh*dpr));c.style.width=vw+'px';c.style.height=vh+'px';});
  bctx.setTransform(dpr,0,0,dpr,0,0);gctx.setTransform(dpr,0,0,dpr,0,0);
  CW=vw;CH=vh;
  computePlayArea();
}
window.addEventListener('resize',resize,{passive:true});
if(window.visualViewport)window.visualViewport.addEventListener('resize',resize,{passive:true});
window.addEventListener('orientationchange',()=>requestAnimationFrame(resize),{passive:true});

function computePlayArea(){
  const isMobile = ('ontouchstart' in window) || vw<768;
  let mode = SETTINGS.layout;
  if(mode==='auto') mode = isMobile ? 'fullscreen' : '43';
  const lp=document.getElementById('leftPanel');
  const rp=document.getElementById('rightPanel');
  if(mode==='43' && gameState==='game'){
    const pw = Math.min(vw, vh*4/3);
    const sideW = (vw-pw)/2;
    playArea={x:sideW,y:0,w:pw,h:vh,laneW:pw/4,judgeY:vh*0.82};
    lp.classList.add('active'); rp.classList.add('active');
    lp.style.width=sideW+'px'; rp.style.width=sideW+'px';
    document.documentElement.style.setProperty('--sideW', sideW+'px');
  } else {
    playArea={x:0,y:0,w:vw,h:vh,laneW:vw/4,judgeY:vh*0.82};
    lp.classList.remove('active'); rp.classList.remove('active');
    document.documentElement.style.setProperty('--sideW', '0px');
  }
  buildStaticPlayfield();
  positionHudDetailsPanel();
}
function buildStaticPlayfield(){
  if(!staticCtx||vw<=0||vh<=0)return;
  staticPlayfield.width=Math.max(1,Math.round(vw));staticPlayfield.height=Math.max(1,Math.round(vh));
  staticCtx.clearRect(0,0,vw,vh);
  const lightPlay=SETTINGS.playTheme==='light';
  const bg=staticCtx.createLinearGradient(0,0,0,vh);
  if(lightPlay){bg.addColorStop(0,'#EFF6FA');bg.addColorStop(.56,'#E3EDF4');bg.addColorStop(1,'#D8E5EE');}
  else{bg.addColorStop(0,'#0B1424');bg.addColorStop(.56,'#0A1221');bg.addColorStop(1,'#080F1C');}
  staticCtx.fillStyle=bg;staticCtx.fillRect(0,0,vw,vh);
  const pa=playArea;
  if(pa.x>0){staticCtx.fillStyle=lightPlay?'#D8E5EE':'#070D18';staticCtx.fillRect(0,0,pa.x,vh);staticCtx.fillRect(pa.x+pa.w,0,vw-pa.x-pa.w,vh);}
  for(let i=0;i<4;i++){
    const x=pa.x+i*pa.laneW,w=pa.laneW,c=LC[i];
    const grad=staticCtx.createLinearGradient(x,0,x+w,vh);
    if(lightPlay){grad.addColorStop(0,'rgba(255,255,255,.68)');grad.addColorStop(.5,'rgba(249,253,255,.42)');grad.addColorStop(1,'rgba(224,236,244,.72)');}
    else{grad.addColorStop(0,'rgba(20,35,57,.68)');grad.addColorStop(.5,'rgba(15,27,46,.42)');grad.addColorStop(1,'rgba(9,19,34,.70)');}
    staticCtx.fillStyle=grad;staticCtx.fillRect(x,0,w,vh);
    staticCtx.fillStyle=lightPlay?'rgba(62,107,139,.035)':'rgba(212,235,255,.018)';staticCtx.fillRect(x+w*.12,0,Math.max(1,w*.012),vh);
    staticCtx.fillStyle=c+'0D';staticCtx.fillRect(x+w*.84,0,Math.max(1,w*.008),vh);
    staticCtx.beginPath();
    staticCtx.moveTo(x+w*.18,56);staticCtx.lineTo(x+w*.18,31);
    staticCtx.quadraticCurveTo(x+w*.18,22,x+w*.29,22);
    staticCtx.lineTo(x+w*.71,22);
    staticCtx.quadraticCurveTo(x+w*.82,22,x+w*.82,31);
    staticCtx.lineTo(x+w*.82,56);
    staticCtx.strokeStyle=c+'31';staticCtx.lineWidth=1.1;staticCtx.stroke();
    staticCtx.strokeStyle=lightPlay?'rgba(73,112,140,.09)':'rgba(220,240,255,.07)';staticCtx.lineWidth=1;
    staticCtx.beginPath();staticCtx.moveTo(x+w*.205,34);staticCtx.lineTo(x+w*.205,53);staticCtx.stroke();
    if(i>0){
      staticCtx.strokeStyle=lightPlay?'rgba(63,105,133,.22)':'rgba(122,159,197,.18)';staticCtx.lineWidth=1;
      staticCtx.beginPath();staticCtx.moveTo(x,0);staticCtx.lineTo(x,vh);staticCtx.stroke();
      staticCtx.strokeStyle=c+'2B';staticCtx.beginPath();staticCtx.moveTo(x+.5,0);staticCtx.lineTo(x+.5,vh);staticCtx.stroke();
    }
  }
  staticCtx.strokeStyle=lightPlay?'rgba(74,113,139,.24)':'rgba(122,170,212,.17)';staticCtx.lineWidth=1;
  staticCtx.strokeRect(pa.x+.5,.5,Math.max(0,pa.w-1),Math.max(0,vh-1));
}
function toggleLayout(){
  SETTINGS.layout = SETTINGS.layout==='fullscreen' ? '43' : 'fullscreen';
  document.getElementById('layoutSelect').value=SETTINGS.layout;
  saveSettings(); computePlayArea();
}
function applyLayout(){ resize(); }

const KEY_PRESETS={dfjk:['KeyD','KeyF','KeyJ','KeyK'],sdkl:['KeyS','KeyD','KeyK','KeyL'],arrows:['ArrowLeft','ArrowDown','ArrowUp','ArrowRight']};
let bindLane=-1;
function keyName(code){
  const m={KeyA:'A',KeyS:'S',KeyD:'D',KeyF:'F',KeyJ:'J',KeyK:'K',KeyL:'L',KeyZ:'Z',KeyX:'X',KeyC:'C',KeyV:'V',KeyB:'B',ArrowLeft:'←',ArrowDown:'↓',ArrowUp:'↑',ArrowRight:'→',Space:'空格'};
  return m[code]||(code.startsWith('Key')?code.slice(3):code);
}
function onKeyPresetChange(v){
  SETTINGS.keyPreset=v;
  if(v!=='custom')SETTINGS.keys=[...KEY_PRESETS[v]];
  saveSettings(); renderKeyBinds();
}
function startKeyBind(lane){ bindLane=lane; renderKeyBinds(); }
function renderKeyBinds(){
  const pre=document.getElementById('keyPresetSelect');
  if(pre) pre.value=SETTINGS.keyPreset||'dfjk';
  const lbl=document.getElementById('keyPresetLabel');
  if(lbl) lbl.textContent=SETTINGS.keys.map(keyName).join(' ');
  const btns=document.querySelectorAll('.key-bind-btn');
  for(let i=0;i<4;i++){
    const b=btns[i]; if(!b) continue;
    b.textContent=bindLane===i?'按任意键...':keyName(SETTINGS.keys[i]);
    b.classList.toggle('capturing',bindLane===i);
  }
  ['keyHintK1','keyHintK2','keyHintK3','keyHintK4'].forEach((id,i)=>{
    const el=document.getElementById(id); if(el) el.textContent=keyName(SETTINGS.keys[i]);
  });
}

function loadSettings(){
  try{Object.assign(SETTINGS,JSON.parse(localStorage.getItem('rg_settings')||'{}'));}catch(e){}
  if(!['low','balanced','high'].includes(SETTINGS.renderQuality))SETTINGS.renderQuality='low';
  if(!['dark','light'].includes(SETTINGS.playTheme))SETTINGS.playTheme='dark';
  // v17.7 additive: UI theme (menu / library / settings / result). Independent from the play-stage theme.
  if(!['dark','light'].includes(SETTINGS.uiTheme))SETTINGS.uiTheme='light';
  if(!['unlimited','30','60','90','120','144','165','240'].includes(String(SETTINGS.frameLimit)))SETTINGS.frameLimit='unlimited';
  SETTINGS.autoPlay = SETTINGS.autoPlay === true || SETTINGS.autoPlay === 'true';
  SETTINGS.multiPressHint = SETTINGS.multiPressHint !== false && SETTINGS.multiPressHint !== 'false';
  if(!Array.isArray(SETTINGS.keys)||SETTINGS.keys.length!==4)SETTINGS.keys=['KeyD','KeyF','KeyJ','KeyK'];
  const fallbackKeys=['KeyD','KeyF','KeyJ','KeyK'];
  const usedKeys=new Set();
  SETTINGS.keys=SETTINGS.keys.map((k,i)=>{if(typeof k!=='string'||usedKeys.has(k)){k=fallbackKeys[i];while(usedKeys.has(k))k='Key'+String.fromCharCode(65+i);}usedKeys.add(k);return k;});
  SETTINGS.slideInput=!!SETTINGS.slideInput;
  SETTINGS.reduceMotion=!!SETTINGS.reduceMotion;
  if(SETTINGS.keyPreset!=='custom'&&!KEY_PRESETS[SETTINGS.keyPreset])SETTINGS.keyPreset='dfjk';
  const $=id=>document.getElementById(id);
  if(SETTINGS.speed>10)SETTINGS.speed=Math.round(SETTINGS.speed/200*10)/10;
  const clamp=(v,min,max,def)=>Number.isFinite(Number(v))?Math.max(min,Math.min(max,Number(v))):def;
  SETTINGS.speed=clamp(SETTINGS.speed,1,8,3);
  SETTINGS.offset=clamp(SETTINGS.offset,-200,200,0);
  SETTINGS.volume=clamp(SETTINGS.volume,0,1,0.8);
  SETTINGS.sfxVolume=clamp(SETTINGS.sfxVolume,0,1,0.6);
  if(!['auto','fullscreen','43'].includes(SETTINGS.layout))SETTINGS.layout='auto';
  if(!JUDGE_PRESETS[SETTINGS.judgePreset])SETTINGS.judgePreset='normal';
  $('speedSlider').value=SETTINGS.speed; $('speedVal').textContent=SETTINGS.speed.toFixed(1)+'x';
  $('offsetSlider').value=SETTINGS.offset; $('offsetVal').textContent=SETTINGS.offset;
  $('volSlider').value=SETTINGS.volume*100; $('volVal').textContent=Math.round(SETTINGS.volume*100)+'%';
  $('sfxSlider').value=SETTINGS.sfxVolume*100; $('sfxVal').textContent=Math.round(SETTINGS.sfxVolume*100)+'%';
  $('layoutSelect').value=SETTINGS.layout;
  $('judgeTextToggle').classList.toggle('on',SETTINGS.showJudgeText);$('judgeTextToggle').setAttribute('aria-checked',String(SETTINGS.showJudgeText));
  $('sfxToggle').classList.toggle('on',SETTINGS.sfxEnabled);$('sfxToggle').setAttribute('aria-checked',String(SETTINGS.sfxEnabled));
  $('slideInputToggle').classList.toggle('on',SETTINGS.slideInput);$('slideInputToggle').setAttribute('aria-checked',String(SETTINGS.slideInput));
  $('multiPressToggle').classList.toggle('on',SETTINGS.multiPressHint);$('multiPressToggle').setAttribute('aria-checked',String(SETTINGS.multiPressHint));
  SETTINGS.survivalGauge=!!SETTINGS.survivalGauge;const sgt=$('survivalGaugeToggle');if(sgt){sgt.classList.toggle('on',SETTINGS.survivalGauge);sgt.setAttribute('aria-checked',String(SETTINGS.survivalGauge));}
  $('motionToggle').classList.toggle('on',SETTINGS.reduceMotion);$('motionToggle').setAttribute('aria-checked',String(SETTINGS.reduceMotion));document.body.classList.toggle('reduce-motion',SETTINGS.reduceMotion);
  $('qualitySelect').value=SETTINGS.renderQuality||'low';$('qualityLabel').textContent=({low:'低延迟',balanced:'均衡',high:'高画质'})[SETTINGS.renderQuality||'low'];
  const pbt=$('playThemeSelect');if(pbt)pbt.value=SETTINGS.playTheme;
  const fls=$('frameLimitSelect');if(fls)fls.value=String(SETTINGS.frameLimit);
  applyPlayTheme();
  applyJudgePreset(SETTINGS.judgePreset);
  updateJudgePresetUI();
  renderKeyBinds();
}
function saveSettings(){try{localStorage.setItem('rg_settings',JSON.stringify(SETTINGS));}catch(e){console.warn('设置无法写入本地存储',e);}}
loadSettings();
$=id=>document.getElementById(id);
function refreshRangeFill(el){if(!el)return;const min=+el.min||0,max=+el.max||100,v=+el.value;const pct=Math.max(0,Math.min(100,(v-min)/(max-min)*100));el.style.setProperty('--fill',pct+'%');}
function refreshAllRangeFills(){['speedSlider','offsetSlider','volSlider','sfxSlider'].forEach(id=>refreshRangeFill(document.getElementById(id)));}
refreshAllRangeFills();
document.querySelectorAll('input[type=range]').forEach(el=>el.addEventListener('input',()=>refreshRangeFill(el)));
syncPlayModeUI();
$('speedSlider').oninput=function(){SETTINGS.speed=+this.value;$('speedVal').textContent=(+this.value).toFixed(1)+'x';saveSettings();};
$('offsetSlider').oninput=function(){SETTINGS.offset=+this.value;$('offsetVal').textContent=this.value;saveSettings();};
$('volSlider').oninput=function(){SETTINGS.volume=+this.value/100;$('volVal').textContent=this.value+'%';saveSettings();applyMusicVolume();};
$('sfxSlider').oninput=function(){SETTINGS.sfxVolume=+this.value/100;$('sfxVal').textContent=this.value+'%';saveSettings();};
function toggleJudgeText(){SETTINGS.showJudgeText=!SETTINGS.showJudgeText;$('judgeTextToggle').classList.toggle('on',SETTINGS.showJudgeText);$('judgeTextToggle').setAttribute('aria-checked',String(SETTINGS.showJudgeText));saveSettings();}
function toggleSfx(){SETTINGS.sfxEnabled=!SETTINGS.sfxEnabled;$('sfxToggle').classList.toggle('on',SETTINGS.sfxEnabled);$('sfxToggle').setAttribute('aria-checked',String(SETTINGS.sfxEnabled));saveSettings();}
function toggleSlideInput(){SETTINGS.slideInput=!SETTINGS.slideInput;$('slideInputToggle').classList.toggle('on',SETTINGS.slideInput);$('slideInputToggle').setAttribute('aria-checked',String(SETTINGS.slideInput));saveSettings();}
function toggleMultiPressHint(){
  SETTINGS.multiPressHint=!SETTINGS.multiPressHint;
  $('multiPressToggle').classList.toggle('on',SETTINGS.multiPressHint);$('multiPressToggle').setAttribute('aria-checked',String(SETTINGS.multiPressHint));saveSettings();
}
function toggleSurvivalGauge(){SETTINGS.survivalGauge=!SETTINGS.survivalGauge;const el=$('survivalGaugeToggle');if(el){el.classList.toggle('on',SETTINGS.survivalGauge);el.setAttribute('aria-checked',String(SETTINGS.survivalGauge));}saveSettings();}

function onFrameLimitChange(value){
  const allowed=['unlimited','30','60','90','120','144','165','240'];
  SETTINGS.frameLimit=allowed.includes(String(value))?String(value):'unlimited';
  saveSettings();
  updateFpsHud(currentRenderFPS);
}
function onPlayThemeChange(value){
  SETTINGS.playTheme=value==='light'?'light':'dark';
  saveSettings();applyPlayTheme();
}
function applyPlayTheme(){
  if(!document.body)return;
  document.body.classList.toggle('play-theme-light',SETTINGS.playTheme==='light');
  if(typeof buildStaticPlayfield==='function'&&vw>0&&vh>0)buildStaticPlayfield();
}
function updateFpsHud(fps){
  const shown=Number.isFinite(fps)&&fps>0?`${fps.toFixed(1)} FPS`:'— FPS';
  setText('panelFps',shown);setText('detailFps',shown);
}
function syncHudMetadata(){
  const pairs=[['hudSongTitle','detailSongTitle'],['hudSongArtist','detailSongArtist'],['hudDifficulty','detailDifficulty'],['autoBadge','detailAutoBadge'],['bestDelta','detailBestDelta']];
  for(const [srcId,dstId] of pairs){
    const src=$(srcId),dst=$(dstId);if(!src||!dst)continue;
    dst.textContent=src.textContent;
    dst.classList.toggle('active',src.classList.contains('active'));
    if(src.style.color)dst.style.color=src.style.color;
    if(src.title)dst.title=src.title;
  }
}
function toggleReduceMotion(){
  SETTINGS.reduceMotion=!SETTINGS.reduceMotion;
  $('motionToggle').classList.toggle('on',SETTINGS.reduceMotion);
  $('motionToggle').setAttribute('aria-checked',String(SETTINGS.reduceMotion));
  document.body.classList.toggle('reduce-motion',SETTINGS.reduceMotion);
  initBgParticles();saveSettings();
  if(gameState==='menu')startBgAnim();
}
function onQualityChange(value){SETTINGS.renderQuality=['low','balanced','high'].includes(value)?value:'low';$('qualityLabel').textContent=({low:'低延迟',balanced:'均衡',high:'高画质'})[SETTINGS.renderQuality];saveSettings();resize();}
document.querySelectorAll('.toggle[role="switch"]').forEach(el=>el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();el.click();}}));

function onJudgePresetChange(name){
  SETTINGS.judgePreset = name;
  applyJudgePreset(name);
  saveSettings();
  updateJudgePresetUI();
}
function updateJudgePresetUI(){
  const sel = document.getElementById('judgeSelect');
  const lbl = document.getElementById('judgePresetLabel');
  const info = document.getElementById('judgeWindowInfo');
  if(!sel) return;
  sel.value = SETTINGS.judgePreset;
  const p = JUDGE_PRESETS[SETTINGS.judgePreset] || JUDGE_PRESETS.normal;
  if(lbl) lbl.textContent = p.label;
  if(info) info.textContent = `Perfect ±${p.perfect}ms · Great ±${p.great}ms · Good ±${p.good}ms · Bad ±${p.bad}ms`;
}

let gameCanvasTransitionToken=0;
function showGameCanvasAnimated(){
  gameCanvasTransitionToken++;
  gameCanvas.style.visibility='visible';
  requestAnimationFrame(()=>{if(gameState==='game'||gameState==='paused')gameCanvas.classList.add('game-canvas-visible');});
}
function hideGameCanvasAnimated(){
  const token=++gameCanvasTransitionToken;
  const wasVisible=gameCanvas.classList.contains('game-canvas-visible')&&gameCanvas.style.visibility!=='hidden';
  if(!wasVisible){gameCanvas.style.visibility='hidden';gctx.clearRect(0,0,vw,vh);return;}
  gameCanvas.classList.remove('game-canvas-visible');
  const finish=()=>{if(token!==gameCanvasTransitionToken||gameCanvas.classList.contains('game-canvas-visible'))return;gameCanvas.style.visibility='hidden';gctx.clearRect(0,0,vw,vh);};
  gameCanvas.addEventListener('transitionend',finish,{once:true});
  setTimeout(finish,260);
}

function showScreen(name){
  hideGameCanvasAnimated();
  closeHudDetails();
  $('gameControls').classList.remove('active');
  $('modeBtn').classList.remove('active');
  $('autoBadge').classList.remove('active');
  document.querySelectorAll('.screen').forEach(s=>{s.classList.remove('active','screen-enter');});
  $('menu').style.display = name==='menu'?'flex':'';
  const el=$(name); if(el)el.classList.add('active');
  gameState=name;
  if(name==='songselect'){renderSongList();syncPlayModeUI();}
  if(name==='menu') startBgAnim(); else stopBgAnim();
  $('progressBar').classList.remove('active');
}

function initBgParticles(){
  bgParticles=[];
  const count=SETTINGS.reduceMotion?12:(SETTINGS.renderQuality==='high'?30:SETTINGS.renderQuality==='balanced'?22:16);
  for(let i=0;i<count;i++){
    bgParticles.push({x:Math.random()*vw,y:Math.random()*vh,vx:(Math.random()-.5)*7,vy:2+Math.random()*7,r:.8+Math.random()*1.8,hue:Math.random()});
  }
}
function drawBg(){
  const lightScene=['menu','songselect','settings','result'].includes(gameState);
  bctx.fillStyle=lightScene?'#E7EEF5':'#080F1D'; bctx.fillRect(0,0,vw,vh);
  const motionTime=performance.now()/1000;
  const t=SETTINGS.reduceMotion?0:motionTime/8;
  const x1=vw*(.22+.035*Math.sin(t)), y1=vh*.22;
  const g1=bctx.createRadialGradient(x1,y1,0,x1,y1,Math.max(vw,vh)*.62);
  g1.addColorStop(0,lightScene?'rgba(105,190,221,.20)':'rgba(54,126,171,.17)'); g1.addColorStop(1,lightScene?'rgba(105,190,221,0)':'rgba(54,126,171,0)');
  bctx.fillStyle=g1; bctx.fillRect(0,0,vw,vh);
  const x2=vw*(.82+.025*Math.cos(t*.8)), y2=vh*.78;
  const g2=bctx.createRadialGradient(x2,y2,0,x2,y2,Math.max(vw,vh)*.52);
  g2.addColorStop(0,lightScene?'rgba(218,151,189,.15)':'rgba(150,79,132,.13)'); g2.addColorStop(1,lightScene?'rgba(218,151,189,0)':'rgba(150,79,132,0)');
  bctx.fillStyle=g2; bctx.fillRect(0,0,vw,vh);

  // Ambient rain-light refractions: five very faint curved bands, independent of game time/input.
  bctx.save();
  bctx.lineWidth=1;
  for(let i=0;i<5;i++){
    const baseY=vh*(.18+i*.17);
    const drift=SETTINGS.reduceMotion?0:Math.sin(motionTime*.22+i*.91)*vh*.022;
    bctx.beginPath();
    bctx.moveTo(-vw*.08,baseY+drift);
    bctx.bezierCurveTo(vw*.22,baseY-vh*.035+drift,vw*.62,baseY+vh*.045-drift,vw*1.08,baseY-vh*.014+drift);
    bctx.strokeStyle=lightScene?(i%2?'rgba(131,196,219,.09)':'rgba(221,162,197,.075)'):(i%2?'rgba(104,177,219,.075)':'rgba(213,147,194,.055)');
    bctx.stroke();
  }
  // Sparse, slow rain streaks; their position is deterministic so they do not flicker between frames.
  const streakCount=SETTINGS.reduceMotion?0:(SETTINGS.renderQuality==='high'?13:SETTINGS.renderQuality==='balanced'?9:6);
  for(let i=0;i<streakCount;i++){
    const x=((i*137+motionTime*(7+(i%3)*2))%(vw+30))-15;
    const y=((i*83+motionTime*(12+(i%4)*3))%(vh+40))-20;
    bctx.beginPath();bctx.moveTo(x,y);bctx.lineTo(x-4,y+13+(i%3)*4);
    bctx.strokeStyle=lightScene?'rgba(117,177,207,.12)':'rgba(142,199,231,.09)';bctx.lineWidth=.8;bctx.stroke();
  }
  bctx.restore();

  for(const p of bgParticles){
    if(!SETTINGS.reduceMotion){p.x+=p.vx/60;p.y+=p.vy/60;if(p.y>vh+5){p.y=-5;p.x=Math.random()*vw;}if(p.x<-5)p.x=vw+5;if(p.x>vw+5)p.x=-5;}
    const col=lightScene?(p.hue<.5?'104,167,195':'195,133,166'):(p.hue<.5?'79,151,194':'174,105,158');
    bctx.fillStyle=`rgba(${col},${lightScene?(SETTINGS.reduceMotion?.08:.07+p.r*.025):(SETTINGS.reduceMotion?.12:.12+p.r*.055)})`;
    bctx.beginPath();bctx.arc(p.x,p.y,p.r,0,Math.PI*2);bctx.fill();
  }
}
function bgLoop(){drawBg();bgAnimId=requestAnimationFrame(bgLoop);}
function startBgAnim(){if(SETTINGS.reduceMotion){if(bgAnimId){cancelAnimationFrame(bgAnimId);bgAnimId=null;}initBgParticles();drawBg();return;}if(!bgAnimId){initBgParticles();bgLoop();}}
function stopBgAnim(){if(bgAnimId){cancelAnimationFrame(bgAnimId);bgAnimId=null;}const lightScene=['menu','songselect','settings','result'].includes(gameState);bctx.fillStyle=lightScene?'#E7EEF5':'#080F1D';bctx.fillRect(0,0,vw,vh);}
resize(); initBgParticles(); startBgAnim();

function setPlayMode(auto){
  if(gameState==='game'||gameState==='paused')return;
  SETTINGS.autoPlay=!!auto;saveSettings();syncPlayModeUI();
}
function syncPlayModeUI(){
  const manual=$('manualModeBtn'),auto=$('autoModeBtn'),desc=$('playModeDescription');
  if(manual){manual.classList.toggle('selected',!SETTINGS.autoPlay);manual.setAttribute('aria-pressed',String(!SETTINGS.autoPlay));}
  if(auto){auto.classList.toggle('selected',SETTINGS.autoPlay);auto.setAttribute('aria-pressed',String(SETTINGS.autoPlay));}
  if(desc)desc.textContent=SETTINGS.autoPlay?'自动演奏 · 结算会明确标注 AUTO':'手动击打 · 使用当前键位或触屏操作';
}
function toggleHudDetails(){
  const panel=$('hudDetailsPanel'),btn=$('hudDetailsBtn');if(!panel||!btn)return;
  const open=!panel.classList.contains('active');
  panel.classList.toggle('active',open);
  panel.setAttribute('aria-hidden',String(!open));
  btn.setAttribute('aria-expanded',String(open));
  if(open)positionHudDetailsPanel();
}
function positionHudDetailsPanel(){
  const panel=$('hudDetailsPanel');if(!panel||!playArea)return;
  const pa=playArea;
  panel.style.left=(pa.x+pa.w/2)+'px';
  panel.style.width=Math.max(0,Math.min(470,pa.w-28))+'px';
}
function closeHudDetails(){
  const panel=$('hudDetailsPanel'),btn=$('hudDetailsBtn');if(panel){panel.classList.remove('active');panel.setAttribute('aria-hidden','true');}if(btn)btn.setAttribute('aria-expanded','false');
}

let expandedSong=-1;
function renderSongList(){
  const list=$('songList'); list.innerHTML='';
  if(songs.length===0){
    const empty=document.createElement('div');
    empty.className='empty-library';
    empty.innerHTML='<div class="empty-note">♫</div><b>曲库还是空的</b><p>从你喜欢的歌曲开始。导入 osu!mania 4K 的 <strong>.osz</strong> 谱面，即可加入本地曲库。</p><span>支持拖拽，也可以点击上方导入区域选择文件</span>';
    list.appendChild(empty);
    const count=$('songCount');if(count)count.textContent='0';
    return;
  }
  const count=$('songCount');if(count)count.textContent=String(songs.length);
  songs.forEach((song,idx)=>{
    const card=document.createElement('div');
    card.className='song-card'+(idx===expandedSong?' selected':'');
    const info=document.createElement('div');info.className='info';
    const title=document.createElement('div');title.className='title';title.textContent=String(song.title||'未命名');
    const artist=document.createElement('div');artist.className='artist';artist.textContent=String(song.artist||'未知曲师');
    info.append(title,artist);
    card.append(info);
    // v17.7：卡片只负责选中曲目，BPM/音符数/难度标签全部移除；
    // 难度只保留在中间「当前曲目」区一处，避免与左侧重复。
    card.onclick=()=>{
      selectedSong=idx;expandedSong=idx;
      const keys=Object.keys(song.difficulties||{});
      if(!keys.includes(selectedDiff))selectedDiff=keys[0]||'normal';
      renderSongList();
    };
    list.appendChild(card);
  });
}

async function collectChartFolderFiles(dirHandle,prefix='',out=[],depth=0){
  if(depth>12)throw new Error('文件夹嵌套层数过深（超过 12 层）');
  for await(const [name,handle] of dirHandle.entries()){
    if(handle.kind==='directory'){
      await collectChartFolderFiles(handle,prefix+name+'/',out,depth+1);
    }else if(handle.kind==='file'&&/\.(osu|mp3|ogg|wav|m4a|aac|opus|jpg|jpeg|png|gif|bmp|webp)$/i.test(name)){
      const file=await handle.getFile();out.push({path:prefix+name,file});
      if(out.length>15000)throw new Error('选定目录的谱面/音频文件超过 15000 个，请选择更具体的曲库文件夹');
    }
  }
  return out;
}
async function chooseChartFolder(){
  unlockAudioGlobal();
  const fallback=$('folderInput');
  if(typeof window.showDirectoryPicker==='function'&&window.isSecureContext){
    try{
      const rootHandle=await window.showDirectoryPicker({mode:'read'});
      showLoading('正在扫描你选择的谱面文件夹…');
      const entries=await collectChartFolderFiles(rootHandle);
      await importOsuFolderFiles(entries,rootHandle.name||'所选文件夹');
      return;
    }catch(err){
      if(err&&err.name==='AbortError'){hideLoading();return;}
      console.warn('目录选择 API 不可用，回退到文件夹输入：',err);
      hideLoading();
    }
  }
  if(fallback)fallback.click();
  else alert('当前浏览器不支持文件夹选择，请使用较新的 Chromium 浏览器。');
}
async function importOsuFolderInput(fileList){
  if(!fileList||!fileList.length)return;
  const entries=Array.from(fileList).map(file=>({path:file.webkitRelativePath||file.name,file}));
  await importOsuFolderFiles(entries,'所选文件夹');
}
async function importOsuFolderFiles(entries,sourceLabel='所选文件夹'){
  showLoading('正在识别 osu!mania 4K 谱面…');
  try{
    const files=entries.filter(e=>e&&e.file&&typeof e.path==='string'&&/\.(osu|mp3|ogg|wav|m4a|aac|opus)$/i.test(e.path));
    const osuFiles=files.filter(e=>/\.osu$/i.test(e.path));
    if(!osuFiles.length)throw new Error('所选文件夹及其子目录中没有找到 .osu 文件');
    const byPath=new Map(files.map(e=>[e.path.replace(/\\/g,'/').replace(/^\.\//,'').toLowerCase(),e]));
    // v17.6 additive: cover images are indexed separately so the existing audio/osu filtering stays untouched.
    const imageExt=/\.(jpg|jpeg|png|gif|bmp|webp)$/i;
    const imageFiles=entries.filter(e=>e&&e.file&&typeof e.path==='string'&&imageExt.test(e.path));
    const audioExt=/\.(mp3|ogg|wav|m4a|aac|opus)$/i;
    const isHitSound=p=>/(hitnormal|hitwhistle|hitfinish|hitclap|hit-|drum-|soft-|normal-hit|slider(whistle|slide)|spinnerspin)/i.test(p);
    const basename=p=>String(p||'').replace(/\\/g,'/').split('/').pop().toLowerCase();
    const dirname=p=>String(p||'').replace(/\\/g,'/').split('/').slice(0,-1).join('/');
    const parsedMaps=[];let skipped=0;
    for(let i=0;i<osuFiles.length;i++){
      const entry=osuFiles[i];
      try{
        const parsed=parseOsu(await entry.file.text());
        if(parsed.mode!==3||parsed.keys!==4||!parsed.notes.length){skipped++;continue;}
        parsedMaps.push({path:entry.path.replace(/\\/g,'/'),parsed});
      }catch(e){skipped++;}
      if((i+1)%80===0){$('loadingText').textContent=`正在识别谱面… ${i+1}/${osuFiles.length}`;await new Promise(resolve=>setTimeout(resolve,0));}
    }
    if(!parsedMaps.length)throw new Error('没有找到可用的 osu!mania 4K 谱面；非 4K、非 mania 或空谱面已跳过');
    const groups=new Map();
    for(const item of parsedMaps){
      const folder=dirname(item.path);
      const key=(folder+'|'+(item.parsed.title||'未命名')+'|'+(item.parsed.artist||'未知')).toLowerCase();
      if(!groups.has(key))groups.set(key,{folder,items:[],title:item.parsed.title||'未命名',artist:item.parsed.artist||'未知',bpm:item.parsed.bpm||120});
      groups.get(key).items.push(item);
    }
    const priority={easy:0,normal:1,hard:2,expert:3},slots=['easy','normal','hard','expert'];
    let added=0,merged=0,allDifficulties=0;
    for(const group of groups.values()){
      group.items.sort((a,b)=>(priority[a.parsed.difficulty]??1)-(priority[b.parsed.difficulty]??1));
      const difficulties={},used=new Set();
      for(const item of group.items){
        let diff=item.parsed.difficulty||'normal';
        if(used.has(diff))diff=slots.find(v=>!used.has(v));
        if(!diff)continue;
        used.add(diff);difficulties[diff]={level:item.parsed.level||5,notes:item.parsed.notes};
      }
      if(!Object.keys(difficulties).length)continue;
      const preferred=group.items.map(x=>x.parsed.audioFile).find(Boolean)||'';
      const folderNorm=group.folder.replace(/\\/g,'/');
      const candidate=preferred?`${folderNorm}/${preferred}`.replace(/\\/g,'/').toLowerCase():'';
      let audioEntry=byPath.get(candidate);
      if(!audioEntry&&preferred)audioEntry=files.find(e=>basename(e.path)===basename(preferred)&&dirname(e.path).toLowerCase()===folderNorm.toLowerCase());
      if(!audioEntry)audioEntry=files.find(e=>dirname(e.path).toLowerCase()===folderNorm.toLowerCase()&&audioExt.test(e.path)&&!isHitSound(e.path));
      if(!audioEntry)audioEntry=files.find(e=>dirname(e.path).toLowerCase()===folderNorm.toLowerCase()&&audioExt.test(e.path));
      const audioUrl=audioEntry?URL.createObjectURL(audioEntry.file):null;
      // v17.6 additive: prefer the [Events] cover, then any image sitting next to the chart.
      const preferredCover=group.items.map(x=>x.parsed.background).find(Boolean)||'';
      const coverCandidate=preferredCover?`${folderNorm}/${preferredCover}`.replace(/\\/g,'/').toLowerCase():'';
      let coverEntry=coverCandidate?byPath.get(coverCandidate):null;
      if(!coverEntry&&preferredCover)coverEntry=imageFiles.find(e=>basename(e.path)===basename(preferredCover)&&dirname(e.path).toLowerCase()===folderNorm.toLowerCase());
      if(!coverEntry&&preferredCover)coverEntry=imageFiles.find(e=>basename(e.path)===basename(preferredCover));
      const coverUrl=coverEntry?URL.createObjectURL(coverEntry.file):null;
      const sourceKey=folderNorm.toLowerCase()+'|'+group.title.toLowerCase()+'|'+group.artist.toLowerCase();
      const song={id:'folder_'+Date.now()+'_'+Math.random().toString(36).slice(2,8),sourceKey,sourcePath:group.folder,title:group.title,artist:group.artist,bpm:group.bpm,audio:audioUrl,coverUrl,difficulties};
      const existIdx=songs.findIndex(old=>old.sourceKey===sourceKey||(!old.sourceKey&&old.title===song.title&&old.artist===song.artist));
      if(existIdx>=0){
        const existing=songs[existIdx];Object.assign(existing.difficulties,difficulties);existing.sourceKey=sourceKey;existing.sourcePath=group.folder;existing.bpm=song.bpm||existing.bpm;
        if(audioUrl){if(existing.audio&&existing.audio.startsWith('blob:'))URL.revokeObjectURL(existing.audio);existing.audio=audioUrl;}
        if(coverUrl){if(existing.coverUrl&&existing.coverUrl.startsWith('blob:'))URL.revokeObjectURL(existing.coverUrl);existing.coverUrl=coverUrl;}
        selectedSong=existIdx;merged++;
      }else{songs.push(song);selectedSong=songs.length-1;added++;}
      allDifficulties+=Object.keys(difficulties).length;
    }
    if(!added&&!merged)throw new Error('未能导入任何曲目，请检查所选目录结构');
    const selected=songs[selectedSong];selectedDiff=selected?(Object.keys(selected.difficulties).includes(selectedDiff)?selectedDiff:(Object.keys(selected.difficulties)[0]||'normal')):'normal';
    expandedSong=selectedSong;hideLoading();renderSongList();
    alert(`文件夹识别完成：${sourceLabel}\n新增曲目：${added} 首\n合并曲目：${merged} 首\n可用难度：${allDifficulties} 个\n跳过无效/非 4K 谱面：${skipped} 个`);
  }catch(err){console.error(err);hideLoading();alert('文件夹读取失败：'+(err&&err.message?err.message:String(err)));}
}
$('songList').addEventListener('wheel',e=>{
  if(gameState!=='songselect'||songs.length<2||Math.abs(e.deltaY)<2)return;
  e.preventDefault();
  const dir=e.deltaY>0?1:-1;
  const base=expandedSong>=0?expandedSong:(selectedSong>=0?selectedSong:0);
  expandedSong=(base+dir+songs.length)%songs.length;
  selectedSong=expandedSong;
  const keys=Object.keys(songs[selectedSong].difficulties||{});if(!keys.includes(selectedDiff))selectedDiff=keys[0]||'normal';
  renderSongList();
  requestAnimationFrame(()=>{const card=$('songList').querySelector('.song-card.selected');if(card)card.scrollIntoView({block:'nearest',behavior:'smooth'});});
},{passive:false});

const dropZone=$('dropZone'), fileInput=$('fileInput');
dropZone.onclick=()=>fileInput.click();
fileInput.onchange=e=>{unlockAudioGlobal();if(e.target.files[0])importOsz(e.target.files[0]);};
const folderInput=$('folderInput');if(folderInput)folderInput.onchange=e=>{unlockAudioGlobal();importOsuFolderInput(e.target.files);e.target.value='';};
dropZone.ondragover=e=>{e.preventDefault();dropZone.classList.add('drag');};
dropZone.ondragleave=()=>dropZone.classList.remove('drag');
dropZone.ondrop=e=>{e.preventDefault();dropZone.classList.remove('drag');unlockAudioGlobal();if(e.dataTransfer.files[0])importOsz(e.dataTransfer.files[0]);};
document.body.ondragover=e=>e.preventDefault();
document.body.ondrop=e=>{e.preventDefault();unlockAudioGlobal();if(gameState==='songselect'&&e.dataTransfer.files[0])importOsz(e.dataTransfer.files[0]);};

async function importOsz(file){
  showLoading('解析谱面...');
  try{
    if(!window.JSZip)throw new Error('压缩库未加载，请检查网络后刷新页面');
    const zip=await JSZip.loadAsync(file);
    const allEntries=Object.entries(zip.files).filter(([name,entry])=>!entry.dir);
    const osuEntries=allEntries.filter(([name])=>/\.osu$/i.test(name)).sort((a,b)=>a[0].localeCompare(b[0]));
    if(!osuEntries.length)throw new Error('压缩包中未找到 .osu 谱面文件');
    const parsedMaps=[];
    for(const [path,entry] of osuEntries){
      const parsed=parseOsu(await entry.async('string'));
      if(!parsed)continue;
      if(parsed.mode!==3)continue;
      if(parsed.keys!==4)continue;
      if(!parsed.notes.length)continue;
      parsedMaps.push({path,parsed});
    }
    if(!parsedMaps.length){
      const first=await osuEntries[0][1].async('string');const sample=parseOsu(first);
      if(sample.mode!==3)throw new Error('仅支持 osu!mania 模式谱面');
      if(sample.keys!==4)throw new Error('仅支持 4K，当前谱面为 '+sample.keys+'K');
      throw new Error('谱面没有可用音符');
    }
    // 背景音乐优先匹配谱面 AudioFilename，再回退到非 hitsound 音频。
    const audioExt=/\.(mp3|ogg|wav|m4a|aac|opus)$/i;
    const isHitSound=p=>/(hitnormal|hitwhistle|hitfinish|hitclap|hit-|drum-|soft-|normal-hit|slider(whistle|slide)|spinnerspin)/i.test(p);
    const basename=p=>p.split('/').pop().toLowerCase();
    let audioEntry=null;
    const preferred=parsedMaps.map(x=>basename(x.parsed.audioFile||'')).find(Boolean);
    if(preferred)audioEntry=allEntries.find(([path])=>basename(path)===preferred);
    if(!audioEntry)audioEntry=allEntries.find(([path])=>audioExt.test(path)&&!isHitSound(path))||allEntries.find(([path])=>audioExt.test(path));
    let audioUrl=null;
    if(audioEntry){const blob=await audioEntry[1].async('blob');audioUrl=URL.createObjectURL(blob);}
    const first=parsedMaps[0].parsed;
    // v17.6 additive: resolve the beatmap cover declared in [Events]; missing images simply fall back to the decorative cover.
    const imageExt=/\.(jpg|jpeg|png|gif|bmp|webp)$/i;
    let coverUrl=null;
    const preferredCover=basename(first.background||'');
    let coverEntry=preferredCover?allEntries.find(([path])=>basename(path)===preferredCover&&imageExt.test(path)):null;
    if(!coverEntry&&preferredCover)coverEntry=allEntries.find(([path])=>basename(path)===preferredCover);
    if(coverEntry){try{coverUrl=URL.createObjectURL(await coverEntry[1].async('blob'));}catch(e){coverUrl=null;}}
    const baseTitle=first.title||file.name.replace(/\.osz$/i,'')||'未命名';
    const song={id:'imp_'+Date.now(),title:baseTitle,artist:first.artist||'未知',bpm:first.bpm||120,audio:audioUrl,coverUrl,difficulties:{}};
    const used=new Set();
    const diffPriority={easy:0,normal:1,hard:2,expert:3};
    parsedMaps.sort((a,b)=>(diffPriority[a.parsed.difficulty]??1)-(diffPriority[b.parsed.difficulty]??1));
    for(const {parsed} of parsedMaps){
      let diff=parsed.difficulty||'normal';
      if(used.has(diff)){
        // 同类难度不互相覆盖，依次填入还未占用的难度槽。
        const slots=['easy','normal','hard','expert'];
        diff=slots.find(x=>!used.has(x));
        if(!diff)continue;
      }
      used.add(diff);
      song.difficulties[diff]={level:parsed.level||5,notes:parsed.notes};
    }
    const existIdx=songs.findIndex(s=>s.title===song.title&&s.artist===song.artist);
    if(existIdx>=0){
      Object.assign(songs[existIdx].difficulties,song.difficulties);
      if(audioUrl){if(songs[existIdx].audio&&songs[existIdx].audio.startsWith('blob:'))URL.revokeObjectURL(songs[existIdx].audio);songs[existIdx].audio=audioUrl;}
      if(coverUrl){if(songs[existIdx].coverUrl&&songs[existIdx].coverUrl.startsWith('blob:'))URL.revokeObjectURL(songs[existIdx].coverUrl);songs[existIdx].coverUrl=coverUrl;}
      selectedSong=existIdx;
    }else{songs.push(song);selectedSong=songs.length-1;}
    selectedDiff=Object.keys(song.difficulties)[0]||'normal';
    hideLoading();renderSongList();
    alert(`导入成功：${song.title}\n识别到 ${Object.keys(song.difficulties).length} 个 4K 难度。${coverUrl?'\n已读取谱面曲绘。':''}\n点击难度按钮开始游玩。`);
  }catch(e){console.error(e);hideLoading();alert('导入失败：'+(e&&e.message?e.message:String(e)));}
}

function parseOsu(text){
  const lines=text.split(/\r?\n/);
  // v17.6 additive: `background` carries the beatmap cover filename (osu [Events]) for song selection.
  const r={mode:0,keys:4,bpm:120,title:'',artist:'',audioFile:'',background:'',difficulty:'normal',level:5,notes:[]};
  let sec='', bpmFound=false;
  for(const raw of lines){
    const t=raw.trim();
    if(t.startsWith('[')&&t.endsWith(']')){sec=t.slice(1,-1);continue;}
    if(!t||t.startsWith('//'))continue;
    if(sec==='General'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='Mode')r.mode=Number(v);
      else if(k==='AudioFilename')r.audioFile=v;
    }else if(sec==='Metadata'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='Title')r.title=v;else if(k==='Artist')r.artist=v;
      else if(k==='Version'){
        const vl=v.toLowerCase();
        r.difficulty=vl.includes('easy')?'easy':(vl.includes('expert')||vl.includes('insane')||vl.includes('another'))?'expert':vl.includes('hard')?'hard':'normal';
      }
    }else if(sec==='Difficulty'){
      const i=t.indexOf(':');if(i<0)continue;
      const k=t.slice(0,i).trim(),v=t.slice(i+1).trim();
      if(k==='CircleSize')r.keys=Number(v);
      else if(k==='OverallDifficulty')r.level=Math.max(1,Math.round(Number(v)*1.5));
    }else if(sec==='TimingPoints'&&!bpmFound){
      const p=t.split(',');const beatLength=Number(p[1]);
      if(p.length>=2&&beatLength>0&&Number.isFinite(beatLength)){r.bpm=Math.round(60000/beatLength);bpmFound=true;}
    }else if(sec==='Events'){
      // v17.6 additive: background events look like 0,0,"bg.jpg",0,0 — only the first one is kept.
      if(!r.background){const m=t.match(/^\s*\d+\s*,\s*\d+\s*,\s*"([^"]+)"/);if(m)r.background=m[1];}
    }else if(sec==='HitObjects'){
      const p=t.split(',');if(p.length<5)continue;
      const x=Number(p[0]),time=Number(p[2]),type=Number(p[3]);
      if(!Number.isFinite(x)||!Number.isFinite(time)||!Number.isFinite(type))continue;
      const lane=Math.min(3,Math.max(0,Math.floor(x/512*4)));
      const isHold=(type&128)!==0;
      const n={time,lane,type:isHold?'hold':'tap'};
      if(isHold&&p[5]){const e=Number(p[5].split(':')[0]);if(Number.isFinite(e)&&e>=time)n.end=e;else n.end=time;}
      if(!isHold)n.end=time;
      r.notes.push(n);
    }
  }
  r.notes.sort((a,b)=>a.time-b.time||a.lane-b.lane);
  return r;
}

function playKeySound(){
  if(!SETTINGS.sfxEnabled||SETTINGS.autoPlay)return;
  ensureAudioCtx();if(!audioCtx)return;
  const t=audioCtx.currentTime,vol=SETTINGS.sfxVolume*.045;
  // A very short, soft glass-tick: a sine sweep rather than the previous piercing square wave.
  const osc=audioCtx.createOscillator(),gain=audioCtx.createGain(),filter=audioCtx.createBiquadFilter();
  osc.type='sine';osc.frequency.setValueAtTime(2350,t);osc.frequency.exponentialRampToValueAtTime(1450,t+.014);
  filter.type='highpass';filter.frequency.setValueAtTime(1100,t);
  gain.gain.setValueAtTime(.0001,t);gain.gain.linearRampToValueAtTime(vol,t+.0018);gain.gain.exponentialRampToValueAtTime(.0001,t+.021);
  osc.connect(filter);filter.connect(gain);gain.connect(audioCtx.destination);osc.start(t);osc.stop(t+.023);
}
function playDoorHitVoice(judge,allowAutoplay=false){
  if(!audioCtx||(!allowAutoplay&&SETTINGS.autoPlay))return;
  const profile={perfect:{freq:1046.5,tail:1568},great:{freq:880,tail:1320},good:{freq:698.46,tail:1046.5},bad:{freq:523.25,tail:784},miss:{freq:392,tail:587.3}}[judge]||{freq:880,tail:1320};
  const t=audioCtx.currentTime,volume=Math.max(0,Math.min(1,SETTINGS.sfxVolume))*.19;
  const main=audioCtx.createOscillator(),mainGain=audioCtx.createGain();
  main.type='sine';main.frequency.setValueAtTime(profile.freq*1.035,t);main.frequency.exponentialRampToValueAtTime(profile.freq*.88,t+.032);
  mainGain.gain.setValueAtTime(.0001,t);mainGain.gain.linearRampToValueAtTime(volume,t+.003);mainGain.gain.exponentialRampToValueAtTime(.0001,t+.082);
  main.connect(mainGain);mainGain.connect(audioCtx.destination);main.start(t);main.stop(t+.086);
  const overtone=audioCtx.createOscillator(),overGain=audioCtx.createGain();
  overtone.type='triangle';overtone.frequency.setValueAtTime(profile.tail,t);overtone.frequency.exponentialRampToValueAtTime(profile.tail*.91,t+.024);
  overGain.gain.setValueAtTime(.0001,t);overGain.gain.linearRampToValueAtTime(volume*.20,t+.002);overGain.gain.exponentialRampToValueAtTime(.0001,t+.036);
  overtone.connect(overGain);overGain.connect(audioCtx.destination);overtone.start(t);overtone.stop(t+.039);
  // Brief broadband-like edge made from a descending sine partial; no external audio file or decode cost.
  const tick=audioCtx.createOscillator(),tickGain=audioCtx.createGain();
  tick.type='sine';tick.frequency.setValueAtTime(3100,t);tick.frequency.exponentialRampToValueAtTime(1750,t+.009);
  tickGain.gain.setValueAtTime(.0001,t);tickGain.gain.linearRampToValueAtTime(volume*.09,t+.001);tickGain.gain.exponentialRampToValueAtTime(.0001,t+.013);
  tick.connect(tickGain);tickGain.connect(audioCtx.destination);tick.start(t);tick.stop(t+.015);
}
function playHitSound(judge){
  if(!SETTINGS.sfxEnabled||!audioCtx||SETTINGS.autoPlay)return;
  playDoorHitVoice(judge,false);
}
function previewHitSound(){
  ensureAudioCtx();if(!audioCtx)return;
  if(audioCtx.state==='suspended'){const p=audioCtx.resume();if(p&&p.catch)p.catch(()=>{});}
  playDoorHitVoice('perfect',true);
}

function startGame(){
  const song=songs[selectedSong];if(!song)return;
  const dd=song.difficulties[selectedDiff];if(!dd||!Array.isArray(dd.notes)||!dd.notes.length){alert('当前难度没有有效音符');return;}
  if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}
  loopToken++;
  showLoading(SETTINGS.autoPlay?'准备自动演奏...':'准备谱面...');gameState='loading';
  unlockAudioGlobal();ensureAudioCtx();teardownAudio();
  if(song.audio){
    const el=new Audio();el.preload='auto';el.volume=SETTINGS.volume;el.src=song.audio;
    try{el.load();}catch(e){}audioEl=el;audioMode='element';
  }else{audioEl=null;audioMode='silent';}
  notes=dd.notes.map((n,index)=>({
    id:`${index}_${n.lane}_${n.time}`,
    time:Number(n.time)||0,lane:Math.min(3,Math.max(0,Number(n.lane)||0)),
    type:n.type==='hold'?'hold':'tap',end:n.type==='hold'?Math.max(Number(n.time)||0,Number(n.end)||Number(n.time)||0):(Number(n.time)||0),
    hit:false,holdHeld:false,holdDone:false,state:'pending',headError:0
  })).sort((a,b)=>a.time-b.time||a.lane-b.lane);
  laneNotes=[[],[],[],[]];notes.forEach(n=>laneNotes[n.lane].push(n));
  multiPressGroups=buildMultiPressGroups(notes);
  lanePtr=[0,0,0,0];score=0;combo=0;maxCombo=0;judgedNotes=0;comboBreaks=0;survivalHP=100;survivalFailed=false;scoreCurve=[];lastCurveSample=-Infinity;bestRecordKey=makeBestRecordKey(song,selectedDiff,dd);judges={perfect:0,great:0,good:0,bad:0,miss:0};
  offsetHistory=[];timingSamples=[];frameStats={frames:0,totalMs:0,slowFrames:0,maxMs:0};renderFrameStats={frames:0,totalMs:0,slowFrames:0,maxMs:0};lastRenderWall=0;fpsWindowStart=0;fpsWindowFrames=0;currentRenderFPS=0;lastStatsPaint=0;lastProgressPaint=0;
  chartEndTime=1;for(const n of notes){const end=n.end||n.time;if(end>chartEndTime)chartEndTime=end;}
  resetInputRuntime();
  particles=[];judgeFx=[];laneFlash=[0,0,0,0];comboPulse=0;
  $('hudSongTitle').textContent=song.title;$('hudSongArtist').textContent=song.artist;
  const hudDiff=$('hudDifficulty');if(hudDiff)hudDiff.textContent=`${selectedDiff.toUpperCase()} · Lv.${dd.level||'—'}`;
  $('autoBadge').classList.toggle('active',SETTINGS.autoPlay);$('autoBadge').textContent=SETTINGS.autoPlay?'AUTO PLAY':'';
  $('hudModeLabel').textContent=SETTINGS.autoPlay?'AUTO PLAY':'MANUAL';closeHudDetails();
  $('survivalHUD').classList.toggle('active',SETTINGS.survivalGauge);updateSurvivalHUD();updateBestDelta(true);
  const pj=document.getElementById('panelJudge');if(pj)pj.textContent=(JUDGE_PRESETS[SETTINGS.judgePreset]||JUDGE_PRESETS.normal).label;
  updateHUD();hideLoading();
  document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));
  $('pauseOverlay').classList.remove('active');$('gameHUD').classList.remove('active');$('progressBar').classList.remove('active');$('modeBtn').classList.remove('active');$('gameControls').classList.remove('active');
  stopBgAnim();gameState='transition';document.body.classList.add('door-enter-play');
  runPortalTransition(()=>{
    // The dimming filter is only for the portal entry; never leave it on the live playfield.
    document.body.classList.remove('door-enter-play');
    $('gameHUD').classList.add('active');$('progressBar').classList.add('active');$('modeBtn').classList.add('active');$('gameControls').classList.add('active');
    gameState='game';showGameCanvasAnimated();computePlayArea();
    musicStarted=false;musicSyncDone=false;audioHintShown=false;countdownStartWall=performance.now();
    dbgArr=[];songStartWall=countdownStartWall+LEAD_IN_MS;pauseWall=0;audioReady=true;
    if(audioMode==='element')unlockAudioElement();
    lastFrame=performance.now();const token=loopToken;gameLoop(token);
  });
}
function ensureAudioCtx(){
  try{
    if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();
    if(audioCtx&&audioCtx.state==='suspended'){const p=audioCtx.resume();if(p&&p.catch)p.catch(()=>{});}
  }catch(e){audioCtx=null;}
}
function unlockAudioElement(){
  const el=audioEl; if(!el)return;
  try{
    const restore=()=>{try{el.pause();el.currentTime=0;el.volume=SETTINGS.volume;}catch(e){}};
    el.volume=0;
    const pr=el.play();
    if(pr&&pr.then){pr.then(restore).catch(()=>{try{el.volume=SETTINGS.volume;}catch(e){}});}
    else restore();
  }catch(e){try{el.volume=SETTINGS.volume;}catch(e2){}}
}
function teardownAudio(){
  if(audioEl){try{audioEl.pause();}catch(e){}try{audioEl.removeAttribute('src');audioEl.load();}catch(e){}audioEl=null;}
  mediaNode=null; musicGain=null;
  if(audioSource){try{audioSource.stop();}catch(e){}audioSource=null;}
}
function applyMusicVolume(){try{if(audioEl)audioEl.volume=SETTINGS.volume;}catch(e){}}
function getGameTime(){
  if(!audioReady)return -LEAD_IN_MS;
  return performance.now()-songStartWall+SETTINGS.offset;
}
function syncMusicToGame(){
  if(audioMode!=='element'||!audioEl||audioEl.ended)return;
  const gt=getGameTime();
  if(gt<0)return;
  const target=gt/1000;
  try{ if(Math.abs(audioEl.currentTime-target)>0.25) audioEl.currentTime=target; }catch(e){}
}
function gestureResumeMusic(){
  ensureAudioCtx();
  if(gameState!=='game'||audioMode!=='element'||!musicStarted||!audioEl||audioEl.ended)return;
  if(audioEl.paused){
    syncMusicToGame();
    const p=audioEl.play(); if(p&&p.catch)p.catch(()=>{});
  }
}
window.addEventListener('touchstart',gestureResumeMusic,{passive:true,capture:true});
window.addEventListener('pointerdown',gestureResumeMusic,{passive:true,capture:true});
window.addEventListener('keydown',gestureResumeMusic,{capture:true});

function gameLoop(token=loopToken){
  if(token!==loopToken||gameState!=='game')return;
  const nowWall=performance.now();const rawFrameMs=Math.max(0,nowWall-lastFrame);const dt=Math.min(.05,rawFrameMs/1000);lastFrame=nowWall;
  frameStats.frames++;frameStats.totalMs+=rawFrameMs;frameStats.maxMs=Math.max(frameStats.maxMs,rawFrameMs);if(rawFrameMs>=25)frameStats.slowFrames++;
  deferHUDUpdate=true;
  processInputQueue();
  const gt=getGameTime();
  if(audioMode==='element'&&!musicStarted&&nowWall-countdownStartWall>=LEAD_IN_MS){
    musicStarted=true;
    try{audioEl.currentTime=0;audioEl.volume=SETTINGS.volume;}catch(e){}
    const playPromise=audioEl.play();if(playPromise&&playPromise.catch)playPromise.catch(()=>{});
  }
  if(audioMode==='element'&&musicStarted&&!musicSyncDone&&audioEl&&!audioEl.paused&&!audioEl.ended&&gt>300){
    if(Math.abs(audioEl.currentTime-gt/1000)>.08){try{audioEl.currentTime=Math.max(0,gt/1000);}catch(e){}}
    musicSyncDone=true;
  }
  const ah=document.getElementById('audioHint');
  if(audioMode==='element'&&musicStarted&&audioEl&&!audioEl.ended&&audioEl.paused&&gt>400){
    if(!audioHintShown){audioHintShown=true;if(ah)ah.style.display='block';}
  }else if(ah&&ah.style.display==='block'){ah.style.display='none';audioHintShown=false;}
  if(SETTINGS.autoPlay)runAutoPlay(gt);
  advanceHoldTails(gt);expirePendingNotes(gt);
  sampleScoreCurve(gt);
  if(SETTINGS.survivalGauge&&survivalHP<=0){finishGame('failed');return;}
  deferHUDUpdate=false;if(hudUpdatePending){hudUpdatePending=false;updateHUD();}
  if(judgedNotes>=notes.length&&gt>chartEndTime+1500){finishGame();return;}
  for(let i=0;i<4;i++)laneFlash[i]=Math.max(0,laneFlash[i]-dt*3);
  comboPulse=Math.max(0,comboPulse-dt*5);
  const targetFPS=SETTINGS.frameLimit==='unlimited'?0:Number(SETTINGS.frameLimit)||0;
  if(!targetFPS||!lastRenderWall||nowWall-lastRenderWall>=1000/targetFPS-0.5){
    const renderDeltaMs=lastRenderWall?Math.max(0,nowWall-lastRenderWall):rawFrameMs;
    const renderDt=Math.min(.05,renderDeltaMs/1000);
    if(lastRenderWall>0){
      renderFrameStats.frames++;renderFrameStats.totalMs+=renderDeltaMs;
      renderFrameStats.maxMs=Math.max(renderFrameStats.maxMs,renderDeltaMs);
      if(renderDeltaMs>=25)renderFrameStats.slowFrames++;
    }
    lastRenderWall=nowWall;fpsWindowFrames++;
    if(!fpsWindowStart)fpsWindowStart=nowWall;
    if(nowWall-fpsWindowStart>=500){currentRenderFPS=fpsWindowFrames*1000/(nowWall-fpsWindowStart);updateFpsHud(currentRenderFPS);fpsWindowFrames=0;fpsWindowStart=nowWall;}
    render(renderDt,nowWall);
  }
  if($('rightPanel').classList.contains('active')&&nowWall-lastStatsPaint>=125){updateOffsetPanel();lastStatsPaint=nowWall;}
  rafId=requestAnimationFrame(()=>gameLoop(token));
}

function runAutoPlay(gt){
  for(let lane=0;lane<4;lane++){
    const n=nextPendingNote(lane);if(!n||gt<n.time)continue;
    const p=lanePtr[lane];
    n.hit=true;
    if(n.type==='hold'){
      n.state='holding';n.holdHeld=true;n.headError=0;holdActive[lane]=n;lanePtr[lane]=p+1;
    }else{n.state='judged';lanePtr[lane]=p+1;applyJudge('perfect',lane,n.time,n.time,0);}
  }
}

function nextPendingNote(lane){
  const ln=laneNotes[lane];let p=lanePtr[lane]||0;
  while(p<ln.length&&ln[p].state!=='pending')p++;
  lanePtr[lane]=p;return p<ln.length?ln[p]:null;
}
function advanceHoldTails(gt){
  for(let lane=0;lane<4;lane++){
    const n=holdActive[lane];
    if(n&&n.state==='holding'&&gt>=n.end){finalizeHold(lane,n,n.end,false);}
  }
}
function expirePendingNotes(gt){
  for(let lane=0;lane<4;lane++){
    const ln=laneNotes[lane];let p=lanePtr[lane]||0;
    // 只推进已到 MISS 截止时间的队首；清理不会调用击打逻辑，也不会复用任何输入事件。
    while(p<ln.length){
      const n=ln[p];if(n.state!=='pending'){p++;continue;}
      if(gt-n.time<=J.miss)break;
      n.state='missed';n.hit=true;n.holdHeld=false;n.holdDone=true;
      applyJudge('miss',lane,n.time,gt,gt-n.time);p++;
    }
    lanePtr[lane]=p;
  }
}

function dbgPush(s){
  dbgArr.push(s);if(dbgArr.length>6)dbgArr.shift();
  const el=document.getElementById('dbgLog');if(el&&DEBUG_MODE){el.style.display='block';el.textContent=dbgArr.join('\n');}
}
function gradeFromError(error){
  const d=Math.abs(error);
  if(d<=J.perfect)return'perfect';if(d<=J.great)return'great';if(d<=J.good)return'good';if(d<=J.bad)return'bad';return null;
}
function applyJudge(result,lane,noteTime,judgedAt=getGameTime(),timingError=judgedAt-noteTime){
  if(!Object.prototype.hasOwnProperty.call(judges,result))return;
  judges[result]++;judgedNotes++;
  dbgPush(`JUDGE ${result.toUpperCase()} L${lane} note=${Math.round(noteTime)} at=${Math.round(judgedAt)} err=${Math.round(timingError)}`);
  if(result==='miss'){if(combo>0)comboBreaks++;combo=0;}
  else{
    combo++;maxCombo=Math.max(maxCombo,combo);
    score+=({perfect:1000,great:700,good:400,bad:100}[result])+combo*2;
    if(Number.isFinite(timingError)){timingSamples.push(timingError);offsetHistory.push(timingError);if(offsetHistory.length>60)offsetHistory.shift();}
    comboPulse=1;
  }
  laneFlash[lane]=1;spawnParticles(lane,result);
  if(SETTINGS.showJudgeText&&judgeFx.length<18)judgeFx.push({text:result.toUpperCase(),color:JC[result],life:1,lane,scale:1.3});
  if(deferHUDUpdate)hudUpdatePending=true;else updateHUD();
  // 新增玩法只消费已产生的判定结果，不改变判定、计分或输入队列。
  if(SETTINGS.survivalGauge)applySurvivalJudge(result);
}
function finalizeHold(lane,n,tailTime,forcedMiss){
  if(!n||n.state!=='holding'||n.holdDone)return;
  const actualTail=Number.isFinite(tailTime)?tailTime:n.end;
  const tailError=actualTail-n.end;
  let result=null;
  if(forcedMiss||tailError < -J.bad)result='miss';
  else result=gradeFromError(Math.abs(n.headError)+Math.abs(tailError))||'miss';
  n.state=result==='miss'?'missed':'judged';n.hit=true;n.holdDone=true;n.holdHeld=false;
  holdActive[lane]=null;
  applyJudge(result,lane,n.time,actualTail,n.headError+tailError);
}
function spawnParticles(lane,result){
  const pa=playArea;const x=pa.x+lane*pa.laneW+pa.laneW/2,y=pa.judgeY;
  const count=SETTINGS.renderQuality==='high'?(result==='miss'?7:16):(SETTINGS.renderQuality==='balanced'?(result==='miss'?4:9):(result==='miss'?2:4));
  const cap=SETTINGS.renderQuality==='high'?160:SETTINGS.renderQuality==='balanced'?90:45;
  for(let i=0;i<count&&particles.length<cap;i++){const a=(Math.random()-.5)*Math.PI,sp=80+Math.random()*280;const shape=result==='perfect'?(i%3===0?'ring':'diamond'):(i%3===0?'ring':'streak');particles.push({x,y,vx:Math.sin(a)*sp,vy:-Math.abs(Math.cos(a)*sp)-60,life:1,color:JC[result],size:1.8+Math.random()*3.1,shape});}
}

function wallToGameTime(wallTime){return wallTime-songStartWall+SETTINGS.offset;}
function getTouchLane(clientX){
  const pa=playArea;if(!pa.laneW||!Number.isFinite(clientX))return 0;
  return Math.min(3,Math.max(0,Math.floor((clientX-pa.x)/pa.laneW)));
}
function enqueueLaneDown(lane,source,wallTime=performance.now()){
  if(gameState!=='game'||SETTINGS.autoPlay)return;
  if(sourceDown.has(source))return;
  sourceDown.add(source);sourceLane.set(source,lane);
  inputQueue.push({type:'down',lane,source,time:wallToGameTime(wallTime),wallTime});
}
function enqueueLaneUp(source,wallTime=performance.now()){
  if(!sourceDown.has(source))return;
  const lane=sourceLane.get(source);sourceDown.delete(source);sourceLane.delete(source);
  if(lane===undefined)return;
  inputQueue.push({type:'up',lane,source,time:wallToGameTime(wallTime),wallTime});
}
function processInputQueue(){
  if(!inputQueue.length)return;
  const queue=inputQueue;inputQueue=[];
  for(const ev of queue){
    if(ev.type==='down')processLaneDown(ev.lane,ev.source,ev.time);
    else processLaneUp(ev.lane,ev.source,ev.time);
  }
}
function processLaneDown(lane,source,eventTime){
  if(gameState!=='game'||lane<0||lane>3)return;
  const sources=laneSources[lane];
  if(sources.has(source))return;
  const wasDown=sources.size>0;sources.add(source);keyDown[lane]=true;
  // 同一轨道上已有其他来源按住时，只登记这个来源，不生成新的击打边沿。
  if(wasDown)return;
  if(audioCtx&&audioCtx.state==='suspended'){const p=audioCtx.resume();if(p&&p.catch)p.catch(()=>{});}
  playKeySound();
  const n=nextPendingNote(lane);if(!n)return;
  const diff=eventTime-n.time;
  if(diff < -J.bad)return;  // 提前输入只算空按，不消耗音符。
  if(diff > J.bad)return;   // 太晚时锁在当前队首；绝不把这个输入转交给下一颗音符。
  if(n.type==='hold'){
    n.state='holding';n.hit=true;n.holdHeld=true;n.headError=diff;holdActive[lane]=n;
    lanePtr[lane]++;nextPendingNote(lane);
  }else{
    const result=gradeFromError(diff);if(!result)return;
    n.state='judged';n.hit=true;lanePtr[lane]++;
    applyJudge(result,lane,n.time,eventTime,diff);nextPendingNote(lane);
  }
}
function processLaneUp(lane,source,eventTime){
  if(lane<0||lane>3)return;
  const sources=laneSources[lane];if(!sources.has(source))return;
  sources.delete(source);
  if(sources.size>0){keyDown[lane]=true;return;}
  keyDown[lane]=false;
  const h=holdActive[lane];if(!h)return;
  // 如果释放事件到达时尾部已过，按实际持续到尾部处理；不将释放事件转交给其他音符。
  if(eventTime>=h.end)finalizeHold(lane,h,h.end,false);
  else finalizeHold(lane,h,eventTime,eventTime<h.end-J.bad);
}
function resetInputRuntime(){
  inputQueue=[];sourceDown.clear();sourceLane.clear();activePointers.clear();
  for(let l=0;l<4;l++){laneSources[l].clear();keyDown[l]=false;holdActive[l]=null;}
}
function releaseAllInputNow(resolveHolds=true){
  if(!resolveHolds){
    // 暂停只清掉物理按键来源，不合成 keyup；长按对象保持冻结态，恢复时钟后继续。
    inputQueue=[];sourceDown.clear();sourceLane.clear();activePointers.clear();
    for(let l=0;l<4;l++){laneSources[l].clear();keyDown[l]=false;}
    return;
  }
  if(gameState==='game'){
    const now=performance.now();for(const src of [...sourceDown])enqueueLaneUp(src,now);
    processInputQueue();
  }else{
    // 失焦发生在暂停期间时，清理物理来源但保留音符状态机，避免悬空 hold 破坏结算。
    inputQueue=[];sourceDown.clear();sourceLane.clear();
    for(let l=0;l<4;l++){laneSources[l].clear();keyDown[l]=false;}
  }
  activePointers.clear();
}

window.addEventListener('keydown',e=>{
  if(bindLane>=0){
    e.preventDefault();e.stopPropagation();
    if(e.code!=='Escape'){
      const old=SETTINGS.keys[bindLane],other=SETTINGS.keys.indexOf(e.code);
      if(other>=0&&other!==bindLane)SETTINGS.keys[other]=old;
      SETTINGS.keys[bindLane]=e.code;SETTINGS.keyPreset='custom';saveSettings();
    }
    bindLane=-1;renderKeyBinds();return;
  }
  if(e.code==='Escape'){
    if(gameState==='game'){e.preventDefault();pauseGame();}
    else if(gameState==='paused'){e.preventDefault();resumeGame();}
    return;
  }
  if(e.repeat)return;
  if(gameState==='game'){
    const lane=SETTINGS.keys.indexOf(e.code);
    if(lane>=0){e.preventDefault();enqueueLaneDown(lane,'key:'+e.code,performance.now());return;}
  }
  if(e.code==='KeyR'&&(gameState==='paused'||gameState==='result')){e.preventDefault();restartGame();}
  if(e.code==='KeyQ'&&(gameState==='paused'||gameState==='result')){e.preventDefault();quitToSongSelect();}
});
window.addEventListener('keyup',e=>enqueueLaneUp('key:'+e.code,performance.now()));

// 鼠标和触屏统一走 Pointer Events。移除 touchstart/mousedown 双入口，杜绝一根手指生成两套击打事件。
gameCanvas.addEventListener('pointerdown',e=>{
  if(gameState!=='game')return;
  if(e.pointerType==='mouse'&&e.button!==0)return;
  e.preventDefault();
  const lane=getTouchLane(e.clientX);const source='pointer:'+e.pointerId;
  if(activePointers.has(e.pointerId))return;
  activePointers.set(e.pointerId,{lane,source});
  try{gameCanvas.setPointerCapture(e.pointerId);}catch(err){}
  enqueueLaneDown(lane,source,performance.now());
},{passive:false});
gameCanvas.addEventListener('pointermove',e=>{
  const data=activePointers.get(e.pointerId);if(!data||!SETTINGS.slideInput||gameState!=='game')return;
  const lane=getTouchLane(e.clientX);if(lane===data.lane)return;
  e.preventDefault();
  const now=performance.now();enqueueLaneUp(data.source,now);
  const newSource='pointer:'+e.pointerId;data.lane=lane;data.source=newSource;
  enqueueLaneDown(lane,newSource,now);
},{passive:false});
function endPointer(e){
  const data=activePointers.get(e.pointerId);if(!data)return;
  enqueueLaneUp(data.source,performance.now());activePointers.delete(e.pointerId);
  try{if(gameCanvas.hasPointerCapture(e.pointerId))gameCanvas.releasePointerCapture(e.pointerId);}catch(err){}
}
gameCanvas.addEventListener('pointerup',endPointer,{passive:false});
gameCanvas.addEventListener('pointercancel',endPointer,{passive:false});
gameCanvas.addEventListener('lostpointercapture',endPointer,{passive:true});
window.addEventListener('blur',()=>releaseAllInputNow(true));
document.addEventListener('visibilitychange',()=>{
  if(document.hidden){releaseAllInputNow(true);if(bgAnimId){cancelAnimationFrame(bgAnimId);bgAnimId=null;}}
  else if(gameState==='menu')startBgAnim();
});

// 多押提示分组只用于绘制，不写入判定队列，也不参与评分。
function buildMultiPressGroups(chartNotes){
  const groups=[];const tolerance=18;
  for(let i=0;i<chartNotes.length;){
    let j=i+1;while(j<chartNotes.length&&chartNotes[j].time-chartNotes[i].time<=tolerance)j++;
    const cluster=chartNotes.slice(i,j),byLane=new Map();
    for(const n of cluster)if(!byLane.has(n.lane))byLane.set(n.lane,n);
    if(byLane.size>=2){const chordNotes=[...byLane.values()];groups.push({time:chordNotes.reduce((sum,n)=>sum+n.time,0)/chordNotes.length,notes:chordNotes,lanes:[...byLane.keys()].sort((a,b)=>a-b)});}
    i=j;
  }
  return groups;
}
function lowerBoundNoteTime(arr,time){let lo=0,hi=arr.length;while(lo<hi){const mid=(lo+hi)>>1;if(arr[mid].time<time)lo=mid+1;else hi=mid;}return lo;}
function hexToRgba(hex,alpha){
  const h=String(hex).replace('#','');const value=parseInt(h.length===3?h.split('').map(c=>c+c).join(''):h,16);
  if(!Number.isFinite(value))return `rgba(180,210,235,${alpha})`;
  return `rgba(${(value>>16)&255},${(value>>8)&255},${value&255},${alpha})`;
}
function drawCrystalHead(x,centerY,w,h,color){
  const y=centerY-h/2,r=Math.min(h/2,w/2);
  gctx.beginPath();gctx.roundRect(x,y,w,h,r);
  // Ver.1.0 transition visual: a slim, rounded glass crystal with a pale central refraction.
  const base=String(color||'#9fd8ee');
  const noteGrad=gctx.createLinearGradient(x,y,x+w,y);
  noteGrad.addColorStop(0,hexToRgba(base,.82));
  noteGrad.addColorStop(.24,hexToRgba(base,.92));
  noteGrad.addColorStop(.47,'rgba(247,251,255,.98)');
  noteGrad.addColorStop(.58,'rgba(231,242,255,.94)');
  noteGrad.addColorStop(.82,hexToRgba(base,.86));
  noteGrad.addColorStop(1,hexToRgba(base,.78));
  gctx.fillStyle=noteGrad;
  gctx.save();
  gctx.shadowColor=hexToRgba(base,.58);
  gctx.shadowBlur=SETTINGS.renderQuality==='high'?6:SETTINGS.renderQuality==='balanced'?3:1;
  gctx.fill();
  gctx.restore();
  gctx.strokeStyle='rgba(250,253,255,.98)';gctx.lineWidth=1.15;gctx.stroke();
  // One quiet upper glint, not a second thick border.
  gctx.beginPath();gctx.moveTo(x+Math.max(7,w*.18),y+1.8);gctx.lineTo(x+w-Math.max(7,w*.18),y+1.8);
  gctx.strokeStyle='rgba(255,255,255,.78)';gctx.lineWidth=.85;gctx.lineCap='round';gctx.stroke();
  // Very light lower refraction keeps the capsule dimensional without looking plastic.
  gctx.beginPath();gctx.moveTo(x+Math.max(9,w*.22),y+h-1.7);gctx.lineTo(x+w-Math.max(9,w*.22),y+h-1.7);
  gctx.strokeStyle='rgba(169,202,240,.48)';gctx.lineWidth=.65;gctx.stroke();
}
function drawNote(n,pa,gt,pxPerMs){
  if(n.state==='judged'||n.state==='missed')return;
  const x=pa.x+n.lane*pa.laneW,w=pa.laneW,col=(SETTINGS.playTheme==='light'?['#AD5E91','#7668CC','#287FA4','#258B7A']:LC)[n.lane];
  const headY=n.state==='holding'?pa.judgeY:pa.judgeY-(n.time-gt)*pxPerMs;
  const tailY=n.type==='hold'?pa.judgeY-(n.end-gt)*pxPerMs:headY;
  if(n.type==='hold'){
    const top=Math.min(headY,tailY),bottom=Math.max(headY,tailY);
    if(bottom < -44 || top > vh+44)return;
    const headH=Math.max(15,Math.min(19,w*.11)),headW=Math.min(w*.88,132),headX=x+(w-headW)/2;
    // Hold remains one continuous glass body with a single crystal head.
    // Its width follows the original soft-glass prototype, while transparency preserves lane readability.
    const bodyW=Math.max(22,Math.min(w*.58,116));
    const bodyX=x+(w-bodyW)/2;
    const bodyTop=Math.min(headY,tailY),bodyBottom=Math.max(headY,tailY);
    if(bodyBottom>=-6&&bodyTop<=vh+6){
      gctx.beginPath();
      gctx.roundRect(bodyX,bodyTop,bodyW,Math.max(1,bodyBottom-bodyTop),Math.min(bodyW/2,12));
      const lightTheme=SETTINGS.playTheme==='light';
      const holdGrad=gctx.createLinearGradient(bodyX,0,bodyX+bodyW,0);
      holdGrad.addColorStop(0,hexToRgba(col,lightTheme?.48:.58));
      holdGrad.addColorStop(.18,hexToRgba(col,lightTheme?.66:.76));
      holdGrad.addColorStop(.43,lightTheme?'rgba(255,255,255,.74)':'rgba(247,251,255,.62)');
      holdGrad.addColorStop(.56,lightTheme?'rgba(250,253,255,.78)':'rgba(232,244,255,.68)');
      holdGrad.addColorStop(.78,hexToRgba(col,lightTheme?.64:.74));
      holdGrad.addColorStop(1,hexToRgba(col,lightTheme?.46:.58));
      gctx.fillStyle=holdGrad;gctx.fill();
      gctx.strokeStyle=hexToRgba(col,lightTheme?.96:.92);gctx.lineWidth=1.35;gctx.stroke();
      gctx.beginPath();gctx.moveTo(bodyX+bodyW*.24,bodyTop+Math.min(8,Math.max(2,bodyW*.12)));
      gctx.lineTo(bodyX+bodyW*.24,Math.max(bodyTop+Math.min(8,Math.max(2,bodyW*.12)),bodyBottom-Math.min(8,Math.max(2,bodyW*.12))));
      gctx.strokeStyle=lightTheme?'rgba(255,255,255,.76)':'rgba(250,254,255,.58)';gctx.lineWidth=.9;gctx.lineCap='round';gctx.stroke();
    }
    if(headY>=-headH&&headY<=vh+headH)drawCrystalHead(headX,headY,headW,headH,col);
  }else{
    if(headY < -34 || headY > vh+34)return;
    drawCrystalHead(x+w*.06,headY,Math.min(w*.88,132),Math.max(15,Math.min(19,w*.11)),col);
  }
}
function render(dt,nowWall=performance.now()){
  const pa=playArea,gt=getGameTime(),pxPerMs=SETTINGS.speed*.2;
  const dl=document.getElementById('dbgLog');
  if(dl)dl.style.display=(gameState==='game'&&DEBUG_MODE)?'block':'none';
  gctx.clearRect(0,0,vw,vh);
  if(staticPlayfield.width&&staticPlayfield.height)gctx.drawImage(staticPlayfield,0,0);
  const minTime=gt-(vh+44-pa.judgeY)/pxPerMs;
  const maxTime=gt+(pa.judgeY+44)/pxPerMs;
  if(SETTINGS.multiPressHint&&multiPressGroups.length){
    let gi=lowerBoundNoteTime(multiPressGroups,minTime);
    for(;gi<multiPressGroups.length&&multiPressGroups[gi].time<=maxTime;gi++){
      const group=multiPressGroups[gi];
      if(!group.notes.every(n=>n.state==='pending'))continue;
      const msUntil=group.time-gt;if(msUntil<105||msUntil>2200)continue;
      const y=pa.judgeY-msUntil*pxPerMs;if(y<26||y>pa.judgeY-30)continue;
      const left=pa.x+group.lanes[0]*pa.laneW+pa.laneW/2;
      const right=pa.x+group.lanes[group.lanes.length-1]*pa.laneW+pa.laneW/2;
      const mid=(left+right)/2;
      gctx.save();gctx.globalAlpha=.74;
      gctx.beginPath();gctx.moveTo(left,y-8);gctx.quadraticCurveTo(mid,y-25,right,y-8);
      gctx.strokeStyle='rgba(176,211,238,.54)';gctx.lineWidth=1.1;gctx.stroke();
      const stars=group.lanes.length;gctx.font='12px sans-serif';gctx.textAlign='center';
      const label=Array.from({length:stars},()=> '✦').join(' ');
      const tw=Math.max(28,gctx.measureText(label).width+14),lh=17,lx=mid-tw/2,ly=y-38;
      gctx.beginPath();gctx.roundRect(lx,ly,tw,lh,9);gctx.fillStyle='rgba(13,25,42,.70)';gctx.fill();
      gctx.strokeStyle='rgba(163,202,230,.42)';gctx.lineWidth=.8;gctx.stroke();
      gctx.fillStyle='#D7EAF8';gctx.fillText(label,mid,ly+12);gctx.restore();
    }
  }
  for(let lane=0;lane<4;lane++){
    const arr=laneNotes[lane],active=holdActive[lane];
    if(active&&active.state==='holding'&&active.time<minTime)drawNote(active,pa,gt,pxPerMs);
    let i=lowerBoundNoteTime(arr,minTime);
    for(;i<arr.length&&arr[i].time<=maxTime;i++)drawNote(arr[i],pa,gt,pxPerMs);
  }
  for(let i=0;i<4;i++){
    if(laneFlash[i]>0){
      gctx.fillStyle=LC[i]+Math.floor(laneFlash[i]*20).toString(16).padStart(2,'0');
      gctx.fillRect(pa.x+i*pa.laneW,pa.judgeY-27,pa.laneW,42);
    }
  }
  gctx.strokeStyle='rgba(110,190,235,.30)';gctx.lineWidth=8;gctx.beginPath();gctx.moveTo(pa.x,pa.judgeY);gctx.lineTo(pa.x+pa.w,pa.judgeY);gctx.stroke();
  gctx.strokeStyle='rgba(224,240,255,.96)';gctx.lineWidth=1.7;gctx.beginPath();gctx.moveTo(pa.x,pa.judgeY);gctx.lineTo(pa.x+pa.w,pa.judgeY);gctx.stroke();
  for(let i=0;i<4;i++){
    const x=pa.x+i*pa.laneW,laneW=pa.laneW;
    const lanePressedVisual=keyDown[i]||(SETTINGS.autoPlay&&holdActive[i]&&holdActive[i].state==='holding');
    if(lanePressedVisual){gctx.fillStyle=hexToRgba(LC[i],.07);gctx.fillRect(x,pa.judgeY,laneW,vh-pa.judgeY);}
    const capW=Math.min(laneW*.48,68),capH=28,capX=x+(laneW-capW)/2,capY=vh-41;
    gctx.beginPath();gctx.roundRect(capX,capY,capW,capH,capH/2);
    gctx.fillStyle=lanePressedVisual?hexToRgba(LC[i],.28):'rgba(18,31,51,.84)';gctx.fill();
    gctx.strokeStyle=lanePressedVisual?hexToRgba(LC[i],.94):hexToRgba(LC[i],.62);gctx.lineWidth=lanePressedVisual?1.35:1;gctx.stroke();
    gctx.fillStyle=lanePressedVisual?'#F4FAFF':'rgba(210,226,244,.76)';
    gctx.font=`700 ${Math.max(11,Math.min(14,laneW*.12))}px sans-serif`;gctx.textAlign='center';
    gctx.fillText(keyName(SETTINGS.keys[i]),x+laneW/2,capY+16);
  }
  gctx.save();
  for(let i=particles.length-1;i>=0;i--){
    const p=particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=500*dt;p.life-=dt*2;
    if(p.life<=0){particles[i]=particles[particles.length-1];particles.pop();continue;}
    gctx.globalAlpha=p.life;
    if(p.shape==='diamond'){
      gctx.beginPath();gctx.moveTo(p.x,p.y-p.size*1.45);gctx.lineTo(p.x+p.size*.72,p.y);gctx.lineTo(p.x,p.y+p.size*1.45);gctx.lineTo(p.x-p.size*.72,p.y);gctx.closePath();
      gctx.fillStyle=p.color;gctx.fill();gctx.strokeStyle='rgba(244,251,255,.58)';gctx.lineWidth=.65;gctx.stroke();
    }else if(p.shape==='ring'){
      gctx.beginPath();gctx.arc(p.x,p.y,p.size*(1.1+(1-p.life)*1.7),0,Math.PI*2);gctx.strokeStyle=p.color;gctx.lineWidth=.85;gctx.stroke();
    }else{
      gctx.beginPath();gctx.moveTo(p.x-p.size*1.5,p.y+p.size*.55);gctx.lineTo(p.x+p.size*1.5,p.y-p.size*.55);gctx.strokeStyle=p.color;gctx.lineWidth=1.05;gctx.lineCap='round';gctx.stroke();
    }
  }
  gctx.restore();
  if(SETTINGS.showJudgeText){
    gctx.save();gctx.textAlign='center';
    for(let i=judgeFx.length-1;i>=0;i--){
      const f=judgeFx[i];f.life-=dt*1.8;f.scale+=(1-f.scale)*dt*8;
      if(f.life<=0){judgeFx[i]=judgeFx[judgeFx.length-1];judgeFx.pop();continue;}
      const x=pa.x+f.lane*pa.laneW+pa.laneW/2,y=pa.judgeY-48-(1-f.life)*34;
      gctx.globalAlpha=f.life;
      gctx.font=`${f.text==='PERFECT'?'italic 800':'700'} ${16*f.scale}px sans-serif`;
      gctx.lineJoin='round';gctx.lineWidth=f.text==='PERFECT'?1.35:1.7;
      gctx.strokeStyle='rgba(6,12,24,.70)';gctx.strokeText(f.text,x,y);
      if(f.text==='PERFECT'){
        const tw=gctx.measureText(f.text).width;
        const rainbow=gctx.createLinearGradient(x-tw/2,y-13,x+tw/2,y+2);
        rainbow.addColorStop(0,'#D99FC5');rainbow.addColorStop(.22,'#E4C4B0');rainbow.addColorStop(.43,'#D8D8A8');
        rainbow.addColorStop(.62,'#9FD5CB');rainbow.addColorStop(.8,'#9DC9E4');rainbow.addColorStop(1,'#B6A8E0');
        gctx.fillStyle=rainbow;
      }else gctx.fillStyle=f.color;
      gctx.fillText(f.text,x,y);
    }
    gctx.restore();
  }else{judgeFx.length=0;}
  if(gt<0&&gameState==='game'){
    const c=Math.ceil(-gt/1000);gctx.save();gctx.globalAlpha=.7+Math.sin(nowWall/120)*.3;gctx.fillStyle='#3D9EBE';gctx.font='bold 70px sans-serif';gctx.textAlign='center';gctx.fillText(c>0?c:'GO!',pa.x+pa.w/2,vh/2);gctx.restore();
  }
  if(notes.length&&nowWall-lastProgressPaint>=100){$('progressFill').style.width=Math.max(0,Math.min(100,gt/chartEndTime*100))+'%';lastProgressPaint=nowWall;}
}

const offCanvas=$('offsetCanvas'), offCtx=offCanvas.getContext('2d');
function updateOffsetPanel(){
  const total=judges.perfect+judges.great+judges.good+judges.bad+judges.miss;
  const acc=total>0?(judges.perfect*100+judges.great*80+judges.good*50+judges.bad*20)/total:100;
  $('panelAcc').textContent=acc.toFixed(2);
  $('panelAcc').style.color=acc>=95?'#7FE0C8':acc>=85?'#F1D17B':'#F17899';
  $('pPerfect').textContent=judges.perfect;$('pGreat').textContent=judges.great;$('pGood').textContent=judges.good;
  $('pBad').textContent=judges.bad;$('pMiss').textContent=judges.miss;
  $('panelScore').textContent=score.toLocaleString();
  const w=offCanvas.clientWidth, h=offCanvas.clientHeight;
  const dpr=Math.min(1.5,devicePixelRatio||1);
  if(offCanvas.width!==Math.round(w*dpr)||offCanvas.height!==Math.round(h*dpr)){offCanvas.width=Math.round(w*dpr);offCanvas.height=Math.round(h*dpr);offCtx.setTransform(dpr,0,0,dpr,0,0);}
  offCtx.clearRect(0,0,w,h);
  offCtx.strokeStyle='rgba(122,139,165,0.2)';offCtx.lineWidth=1;
  offCtx.beginPath();offCtx.moveTo(0,h/2);offCtx.lineTo(w,h/2);offCtx.stroke();
  [J.perfect,J.great,J.good].forEach((ms,idx)=>{
    const y1=h/2-ms/250*h/2, y2=h/2+ms/250*h/2;
    offCtx.strokeStyle=['rgba(80,220,120,0.15)','rgba(103,232,249,0.1)','rgba(253,224,71,0.08)'][idx];
    offCtx.beginPath();offCtx.moveTo(0,y1);offCtx.lineTo(w,y1);offCtx.moveTo(0,y2);offCtx.lineTo(w,y2);offCtx.stroke();
  });
  const n=offsetHistory.length;
  offsetHistory.forEach((off,i)=>{
    const x=(i+1)/60*w;
    const y=h/2-Math.max(-250,Math.min(250,off))/250*h/2;
    const age=n?i/n:0;
    let col='#7FE0C8';
    if(Math.abs(off)>J.great)col='#F1D17B';
    if(Math.abs(off)>J.good)col='#F0A071';
    offCtx.fillStyle=col;offCtx.globalAlpha=0.3+age*0.7;
    offCtx.beginPath();offCtx.arc(x,y,2.5,0,Math.PI*2);offCtx.fill();
  });
  offCtx.globalAlpha=1;
}

function updateHUD(){
  $('hudScore').textContent=score.toLocaleString();
  const total=judges.perfect+judges.great+judges.good+judges.bad+judges.miss;
  const acc=total>0?(judges.perfect*100+judges.great*80+judges.good*50+judges.bad*20)/total:100;
  $('hudAcc').textContent=acc.toFixed(2)+'%';
  const ce=$('hudCombo');ce.textContent=combo;
  setText('hudPerfect',judges.perfect);setText('hudGreat',judges.great);setText('hudGood',judges.good);setText('hudBad',judges.bad);setText('hudMiss',judges.miss);
  setText('hudJudgedCount',`${Math.min(judgedNotes,notes.length)} / ${notes.length}`);
  const recent=offsetHistory;const mean=recent.length?recent.reduce((sum,v)=>sum+v,0)/recent.length:NaN;
  setText('hudMeanOffset',Number.isFinite(mean)?`${mean>0?'+':''}${mean.toFixed(1)} ms`:'—');
  setText('hudHoldCount',holdActive.filter(n=>n&&n.state==='holding').length);
  const pct=notes.length?Math.max(0,Math.min(100,judgedNotes/notes.length*100)):0;
  const bar=$('hudDetailsProgress');if(bar)bar.style.width=pct+'%';
  setText('hudProgressLabel',`${SETTINGS.autoPlay?'AUTO PLAY':'手动'} · 谱面进度`);
  updateSurvivalHUD();updateBestDelta(false);syncHudMetadata();
  ce.classList.remove('pulse');
}

function pauseGame(){
  if(gameState!=='game')return;
  processInputQueue();gameState='paused';pauseWall=performance.now();
  if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}
  releaseAllInputNow(false);
  if(audioMode==='element'&&audioEl){try{audioEl.pause();}catch(e){}}
  $('pauseOverlay').classList.add('active');
}
function resumeGame(){
  if(gameState!=='paused')return;
  if(pauseWall){songStartWall+=performance.now()-pauseWall;pauseWall=0;}
  if(audioMode==='element'&&audioEl){syncMusicToGame();const p=audioEl.play();if(p&&p.catch)p.catch(()=>{});}
  $('pauseOverlay').classList.remove('active');gameState='game';showGameCanvasAnimated();$('gameControls').classList.add('active');lastFrame=performance.now();
  const token=loopToken;if(rafId!==null)cancelAnimationFrame(rafId);rafId=null;gameLoop(token);
}
function restartGame(){
  if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}loopToken++;
  $('pauseOverlay').classList.remove('active');$('result').classList.remove('active');$('gameHUD').classList.remove('active');$('gameControls').classList.remove('active');closeHudDetails();
  teardownAudio();audioReady=false;musicStarted=false;resetInputRuntime();startGame();
}
function quitToSongSelect(){
  document.body.classList.remove('door-enter-play');
  if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}loopToken++;resetInputRuntime();
  $('pauseOverlay').classList.remove('active');$('result').classList.remove('active');$('gameHUD').classList.remove('active');$('survivalHUD').classList.remove('active');$('progressBar').classList.remove('active');$('modeBtn').classList.remove('active');$('gameControls').classList.remove('active');closeHudDetails();
  teardownAudio();audioReady=false;musicStarted=false;computePlayArea();showScreen('songselect');
}
function medianOf(values){if(!values.length)return 0;const a=[...values].sort((x,y)=>x-y),m=a.length>>1;return a.length%2?a[m]:(a[m-1]+a[m])/2;}
function fmtMs(v){return (v>0?'+':'')+v.toFixed(1)+' ms';}
function setText(id,value){const el=$(id);if(el)el.textContent=String(value);}

function makeBestRecordKey(song,diff,dd){
  const identity=[song?.title||'',song?.artist||'',diff||'',dd?.notes?.length||0,Math.round((dd?.notes||[]).reduce((m,n)=>Math.max(m,Number(n.end)||Number(n.time)||0),0))].join('|');
  return 'door_v13_best_'+identity;
}
function readBestRecord(){try{return JSON.parse(localStorage.getItem(bestRecordKey)||'null')}catch(e){return null}}
function sampleScoreCurve(gt){
  if(!Number.isFinite(gt)||gt<0||gt-lastCurveSample<500)return;
  lastCurveSample=gt;scoreCurve.push([Math.round(gt),score]);
  if(scoreCurve.length>2400)scoreCurve.shift();
  updateBestDelta(false);
}
function updateBestDelta(reset=false){
  const el=$('bestDelta');if(!el)return;
  if(!bestRecordKey){el.textContent='BEST —';return;}
  const best=readBestRecord();if(!best||!Array.isArray(best.curve)||!best.curve.length){el.textContent='BEST · 建立基准';return;}
  const t=Math.max(0,getGameTime());let lo=0,hi=best.curve.length-1;
  while(lo<hi){const mid=(lo+hi+1)>>1;if(best.curve[mid][0]<=t)lo=mid;else hi=mid-1;}
  const point=best.curve[lo]||best.curve[0];const delta=score-(Number(point[1])||0);el.textContent=(delta>=0?'领先 +':'落后 −')+Math.abs(delta).toLocaleString();
  el.style.color=delta>=0?'#A9E7D9':'#F0C2D2';el.title='与历史最佳在相同歌曲时间点的累计分数比较';
}
function saveBestRecord(){
  if(!bestRecordKey||SETTINGS.autoPlay||survivalFailed)return;
  const old=readBestRecord();if(old&&Number(old.score)>=score)return;
  const curve=scoreCurve.slice();if(!curve.length||curve[curve.length-1][0]<(chartEndTime||0))curve.push([Math.round(chartEndTime||0),score]);
  try{localStorage.setItem(bestRecordKey,JSON.stringify({score,curve,updatedAt:Date.now(),difficulty:selectedDiff,song:songs[selectedSong]?.title||''}));}catch(e){}
}
function updateSurvivalHUD(){
  const hud=$('survivalHUD'),fill=$('survivalFill'),value=$('survivalValue');if(!hud||!fill||!value)return;
  hud.classList.toggle('active',!!SETTINGS.survivalGauge&&gameState!=='menu'&&gameState!=='songselect'&&gameState!=='settings'&&gameState!=='result');
  hud.classList.toggle('low',survivalHP<=25);fill.style.width=Math.max(0,Math.min(100,survivalHP))+'%';value.textContent=Math.round(survivalHP)+'%';
}
function applySurvivalJudge(result){
  const delta=({perfect:.2,great:.1,good:0,bad:-2,miss:-4})[result]||0;
  survivalHP=Math.max(0,Math.min(100,survivalHP+delta));updateSurvivalHUD();
}

function finishGame(reason='complete'){
  document.body.classList.remove('door-enter-play');
  if(gameState!=='game')return;
  survivalFailed=reason==='failed';
  gameState='result';if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}loopToken++;resetInputRuntime();
  teardownAudio();audioReady=false;musicStarted=false;
  const total=notes.length,judged=judges.perfect+judges.great+judges.good+judges.bad+judges.miss;
  const acc=total>0?(judges.perfect*100+judges.great*80+judges.good*50+judges.bad*20)/total:100;
  let rank='F';if(!survivalFailed){if(acc>=98)rank='S';else if(acc>=95)rank='A';else if(acc>=88)rank='B';else if(acc>=75)rank='C';else if(acc>=60)rank='D';}
  const rc={S:'#B28A24',A:'#258B70',B:'#278DB5',C:'#8D82D8',D:'#C66B33',F:'#CB526C'};
  const re=$('resultRank');re.textContent=rank;re.style.color=rc[rank];re.style.textShadow=`0 0 36px ${rc[rank]}55`;
  const song=songs[selectedSong];setText('resultSongTitle',song?.title||'未知曲目');
  setText('resultSongArtist',`${song?.artist||'未知曲师'} · ${selectedDiff.toUpperCase()} ${song?.difficulties?.[selectedDiff]?.level!==undefined?'Lv.'+song.difficulties[selectedDiff].level:''}`);
  setText('resultScore',score.toLocaleString());setText('resultAcc',acc.toFixed(2)+'%');setText('resultCombo',maxCombo);setText('resultTotal',total);
  for(const key of ['perfect','great','good','bad','miss'])setText('result'+key[0].toUpperCase()+key.slice(1),judges[key]);
  setText('resultJudgedCount',`${Math.min(judged,total)} / ${total} 已结算`);setText('resultClearRate',`命中率 ${total?((total-judges.miss)/total*100).toFixed(2):'100.00'}%`);
  for(const key of ['perfect','great','good','bad','miss'])setText('result'+key[0].toUpperCase()+key.slice(1)+'Rate',`${total?(judges[key]/total*100).toFixed(1):'0.0'}%`);
  const bar=$('resultJudgeBar');bar.replaceChildren();
  const judgeColors={perfect:'#258B70',great:'#278DB5',good:'#A87919',bad:'#C66B33',miss:'#CB526C'};
  for(const key of ['perfect','great','good','bad','miss']){
    if(judges[key]<=0)continue;const piece=document.createElement('span');piece.style.width=(judges[key]/Math.max(1,total)*100)+'%';piece.style.background=judgeColors[key];piece.title=`${key.toUpperCase()}: ${judges[key]}`;bar.appendChild(piece);
  }
  const goodTimings=timingSamples.filter(Number.isFinite);const mean=goodTimings.length?goodTimings.reduce((a,b)=>a+b,0)/goodTimings.length:0;
  const median=medianOf(goodTimings);const spread=goodTimings.length?Math.sqrt(goodTimings.reduce((a,b)=>a+(b-mean)**2,0)/goodTimings.length):0;
  const early=goodTimings.filter(v=>v<0).length,late=goodTimings.filter(v=>v>0).length;
  setText('resultMeanError',goodTimings.length?fmtMs(mean):'—');setText('resultMedianError',goodTimings.length?fmtMs(median):'—');setText('resultTimingSpread',goodTimings.length?spread.toFixed(1)+' ms':'—');
  setText('resultEarly',early);setText('resultLate',late);setText('resultTimingSamples',goodTimings.length);
  const tapNotes=notes.filter(n=>n.type!=='hold'),holdNotes=notes.filter(n=>n.type==='hold');
  const holdBreaks=holdNotes.filter(n=>n.state==='missed').length;
  setText('resultTapTotal',`${tapNotes.length}（失误 ${tapNotes.filter(n=>n.state==='missed').length}）`);
  setText('resultHoldTotal',`${holdNotes.length}（完成 ${holdNotes.length-holdBreaks}）`);setText('resultHoldBreaks',holdBreaks);
  setText('resultScorePerNote',total?(score/total).toFixed(1):'0');setText('resultComboStatus',judges.miss===0?'FULL COMBO':'已断连');setText('resultComboBreaks',comboBreaks);
  const avgMs=renderFrameStats.frames?renderFrameStats.totalMs/renderFrameStats.frames:0;
  setText('resultAvgFps',avgMs>0?(1000/avgMs).toFixed(1)+' FPS':'—');setText('resultSlowFrames',renderFrameStats.slowFrames);setText('resultMaxFrame',renderFrameStats.frames?renderFrameStats.maxMs.toFixed(1)+' ms':'—');
  const badges=$('resultBadges');badges.replaceChildren();
  const addBadge=(text,cls)=>{const el=document.createElement('span');el.className='badge '+cls;el.textContent=text;badges.appendChild(el);};
  if(survivalFailed)addBadge('FAILED · LIFE DEPLETED','badge-miss');
  if(SETTINGS.survivalGauge)addBadge(`LIFE ${Math.round(survivalHP)}%`,'badge-auto');
  if(SETTINGS.autoPlay)addBadge('AUTO PLAY','badge-auto');
  if(judges.perfect===notes.length)addBadge('ALL PERFECT','badge-ap');
  else if(judges.miss===0)addBadge('FULL COMBO','badge-fc');
  if(judges.miss===0&&judges.bad===0)addBadge('NO BAD','badge-fc');
  const rj=$('resultJudge');if(rj)rj.textContent=(JUDGE_PRESETS[SETTINGS.judgePreset]||JUDGE_PRESETS.normal).label;
  $('gameHUD').classList.remove('active');$('survivalHUD').classList.remove('active');$('progressBar').classList.remove('active');$('modeBtn').classList.remove('active');$('gameControls').classList.remove('active');closeHudDetails();
  computePlayArea();saveBestRecord();showScreen('result');$('result').scrollTop=0;
}
function runPortalTransition(onComplete){
  const overlay=$('portalTransition');const token=++portalTransitionToken;
  if(!overlay||SETTINGS.reduceMotion){if(typeof onComplete==='function')onComplete();return;}
  overlay.classList.remove('run','leaving');overlay.classList.add('active');
  requestAnimationFrame(()=>{if(token===portalTransitionToken)overlay.classList.add('run');});
  setTimeout(()=>{
    if(token!==portalTransitionToken)return;
    if(typeof onComplete==='function')onComplete();
    overlay.classList.add('leaving');
    setTimeout(()=>{if(token!==portalTransitionToken)return;overlay.classList.remove('active','run','leaving');},340);
  },760);
}
function showLoading(t){$('loadingText').textContent=t||'加载中...';$('loading').classList.add('active');}
function hideLoading(){$('loading').classList.remove('active');}
</script>

<style id="door-ver10-pc-rainlight-glass">
/* Door Ver.1.0 PC interface pass — menu and song selection only. Gameplay logic and gameplay visuals are intentionally out of scope. */
:root{
  --d10-ink:#38566c;--d10-muted:#7e96a8;--d10-line:rgba(167,202,220,.56);
  --d10-ice:rgba(231,247,253,.78);--d10-lilac:rgba(241,236,251,.70);--d10-rose:rgba(252,235,244,.60);
  --d10-glass:rgba(250,253,255,.74);--d10-shadow:0 18px 52px rgba(88,137,164,.09);
}
/* Main menu: open composition, quiet glass, soft rain-light depth. */
#menu{background:transparent;overflow:auto;}
#menu .menu-content{
  width:min(1200px,100%);min-height:min(700px,calc(100vh - 34px));
  grid-template-columns:minmax(330px,.88fr) minmax(360px,1.12fr);
  gap:20px clamp(24px,4vw,54px);padding:clamp(28px,4vw,56px) clamp(26px,4.8vw,68px) 22px;
  border:1px solid rgba(195,220,234,.78);border-radius:30px;
  background:linear-gradient(132deg,rgba(252,254,255,.86),rgba(243,249,253,.70) 56%,rgba(251,243,249,.68));
  box-shadow:0 26px 84px rgba(90,139,166,.12),inset 0 1px 0 rgba(255,255,255,.9);
  backdrop-filter:blur(24px) saturate(112%);
}
#menu .menu-content:before{width:520px;height:520px;right:-180px;top:-260px;background:radial-gradient(circle,rgba(174,225,243,.42),rgba(217,208,245,.17) 42%,transparent 70%);}
#menu .menu-copy{padding:8px 0 22px;}
#menu .brand-lockup{margin-bottom:30px;gap:10px;color:#4c7893;}
#menu .brand-icon{color:#75b8d0;filter:drop-shadow(0 2px 8px rgba(116,187,214,.16));}
#menu .menu-eyebrow{color:#8ba8b9;letter-spacing:.19em;font-size:9px;}
#menu .eyebrow-dot{background:#8ecfe2;box-shadow:0 0 0 4px rgba(142,207,226,.13);}
#menu .menu-copy h1{font-size:clamp(27px,2.8vw,37px);color:#36566d;letter-spacing:.005em;font-weight:620;line-height:1.22;margin:0 0 12px;}
#menu .menu-copy h1 em{color:#5ca9c6;}
#menu .menu-subtitle{max-width:360px;color:#7890a2;font-size:12px;line-height:1.9;letter-spacing:.035em;margin-bottom:27px;}
#menu .menu-actions{gap:10px;}
#menu .menu-btn{min-height:44px;border-radius:15px;padding:0 17px;font-size:12px;letter-spacing:.025em;}
#menu .menu-btn.primary{background:linear-gradient(112deg,rgba(194,231,244,.88),rgba(222,216,247,.82) 58%,rgba(246,219,234,.78));border:1px solid rgba(167,207,226,.78);color:#416b82;box-shadow:0 7px 20px rgba(121,175,201,.10),inset 0 1px 0 rgba(255,255,255,.86);}
#menu .menu-btn.primary:hover{background:linear-gradient(112deg,#d9f1f9,#e9e2fa 58%,#fbe9f2);box-shadow:0 9px 25px rgba(121,175,201,.15);}
#menu .menu-btn.secondary{border:1px solid rgba(188,211,226,.66);background:rgba(255,255,255,.52);color:#718da1;}
#menu .menu-btn.secondary:hover{background:rgba(255,255,255,.88);border-color:rgba(145,198,220,.8);}
#menu .menu-hint{margin-top:30px;color:#8198a9;}
#menu .key-hint-row{gap:6px;}
#menu .key-hint-row kbd{border-radius:7px;background:rgba(255,255,255,.70);border-color:rgba(196,218,231,.8);box-shadow:0 2px 5px rgba(83,130,156,.045);}
#menu .hint-secondary{font-size:9px;color:#91a5b3;}
#menu .menu-visual{min-height:420px;border-radius:26px;border-color:rgba(202,224,236,.82);background:radial-gradient(ellipse at 50% 42%,rgba(255,255,255,.88),rgba(221,241,249,.58) 35%,rgba(237,231,248,.42) 67%,rgba(251,241,247,.48));box-shadow:inset 0 1px 0 rgba(255,255,255,.88),0 12px 36px rgba(102,155,180,.045);}
#menu .menu-visual:after{inset:14px;border-radius:20px;border-color:rgba(255,255,255,.72);}
#menu .menu-visual:before{opacity:.25;background:linear-gradient(90deg,transparent,rgba(255,255,255,.82),rgba(176,223,241,.23),transparent);}
#menu .visual-halo.halo-blue{background:radial-gradient(circle,rgba(156,222,241,.34),transparent 70%);}
#menu .visual-halo.halo-pink{background:radial-gradient(circle,rgba(234,190,222,.24),transparent 70%);}
#menu .portal-art{filter:drop-shadow(0 14px 25px rgba(73,130,160,.11)) saturate(.86) brightness(1.04);}
#menu .floating-chip{border-color:rgba(192,218,231,.62);background:rgba(255,255,255,.64);color:#7897aa;box-shadow:0 6px 18px rgba(103,151,177,.06);backdrop-filter:blur(12px);}
#menu .menu-footer{border-top-color:rgba(178,205,221,.58);color:#94a8b6;}
/* Song selection: keep all existing controls and DOM hooks; recompose the page into clear reading zones. */
#songselect{background-color:#edf4f8;background-image:radial-gradient(ellipse at 13% 10%,rgba(158,219,237,.23),transparent 39%),radial-gradient(ellipse at 91% 72%,rgba(234,190,220,.17),transparent 43%),linear-gradient(135deg,rgba(255,255,255,.35),transparent 58%);}
#songselect .song-page-shell{width:min(1280px,100%);margin:10px auto;gap:21px;padding:clamp(20px,2.4vw,32px);border-radius:26px;border-color:rgba(190,216,230,.72);background:rgba(250,253,255,.64);box-shadow:0 16px 50px rgba(93,137,162,.06);backdrop-filter:blur(20px) saturate(108%);}
#songselect .page-header{min-height:43px;padding-bottom:13px;border-color:rgba(183,210,226,.65);}
#songselect .back-btn{border-radius:12px;color:#6e8da1;background:rgba(255,255,255,.55);border-color:rgba(192,215,228,.68);}
#songselect .mini-brand{color:#45677f;}
#songselect .mini-brand-mark{border-radius:10px;background:linear-gradient(140deg,#d9f0f8,#e8e2f7 70%,#f8e6ef);color:#6b9db4;box-shadow:inset 0 1px 0 rgba(255,255,255,.85);}
#songselect .header-note{color:#98adba;letter-spacing:.16em;}
#songselect .library-intro{align-items:center;gap:24px;margin-top:0;}
#songselect .library-intro h2{font-size:clamp(28px,3vw,39px);line-height:1.1;color:#3a5a70;letter-spacing:-.035em;}
#songselect .library-intro h2 span{color:#65b1cc;}
#songselect .library-intro p{font-size:12px;color:#8298a8;margin-top:8px;}
#songselect .section-eyebrow{font-size:9px;letter-spacing:.17em;color:#91aaba;}
#songselect .library-count{border-color:rgba(191,216,229,.68);border-radius:14px;background:rgba(255,255,255,.58);padding:9px 13px;}
#songselect .count-mark{border-radius:10px;background:linear-gradient(140deg,#e1f4fa,#f3e7f3);color:#76b7cc;}
#songselect .library-count b{color:#476a80;font-size:16px;}
#songselect .library-count small{color:#93a8b6;}
#songselect .play-mode-bar{grid-template-columns:minmax(180px,.8fr) auto minmax(190px,1fr);gap:16px;padding:12px 15px;border-color:rgba(191,215,228,.72);border-radius:17px;background:linear-gradient(110deg,rgba(255,255,255,.73),rgba(239,247,252,.62) 65%,rgba(250,239,247,.52));box-shadow:inset 0 1px 0 rgba(255,255,255,.85);}
#songselect .play-mode-copy b{color:#48677c;font-size:12px;}
#songselect .play-mode-copy small{color:#91a5b3;font-size:9px;}
#songselect .play-mode-icon{border-radius:11px;background:linear-gradient(145deg,#dff4fa,#eee6f8 70%,#f9e9f1);color:#72b1c8;}
#songselect .play-mode-segment{border-color:rgba(194,215,228,.78);background:rgba(233,242,248,.68);}
#songselect .play-mode-option{min-width:112px;border-radius:999px;color:#7e98aa;}
#songselect .play-mode-option.selected{background:rgba(255,255,255,.94);border-color:rgba(178,211,228,.88);color:#4e8198;box-shadow:0 3px 10px rgba(92,143,170,.08);}
#songselect .play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,#e5f5fa,#f7eaf2);border-color:rgba(224,194,217,.8);color:#9a7090;}
#songselect .play-mode-description{font-size:10px;color:#8da3b2;line-height:1.6;text-align:right;}
#songselect .library-layout{grid-template-columns:minmax(0,1fr) minmax(245px,285px);gap:20px;align-items:start;}
#songselect .library-section-title{margin-bottom:14px;}
#songselect .library-section-title h3{font-size:14px;color:#45657a;}
#songselect .library-section-title p{font-size:10px;color:#93a7b5;}
#songselect .section-index{color:#a4b8c5;}
#songselect .drop-zone{min-height:96px;grid-template-columns:40px 1fr;column-gap:12px;border-radius:15px;border-color:rgba(153,204,224,.76);background:linear-gradient(105deg,rgba(255,255,255,.72),rgba(235,248,252,.70));box-shadow:inset 0 1px 0 rgba(255,255,255,.86);}
#songselect .drop-zone:hover,#songselect .drop-zone.drag{border-color:#8cc9df;background:linear-gradient(105deg,rgba(255,255,255,.92),rgba(226,245,251,.84));box-shadow:0 0 0 4px rgba(143,203,225,.09);}
#songselect .upload-icon{border-radius:12px;background:linear-gradient(145deg,#dff4fa,#eee8f8);color:#6faec5;}
#songselect .upload-main{color:#55768c;font-size:12px;}
#songselect .upload-sub{font-size:10px;color:#91a6b5;}
#songselect .folder-import-btn{border-radius:11px;background:rgba(255,255,255,.64);border-color:rgba(190,215,228,.78);color:#6c8ba0;}
#songselect .folder-import-note{font-size:9px;color:#9aadb9;}
#songselect .song-list{gap:8px;}
#songselect .song-card{border-radius:15px;border-color:rgba(195,216,228,.70);background:rgba(255,255,255,.68);box-shadow:0 3px 12px rgba(91,138,164,.035);}
#songselect .song-card.selected{border-color:rgba(133,194,218,.9);background:linear-gradient(110deg,rgba(244,252,255,.95),rgba(249,244,252,.90));box-shadow:inset 0 0 0 1px rgba(138,194,220,.17),0 7px 20px rgba(83,136,167,.06);}
#songselect .library-aside{border-radius:17px;border-color:rgba(191,215,228,.74);background:rgba(255,255,255,.56);box-shadow:inset 0 1px 0 rgba(255,255,255,.8);}
#songselect .resource-card{border-radius:13px;border-color:rgba(196,217,229,.74);background:rgba(255,255,255,.64);box-shadow:0 3px 10px rgba(91,138,164,.025);}
#songselect .resource-card:hover{border-color:rgba(137,196,218,.82);background:rgba(255,255,255,.9);}
#songselect .resource-text b{color:#4b6a7f;}
#songselect .resource-text small{color:#8ba1b0;}
#songselect .resource-tip{border-radius:12px;background:rgba(224,240,248,.58);color:#8299a9;}
#songselect .page-footer{border-color:rgba(183,210,226,.62);color:#94a9b7;}
@media(max-width:900px){
 #menu .menu-content{grid-template-columns:minmax(0,1fr) minmax(270px,.9fr);gap:18px;padding:28px 26px 18px;}
 #menu .menu-visual{min-height:350px;}
 #songselect .play-mode-bar{grid-template-columns:1fr auto;}
 #songselect .play-mode-description{grid-column:1/-1;text-align:left;padding-left:43px;}
 #songselect .library-layout{grid-template-columns:minmax(0,1fr) 245px;gap:14px;}
}
@media(max-width:680px){
 #menu .menu-content{grid-template-columns:1fr;grid-template-rows:auto auto auto;gap:14px;padding:23px 19px 15px;}
 #menu .menu-copy{padding:3px 0 0;}
 #menu .brand-lockup{margin-bottom:18px;}
 #menu .menu-visual{min-height:230px;}
 #menu .menu-hint{margin-top:18px;}
 #songselect .song-page-shell{padding:16px;gap:17px;margin:4px auto;}
 #songselect .library-layout{grid-template-columns:1fr;}
 #songselect .library-aside{display:block;}
 #songselect .play-mode-bar{grid-template-columns:1fr;gap:10px;}
 #songselect .play-mode-segment{width:max-content;max-width:100%;}
 #songselect .play-mode-description{grid-column:auto;padding-left:0;text-align:left;}
 #songselect .library-intro{align-items:flex-start;}
}
@media(prefers-reduced-motion:reduce){#menu .menu-visual:before,#menu .menu-visual .portal-art,#menu .menu-visual .visual-halo,#menu .menu-visual .portal-orbit,#menu .menu-visual .floating-chip{animation:none!important}}
</style>


<style id="door-v1732-stability-patch">
/* Stability patch: interaction layers remain hit-testable; no overlay is allowed to intercept clicks. */
#menu button, #songselect button, #settings button, #pauseOverlay button, #result button { position: relative; }
/* Keep the entry filter transitional only; live playfield brightness follows the selected theme. */
body:not(.door-enter-play) #game { filter: none !important; }
</style>
<style id="door-v174-ver10-redesign">
/* v17.4 Ver.1.0 — structural visual re-composition; visual effects are pointer-transparent. */
:root{
 --d174-ink:#355369;--d174-muted:#7892A5;--d174-line:rgba(154,193,213,.48);
 --d174-ice:#BDECF8;--d174-lilac:#D5C9F1;--d174-rose:#E9B5D0;--d174-mint:#B8E9E0;
 --d174-ease:cubic-bezier(.19,.72,.22,1);
}
html,body{font-family:"Avenir Next","PingFang SC","Segoe UI","Microsoft YaHei",system-ui,sans-serif;}
#bgCanvas{opacity:.9;transition:opacity .6s ease}

/* Home page: no longer a glass card with an illustration inside; the portal now inhabits the page. */
#menu{position:relative;isolation:isolate;overflow:auto;align-items:center;justify-content:center;background:transparent;padding:0 clamp(16px,3vw,48px);}
#menu::before,#menu::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;}
#menu::before{background:radial-gradient(ellipse at 72% 44%,rgba(170,224,242,.27),transparent 34%),radial-gradient(ellipse at 15% 82%,rgba(228,187,216,.19),transparent 36%),linear-gradient(120deg,rgba(255,255,255,.24),transparent 50%);}
#menu::after{inset:10px 2.4vw;border-top:1px solid rgba(255,255,255,.64);border-bottom:1px solid rgba(178,208,223,.35);opacity:.68;}
.home-atmosphere{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0;contain:paint;}
.home-atmosphere *{pointer-events:none!important;}
.home-lightfield{position:absolute;border-radius:50%;pointer-events:none;will-change:transform,opacity;}
.home-lightfield.field-ice{width:min(60vw,780px);height:min(60vw,780px);right:-10%;top:-30%;background:radial-gradient(circle,rgba(160,222,241,.30),rgba(190,227,242,.11) 35%,transparent 70%);animation:rainlightDriftA 23s ease-in-out infinite alternate;}
.home-lightfield.field-lilac{width:min(54vw,690px);height:min(54vw,690px);left:-15%;bottom:-38%;background:radial-gradient(circle,rgba(228,180,213,.22),rgba(220,210,241,.08) 42%,transparent 70%);animation:rainlightDriftB 29s ease-in-out infinite alternate;}
.home-light-ribbon{position:absolute;width:115vw;height:16vh;left:-8vw;border-radius:50%;border-top:1px solid rgba(255,255,255,.62);border-bottom:1px solid rgba(151,204,225,.16);transform:rotate(-15deg);opacity:.48;filter:none;}
.ribbon-one{top:12%;animation:rainlightRibbonA 26s ease-in-out infinite alternate;}
.ribbon-two{top:67%;height:20vh;transform:rotate(12deg);opacity:.28;animation:rainlightRibbonB 32s ease-in-out infinite alternate;}
.home-rain-thread{position:absolute;width:1px;height:170px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.62),rgba(138,198,220,.18),transparent);opacity:.5;transform:rotate(19deg);}
.thread-one{left:16%;top:14%;animation:rainThread 12s ease-in-out infinite;}
.thread-two{left:84%;top:53%;height:210px;animation:rainThread 17s -5s ease-in-out infinite;}
.thread-three{left:59%;top:2%;height:125px;opacity:.28;animation:rainThread 14s -8s ease-in-out infinite;}
.home-waterline{position:absolute;left:8%;right:8%;bottom:9%;height:1px;background:linear-gradient(90deg,transparent,rgba(154,203,222,.48),rgba(230,190,216,.36),transparent);opacity:.6;}
#menu .menu-content.door-home-stage{position:relative;z-index:1;isolation:isolate;width:min(1320px,100%);min-height:min(790px,calc(100dvh - 28px));height:auto;padding:58px clamp(16px,3.2vw,44px) 22px;border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;grid-template-columns:minmax(0,.89fr) minmax(0,1.11fr);grid-template-rows:minmax(0,1fr) auto;grid-template-areas:"copy portal" "footer footer";gap:8px clamp(20px,4vw,66px);overflow:visible;}
#menu .menu-content:before{content:none;animation:none;}
.home-eyeline{position:absolute;z-index:5;top:18px;left:clamp(16px,3.2vw,44px);right:clamp(16px,3.2vw,44px);display:flex;align-items:center;justify-content:space-between;gap:16px;color:#8AA7B7;font-size:8px;font-weight:750;letter-spacing:.2em;pointer-events:none;}
.home-eyeline span:last-child{color:#A1AFBA;font-weight:600;}
#menu .menu-copy{grid-area:copy;align-self:center;justify-content:center;padding:0;max-width:480px;min-width:0;animation:doorCopyArrive .8s var(--d174-ease) both;}
#menu .brand-lockup{gap:12px;margin:0 0 clamp(35px,5.4vh,62px);color:#4A829D;}
#menu .brand-icon{width:35px;height:35px;color:#5AB9D6;filter:drop-shadow(0 3px 12px rgba(89,182,214,.20));}
#menu .brand-word{font-size:25px;font-weight:720;letter-spacing:-.04em;color:#3A5A70;}
#menu .menu-eyebrow{font-size:9px;letter-spacing:.23em;color:#819EAF;gap:10px;}
#menu .eyebrow-dot{width:5px;height:5px;background:#E7A6C8;box-shadow:0 0 0 5px rgba(231,166,200,.13),0 0 16px rgba(231,166,200,.18);}
#menu h1,#menu .menu-copy h1{font-size:clamp(37px,5.2vw,69px);font-weight:570;line-height:1.04;letter-spacing:-.055em;color:#304D63;-webkit-text-fill-color:#304D63;margin:22px 0 15px;white-space:normal;filter:none;text-shadow:0 2px 24px rgba(138,191,213,.09);}
#menu .menu-copy h1 em{display:inline-block;font-style:normal;color:#559DBB;-webkit-text-fill-color:#559DBB;background:linear-gradient(100deg,#53A9C9,#878BD0 55%,#C987AF);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
#menu .menu-subtitle{max-width:355px;margin:0 0 31px;color:#718B9F;font-size:13px;line-height:2;letter-spacing:.035em;}
#menu .menu-actions{width:min(100%,335px);gap:11px;}
#menu .menu-btn{position:relative;overflow:hidden;min-height:50px;border-radius:16px;padding:0 18px;font-size:12px;letter-spacing:.035em;box-shadow:none;backdrop-filter:none;transition:transform .34s var(--d174-ease),background .35s ease,border-color .35s ease,box-shadow .35s ease;}
#menu .menu-btn::before{content:"";position:absolute;top:-120%;bottom:-120%;left:-45%;width:24%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.64),transparent);transform:translateX(-210%) rotate(20deg);opacity:0;pointer-events:none;transition:transform .65s var(--d174-ease),opacity .25s ease;}
#menu .menu-btn:hover::before{transform:translateX(650%) rotate(20deg);opacity:.9;}
#menu .menu-btn.primary{border:1px solid rgba(164,208,226,.72);color:#3A657D;background:linear-gradient(112deg,rgba(187,233,245,.90),rgba(218,215,244,.86) 59%,rgba(244,215,232,.83));box-shadow:0 8px 25px rgba(113,173,198,.12),inset 0 1px 0 rgba(255,255,255,.88);}
#menu .menu-btn.primary:hover{transform:translateY(-2px);box-shadow:0 13px 30px rgba(113,173,198,.18),inset 0 1px 0 rgba(255,255,255,.96);border-color:rgba(128,190,215,.84);}
#menu .menu-btn.secondary{border:1px solid rgba(174,202,218,.52);background:rgba(255,255,255,.36);color:#6F8B9E;}
#menu .menu-btn.secondary:hover{transform:translateY(-2px);background:rgba(255,255,255,.68);border-color:rgba(157,202,222,.77);box-shadow:0 8px 22px rgba(100,151,177,.08);}
#menu .btn-arrow{background:rgba(255,255,255,.42);}
#menu .menu-hint{margin-top:clamp(25px,4vh,42px);color:#8AA0AF;font-size:10px;}
#menu .key-hint-row{gap:6px;}
#menu .key-hint-row kbd{min-width:27px;min-height:25px;border:1px solid rgba(179,205,220,.67);border-radius:8px;background:rgba(255,255,255,.48);color:#55758A;box-shadow:0 2px 0 rgba(201,221,232,.56);}
#menu .key-hint-row span{font-size:10px;color:#8199A9;}
#menu .hint-secondary{margin-top:10px;color:#96A8B6;font-size:9px;letter-spacing:.025em;}
#menu .menu-visual{grid-area:portal;position:relative;align-self:stretch;justify-self:stretch;min-width:0;min-height:520px;overflow:visible;border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;isolation:isolate;animation:doorPortalArrive 1s .06s var(--d174-ease) both;}pointer-events:none;
#menu .menu-visual::before{content:"";position:absolute;z-index:0;inset:7% -3% 8%;border-radius:50%;background:radial-gradient(ellipse at 50% 44%,rgba(255,255,255,.80),rgba(185,227,242,.30) 28%,rgba(210,200,241,.15) 51%,transparent 73%);opacity:.95;pointer-events:none;}
#menu .menu-visual::after{content:"";position:absolute;inset:5% 0 7%;z-index:0;border:0;border-radius:50%;background:radial-gradient(ellipse at 50% 96%,rgba(157,205,225,.24),transparent 54%);pointer-events:none;}
#menu .portal-art{position:relative;z-index:2;width:min(100%,510px);max-height:min(68vh,610px);filter:drop-shadow(0 18px 32px rgba(77,146,178,.13)) saturate(1.02);transform-origin:50% 58%;animation:portalBreath 9.5s ease-in-out infinite;}
#menu .portal-stage-floor{position:absolute;z-index:1;left:13%;right:13%;bottom:16%;height:6%;border-radius:50%;background:radial-gradient(ellipse,rgba(111,182,209,.25),rgba(198,176,215,.10) 42%,transparent 72%);transform:scaleX(.86);animation:portalFloorPulse 8s ease-in-out infinite;}
#menu .portal-light-stream{position:absolute;z-index:2;left:8%;right:8%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.78),rgba(133,207,228,.35),rgba(237,186,214,.26),transparent);pointer-events:none;transform-origin:center;}
#menu .stream-a{top:24%;transform:rotate(-18deg);animation:portalStreamA 12s ease-in-out infinite;}
#menu .stream-b{top:71%;transform:rotate(13deg);opacity:.52;animation:portalStreamB 15s ease-in-out infinite;}
#menu .portal-waterline{position:absolute;z-index:1;left:12%;right:12%;height:16%;border-top:1px solid rgba(129,193,216,.28);border-radius:50%;opacity:.48;transform:scaleX(.75);pointer-events:none;}
#menu .waterline-a{bottom:12%;animation:waterRipple 7s ease-in-out infinite;}
#menu .waterline-b{bottom:9%;left:23%;right:23%;opacity:.28;animation:waterRipple 7s -2.4s ease-in-out infinite;}
#menu .visual-halo{z-index:1;filter:none;}
#menu .halo-blue{width:310px;height:310px;top:8%;left:3%;background:radial-gradient(circle,rgba(119,211,235,.29),transparent 72%);animation:haloGlide 15s ease-in-out infinite alternate;}
#menu .halo-pink{width:300px;height:300px;right:3%;bottom:6%;background:radial-gradient(circle,rgba(231,162,202,.24),transparent 72%);animation:haloGlide 18s -6s ease-in-out infinite alternate-reverse;}
#menu .portal-orbit{width:min(79%,420px);height:auto;aspect-ratio:1;border-color:rgba(118,191,216,.21);}
#menu .orbit-one{animation:orbitFloatA 54s linear infinite;}
#menu .orbit-two{border-color:rgba(219,164,204,.21);animation:orbitFloatB 69s linear infinite;}
#menu .floating-chip{z-index:4;border:1px solid rgba(186,215,229,.70);background:rgba(255,255,255,.52);color:#718FA2;box-shadow:0 8px 24px rgba(99,150,177,.06),inset 0 1px 0 rgba(255,255,255,.72);backdrop-filter:blur(10px);padding:10px 13px;border-radius:13px;font-size:8px;letter-spacing:.14em;}
#menu .chip-top{top:16%;right:0;animation:chipFloat 6.8s ease-in-out infinite;}
#menu .chip-bottom{bottom:17%;left:1%;animation:chipFloat 8.2s -2s ease-in-out infinite reverse;}
#menu .visual-caption{bottom:3%;font-size:8px;letter-spacing:.20em;color:#8AA7B6;}
#menu .caption-line{background:linear-gradient(90deg,transparent,#99CADC,transparent);width:30px;}
#menu .menu-footer{grid-area:footer;position:relative;z-index:3;margin-top:0;padding-top:15px;border-top:1px solid rgba(171,202,219,.45);color:#95AAB7;font-size:8px;letter-spacing:.16em;}

/* Library: songs lead the page; mode and chart sources become one functional side rail. */
#songselect{position:relative;isolation:isolate;align-items:stretch;justify-content:flex-start;overflow-y:auto;overflow-x:hidden;padding:12px clamp(12px,2.3vw,32px) 24px;background:transparent;}
#songselect::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse at 84% 4%,rgba(175,220,239,.27),transparent 31%),radial-gradient(ellipse at 6% 82%,rgba(229,185,216,.19),transparent 32%),linear-gradient(132deg,rgba(255,255,255,.24),transparent 49%);}
#songselect .song-page-shell.door-library-workspace{position:relative;z-index:1;width:min(1360px,100%);min-height:calc(100% - 8px);margin:4px auto;display:flex;flex-direction:column;gap:clamp(16px,2vw,24px);padding:clamp(12px,2vw,26px);border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;}
#songselect .page-header{position:relative;min-height:46px;padding:0 2px 14px;border-bottom:1px solid rgba(164,198,216,.48);}
#songselect .header-back{border:1px solid rgba(164,200,219,.58);background:rgba(255,255,255,.42);color:#608097;border-radius:999px;min-height:38px;padding:8px 15px;transition:transform .25s var(--d174-ease),background .25s,border-color .25s;}
#songselect .header-back:hover{transform:translateX(-3px);background:rgba(255,255,255,.76);border-color:rgba(115,181,207,.76);}
#songselect .mini-brand{color:#3C5F75;font-size:19px;letter-spacing:-.045em;}
#songselect .mini-brand-mark{width:31px;height:31px;border-radius:11px;background:linear-gradient(138deg,#BDECF8,#D8D0F0 64%,#F0CFE0);color:#427995;box-shadow:0 5px 14px rgba(114,174,198,.10),inset 0 1px 0 rgba(255,255,255,.82);}
#songselect .header-note{font-size:8px;letter-spacing:.21em;color:#9AAEBA;}
#songselect .library-hero-wrap{position:relative;display:flex;align-items:center;min-height:116px;padding:3px 12px 6px;overflow:hidden;}
#songselect .library-hero-orbit{position:absolute;right:4%;top:-115px;width:320px;height:320px;border-radius:50%;border:1px solid rgba(146,199,219,.26);box-shadow:0 0 0 24px rgba(255,255,255,.08),0 0 0 58px rgba(180,218,234,.055);pointer-events:none;animation:heroOrbitDrift 30s linear infinite;}
#songselect .library-intro{position:relative;z-index:1;width:100%;display:flex;align-items:center;justify-content:space-between;gap:22px;margin:0;}
#songselect .section-eyebrow{font-size:8px;letter-spacing:.23em;color:#8DA9B9;}
#songselect .library-intro h2{margin-top:6px;font-size:clamp(32px,4.2vw,52px);line-height:1.0;color:#304F64;font-weight:580;letter-spacing:-.06em;}
#songselect .library-intro h2 span{color:#66B4CE;}
#songselect .library-intro p{margin-top:12px;font-size:12px;line-height:1.8;color:#7B94A5;letter-spacing:.02em;}
#songselect .library-count{position:relative;z-index:1;display:flex;align-items:center;gap:11px;min-width:142px;padding:12px 15px;border-radius:17px;border:1px solid rgba(166,202,221,.52);background:rgba(255,255,255,.47);box-shadow:0 12px 30px rgba(103,150,174,.055),inset 0 1px 0 rgba(255,255,255,.75);}
#songselect .count-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(140deg,rgba(190,234,246,.78),rgba(224,215,242,.74));color:#5BA4BF;font-size:17px;}
#songselect .library-count b{color:#3F6379;font-size:19px;font-weight:690;}
#songselect .library-count small{color:#8BA2B2;font-size:9px;}
#songselect .library-hero-note{position:absolute;right:clamp(185px,22vw,290px);display:flex;align-items:center;gap:7px;opacity:.42;pointer-events:none;color:#90A9B8;font-size:7px;line-height:1.7;letter-spacing:.12em;}
#songselect .hero-note-mark{font-size:18px;color:#C4A6D5;}
#songselect .library-layout{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(265px,322px);align-items:start;gap:clamp(14px,2vw,25px);}
#songselect .library-main{min-width:0;padding:clamp(17px,2vw,25px);border:1px solid rgba(167,202,220,.55);border-radius:25px;background:linear-gradient(145deg,rgba(255,255,255,.72),rgba(247,251,254,.52) 56%,rgba(248,242,249,.44));box-shadow:0 18px 48px rgba(84,134,161,.055),inset 0 1px 0 rgba(255,255,255,.91);}
#songselect .library-section-title{align-items:flex-start;margin-bottom:18px;}
#songselect .library-section-title h3{font-size:15px;font-weight:700;color:#3F5F74;letter-spacing:-.015em;}
#songselect .library-section-title p{margin-top:5px;font-size:10px;color:#8CA3B2;line-height:1.7;}
#songselect .section-index{font-size:9px;letter-spacing:.18em;color:#9EB4C1;}
#songselect .drop-zone{position:relative;min-height:103px;display:grid;grid-template-columns:46px minmax(0,1fr);grid-template-rows:auto auto;align-content:center;justify-content:stretch;column-gap:15px;row-gap:3px;padding:17px 20px;border-radius:18px;border:1px dashed rgba(117,183,209,.69);background:linear-gradient(100deg,rgba(240,250,254,.86),rgba(244,241,251,.68) 70%,rgba(255,244,249,.62));box-shadow:inset 0 1px 0 rgba(255,255,255,.92);transition:transform .3s var(--d174-ease),border-color .3s,background .3s,box-shadow .3s;cursor:pointer;}
#songselect .drop-zone::after{content:".OSZ / 4K";position:absolute;right:17px;top:15px;color:#A0B7C5;font-size:7px;letter-spacing:.18em;pointer-events:none;}
#songselect .drop-zone:hover,#songselect .drop-zone.drag{transform:translateY(-2px);border-color:rgba(74,166,201,.9);background:linear-gradient(100deg,rgba(235,249,253,.97),rgba(241,236,250,.84) 70%,rgba(255,241,248,.84));box-shadow:0 9px 22px rgba(95,164,192,.10),inset 0 1px 0 #fff;}
#songselect .upload-icon{grid-row:1/3;width:43px;height:43px;display:grid;place-items:center;border:1px solid rgba(150,205,225,.47);border-radius:14px;background:linear-gradient(145deg,#DDF4FB,#EAE2F5 72%,#F8E6F0);color:#5A9AB5;font-size:23px;box-shadow:0 5px 13px rgba(111,168,192,.08);}
#songselect .upload-main{align-self:end;font-size:13px;color:#466980;font-weight:700;line-height:1.4;}
#songselect .upload-main b{display:inline-block;margin-left:5px;padding:2px 7px;border:1px solid rgba(154,196,216,.42);border-radius:6px;color:#5FA5BF;background:rgba(255,255,255,.56);font-size:8px;letter-spacing:.09em;}
#songselect .upload-sub{align-self:start;font-size:10px;color:#899FAE;line-height:1.6;}
#songselect .folder-import-row{margin:10px 0 21px;gap:10px;}
#songselect .folder-import-btn{border-radius:12px;background:rgba(255,255,255,.51);border:1px solid rgba(159,198,217,.52);color:#638298;min-height:37px;padding:8px 13px;transition:transform .24s var(--d174-ease),background .24s,border-color .24s;}
#songselect .folder-import-btn:hover{transform:translateY(-1px);background:rgba(255,255,255,.85);border-color:#91C8DD;}
#songselect .folder-import-note{font-size:9px;color:#9AADB9;}
#songselect .song-list{display:flex;flex-direction:column;gap:9px;}
#songselect .song-card{position:relative;overflow:hidden;display:flex;align-items:center;gap:14px;min-height:76px;padding:14px 15px;border:1px solid rgba(166,200,218,.47);border-radius:17px;background:rgba(255,255,255,.48);box-shadow:0 3px 12px rgba(88,139,163,.025);transition:transform .28s var(--d174-ease),border-color .28s,background .28s,box-shadow .28s;}
#songselect .song-card::before{content:"♫";flex:0 0 35px;height:35px;display:grid;place-items:center;border-radius:12px;color:#63A8C2;font-size:15px;background:linear-gradient(145deg,rgba(200,239,248,.8),rgba(225,218,244,.74) 67%,rgba(248,222,236,.7));border:1px solid rgba(177,212,228,.36);}
#songselect .song-card:hover{transform:translateY(-2px);border-color:rgba(126,188,214,.78);background:rgba(255,255,255,.80);box-shadow:0 10px 23px rgba(83,143,171,.085);}
#songselect .song-card.selected{border-color:rgba(103,179,208,.82);background:linear-gradient(108deg,rgba(234,249,253,.94),rgba(241,236,250,.83) 72%,rgba(251,236,245,.76));box-shadow:inset 3px 0 0 rgba(101,184,212,.78),0 10px 25px rgba(94,155,181,.09);}
#songselect .song-card .info{flex:1;min-width:0;}
#songselect .song-card .title{color:#3D5C71;font-size:13px;font-weight:730;line-height:1.5;overflow-wrap:anywhere;}
#songselect .song-card .artist{margin-top:4px;color:#91A4B2;font-size:9px;line-height:1.6;}
#songselect .song-card .diff{gap:5px;flex-wrap:wrap;margin-left:8px;}
#songselect .song-card .diff-tag{border-radius:999px;font-size:8px;padding:4px 7px;}
#songselect .song-difficulty-expand{display:flex;flex-wrap:wrap;gap:8px;padding:10px 13px 14px 62px;animation:doorDifficultyOpen .38s var(--d174-ease) both;}
#songselect .diff-btn{border-radius:999px;min-height:37px;padding:9px 14px;transition:transform .24s var(--d174-ease),box-shadow .24s,background .24s;}
#songselect .diff-btn:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(94,150,178,.10);}
#songselect .empty-library{position:relative;overflow:hidden;min-height:235px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:26px 18px;border:1px dashed rgba(154,195,216,.52);border-radius:20px;background:radial-gradient(ellipse at 50% 0,rgba(195,233,246,.22),transparent 60%),rgba(255,255,255,.25);text-align:center;}
#songselect .empty-library .empty-note{width:52px;height:52px;display:grid;place-items:center;border:1px solid rgba(168,211,228,.52);border-radius:18px;background:linear-gradient(145deg,rgba(219,243,250,.88),rgba(235,229,248,.80) 70%,rgba(250,230,240,.75));color:#66AFC8;font-size:23px;box-shadow:0 8px 24px rgba(97,159,188,.09);margin-bottom:13px;}
#songselect .empty-library>b{color:#526F83;font-size:13px;font-weight:700;}
#songselect .empty-library>p{max-width:390px;margin-top:8px;color:#8DA2B1;font-size:10px;line-height:1.9;}
#songselect .empty-library>span{margin-top:7px;color:#A2B3BE;font-size:9px;}
#songselect .library-aside{position:relative;display:flex;flex-direction:column;gap:12px;min-width:0;padding:17px;border:1px solid rgba(168,202,220,.52);border-radius:25px;background:linear-gradient(155deg,rgba(250,253,255,.74),rgba(241,248,252,.52) 67%,rgba(249,242,248,.49));box-shadow:0 18px 44px rgba(84,134,161,.045),inset 0 1px 0 rgba(255,255,255,.91);overflow:hidden;}
#songselect .library-aside::before{content:"";position:absolute;right:-95px;top:-130px;width:260px;height:260px;border-radius:50%;border:1px solid rgba(168,209,226,.25);box-shadow:0 0 0 22px rgba(255,255,255,.075),0 0 0 49px rgba(176,215,231,.045);pointer-events:none;}
#songselect .library-aside>*{position:relative;z-index:1;}
#songselect .play-mode-bar.mode-workspace-card{display:flex;flex-direction:column;align-items:stretch;gap:12px;padding:2px 0 17px;margin:0 0 2px;border:0;border-bottom:1px solid rgba(164,199,217,.43);border-radius:0;background:transparent;box-shadow:none;}
#songselect .play-mode-copy{display:flex;align-items:center;gap:10px;min-width:0;}
#songselect .play-mode-icon{width:35px;height:35px;display:grid;place-items:center;flex:0 0 35px;border-radius:13px;background:linear-gradient(145deg,#DDF3FA,#E8E2F6 73%,#F8E6F0);color:#62A8C3;}
#songselect .play-mode-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
#songselect .play-mode-copy b{display:block;font-size:12px;color:#41637A;}
#songselect .play-mode-copy small{display:block;margin-top:4px;font-size:9px;color:#8CA2B1;line-height:1.5;}
#songselect .play-mode-segment{display:grid;grid-template-columns:1fr 1fr;gap:4px;width:100%;padding:4px;border-radius:14px;border:1px solid rgba(161,198,217,.45);background:rgba(228,240,247,.48);}
#songselect .play-mode-option{min-width:0;min-height:38px;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 10px;border:1px solid transparent;border-radius:11px;background:transparent;color:#8299A9;font-size:10px;font-weight:650;transition:background .3s,border-color .3s,color .3s,box-shadow .3s;}
#songselect .play-mode-option svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
#songselect .play-mode-option.selected{background:rgba(255,255,255,.86);border-color:rgba(167,207,224,.45);color:#4F819A;box-shadow:0 4px 12px rgba(83,141,168,.08),inset 0 1px 0 rgba(255,255,255,.9);}
#songselect .play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,rgba(220,244,250,.92),rgba(239,228,247,.84) 70%,rgba(250,231,241,.8));color:#997291;}
#songselect .play-mode-description{font-size:9px;color:#8BA2B2;line-height:1.7;text-align:left;}
#songselect .library-aside .library-section-title{margin:2px 0 1px;}
#songselect .library-aside .library-section-title h3{color:#426277;font-size:13px;font-weight:700;}
#songselect .library-aside .library-section-title p{font-size:9px;color:#8DA3B1;line-height:1.6;}
#songselect .resource-card{position:relative;display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;gap:10px;min-width:0;padding:12px 11px;border:1px solid rgba(163,199,217,.43);border-radius:15px;background:rgba(255,255,255,.45);box-shadow:0 3px 12px rgba(87,137,162,.025);transition:transform .28s var(--d174-ease),background .28s,border-color .28s,box-shadow .28s;}
#songselect .resource-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.78);border-color:rgba(125,187,213,.70);box-shadow:0 9px 20px rgba(84,145,171,.075);}
#songselect .resource-icon{width:35px;height:35px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,#DFF3FA,#EEE6F6);color:#5E9EB9;font-size:11px;font-weight:750;}
#songselect .resource-icon.pack-icon{background:linear-gradient(145deg,#F7E8F0,#E9E3F7);color:#B5799E;}
#songselect .resource-text{min-width:0;display:flex;flex-direction:column;gap:4px;}
#songselect .resource-text b{font-size:10px;color:#4A687D;font-weight:720;}
#songselect .resource-text small{font-size:8px;line-height:1.6;color:#8CA2B0;}
#songselect .resource-arrow{color:#91B9C9;font-size:14px;transition:transform .25s var(--d174-ease),color .25s;}
#songselect .resource-card:hover .resource-arrow{transform:translate(2px,-2px);color:#559FBD;}
#songselect .resource-tip{display:flex;gap:9px;margin-top:2px;padding:12px;border-radius:13px;background:rgba(223,239,247,.45);color:#879DAD;font-size:9px;line-height:1.8;}
#songselect .resource-tip .tip-icon{flex:0 0 17px;width:17px;height:17px;display:grid;place-items:center;border:1px solid rgba(154,192,211,.52);border-radius:50%;color:#6EA6BE;font-size:9px;}
#songselect .library-aside-footer{display:flex;align-items:center;gap:8px;margin-top:3px;padding-top:12px;border-top:1px solid rgba(166,198,215,.36);color:#9AAEBA;font-size:7px;letter-spacing:.16em;}
#songselect .page-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 4px 0;border-top:1px solid rgba(163,198,216,.38);color:#98ADB9;font-size:7px;letter-spacing:.17em;}
#songselect .page-footer span:last-child{color:#A9B8C1;}

/* Settings harmonize with the same material language. */
#settings{background:transparent;}
#settings .settings-panel{width:min(700px,100%);max-width:700px;margin:auto;padding:clamp(21px,3vw,34px);border:1px solid rgba(168,202,220,.59);border-radius:25px;background:linear-gradient(145deg,rgba(252,254,255,.87),rgba(244,250,253,.77) 58%,rgba(249,242,249,.75));box-shadow:0 24px 68px rgba(76,129,158,.10),inset 0 1px 0 rgba(255,255,255,.92);backdrop-filter:blur(20px) saturate(112%);}
#settings .settings-panel h2{font-size:24px;letter-spacing:-.035em;color:#35566C;}
#settings .setting-item{padding:13px 0 11px;border-bottom:1px solid rgba(170,202,220,.26);}
#settings .setting-item label{color:#5F7B90;font-size:11px;font-weight:650;}
#settings .setting-item .vd{color:#589DB8;font-variant-numeric:tabular-nums;}
#settings .setting-item select{min-height:39px;border:1px solid rgba(159,198,218,.59);border-radius:12px;background:rgba(255,255,255,.77);color:#426379;box-shadow:inset 0 1px 0 rgba(255,255,255,.95);}
#settings .setting-item select:focus-visible{outline:2px solid rgba(88,177,207,.65);outline-offset:2px;}
#settings .quality-hint{color:#8CA2B1;}
#settings .toggle{border:1px solid rgba(153,190,210,.44);background:#D9E6EE;}
#settings .toggle.on{background:linear-gradient(90deg,#72C7DB,#A4B9E6);}
#settings .toggle:after{box-shadow:0 2px 6px rgba(60,105,132,.22);}
.play-theme-preview{position:relative;overflow:hidden;margin-top:12px;padding:10px 11px 12px;border:1px solid rgba(158,197,217,.46);border-radius:14px;background:#0B1424;transition:background .62s var(--d174-ease),border-color .62s;}
.theme-preview-copy{position:relative;z-index:2;display:flex;justify-content:space-between;gap:10px;margin-bottom:9px;color:rgba(218,235,246,.66);font-size:8px;letter-spacing:.07em;}
.theme-preview-copy b{color:#B6D8E7;font-size:9px;font-weight:650;letter-spacing:.025em;transition:color .45s;}
.theme-preview-track{position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(4,1fr);height:62px;overflow:hidden;border:1px solid rgba(149,192,218,.17);border-radius:9px;background:linear-gradient(180deg,#0F1C2F,#0A1422);transition:background .62s,border-color .62s;}
.theme-preview-track i{display:block;border-left:1px solid rgba(165,206,233,.13);background:linear-gradient(100deg,rgba(23,41,64,.38),rgba(16,28,45,.28),rgba(22,38,59,.38));}
.theme-preview-track i:first-child{border-left:0;}
.preview-note{position:absolute;z-index:3;top:24px;width:13%;height:8px;border-radius:999px;background:linear-gradient(90deg,#D887BD,#F8F4FF 48%,#AAA2F2);box-shadow:0 0 8px rgba(183,169,244,.23);animation:previewNoteDrift 4s ease-in-out infinite alternate;}
.preview-note-a{left:13%;}.preview-note-b{left:62%;top:10px;animation-delay:-1.8s;background:linear-gradient(90deg,#75CDED,#F8FDFF 50%,#78D5C5);}
.preview-hold{position:absolute;z-index:2;left:37%;top:19px;width:8%;height:31px;border-radius:999px;background:linear-gradient(90deg,rgba(170,162,242,.76),rgba(247,251,255,.67),rgba(216,135,189,.74));border:1px solid rgba(246,251,255,.72);}
.play-theme-preview[data-theme="light"]{background:#E6EFF5;border-color:rgba(93,147,177,.45);}
.play-theme-preview[data-theme="light"] .theme-preview-copy{color:#7A94A7;}
.play-theme-preview[data-theme="light"] .theme-preview-copy b{color:#426B83;}
.play-theme-preview[data-theme="light"] .theme-preview-track{background:linear-gradient(180deg,#F1F7FA,#D7E6EF);border-color:rgba(86,137,164,.29);}
.play-theme-preview[data-theme="light"] .theme-preview-track i{border-color:rgba(73,121,151,.20);background:linear-gradient(100deg,rgba(255,255,255,.70),rgba(222,236,244,.52),rgba(255,255,255,.62));}
.play-theme-preview[data-theme="light"] .preview-note{background:linear-gradient(90deg,#B46B98,#FFFFFF 48%,#8C78D2);box-shadow:0 1px 8px rgba(79,139,170,.24);}
.play-theme-preview[data-theme="light"] .preview-note-b{background:linear-gradient(90deg,#287FA4,#FFFFFF 50%,#258B7A);}
.play-theme-preview[data-theme="light"] .preview-hold{background:linear-gradient(90deg,rgba(118,104,204,.68),rgba(255,255,255,.89),rgba(173,94,145,.68));border-color:rgba(91,142,171,.65);}

/* Theme state is authoritative for canvas, the 4:3 gutters and every live data panel. */
#game{transition:opacity .48s ease!important;}
body.play-theme-light #leftPanel,body.play-theme-light #rightPanel{background:rgba(231,242,248,.96);border-color:rgba(67,112,140,.23);color:#2D475D;box-shadow:0 12px 34px rgba(62,104,132,.10);}
body.play-theme-light #leftPanel .panel-section,body.play-theme-light #rightPanel .panel-section{background:rgba(255,255,255,.82);border-color:rgba(75,121,151,.23);}
body.play-theme-light #leftPanel .panel-title,body.play-theme-light #rightPanel .panel-title{color:#55778D;}
body.play-theme-light #leftPanel .judge-row,body.play-theme-light #rightPanel .panel-song-title{color:#304C63;}
body.play-theme-light .panel-song-artist{color:#617F94;}
body.play-theme-light .panel-song-difficulty{color:#756FB0;}
body.play-theme-light .runtime-item>b{color:#33677B;}
body.play-theme-light .survival-hud{background:rgba(255,255,255,.88);border-color:rgba(75,121,151,.26);color:#34536A;}
body.play-theme-light .hud-details-panel{background:rgba(246,251,254,.98);border-color:rgba(73,123,154,.24);color:#2B465B;}
body.play-theme-light .hud-details-song,body.play-theme-light .detail-stat{background:rgba(222,236,245,.66);border-color:rgba(77,123,154,.20);}
#leftPanel,#rightPanel,#leftPanel .panel-section,#rightPanel .panel-section,.hud-details-panel,.survival-hud{transition:background-color .55s ease,border-color .55s ease,color .45s ease,box-shadow .55s ease;}

/* The accepted Door-entry animation stays ceremonial: water light converges, the frame opens, refracted rings release. */
.portal-transition{background:#EAF5FA;}
.portal-transition-wash{will-change:opacity,transform;background:radial-gradient(ellipse at 50% 44%,rgba(255,255,255,.98) 0%,rgba(207,239,248,.88) 25%,rgba(219,205,240,.54) 52%,rgba(240,228,240,.77) 74%,#EAF5FA 100%);}
.portal-transition-door{box-shadow:0 0 0 9px rgba(255,255,255,.24),0 0 48px rgba(98,184,211,.31),inset 0 0 36px rgba(255,255,255,.61);}
.portal-door-inner{box-shadow:inset 0 0 28px rgba(255,255,255,.43);}
.portal-transition.run .portal-transition-door{animation:doorSweep .88s cubic-bezier(.65,0,.25,1) forwards;}
.portal-transition.run .ripple-a{animation:rippleSweep .82s .04s cubic-bezier(.17,.67,.29,1) forwards;}
.portal-transition.run .ripple-b{animation:rippleSweep .84s .12s cubic-bezier(.17,.67,.29,1) forwards;}
.portal-transition.run .portal-transition-copy{animation:portalCopyIn .52s .34s ease-out forwards;}

/* Page and component motion has clear hierarchy: entrance > card hover > idle breathing. */
#menu.active .home-eyeline{animation:doorEyelineArrive .65s .04s var(--d174-ease) both;}
#menu.active .menu-footer{animation:doorFooterArrive .7s .18s var(--d174-ease) both;}
#songselect.active .page-header{animation:doorLibraryHeader .6s var(--d174-ease) both;}
#songselect.active .library-hero-wrap{animation:doorLibraryHero .72s .04s var(--d174-ease) both;}
#songselect.active .library-main{animation:doorLibraryPanel .72s .09s var(--d174-ease) both;}
#songselect.active .library-aside{animation:doorLibraryPanel .76s .16s var(--d174-ease) both;}
#songselect.active .page-footer{animation:doorFooterArrive .65s .22s var(--d174-ease) both;}
#songselect .resource-card:active,#songselect .folder-import-btn:active,#songselect .header-back:active{transform:scale(.985);}
@keyframes rainlightDriftA{0%{transform:translate3d(0,0,0) scale(1);opacity:.7}100%{transform:translate3d(-5%,5%,0) scale(1.09);opacity:1}}
@keyframes rainlightDriftB{0%{transform:translate3d(0,0,0) scale(1);opacity:.65}100%{transform:translate3d(7%,-4%,0) scale(1.08);opacity:.92}}
@keyframes rainlightRibbonA{0%{transform:translate3d(-2%,0,0) rotate(-15deg);opacity:.28}100%{transform:translate3d(4%,5%,0) rotate(-12deg);opacity:.55}}
@keyframes rainlightRibbonB{0%{transform:translate3d(2%,0,0) rotate(12deg);opacity:.2}100%{transform:translate3d(-4%,-4%,0) rotate(9deg);opacity:.42}}
@keyframes rainThread{0%,100%{transform:translate3d(0,-12px,0) rotate(19deg);opacity:.22}50%{transform:translate3d(-7px,18px,0) rotate(19deg);opacity:.62}}
@keyframes doorCopyArrive{0%{opacity:0;transform:translate3d(-15px,10px,0)}100%{opacity:1;transform:translate3d(0,0,0)}}
@keyframes doorPortalArrive{0%{opacity:0;transform:translate3d(0,12px,0) scale(.975)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes doorEyelineArrive{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
@keyframes doorFooterArrive{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes portalBreath{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-6px) scale(1.008)}}
@keyframes portalFloorPulse{0%,100%{transform:scaleX(.76);opacity:.52}50%{transform:scaleX(1);opacity:.82}}
@keyframes portalStreamA{0%,100%{transform:translateX(-4%) rotate(-18deg);opacity:.22}50%{transform:translateX(5%) rotate(-16deg);opacity:.64}}
@keyframes portalStreamB{0%,100%{transform:translateX(3%) rotate(13deg);opacity:.18}50%{transform:translateX(-5%) rotate(10deg);opacity:.49}}
@keyframes waterRipple{0%,100%{transform:scaleX(.74) translateY(0);opacity:.24}50%{transform:scaleX(1) translateY(-4px);opacity:.54}}
@keyframes haloGlide{0%{transform:translate3d(-5px,4px,0) scale(.96)}100%{transform:translate3d(8px,-6px,0) scale(1.06)}}
@keyframes orbitFloatA{0%{transform:rotate(-24deg) scaleX(.72)}100%{transform:rotate(336deg) scaleX(.72)}}
@keyframes orbitFloatB{0%{transform:rotate(38deg) scaleX(.9) scaleY(.88)}100%{transform:rotate(-322deg) scaleX(.9) scaleY(.88)}}
@keyframes chipFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes heroOrbitDrift{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes doorLibraryHeader{from{opacity:0;transform:translateY(-7px)}to{opacity:1;transform:translateY(0)}}
@keyframes doorLibraryHero{from{opacity:0;transform:translateY(10px);clip-path:inset(0 0 12% 0)}to{opacity:1;transform:translateY(0);clip-path:inset(0 0 0 0)}}
@keyframes doorLibraryPanel{from{opacity:0;transform:translateY(12px) scale(.995)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes doorDifficultyOpen{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
@keyframes previewNoteDrift{from{transform:translateY(0)}to{transform:translateY(21px)}}

