 #menu{padding:10px 14px 16px;align-items:flex-start;}
 #menu .menu-content.door-home-stage{width:100%;min-height:0;padding:48px 4px 18px;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto;grid-template-areas:"copy" "portal" "footer";gap:8px;}
 .home-eyeline{left:4px;right:4px;top:8px;font-size:7px;letter-spacing:.14em;}
 #menu .menu-copy{max-width:520px;padding:6px 6px 0;}
 #menu .brand-lockup{margin-bottom:24px;}
 #menu h1,#menu .menu-copy h1{font-size:clamp(38px,8.8vw,58px);max-width:520px;margin:17px 0 12px;}
 #menu .menu-subtitle{margin-bottom:22px;font-size:12px;}
 #menu .menu-actions{width:min(100%,360px);}
 #menu .menu-hint{margin-top:21px;}
 #menu .menu-visual{min-height:clamp(255px,66vw,390px);height:clamp(255px,66vw,390px);overflow:visible;margin-top:-1px;}
 #menu .portal-art{width:min(88%,370px);max-height:100%;}
 #menu .portal-orbit{width:min(82%,330px);}
 #menu .floating-chip{font-size:7px;padding:8px 10px;}
 #menu .chip-top{right:2%;top:8%;}#menu .chip-bottom{left:2%;bottom:13%;}
 #menu .visual-caption{bottom:0;}
 #menu .menu-footer{flex-wrap:wrap;justify-content:space-between;font-size:7px;gap:8px;padding-top:12px;}
 #songselect{padding:6px 9px 18px;}
 #songselect .song-page-shell.door-library-workspace{padding:8px 3px;gap:15px;margin:0 auto;}
 #songselect .page-header{padding-bottom:10px;}
 #songselect .header-note{font-size:7px;letter-spacing:.12em;}
 #songselect .library-hero-wrap{min-height:100px;padding:0 5px;}
 #songselect .library-intro h2{font-size:clamp(31px,8vw,42px);}
 #songselect .library-intro p{max-width:260px;font-size:10px;}
 #songselect .library-count{min-width:0;padding:9px 10px;gap:7px;border-radius:13px;}
 #songselect .count-mark{width:29px;height:29px;border-radius:10px;}
 #songselect .library-count b{font-size:16px;}
 #songselect .library-hero-note{display:none;}
 #songselect .library-layout{grid-template-columns:minmax(0,1fr);gap:13px;}
 #songselect .library-main{padding:14px 12px;border-radius:19px;}
 #songselect .library-aside{padding:14px;border-radius:19px;}
 #songselect .play-mode-bar.mode-workspace-card{padding-bottom:13px;}
 #songselect .drop-zone{grid-template-columns:39px minmax(0,1fr);column-gap:10px;min-height:88px;padding:13px;}
 #songselect .upload-icon{width:37px;height:37px;border-radius:12px;}
 #songselect .drop-zone::after{right:10px;top:9px;font-size:6px;}
 #songselect .song-card{gap:9px;padding:11px 10px;}
 #songselect .song-card::before{flex-basis:29px;height:29px;border-radius:10px;font-size:13px;}
 #songselect .song-card .title{font-size:12px;}
 #songselect .song-card .artist{font-size:8px;}
 #songselect .song-card .diff{margin-left:0;max-width:100%;}
 #songselect .song-card .diff-tag{font-size:7px;padding:3px 6px;}
 #songselect .song-difficulty-expand{padding-left:14px;}
 #songselect .page-footer{flex-wrap:wrap;line-height:1.7;}
 #settings .settings-panel{padding:18px 14px;border-radius:20px;}
}
@media(max-width:390px){
 #menu .menu-copy h1{font-size:36px;}
 #menu .key-hint-row span{margin-inline:2px;}
 #songselect .library-intro{align-items:flex-start;}
 #songselect .library-count{flex-direction:column;align-items:flex-start;gap:4px;}
 #songselect .library-count small{display:block;}
 #songselect .song-card{align-items:flex-start;flex-wrap:wrap;}
 #songselect .song-card .info{flex-basis:calc(100% - 40px);}
 #songselect .song-card .diff{margin-left:38px;}
}
@media(prefers-reduced-motion:reduce){
 #menu .home-atmosphere *,#menu .menu-visual *,#songselect .library-hero-orbit,#songselect .preview-note{animation:none!important;}
 #menu .menu-copy,#menu .menu-visual,#menu .home-eyeline,#menu .menu-footer,#songselect.active .page-header,#songselect.active .library-hero-wrap,#songselect.active .library-main,#songselect.active .library-aside,#songselect.active .page-footer{animation:none!important;}
 #menu .menu-btn,#songselect .song-card,#songselect .resource-card,#songselect .folder-import-btn,#songselect .header-back{transition:none!important;}
 #settings.active .setting-item,.play-theme-preview.theme-enter{animation:none!important;}
}
body.reduce-motion #menu .home-atmosphere *,body.reduce-motion #menu .menu-visual *,body.reduce-motion #songselect .library-hero-orbit,body.reduce-motion #songselect .preview-note,body.reduce-motion .play-theme-preview.theme-enter,body.reduce-motion #settings.active .setting-item{animation:none!important;}
body.reduce-motion #menu .home-light-ribbon{opacity:.12;}
/* Smoothly blend the data glass when the stage palette changes; falling notes are never color-filtered. */
#leftPanel,#rightPanel,#leftPanel .panel-section,#rightPanel .panel-section,#rightPanel .survival-hud,
#leftPanel .judge-row,#rightPanel .runtime-item,#leftPanel .panel-title,#rightPanel .panel-title{
 transition:background-color .38s ease,border-color .38s ease,color .38s ease,box-shadow .38s ease;
}
#menu .menu-btn:focus-visible,#songselect .header-back:focus-visible,#songselect .folder-import-btn:focus-visible,#songselect .resource-card:focus-visible{
 outline:2px solid rgba(91,177,207,.78);outline-offset:3px;
}
@media(prefers-reduced-motion:reduce){#leftPanel,#rightPanel,#leftPanel .panel-section,#rightPanel .panel-section,#rightPanel .survival-hud{transition:none!important;}}
body.reduce-motion #leftPanel,body.reduce-motion #rightPanel,body.reduce-motion #leftPanel .panel-section,body.reduce-motion #rightPanel .panel-section{transition:none!important;}
</style>

<script id="door-v174-theme-state">
/* Explicitly synchronize theme state with the selector, canvas renderer, preview and playfield panels.
   Does not alter judgment/input/audio/parser timing. */
(function(){
  function applyDoorTheme(){
    if(!document.body)return;
    const light=!!(typeof SETTINGS!=='undefined'&&SETTINGS.playTheme==='light');
    document.body.classList.toggle('play-theme-light',light);
    document.body.dataset.playTheme=light?'light':'dark';
    document.documentElement.dataset.playTheme=light?'light':'dark';
    const select=document.getElementById('playThemeSelect');
    if(select&&select.value!==(light?'light':'dark'))select.value=light?'light':'dark';
    const preview=document.getElementById('playThemePreview');
    if(preview){
      preview.dataset.theme=light?'light':'dark';
      const label=document.getElementById('playThemePreviewLabel');
      if(label)label.textContent=light?'明亮雨雾':'深色雨夜';
      preview.classList.remove('theme-enter');
      void preview.offsetWidth;
      preview.classList.add('theme-enter');
    }
    // resize() rebuilds the static lane canvas from SETTINGS.playTheme and re-evaluates the 4:3 gutters.
    if(typeof resize==='function'&&typeof vw!=='undefined'&&vw>0&&typeof vh!=='undefined'&&vh>0)resize();
    else if(typeof buildStaticPlayfield==='function')buildStaticPlayfield();
  }
  window.applyPlayTheme=applyDoorTheme;
  window.onPlayThemeChange=function(value){
    if(typeof SETTINGS==='undefined')return;
    SETTINGS.playTheme=value==='light'?'light':'dark';
    try{localStorage.setItem('rg_settings',JSON.stringify(SETTINGS));}catch(e){}
    applyDoorTheme();
  };
  // Reassert theme just before starting a chart so persisted settings can never be stale at entry.
  const originalStartGame=window.startGame;
  if(typeof originalStartGame==='function'){
    window.startGame=function(){applyDoorTheme();return originalStartGame.apply(this,arguments);};
  }
  applyDoorTheme();
})();
</script>

<style id="door-v176-rainlight-cinematic">
/* ============================================================
   v17.6 · RAINLIGHT CINEMATIC
   仅视觉层。判定、输入、时钟、音频与谱面解析逻辑保持不变；
   所有装饰层 pointer-events:none，且不覆盖游玩轨道、判定线与必要 HUD。
   ============================================================ */
:root{
  --rl-ink:#2F4A66;--rl-ink-soft:#5D7893;--rl-muted:#7E96AC;--rl-line:rgba(150,186,214,.42);
  --rl-ice:#8FD3EA;--rl-lilac:#A9A6E6;--rl-rose:#E3A6C6;--rl-mint:#8FD4C6;
  --rl-serif:Georgia,"Times New Roman","Songti SC","Noto Serif CJK SC",serif;
  --rl-ease:cubic-bezier(.19,.72,.22,1);--rl-soft:cubic-bezier(.4,0,.2,1);
}
html,body{background:#E9F1F8}
#bgCanvas{z-index:0;opacity:.92}

/* ---------- 1. 常驻环境层（L1：低强度、低干扰） ---------- */
.rl-ambient{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;contain:paint}
.rl-ambient *{pointer-events:none!important}
.rl-field{position:absolute;border-radius:50%;filter:blur(2px);will-change:transform,opacity}
.rl-field-ice{width:min(72vw,1040px);height:min(72vw,1040px);top:-30%;right:-14%;background:radial-gradient(circle,rgba(150,214,238,.30),rgba(184,224,242,.12) 38%,transparent 70%);animation:rlDriftA 27s ease-in-out infinite alternate}
.rl-field-lilac{width:min(66vw,940px);height:min(66vw,940px);bottom:-34%;left:-16%;background:radial-gradient(circle,rgba(198,190,240,.26),rgba(206,200,244,.09) 42%,transparent 70%);animation:rlDriftB 33s ease-in-out infinite alternate}
.rl-field-rose{width:min(48vw,660px);height:min(48vw,660px);top:34%;left:52%;background:radial-gradient(circle,rgba(233,182,214,.22),transparent 68%);animation:rlDriftC 39s ease-in-out infinite alternate}
.rl-ribbon{position:absolute;width:150vw;height:15vh;left:-24vw;border-radius:50%;border-top:1px solid rgba(255,255,255,.66);border-bottom:1px solid rgba(150,204,226,.16);will-change:transform,opacity}
.rl-ribbon-a{top:11%;transform:rotate(-16deg);opacity:.5;animation:rlRibbonA 24s ease-in-out infinite alternate}
.rl-ribbon-b{top:58%;height:19vh;transform:rotate(11deg);opacity:.32;animation:rlRibbonB 31s ease-in-out infinite alternate}
.rl-ribbon-c{top:82%;height:12vh;transform:rotate(-7deg);opacity:.24;animation:rlRibbonA 37s -9s ease-in-out infinite alternate-reverse}
.rl-rain{position:absolute;width:1px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.72),rgba(138,198,222,.20),transparent);transform:rotate(19deg);will-change:transform,opacity}
.rl-rain-a{left:14%;top:12%;height:180px;opacity:.5;animation:rlRain 13s ease-in-out infinite}
.rl-rain-b{left:83%;top:48%;height:220px;opacity:.42;animation:rlRain 18s -5s ease-in-out infinite}
.rl-rain-c{left:57%;top:2%;height:130px;opacity:.28;animation:rlRain 15s -8s ease-in-out infinite}
.rl-rain-d{left:36%;top:66%;height:150px;opacity:.34;animation:rlRain 21s -3s ease-in-out infinite}
.rl-waterline{position:absolute;left:6%;right:6%;bottom:8%;height:1px;background:linear-gradient(90deg,transparent,rgba(150,203,224,.5),rgba(230,190,216,.38),transparent);opacity:.62;animation:rlWater 11s ease-in-out infinite}
.rl-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 42%,transparent 52%,rgba(112,146,180,.13) 100%)}
@keyframes rlDriftA{0%{transform:translate3d(0,0,0) scale(1)}100%{transform:translate3d(-6%,6%,0) scale(1.12)}}
@keyframes rlDriftB{0%{transform:translate3d(0,0,0) scale(1)}100%{transform:translate3d(7%,-5%,0) scale(1.1)}}
@keyframes rlDriftC{0%{transform:translate3d(0,0,0) scale(.94);opacity:.7}100%{transform:translate3d(-8%,7%,0) scale(1.14);opacity:1}}
@keyframes rlRibbonA{0%{transform:translate3d(-3%,0,0) rotate(-16deg);opacity:.24}100%{transform:translate3d(5%,4%,0) rotate(-12deg);opacity:.58}}
@keyframes rlRibbonB{0%{transform:translate3d(3%,0,0) rotate(11deg);opacity:.18}100%{transform:translate3d(-5%,-4%,0) rotate(8deg);opacity:.46}}
@keyframes rlRain{0%,100%{transform:translate3d(0,-16px,0) rotate(19deg);opacity:.22}50%{transform:translate3d(-8px,22px,0) rotate(19deg);opacity:.64}}
@keyframes rlWater{0%,100%{transform:scaleX(.72);opacity:.3}50%{transform:scaleX(1);opacity:.66}}

/* ---------- 2. 页面容器：真正受视口约束，滚动可用 ---------- */
/* 修复：原先 #menu / #songselect 为常规流元素，高度随内容增长，
   overflow-y:auto 永不触发，超出部分被 body 裁掉且无法滚到。 */
#menu,#songselect{position:absolute;inset:0}
/* 注意：此处不得声明 display，否则 ID 优先级会覆盖 .screen{display:none}，令未激活页面持续拦截点击。 */
#menu{align-items:center;justify-content:center;overflow:auto;overflow-x:hidden}
#songselect{flex-direction:column;align-items:stretch;justify-content:flex-start;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;touch-action:pan-y}
#settings,#result{position:absolute;inset:0;overflow-y:auto;overscroll-behavior:contain}
#menu,#songselect,#settings,#result{background-color:transparent;background-image:none;color:var(--rl-ink)}
#game{z-index:2}

/* ---------- 3. 页面转场（L3：转场共鸣） ---------- */
.rl-transit{position:fixed;inset:0;z-index:60;display:grid;place-items:center;pointer-events:none;opacity:0;visibility:hidden;overflow:hidden;perspective:1000px}
.rl-transit.run{visibility:visible;animation:rlTransitFade 1.2s var(--rl-ease) both}
.rl-transit-wash{position:absolute;inset:-25%;opacity:0;background:radial-gradient(ellipse at center,#fff 0,rgba(238,246,255,.86) 18%,rgba(206,222,250,.44) 45%,transparent 72%);filter:blur(7px);transform:scale(.2)}
.rl-transit.run .rl-transit-wash{animation:rlWash 1.1s ease-out both}
.rl-transit-arch{position:absolute;width:min(38vw,470px);height:min(80vh,740px);border:1px solid #fff;border-radius:49% 49% 4% 4% / 32% 32% 1% 1%;box-shadow:0 0 0 1px rgba(157,185,232,.5),0 0 0 11px rgba(255,255,255,.32),0 0 0 23px rgba(192,207,245,.3),inset 0 0 50px rgba(255,255,255,.85),0 0 100px rgba(168,201,248,.7);opacity:0;transform:scale(.3) rotateY(16deg)}
.rl-transit.run .rl-transit-arch{animation:rlArch 1.18s var(--rl-ease) both}
.rl-transit-core{position:absolute;width:12vw;height:12vw;min-width:100px;min-height:100px;max-width:190px;max-height:190px;border-radius:50%;background:radial-gradient(circle,#fff 0,rgba(247,251,255,.94) 12%,rgba(220,233,255,.72) 31%,rgba(180,199,248,.33) 58%,transparent 72%);box-shadow:0 0 70px 30px rgba(255,255,255,.7);opacity:0;transform:scale(.5)}
.rl-transit.run .rl-transit-core{animation:rlCore 1s var(--rl-soft) both}
.rl-transit-sweep{position:absolute;top:-30%;bottom:-30%;left:-30%;width:14%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85) 42%,#fff 50%,rgba(216,231,255,.7) 58%,transparent);filter:blur(2px);opacity:0;transform:rotate(16deg) translateX(-100vw)}
.rl-transit.run .rl-transit-sweep{animation:rlSweep .85s .2s ease-in-out both}
.rl-transit-copy{position:relative;z-index:3;text-align:center;opacity:0;transform:translateY(10px)}
.rl-transit.run .rl-transit-copy{animation:rlCopy .7s .3s var(--rl-ease) both}
.rl-transit-copy b{display:block;font-family:var(--rl-serif);font-size:clamp(26px,3.4vw,46px);font-weight:400;letter-spacing:.06em;color:#3B5A7C;text-shadow:0 2px 22px rgba(255,255,255,.9)}
.rl-transit-copy span{display:block;margin-top:8px;font-size:9px;letter-spacing:.32em;color:#6F8CA6}
@keyframes rlTransitFade{0%,74%{opacity:1}100%{opacity:0}}
@keyframes rlWash{0%{opacity:0;transform:scale(.16)}26%{opacity:1}100%{opacity:0;transform:scale(1.75)}}
@keyframes rlArch{0%{opacity:0;transform:scale(.26) rotateY(22deg)}22%{opacity:1}70%{opacity:.92;transform:scale(1.34) rotateY(-4deg)}100%{opacity:0;transform:scale(2.7) rotateY(0)}}
@keyframes rlCore{0%{opacity:0;transform:scale(.1)}32%{opacity:1;transform:scale(1.18)}100%{opacity:0;transform:scale(3.3)}}
@keyframes rlSweep{0%{opacity:0;transform:rotate(16deg) translateX(-100vw)}22%{opacity:1}100%{opacity:0;transform:rotate(16deg) translateX(180vw)}}
@keyframes rlCopy{0%{opacity:0;transform:translateY(12px)}100%{opacity:1;transform:translateY(0)}}

/* ---------- 4. 主菜单：沿用 v17.4 门扉，仅增强动效 ---------- */
#menu .menu-content.door-home-stage{width:min(1400px,100%);height:min(840px,calc(100dvh - 24px));min-height:0;padding:58px clamp(18px,3.2vw,48px) 18px;grid-template-columns:minmax(0,.84fr) minmax(0,1.16fr);gap:8px clamp(10px,2.2vw,36px)}
#menu .menu-copy{max-width:520px}
#menu .brand-word{font-size:26px;font-weight:660;letter-spacing:.16em;text-transform:uppercase;color:#35536E}
#menu .menu-eyebrow{color:#5E86A3;font-weight:660;letter-spacing:.24em}
#menu .menu-copy h1{font-family:var(--rl-serif);font-weight:400;font-size:clamp(52px,5.6vw,88px);line-height:.98;letter-spacing:-.062em;margin:22px 0 22px;color:#28425F;-webkit-text-fill-color:#28425F;white-space:normal}
#menu .menu-copy h1 em{display:inline-block;font-style:italic;background:linear-gradient(108deg,#4E86BC 4%,#8B90D3 55%,#C488AC 96%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
#menu .menu-subtitle{max-width:400px;font-size:13.5px;line-height:2;letter-spacing:.04em;color:#63798F;margin-bottom:28px}
#menu .menu-actions{width:min(100%,372px);flex-direction:row;flex-wrap:wrap;gap:10px}
#menu .menu-actions .menu-btn{flex:1 1 160px;width:auto;height:50px;min-height:50px;border-radius:999px;justify-content:space-between;padding:0 18px;font-size:12px}
#menu .menu-btn.primary{color:#2E4E6E;background:linear-gradient(112deg,rgba(255,255,255,.94),rgba(238,246,255,.86) 62%,rgba(250,236,245,.84));border:1px solid #fff;box-shadow:0 10px 28px rgba(101,146,192,.14),inset 0 1px 0 #fff}
#menu .menu-btn.secondary{color:#546F89;background:rgba(255,255,255,.42);border:1px solid rgba(255,255,255,.82)}
#menu .menu-btn::after{content:"";position:absolute;top:-130%;bottom:-130%;left:-40%;width:26%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);transform:translateX(-220%) rotate(18deg);opacity:0;pointer-events:none;transition:transform .7s var(--rl-ease),opacity .3s}
#menu .menu-btn:hover::after{transform:translateX(660%) rotate(18deg);opacity:.9}
#menu .menu-hint{margin-top:34px}
#menu .key-hint-row kbd{background:rgba(255,255,255,.62);border-color:rgba(186,214,232,.7)}
/* 门扉：v17.4 原有 portal-art 结构，叠加呼吸、光流与视差 */
#menu .menu-visual{position:relative;min-height:0;height:100%;overflow:visible;border:0;background:transparent;box-shadow:none;backdrop-filter:none;isolation:isolate}
#menu .menu-visual::before{content:"";position:absolute;z-index:0;inset:4% -4% 6%;border-radius:50%;background:radial-gradient(ellipse at 50% 44%,rgba(255,255,255,.86),rgba(185,227,242,.32) 28%,rgba(208,200,241,.16) 52%,transparent 73%);animation:rlHaloBreathe 8.5s ease-in-out infinite alternate}
#menu .menu-visual::after{content:"";position:absolute;inset:4% 0 6%;z-index:0;border:0;border-radius:50%;background:radial-gradient(ellipse at 50% 96%,rgba(157,205,225,.26),transparent 54%)}
#menu .portal-art{position:relative;z-index:2;width:min(100%,660px);max-height:min(78vh,700px);transform-origin:50% 58%;filter:drop-shadow(0 20px 34px rgba(74,142,178,.15)) saturate(1.04);animation:rlPortalBreath 9s ease-in-out infinite;will-change:transform}
#menu .visual-halo{z-index:1;filter:blur(1px)}
#menu .halo-blue{width:330px;height:330px;top:6%;left:2%;background:radial-gradient(circle,rgba(120,212,238,.32),transparent 72%);animation:rlHaloGlide 15s ease-in-out infinite alternate}
#menu .halo-pink{width:320px;height:320px;right:2%;bottom:5%;background:radial-gradient(circle,rgba(232,164,204,.26),transparent 72%);animation:rlHaloGlide 18s -6s ease-in-out infinite alternate-reverse}
#menu .portal-orbit{width:min(80%,430px);aspect-ratio:1;height:auto}
#menu .orbit-one{border-color:rgba(118,191,216,.24);animation:rlOrbitA 56s linear infinite}
#menu .orbit-two{border-color:rgba(219,164,204,.24);animation:rlOrbitB 72s linear infinite}
#menu .portal-light-stream{position:absolute;z-index:2;left:7%;right:7%;height:1px;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.8),rgba(133,207,228,.38),rgba(237,186,214,.3),transparent)}
#menu .stream-a{top:23%;transform:rotate(-18deg);animation:rlStreamA 12s ease-in-out infinite}
#menu .stream-b{top:70%;transform:rotate(13deg);opacity:.5;animation:rlStreamB 15s ease-in-out infinite}
#menu .floating-chip{background:rgba(255,255,255,.6);border-color:rgba(255,255,255,.92);color:#6C8AA0;box-shadow:0 8px 24px rgba(94,142,172,.09);animation:rlChipFloat 7s ease-in-out infinite}
#menu .chip-bottom{animation-duration:8.6s;animation-direction:alternate-reverse}
#menu .portal-waterline{position:absolute;z-index:1;left:12%;right:12%;height:15%;border-top:1px solid rgba(129,193,216,.3);border-radius:50%;pointer-events:none;transform:scaleX(.75)}
#menu .waterline-a{bottom:12%;animation:rlWater 7s ease-in-out infinite}
#menu .waterline-b{bottom:9%;left:23%;right:23%;opacity:.3;animation:rlWater 7s -2.4s ease-in-out infinite}
#menu .portal-stage-floor{position:absolute;z-index:1;left:13%;right:13%;bottom:15%;height:6%;border-radius:50%;background:radial-gradient(ellipse,rgba(111,182,209,.28),rgba(198,176,215,.11) 42%,transparent 72%);animation:rlFloorPulse 8s ease-in-out infinite}
#menu .visual-caption{bottom:2%;color:#7A97B1;letter-spacing:.2em}
@keyframes rlPortalBreath{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-8px) scale(1.012)}}
@keyframes rlHaloBreathe{0%{transform:scale(.94);opacity:.62}100%{transform:scale(1.07);opacity:1}}
@keyframes rlHaloGlide{0%{transform:translate3d(-7px,5px,0) scale(.95)}100%{transform:translate3d(10px,-7px,0) scale(1.08)}}
@keyframes rlOrbitA{0%{transform:rotate(-24deg) scaleX(.72)}100%{transform:rotate(336deg) scaleX(.72)}}
@keyframes rlOrbitB{0%{transform:rotate(38deg) scaleX(.9) scaleY(.88)}100%{transform:rotate(-322deg) scaleX(.9) scaleY(.88)}}
@keyframes rlStreamA{0%,100%{transform:translateX(-4%) rotate(-18deg);opacity:.2}50%{transform:translateX(5%) rotate(-16deg);opacity:.66}}
@keyframes rlStreamB{0%,100%{transform:translateX(3%) rotate(13deg);opacity:.16}50%{transform:translateX(-5%) rotate(10deg);opacity:.5}}
@keyframes rlChipFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes rlFloorPulse{0%,100%{transform:scaleX(.78);opacity:.5}50%{transform:scaleX(1);opacity:.84}}

/* ---------- 5. 选曲页：列表 / 曲绘 / 工具 三区，PC 宽屏优先 ---------- */
#songselect{padding:14px clamp(14px,2.4vw,36px) 22px}
#songselect .song-page-shell.door-library-workspace{width:min(1560px,100%);margin:0 auto;display:flex;flex-direction:column;gap:clamp(13px,1.7vw,22px);padding:0;border:0;background:transparent;box-shadow:none;backdrop-filter:none}
#songselect .page-header{min-height:48px;padding:0 2px 13px;border-bottom:1px solid rgba(158,192,216,.44)}
#songselect .header-back{border-radius:999px;border:1px solid rgba(160,197,218,.6);background:rgba(255,255,255,.5);color:#5E7E97;min-height:37px;padding:8px 15px;transition:transform .28s var(--rl-ease),background .28s,border-color .28s}
#songselect .header-back:hover{transform:translateX(-3px);background:rgba(255,255,255,.84);border-color:rgba(116,182,208,.8)}
#songselect .mini-brand{color:#3B5E76;font-size:19px;letter-spacing:-.045em}
#songselect .mini-brand-mark{width:31px;height:31px;border-radius:11px;background:linear-gradient(138deg,#BDECF8,#D8D0F0 64%,#F0CFE0);color:#417792;box-shadow:0 5px 14px rgba(114,174,198,.12),inset 0 1px 0 rgba(255,255,255,.85)}
#songselect .header-note{font-size:8px;letter-spacing:.21em;color:#93A9B8}
#songselect .library-hero-wrap{position:relative;display:flex;align-items:center;min-height:92px;padding:2px 10px 2px;overflow:hidden}
#songselect .library-hero-orbit{position:absolute;right:4%;top:-120px;width:310px;height:310px;border-radius:50%;border:1px solid rgba(146,199,219,.28);box-shadow:0 0 0 24px rgba(255,255,255,.09),0 0 0 58px rgba(180,218,234,.06);animation:rlOrbitA 34s linear infinite}
#songselect .library-intro{position:relative;z-index:1;width:100%;display:flex;align-items:center;justify-content:space-between;gap:22px;margin:0}
#songselect .library-intro h2{font-family:var(--rl-serif);font-weight:400;font-size:clamp(34px,3.9vw,54px);line-height:1;letter-spacing:-.06em;color:#2E4B63;margin-top:6px}
#songselect .library-intro h2 span{font-style:italic;color:#63AECD}
#songselect .library-intro p{margin-top:11px;font-size:12px;line-height:1.8;color:#748DA1}
#songselect .library-count{border-radius:999px;padding:10px 15px;border:1px solid rgba(164,200,220,.5);background:rgba(255,255,255,.55);box-shadow:0 10px 26px rgba(103,150,174,.07),inset 0 1px 0 rgba(255,255,255,.8)}
#songselect .count-mark{background:linear-gradient(140deg,rgba(190,234,246,.82),rgba(224,215,242,.78));color:#5AA2BE}
#songselect .library-hero-note{opacity:.36}
#songselect .library-layout{position:relative;display:grid;grid-template-columns:minmax(272px,336px) minmax(330px,1fr) minmax(238px,292px);gap:clamp(12px,1.5vw,20px);align-items:stretch}
#songselect .library-main{min-width:0;display:flex;flex-direction:column;padding:16px 13px;border:1px solid rgba(255,255,255,.78);border-radius:22px;background:linear-gradient(150deg,rgba(255,255,255,.74),rgba(244,249,255,.56) 58%,rgba(250,241,248,.5));box-shadow:0 18px 44px rgba(84,134,161,.075);backdrop-filter:blur(18px) saturate(110%)}
#songselect .library-section-title{align-items:flex-start;margin-bottom:13px}
#songselect .library-section-title h3{font-family:var(--rl-serif);font-size:19px;font-weight:400;color:#35536C;letter-spacing:-.02em}
#songselect .library-section-title p{margin-top:4px;font-size:9px;color:#849BAE;line-height:1.7}
#songselect .section-index{font-size:9px;letter-spacing:.18em;color:#9CB2C0}
#songselect .drop-zone{position:relative;min-height:78px;display:grid;grid-template-columns:38px minmax(0,1fr);grid-template-rows:auto auto;align-content:center;column-gap:11px;row-gap:2px;padding:12px 14px;border-radius:15px;border:1px dashed rgba(117,183,209,.7);background:linear-gradient(100deg,rgba(240,250,254,.86),rgba(244,241,251,.7) 70%,rgba(255,244,249,.64));transition:transform .3s var(--rl-ease),border-color .3s,background .3s,box-shadow .3s;cursor:pointer}
#songselect .drop-zone::after{display:none}
#songselect .drop-zone:hover,#songselect .drop-zone.drag{transform:translateY(-2px);border-color:rgba(74,166,201,.9);background:linear-gradient(100deg,rgba(233,248,253,.98),rgba(241,236,250,.86) 70%,rgba(255,241,248,.86));box-shadow:0 10px 24px rgba(95,164,192,.12),inset 0 1px 0 #fff}
#songselect .upload-icon{grid-row:1/3;width:37px;height:37px;border-radius:12px;background:linear-gradient(145deg,#DDF4FB,#EAE2F5 72%,#F8E6F0);color:#5896B2;font-size:20px}
#songselect .upload-main{align-self:end;font-size:12px;color:#43667E;font-weight:700}
#songselect .upload-main b{margin-left:5px;padding:2px 6px;border:1px solid rgba(154,196,216,.44);border-radius:6px;color:#5FA5BF;background:rgba(255,255,255,.6);font-size:8px}
#songselect .upload-sub{align-self:start;font-size:9px;color:#849BA9;line-height:1.55}
#songselect .folder-import-row{margin:9px 0 15px;gap:9px}
#songselect .folder-import-btn{border-radius:11px;background:rgba(255,255,255,.56);border:1px solid rgba(159,198,217,.55);color:#5F7F97;min-height:33px;padding:7px 11px;font-size:10px;transition:transform .26s var(--rl-ease),background .26s,border-color .26s}
#songselect .folder-import-btn:hover{transform:translateY(-1px);background:rgba(255,255,255,.9);border-color:#91C8DD}
#songselect .folder-import-note{font-size:9px;color:#93A7B4}
#songselect .song-list{flex:1;min-height:120px;max-height:min(54vh,470px);overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:9px;padding-right:5px;scrollbar-width:thin;scrollbar-color:rgba(150,186,214,.75) transparent}
#songselect .song-list::-webkit-scrollbar{width:7px}
#songselect .song-list::-webkit-scrollbar-thumb{background:rgba(150,186,214,.6);border-radius:99px}
#songselect .song-card{position:relative;overflow:hidden;display:flex;align-items:center;gap:12px;min-height:66px;padding:11px 12px;border:1px solid rgba(166,200,218,.5);border-radius:15px;background:rgba(255,255,255,.56);box-shadow:0 3px 12px rgba(88,139,163,.035);transition:transform .3s var(--rl-ease),border-color .3s,background .3s,box-shadow .3s}
#songselect .song-card::before{content:"♪";flex:0 0 34px;height:34px;display:grid;place-items:center;border-radius:11px;color:#5FA3BF;font-size:15px;background:linear-gradient(145deg,rgba(200,239,248,.82),rgba(225,218,244,.76) 67%,rgba(248,222,236,.72));border:1px solid rgba(177,212,228,.4)}
#songselect .song-card::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,.62) 50%,transparent 62%);transform:translateX(-40%);transition:opacity .3s,transform .75s var(--rl-ease)}
#songselect .song-card:hover{transform:translateY(-2px);border-color:rgba(126,188,214,.8);background:rgba(255,255,255,.84);box-shadow:0 11px 25px rgba(83,143,171,.1)}
#songselect .song-card:hover::after{opacity:1;transform:translateX(40%)}
#songselect .song-card.selected{border-color:rgba(103,179,208,.85);background:linear-gradient(108deg,rgba(232,248,253,.96),rgba(240,235,250,.86) 72%,rgba(251,236,245,.8));box-shadow:inset 3px 0 0 rgba(101,184,212,.8),0 11px 26px rgba(94,155,181,.11)}
#songselect .song-card .info{flex:1;min-width:0}
#songselect .song-card .title{color:#3A5A70;font-size:12.5px;font-weight:720;line-height:1.45;overflow-wrap:anywhere}
#songselect .song-card .artist{margin-top:4px;color:#8AA0AF;font-size:9px;line-height:1.55}
#songselect .song-card .diff{gap:4px;flex-wrap:wrap;margin-left:6px}
#songselect .song-card .diff-tag{border-radius:999px;font-size:8px;padding:4px 7px}
#songselect .song-difficulty-expand{display:flex;flex-wrap:wrap;gap:7px;padding:9px 11px 12px 58px;animation:rlRise .4s var(--rl-ease) both}
#songselect .diff-btn{border-radius:999px;min-height:35px;padding:8px 13px;font-size:11px;transition:transform .26s var(--rl-ease),box-shadow .26s,background .26s}
#songselect .diff-btn:hover{transform:translateY(-2px);box-shadow:0 7px 17px rgba(94,150,178,.12)}
#songselect .empty-library{min-height:180px;padding:20px 12px;border-radius:18px}
#songselect .empty-library .empty-note{width:46px;height:46px;border-radius:16px;font-size:20px;margin-bottom:11px;animation:rlChipFloat 6s ease-in-out infinite}
#songselect .empty-library>p{font-size:10px}
/* 曲绘舞台 */
.track-stage{position:relative;min-width:0;display:flex;flex-direction:column;padding:16px clamp(15px,2vw,28px) 20px;border:1px solid rgba(255,255,255,.82);border-radius:22px;background:linear-gradient(152deg,rgba(255,255,255,.66),rgba(238,247,255,.5) 56%,rgba(251,241,248,.46));box-shadow:0 20px 48px rgba(84,134,161,.085);overflow:hidden;backdrop-filter:blur(20px) saturate(112%)}
.track-stage::before{content:"";position:absolute;top:-34%;left:8%;width:84%;height:62%;border-radius:50%;background:radial-gradient(ellipse,rgba(255,255,255,.7),transparent 68%);pointer-events:none;animation:rlHaloBreathe 9s ease-in-out infinite alternate}
.stage-heading{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;font-size:8.5px;font-weight:660;letter-spacing:.2em;color:#6485A1}
.stage-heading-mark{font-size:17px;color:#AC90C4;font-weight:300;animation:rlChipFloat 5.5s ease-in-out infinite}
.cover-frame{position:relative;z-index:1;width:min(100%,344px);aspect-ratio:1.26/1;margin:9px auto 13px;border:1px solid rgba(255,255,255,.9);border-radius:5px 5px 28px 5px;overflow:hidden;background:linear-gradient(135deg,#9CCDE4,#AFC6E9 48%,#D9B6DD);box-shadow:0 24px 48px rgba(85,113,158,.28),inset 0 1px 0 #fff;transform:rotate(1.4deg);translate:calc(var(--rl-px,0)*7px) calc(var(--rl-py,0)*7px);transition:transform .6s var(--rl-ease),box-shadow .6s,translate .4s ease-out}
.cover-frame:hover{transform:rotate(.4deg) translateY(-4px);box-shadow:0 30px 58px rgba(85,113,158,.34),inset 0 1px 0 #fff}
.cover-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.04);animation:rlCoverDrift 26s ease-in-out infinite alternate}
.cover-fallback{position:absolute;inset:0}
.cover-halo{position:absolute;inset:-18%;background:radial-gradient(circle at 74% 16%,rgba(255,255,255,.8) 1%,transparent 38%),radial-gradient(circle at 26% 88%,rgba(255,255,255,.5),transparent 50%)}
.cover-orbit{position:absolute;width:74%;height:108%;left:13%;top:-14%;border:1px solid rgba(255,255,255,.72);border-radius:50%;box-shadow:0 0 0 18px rgba(255,255,255,.1),0 0 26px rgba(255,255,255,.4);transform:rotate(-24deg);animation:rlOrbitA 44s linear infinite}
.cover-door{position:absolute;width:38%;height:74%;left:31%;top:14%;border:1px solid rgba(255,255,255,.88);border-radius:49% 49% 2% 2% / 30% 30% 1% 1%;background:linear-gradient(95deg,rgba(255,255,255,.5),rgba(243,246,255,.16) 39%,rgba(255,255,255,.5));box-shadow:inset 0 0 30px rgba(255,255,255,.6),0 0 30px rgba(255,255,255,.55)}
.cover-door::before{content:"";position:absolute;inset:9px;border:1px solid rgba(255,255,255,.6);border-radius:inherit}
.cover-door i{position:absolute;top:7%;bottom:5%;left:50%;width:1px;background:linear-gradient(transparent,#fff,rgba(255,255,255,.4),transparent);box-shadow:0 0 12px #fff}
.cover-wordmark{position:absolute;left:20px;bottom:20px;font-family:var(--rl-serif);font-size:clamp(28px,3vw,46px);line-height:.96;letter-spacing:-.06em;color:#fff;text-shadow:0 2px 18px rgba(69,95,138,.6)}
.cover-sheen{position:absolute;inset:-40%;pointer-events:none;transform:rotate(20deg);background:linear-gradient(90deg,transparent 46%,rgba(255,255,255,.34) 50%,transparent 54%);animation:rlSheen 7.5s ease-in-out infinite}
.cover-frame-line{position:absolute;inset:10px;border:1px solid rgba(255,255,255,.62);pointer-events:none}
.cover-badge{position:absolute;z-index:2;right:12px;top:12px;padding:4px 8px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(30,52,78,.32);color:#fff;font-size:7.5px;letter-spacing:.14em;backdrop-filter:blur(6px)}
.cover-frame.has-art .cover-badge{background:rgba(30,52,78,.42)}
.stage-info{position:relative;z-index:1;display:flex;flex-direction:column;min-width:0;flex:1}
.stage-eyebrow{font-size:8px;letter-spacing:.18em;color:#7291A9}
.stage-eyebrow span{color:#AA8AC2;margin:0 5px}
.stage-info h3{font-family:var(--rl-serif);font-weight:400;font-size:clamp(23px,2.3vw,36px);line-height:1.16;letter-spacing:-.04em;margin:8px 0 5px;color:#2E4A68;overflow-wrap:anywhere}
.stage-info p{color:#67809A;font-size:11px;line-height:1.65}
.stage-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:12px 0;margin:14px 0 10px;border-top:1px solid rgba(178,201,222,.5);border-bottom:1px solid rgba(178,201,222,.5)}
.stage-facts div{display:flex;flex-direction:column;gap:4px;min-width:0}
.stage-facts small{font-size:8px;letter-spacing:.13em;color:#7C93A9}
.stage-facts b{font-size:14px;font-weight:560;color:#334E6E;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stage-choice-label{display:flex;justify-content:space-between;gap:10px;font-size:8px;letter-spacing:.15em;color:#738BA4;margin-bottom:8px}
.stage-difficulties{display:flex;gap:7px;flex-wrap:wrap;min-height:32px}
.stage-diff{min-height:32px;padding:7px 11px;border:1px solid #C7D7E7;border-radius:999px;background:rgba(255,255,255,.72);color:#5C7693;font-size:10px;cursor:pointer;transition:background .22s,transform .22s var(--rl-ease),border-color .22s,box-shadow .22s}
.stage-diff:hover{transform:translateY(-2px);border-color:#7BAED3;box-shadow:0 6px 15px rgba(105,160,196,.14)}
.stage-diff.selected{background:linear-gradient(110deg,#D6EDFB,#E6E2F8 66%,#F7E6F0);color:#2C5B82;border-color:#86BEDB;box-shadow:0 4px 14px rgba(107,166,203,.2)}
.stage-empty{color:#8196A9;font-size:10px;line-height:2.1}
.stage-play{position:relative;overflow:hidden;width:100%;height:46px;margin-top:16px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;border:1px solid #A3C7E0;border-radius:999px;background:linear-gradient(110deg,#DBEEFC,#EAE3F9 63%,#F7E3ED);color:#325473;font-size:12px;font-weight:660;cursor:pointer;box-shadow:0 9px 22px rgba(114,155,192,.22);transition:transform .26s var(--rl-ease),box-shadow .26s}
.stage-play::after{content:"";position:absolute;top:-130%;bottom:-130%;left:-40%;width:26%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.75),transparent);transform:translateX(-220%) rotate(18deg);opacity:0;transition:transform .7s var(--rl-ease),opacity .3s}
.stage-play:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 13px 28px rgba(114,155,192,.3)}
.stage-play:hover:not(:disabled)::after{transform:translateX(660%) rotate(18deg);opacity:.95}
.stage-play:disabled{cursor:not-allowed;opacity:.5;box-shadow:none}
/* 侧栏工具 */
#songselect .library-aside{position:relative;display:flex;flex-direction:column;gap:11px;min-width:0;padding:16px 13px;border:1px solid rgba(255,255,255,.78);border-radius:22px;background:linear-gradient(155deg,rgba(252,254,255,.72),rgba(241,248,252,.54) 67%,rgba(249,242,248,.5));box-shadow:0 18px 42px rgba(84,134,161,.065);overflow:hidden;backdrop-filter:blur(16px) saturate(108%)}
#songselect .library-aside::before{content:"";position:absolute;right:-100px;top:-136px;width:270px;height:270px;border-radius:50%;border:1px solid rgba(168,209,226,.28);box-shadow:0 0 0 22px rgba(255,255,255,.08),0 0 0 49px rgba(176,215,231,.05);pointer-events:none;animation:rlOrbitA 52s linear infinite}
#songselect .library-aside>*{position:relative;z-index:1}
#songselect .play-mode-bar.mode-workspace-card{display:flex;flex-direction:column;align-items:stretch;gap:11px;padding:2px 0 15px;margin:0 0 2px;border:0;border-bottom:1px solid rgba(164,199,217,.44);border-radius:0;background:transparent;box-shadow:none}
#songselect .play-mode-icon{width:34px;height:34px;border-radius:12px;background:linear-gradient(145deg,#DDF3FA,#E8E2F6 73%,#F8E6F0);color:#5FA5C1}
#songselect .play-mode-copy b{font-size:12px;color:#3F6279}
#songselect .play-mode-copy small{font-size:9px;color:#879EAE}
#songselect .play-mode-segment{display:grid;grid-template-columns:1fr 1fr;gap:4px;width:100%;padding:4px;border-radius:14px;border:1px solid rgba(161,198,217,.48);background:rgba(228,240,247,.5)}
#songselect .play-mode-option{min-width:0;min-height:38px;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 10px;border:1px solid transparent;border-radius:11px;background:transparent;color:#8098A9;font-size:10px;font-weight:660;transition:background .3s,border-color .3s,color .3s,box-shadow .3s,transform .3s var(--rl-ease)}
#songselect .play-mode-option.selected{background:rgba(255,255,255,.9);border-color:rgba(167,207,224,.5);color:#4C7F99;box-shadow:0 4px 13px rgba(83,141,168,.1),inset 0 1px 0 #fff}
#songselect .play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,rgba(218,243,250,.94),rgba(238,227,247,.86) 70%,rgba(250,231,241,.82));color:#96708F}
#songselect .play-mode-description{font-size:9px;color:#879EAE;line-height:1.7;text-align:left}
#songselect .library-aside .library-section-title h3{font-family:var(--rl-serif);font-size:17px;font-weight:400}
#songselect .resource-card{padding:10px 9px;border-radius:13px;border:1px solid rgba(163,199,217,.46);background:rgba(255,255,255,.5);transition:transform .28s var(--rl-ease),background .28s,border-color .28s,box-shadow .28s}
#songselect .resource-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.84);border-color:rgba(125,187,213,.72);box-shadow:0 10px 22px rgba(84,145,171,.1)}
#songselect .resource-text b{font-size:10px}#songselect .resource-text small{font-size:8px;line-height:1.55}
#songselect .resource-tip{font-size:9px;line-height:1.7}
#songselect .page-footer{border-top:1px solid rgba(163,198,216,.4);color:#93A8B5;font-size:7px;letter-spacing:.17em}
/* 选曲页入场：分层错峰 */
#songselect.active .page-header{animation:rlRise .6s var(--rl-ease) both}
#songselect.active .library-hero-wrap{animation:rlRise .7s .05s var(--rl-ease) both}
#songselect.active .library-main{animation:rlPanelIn .74s .1s var(--rl-ease) both}
#songselect.active .track-stage{animation:rlPanelIn .78s .16s var(--rl-ease) both}
#songselect.active .library-aside{animation:rlPanelIn .82s .22s var(--rl-ease) both}
#songselect.active .page-footer{animation:rlRise .6s .26s var(--rl-ease) both}
@keyframes rlRise{from{opacity:0;transform:translateY(11px)}to{opacity:1;transform:translateY(0)}}
@keyframes rlPanelIn{from{opacity:0;transform:translateY(15px) scale(.994)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes rlCoverDrift{0%{transform:scale(1.04) translate3d(0,0,0)}100%{transform:scale(1.12) translate3d(-1.6%,-1.6%,0)}}
@keyframes rlSheen{0%,58%{transform:rotate(20deg) translateX(-52%);opacity:0}72%{opacity:1}100%{transform:rotate(20deg) translateX(52%);opacity:0}}

/* ---------- 6. 设置页 ---------- */
#settings{padding:26px 18px;align-items:center}
#settings .settings-panel{width:min(920px,100%);max-width:920px;margin:auto;padding:clamp(20px,3vw,40px);border:1px solid rgba(255,255,255,.86);border-radius:24px;background:linear-gradient(148deg,rgba(255,255,255,.82),rgba(242,249,253,.68) 60%,rgba(251,243,249,.62));box-shadow:0 26px 62px rgba(88,132,162,.13);backdrop-filter:blur(22px) saturate(112%)}
.settings-intro{padding:2px 0 20px;margin-bottom:6px;border-bottom:1px solid rgba(178,201,222,.5)}
.settings-kicker{display:block;font-size:9px;letter-spacing:.22em;color:#6B90AC}
#settings .settings-intro h2{font-family:var(--rl-serif);font-weight:400;font-size:clamp(30px,3.6vw,48px);line-height:1.18;letter-spacing:-.05em;margin:8px 0;color:#2E4A66}
#settings .settings-intro h2 span{font-style:italic;color:#8896CE}
.settings-intro p{color:#698199;font-size:11px;line-height:1.75}
#settings .setting-item{padding:13px 0 11px;border-bottom:1px solid rgba(178,201,222,.36)}
#settings .setting-item label{color:#45637D;font-size:12px;font-weight:660}
#settings .setting-item select{color:#3B5F79;border-color:rgba(159,198,218,.6);border-radius:12px;background:rgba(255,255,255,.82)}
#settings .quality-hint{color:#879EAF}
#settings .settings-panel>.menu-btn{margin-top:14px;border-radius:999px;background:linear-gradient(112deg,rgba(255,255,255,.94),rgba(236,245,255,.88));border:1px solid #fff;color:#35567A;box-shadow:0 9px 24px rgba(101,146,192,.14)}
#settings.active .settings-panel{animation:rlPanelIn .62s var(--rl-ease) both}
#settings.active .setting-item{animation:rlRise .5s var(--rl-ease) both}
#settings.active .setting-item:nth-child(1){animation-delay:.03s}#settings.active .setting-item:nth-child(2){animation-delay:.05s}#settings.active .setting-item:nth-child(3){animation-delay:.07s}#settings.active .setting-item:nth-child(4){animation-delay:.09s}#settings.active .setting-item:nth-child(5){animation-delay:.11s}#settings.active .setting-item:nth-child(6){animation-delay:.13s}#settings.active .setting-item:nth-child(7){animation-delay:.15s}#settings.active .setting-item:nth-child(8){animation-delay:.17s}#settings.active .setting-item:nth-child(9){animation-delay:.19s}#settings.active .setting-item:nth-child(10){animation-delay:.21s}#settings.active .setting-item:nth-child(11){animation-delay:.23s}#settings.active .setting-item:nth-child(12){animation-delay:.25s}#settings.active .setting-item:nth-child(13){animation-delay:.27s}#settings.active .setting-item:nth-child(14){animation-delay:.29s}#settings.active .setting-item:nth-child(15){animation-delay:.31s}#settings.active .setting-item:nth-child(16){animation-delay:.33s}#settings.active .setting-item:nth-child(17){animation-delay:.35s}

/* ---------- 7. 结算页（L4：重要结果节点） ---------- */
#result{padding:22px 16px 30px;align-items:center}
#result .result-wrap{width:min(1020px,100%);margin:auto 0;display:flex;flex-direction:column;gap:13px}
#result .result-heading{border-bottom:1px solid rgba(168,198,220,.5);padding:8px 4px 15px}
#result .result-kicker{color:#5E85A2;font-size:9.5px;letter-spacing:.22em}
#result .result-hero{position:relative;overflow:hidden;min-height:158px;border:1px solid rgba(255,255,255,.86);border-radius:20px;background:linear-gradient(118deg,rgba(255,255,255,.86),rgba(240,247,255,.8) 62%,rgba(248,240,249,.78));box-shadow:0 18px 44px rgba(96,138,172,.13)}
#result .result-hero::before{content:"";position:absolute;inset:-30% -10%;background:radial-gradient(ellipse at 50% 40%,rgba(255,255,255,.72),transparent 62%);pointer-events:none;animation:rlHaloBreathe 7s ease-in-out infinite alternate}
#result .result-rank{position:relative;z-index:1;font-family:var(--rl-serif);font-weight:400;font-size:clamp(74px,8.6vw,116px);letter-spacing:-.09em;text-shadow:none!important;animation:rlRankIn .9s var(--rl-ease) both}
#result .result-song-title{font-family:var(--rl-serif);font-weight:400;font-size:clamp(23px,2.8vw,37px);color:#2E4A68}
#result .result-song-artist,#result .result-judge-label{color:#657E96}
#result .result-metric{border:1px solid rgba(255,255,255,.8);background:rgba(255,255,255,.7);box-shadow:0 6px 18px rgba(116,154,176,.08);backdrop-filter:blur(10px)}
#result .result-metric .m-label{color:#647F98}
#result .result-section{border:1px solid rgba(255,255,255,.74);background:rgba(255,255,255,.56);box-shadow:0 6px 20px rgba(96,138,172,.07);backdrop-filter:blur(12px)}
#result .result-judgegrid .result-judgecell{background:#EEF5FB;border:1px solid #D8E7F2;border-radius:12px}
#result .result-detail{background:rgba(240,245,250,.9)}
#result.active .result-heading{animation:rlRise .55s var(--rl-ease) both}
#result.active .result-hero{animation:rlPanelIn .7s .06s var(--rl-ease) both}
#result.active .result-metric{animation:rlRise .5s var(--rl-ease) both}
#result.active .result-metric:nth-child(1){animation-delay:.16s}#result.active .result-metric:nth-child(2){animation-delay:.2s}#result.active .result-metric:nth-child(3){animation-delay:.24s}#result.active .result-metric:nth-child(4){animation-delay:.28s}
#result.active .result-section{animation:rlRise .55s var(--rl-ease) both}
#result.active .result-section:nth-of-type(1){animation-delay:.3s}#result.active .result-section:nth-of-type(2){animation-delay:.34s}#result.active .result-section:nth-of-type(3){animation-delay:.38s}
#result.active .result-actions{animation:rlRise .5s .42s var(--rl-ease) both}
@keyframes rlRankIn{0%{opacity:0;transform:scale(.72) rotate(-6deg);filter:blur(6px)}60%{opacity:1;filter:blur(0)}100%{opacity:1;transform:scale(1) rotate(0)}}

/* ---------- 8. 游玩界面：只改侧栏与 HUD，不触碰轨道、音符与判定线 ---------- */
#leftPanel,#rightPanel{background:linear-gradient(158deg,rgba(14,26,44,.94),rgba(18,32,52,.96));border-color:rgba(163,196,229,.16);color:#E4EEFA}
#leftPanel .panel-section,#rightPanel .panel-section{position:relative;overflow:hidden;background:rgba(219,234,250,.045);border:1px solid rgba(191,213,238,.14);border-radius:16px}
#leftPanel .panel-section::after,#rightPanel .panel-section::after{content:"";position:absolute;top:0;left:-45%;width:40%;height:100%;background:linear-gradient(90deg,transparent,rgba(190,225,255,.13),transparent);transform:translateX(-140%);animation:rlPanelSweep 9s ease-in-out infinite}
#leftPanel .panel-title,#rightPanel .panel-title{color:#8FAEC9;letter-spacing:.16em;font-size:9px}
#leftPanel .panel-score-value,#rightPanel .panel-song-title{font-family:var(--rl-serif);font-weight:400;color:#EEF4FF}
#rightPanel .panel-song-artist{color:#9BB2CA}
#gameHUD .hud-pill-center{background:transparent;border:0;box-shadow:none;backdrop-filter:none;padding:6px 14px}
#gameHUD .hud-combo{font-family:var(--rl-serif);font-weight:400;font-size:clamp(31px,3vw,45px);color:#F2F2FF;text-shadow:0 0 18px rgba(191,216,255,.62)}
#gameHUD .hud-combo-label{color:#B1C6DF;letter-spacing:.33em;font-size:9px}
.game-controls .hud-icon-btn,.game-controls .mode-btn{background:rgba(29,48,74,.79);border:1px solid rgba(210,228,255,.3);color:#E7F3FF;box-shadow:0 5px 17px rgba(7,20,37,.42);transition:transform .24s var(--rl-ease),background .24s,border-color .24s}
.game-controls .hud-icon-btn:hover,.game-controls .mode-btn:hover{transform:translateY(-2px);background:rgba(45,70,104,.9);border-color:rgba(140,206,236,.6)}
#pauseOverlay{background:rgba(9,18,33,.74);backdrop-filter:blur(11px)}
#pauseOverlay h2{font-family:var(--rl-serif);font-weight:400;font-size:38px;letter-spacing:.02em;color:#F1F6FF}
#pauseOverlay .menu-btn{border-radius:999px;background:rgba(247,250,255,.9);color:#36536D}
body.play-theme-light #leftPanel,body.play-theme-light #rightPanel{background:linear-gradient(158deg,rgba(234,244,251,.95),rgba(243,249,253,.94));color:#35546C;border-color:rgba(171,197,215,.6)}
body.play-theme-light #leftPanel .panel-section,body.play-theme-light #rightPanel .panel-section{background:rgba(255,255,255,.68);border-color:rgba(184,208,224,.62)}
body.play-theme-light #leftPanel .panel-title,body.play-theme-light #rightPanel .panel-title{color:#567B96}
body.play-theme-light #leftPanel .panel-score-value,body.play-theme-light #rightPanel .panel-song-title{color:#324B67}
body.play-theme-light #rightPanel .panel-song-artist{color:#617E96}
@keyframes rlPanelSweep{0%,72%{transform:translateX(-140%);opacity:0}82%{opacity:1}100%{transform:translateX(340%);opacity:0}}

/* ---------- 9. 自适应 ---------- */
@media(max-width:1240px){
  #songselect .library-layout{grid-template-columns:minmax(252px,308px) minmax(300px,1fr)}
  #songselect .library-aside{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:12px}
  #songselect .library-aside .play-mode-bar.mode-workspace-card,#songselect .library-aside .library-section-title,#songselect .library-aside .resource-tip,#songselect .library-aside .library-aside-footer{grid-column:1/-1}
}
@media(max-width:880px){
  #menu .menu-content.door-home-stage{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto;grid-template-areas:"copy" "portal" "footer";height:auto;max-height:none;min-height:0;padding:44px 8px 14px;gap:10px}
  #menu .menu-copy{max-width:none;padding:4px 4px 0}
  #menu .menu-copy h1{font-size:clamp(42px,10vw,64px);margin:18px 0}
  #menu .menu-visual{height:min(58vh,420px);min-height:300px}
  #songselect .library-layout{grid-template-columns:minmax(0,1fr)}
  #songselect .library-aside{grid-column:auto;display:flex;flex-direction:column}
  #songselect .song-list{max-height:340px}
  .cover-frame{width:min(100%,330px)}
  #songselect{padding:10px 12px 20px}
}
@media(max-width:520px){
  #menu{padding:12px}
  #menu .menu-actions{width:100%}
  #menu .menu-actions .menu-btn{flex:1 1 100%}
  #menu .menu-visual{height:min(52vh,340px);min-height:260px}
  #songselect .library-intro{align-items:flex-start;flex-direction:column}
  #songselect .library-hero-note{display:none}
  #songselect .page-header{flex-wrap:wrap;gap:8px}
  .track-stage{padding:14px 13px 17px}
  .cover-frame{width:min(100%,280px)}
  .stage-info h3{font-size:26px}
  #result .result-hero{grid-template-columns:82px 1fr;gap:10px;padding:14px}
  #result .result-rank{font-size:70px}
  #settings{padding:14px 10px}
}
@media(max-height:760px) and (min-width:881px){
  #menu .menu-content.door-home-stage{height:calc(100dvh - 20px);padding-top:44px}
  #menu .brand-lockup{margin-bottom:18px}
  #menu .menu-copy h1{font-size:clamp(42px,5vw,68px);margin:14px 0}
  #menu .menu-hint{margin-top:18px}
  #menu .portal-art{max-height:62vh}
  #songselect .song-list{max-height:min(46vh,380px)}
  .cover-frame{width:min(100%,300px);margin:8px auto 12px}
}
@media(max-height:520px) and (orientation:landscape){
  #menu .menu-content.door-home-stage{height:100dvh;padding:20px 18px 8px}
  #menu .menu-copy h1{font-size:clamp(28px,6vh,40px);margin:6px 0}
  #menu .brand-lockup{margin-bottom:7px}
  #menu .menu-visual{height:86%}
  #menu .menu-subtitle{margin:0 0 7px;font-size:10px}
  #menu .menu-hint{margin-top:5px}
}
/* ---------- 10. 动效降级 ---------- */
@media(prefers-reduced-motion:reduce){
  .rl-ambient,.rl-transit{display:none}
  .rl-ambient *,.rl-transit *,#menu .menu-visual *,#songselect .library-hero-orbit,.cover-sheen,.cover-image,#leftPanel .panel-section::after,#rightPanel .panel-section::after{animation:none!important}
  #menu .menu-copy,#menu .menu-visual,#menu .menu-footer,#songselect.active .page-header,#songselect.active .library-hero-wrap,#songselect.active .library-main,#songselect.active .track-stage,#songselect.active .library-aside,#songselect.active .page-footer,#settings.active .settings-panel,#settings.active .setting-item,#result.active .result-hero,#result.active .result-metric,#result.active .result-section,#result.active .result-actions{animation:none!important}
  *{transition-duration:.01ms!important}
}
body.reduce-motion .rl-ambient,body.reduce-motion .rl-transit{display:none}
body.reduce-motion .rl-ambient *,body.reduce-motion #menu .menu-visual *,body.reduce-motion .cover-sheen,body.reduce-motion .cover-image{animation:none!important}
body.reduce-motion #menu .menu-copy,body.reduce-motion #menu .menu-visual,body.reduce-motion #songselect.active .page-header,body.reduce-motion #songselect.active .library-hero-wrap,body.reduce-motion #songselect.active .library-main,body.reduce-motion #songselect.active .track-stage,body.reduce-motion #songselect.active .library-aside,body.reduce-motion #settings.active .settings-panel,body.reduce-motion #settings.active .setting-item,body.reduce-motion #result.active .result-hero,body.reduce-motion #result.active .result-metric,body.reduce-motion #result.active .result-section{animation:none!important}
</style>

<script id="door-v176-cinematic-runtime">
/* 视觉层运行时：曲绘展示、页面转场、封面视差。
   不读取也不修改判定、输入、时钟、音频与谱面解析的任何状态。 */
(function(){
  const $=id=>document.getElementById(id);
  const palettes=[['#93CDE6','#E4C3DE'],['#ADB4EC','#8CC3DE'],['#95C9CE','#D6B8E4'],['#B3C5EC','#EAC1D4'],['#92D1DC','#B6B0EA']];
  const diffNames={easy:'简单',normal:'普通',hard:'困难',expert:'专家'};
  const covers=new Map();
  let lastCoverKey='';

  function activeIndex(){return expandedSong>=0&&expandedSong<songs.length?expandedSong:selectedSong;}

  function paintCover(song,index){
    const frame=$('coverFrame'),img=$('coverImage'),fallback=$('coverFallback'),badge=$('coverBadge');
    const key=song?(song.id||song.sourceKey||song.title)+'|'+(song.coverUrl||''):'none';
    const hasArt=!!(song&&song.coverUrl);
    frame.classList.toggle('has-art',hasArt);
    badge.textContent=hasArt?'BEATMAP ART · 谱面曲绘':'DECORATIVE COVER · 界面生成';
    if(hasArt){
      if(img.getAttribute('src')!==song.coverUrl)img.setAttribute('src',song.coverUrl);
      img.hidden=false;fallback.hidden=true;
      img.alt=String(song.title||'')+' 曲绘';
    }else{
      img.hidden=true;img.removeAttribute('src');fallback.hidden=false;
      if(song){
        const hash=Array.from(String(song.title||'')).reduce((n,c)=>((n*31+c.charCodeAt(0))>>>0),0);
        const pair=palettes[hash%palettes.length];
        frame.style.setProperty('--cover-a',pair[0]);frame.style.setProperty('--cover-b',pair[1]);
        frame.style.background='linear-gradient(135deg,'+pair[0]+','+pair[1]+')';
      }
    }
    lastCoverKey=key;
  }

  function refreshStage(){
    const index=activeIndex(),song=songs[index],play=$('stagePlay'),choices=$('stageDifficulties');
    choices.replaceChildren();play.disabled=!song;
    if(!song){
      $('stageTitle').textContent='等待下一首歌';
      $('stageArtist').textContent='从左侧导入谱面，让音乐在此展开。';
      $('stageBpm').textContent='—';$('stageNotes').textContent='—';$('stageCharts').textContent='—';
      const empty=document.createElement('span');empty.className='stage-empty';empty.textContent='导入谱面后选择难度';choices.append(empty);
      paintCover(null,index);
      return;
    }
    const diffs=Object.keys(song.difficulties||{});
    const active=diffs.includes(selectedDiff)?selectedDiff:diffs[0];
    $('stageTitle').textContent=String(song.title||'未命名');
    $('stageArtist').textContent=String(song.artist||'未知曲师')+' · 4K';
    $('stageBpm').textContent=String(Number(song.bpm)||120);
    $('stageCharts').textContent=String(diffs.length);
    $('stageNotes').textContent=String((song.difficulties[active]&&song.difficulties[active].notes?song.difficulties[active].notes.length:'—'));
    diffs.forEach(diff=>{
      const btn=document.createElement('button');btn.type='button';
      btn.className='stage-diff'+(diff===active?' selected':'');
      btn.dataset.diff=diff;
      btn.textContent=(diffNames[diff]||diff)+' · Lv.'+song.difficulties[diff].level;
      btn.setAttribute('aria-pressed',String(diff===active));
      btn.onclick=()=>{selectedSong=index;selectedDiff=diff;expandedSong=index;renderSongList();};
      choices.append(btn);
    });
    paintCover(song,index);
  }

  const baseRender=renderSongList;
  renderSongList=function(){
    baseRender();
    document.querySelectorAll('#songList .song-card').forEach(card=>{
      if(card.dataset.rlKey===undefined){
        card.tabIndex=0;card.setAttribute('role','button');
        card.setAttribute('aria-label','选择曲目 '+(card.querySelector('.title')?card.querySelector('.title').textContent:''));
        card.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();card.click();}});
        card.dataset.rlKey='1';
      }
    });
    refreshStage();
  };

  $('stagePlay').addEventListener('click',()=>{
    const index=activeIndex(),song=songs[index];if(!song)return;
    const diffs=Object.keys(song.difficulties||{});if(!diffs.length)return;
    selectedSong=index;if(!diffs.includes(selectedDiff))selectedDiff=diffs[0];
    unlockAudioGlobal();startGame();
  });

  /* 页面转场：仅在菜单/选曲/设置/结算之间切换时播放，不介入门扉入境流程。 */
  const baseShowScreen=showScreen;
  const titles={menu:['DOOR','BACK TO THE THRESHOLD'],songselect:['LIBRARY','CHOOSE A MEMORY'],settings:['SETTINGS','TUNE YOUR RHYTHM'],result:['RESULT','A MOMENT HELD STILL']};
  let transitBusy=false,transitTimer=0;
  function endTransit(overlay){
    if(!overlay)return;
    overlay.classList.remove('run');
    transitBusy=false;
    clearTimeout(transitTimer);transitTimer=0;
  }
  showScreen=function(name){
    const overlay=$('rlTransit'),meta=titles[name];
    if(overlay&&meta&&!SETTINGS.reduceMotion&&!document.body.classList.contains('reduce-motion')&&!transitBusy){
      transitBusy=true;
      $('rlTransitTitle').textContent=meta[0];$('rlTransitSub').textContent=meta[1];
      overlay.classList.remove('run');void overlay.offsetWidth;overlay.classList.add('run');
      // 以动画结束为准清理；定时器仅作兜底，避免动画被降级或标签页节流时残留。
      overlay.addEventListener('animationend',e=>{if(e.target===overlay)endTransit(overlay);},{once:true});
      clearTimeout(transitTimer);
      transitTimer=setTimeout(()=>endTransit(overlay),1600);
    }
    const result=baseShowScreen.apply(this,arguments);
    syncAmbient();
    return result;
  };

  /* 曲绘视差：只在选曲页生效，仅读取鼠标位置。 */
  let rafPending=false,px=0,py=0;
  document.addEventListener('mousemove',e=>{
    if(gameState!=='songselect')return;
    px=(e.clientX/window.innerWidth-.5)*2;py=(e.clientY/window.innerHeight-.5)*2;
    if(rafPending)return;rafPending=true;
    requestAnimationFrame(()=>{
      rafPending=false;
      const frame=$('coverFrame');if(!frame)return;
      frame.style.setProperty('--rl-px',px.toFixed(3));frame.style.setProperty('--rl-py',py.toFixed(3));
    });
  },{passive:true});

  const ambient=$('rlAmbient');
  function syncAmbient(){
    const playing=(typeof gameState!=='undefined'&&gameState==='game');
    if(ambient)ambient.style.opacity=playing?'0':'1';
  }
  setInterval(syncAmbient,900);syncAmbient();
  refreshStage();
})();
</script>

<style id="door-v177-rainlight-dual">
/* ============================================================
   v17.7 · RAINLIGHT DUAL
   双主题（雨光白昼 / 深夜暴雨）+ 材质分级 + 阴影体系 + 雨痕玻璃。
   仅视觉层：判定、输入、时钟、音频与谱面解析逻辑未改动。
   ============================================================ */
:root{
  /* —— 明亮模式：底色下沉，白色只留给最上层控件 —— */
  --ui-bg-1:#D2E1F0;--ui-bg-2:#DBE7F4;--ui-bg-3:#E1DBEE;
  --ui-deep:#C2D2E3;
  --ui-ink:#1D3350;--ui-ink-soft:#456280;--ui-muted:#71889F;
  --ui-line:rgba(114,154,188,.36);--ui-line-soft:rgba(114,154,188,.2);
  --ui-panel:rgba(247,251,255,.52);--ui-panel-2:rgba(255,255,255,.4);--ui-panel-3:rgba(255,255,255,.74);
  --ui-sunken:rgba(203,217,232,.5);
  --ui-blur:22px;--ui-sat:118%;
  --ui-hi:inset 0 1px 0 rgba(255,255,255,.86);
  --acc-cyan:#3589AE;--acc-indigo:#6367BE;--acc-lilac:#8277B2;--acc-rose:#B96C9C;
  --diff-easy:#2B8A6E;--diff-normal:#2F6D9C;--diff-hard:#96701F;--diff-expert:#A2507A;
  --diff-easy-bg:rgba(43,138,110,.13);--diff-normal-bg:rgba(47,109,156,.13);--diff-hard-bg:rgba(150,112,31,.15);--diff-expert-bg:rgba(162,80,122,.13);
  /* —— 阴影：多层低透明叠加，统一左上光源，避免生硬单层大黑影 —— */
  --sh-1:0 1px 2px rgba(26,56,90,.05),0 3px 8px rgba(26,56,90,.05);
  --sh-2:0 1px 2px rgba(26,56,90,.05),0 6px 16px rgba(26,56,90,.07),0 16px 34px rgba(26,56,90,.06);
  --sh-3:0 2px 4px rgba(22,50,82,.06),0 12px 26px rgba(22,50,82,.09),0 30px 62px rgba(22,50,82,.09);
  --sh-4:0 4px 10px rgba(18,44,76,.08),0 22px 48px rgba(18,44,76,.12),0 52px 104px rgba(18,44,76,.11);
  --sh-in:inset 0 1px 0 rgba(255,255,255,.9),inset 0 -1px 0 rgba(120,152,184,.14);
  --cover-accent:#3E93B8;--cover-accent-soft:rgba(62,147,184,.22);
}
html[data-ui-theme="dark"]{
  /* —— 深夜暴雨：独立设计，不是明亮模式换色 —— */
  --ui-bg-1:#060A13;--ui-bg-2:#0A1120;--ui-bg-3:#0E1326;
  --ui-deep:#04070D;
  --ui-ink:#DEE9F7;--ui-ink-soft:#A5BBD3;--ui-muted:#788CA5;
  --ui-line:rgba(118,156,196,.22);--ui-line-soft:rgba(118,156,196,.12);
  --ui-panel:rgba(18,28,45,.62);--ui-panel-2:rgba(13,21,35,.5);--ui-panel-3:rgba(24,36,56,.72);
  --ui-sunken:rgba(6,10,19,.6);
  --ui-blur:26px;--ui-sat:112%;
  --ui-hi:inset 0 1px 0 rgba(178,214,255,.08);
  --acc-cyan:#63BBDC;--acc-indigo:#8E8CD8;--acc-lilac:#AB9FDD;--acc-rose:#D394BA;
  --diff-easy:#71D6B2;--diff-normal:#82BAEC;--diff-hard:#EBC684;--diff-expert:#EDA1C6;
  --diff-easy-bg:rgba(113,214,178,.14);--diff-normal-bg:rgba(130,186,236,.14);--diff-hard-bg:rgba(235,198,132,.15);--diff-expert-bg:rgba(237,161,198,.14);
  --sh-1:0 1px 2px rgba(0,0,0,.46),0 4px 10px rgba(0,0,0,.34);
  --sh-2:0 2px 4px rgba(0,0,0,.5),0 10px 24px rgba(0,0,0,.44),0 22px 44px rgba(0,0,0,.34);
  --sh-3:0 3px 8px rgba(0,0,0,.52),0 18px 40px rgba(0,0,0,.48),0 38px 76px rgba(0,0,0,.4);
  --sh-4:0 6px 16px rgba(0,0,0,.56),0 30px 70px rgba(0,0,0,.5),0 60px 120px rgba(0,0,0,.42);
  --sh-in:inset 0 1px 0 rgba(178,214,255,.09),inset 0 -1px 0 rgba(0,0,0,.36);
}
html,body{background:var(--ui-deep);color:var(--ui-ink)}
#menu,#songselect,#settings,#result{
  color:var(--ui-ink);
  background-image:radial-gradient(ellipse at 12% 8%,rgba(255,255,255,.34),transparent 34%),
    radial-gradient(ellipse at 84% 12%,rgba(158,192,232,.46),transparent 40%),
    radial-gradient(ellipse at 78% 86%,rgba(214,180,212,.36),transparent 38%),
    linear-gradient(158deg,var(--ui-bg-1) 0%,var(--ui-bg-2) 46%,var(--ui-bg-3) 100%);
  background-attachment:fixed;
}
html[data-ui-theme="dark"] #menu,html[data-ui-theme="dark"] #songselect,html[data-ui-theme="dark"] #settings,html[data-ui-theme="dark"] #result{
  background-image:radial-gradient(ellipse at 14% 6%,rgba(84,132,186,.2),transparent 38%),
    radial-gradient(ellipse at 86% 16%,rgba(120,110,196,.16),transparent 42%),
    radial-gradient(ellipse at 72% 92%,rgba(158,96,138,.12),transparent 40%),
    linear-gradient(162deg,var(--ui-bg-1) 0%,var(--ui-bg-2) 48%,var(--ui-bg-3) 100%);
}
/* 环境层：暗色下更密更冷 */
html[data-ui-theme="dark"] #bgCanvas{opacity:.32}
html[data-ui-theme="dark"] .rl-field-ice{background:radial-gradient(circle,rgba(78,132,180,.3),rgba(70,110,164,.11) 38%,transparent 70%)}
html[data-ui-theme="dark"] .rl-field-lilac{background:radial-gradient(circle,rgba(112,102,186,.26),rgba(96,90,168,.09) 42%,transparent 70%)}
html[data-ui-theme="dark"] .rl-field-rose{background:radial-gradient(circle,rgba(160,102,140,.2),transparent 68%)}
html[data-ui-theme="dark"] .rl-ribbon{border-top-color:rgba(186,220,255,.34);border-bottom-color:rgba(96,140,196,.14)}
html[data-ui-theme="dark"] .rl-rain{background:linear-gradient(180deg,transparent,rgba(206,232,255,.52),rgba(120,168,214,.2),transparent)}
html[data-ui-theme="dark"] .rl-waterline{background:linear-gradient(90deg,transparent,rgba(120,176,214,.42),rgba(168,120,164,.3),transparent)}
html[data-ui-theme="dark"] .rl-vignette{background:radial-gradient(ellipse at 50% 40%,transparent 40%,rgba(0,0,0,.5) 100%)}

/* ---------- 玻璃材质分级 ---------- */
.rl-glass-1{background:var(--ui-panel);border:1px solid var(--ui-line);border-radius:22px;
  box-shadow:var(--sh-3),var(--sh-in);backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat));-webkit-backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat))}
.rl-glass-2{background:var(--ui-panel-2);border:1px solid var(--ui-line-soft);border-radius:16px;
  box-shadow:var(--sh-2),inset 0 1px 0 rgba(255,255,255,.6);backdrop-filter:blur(14px) saturate(112%);-webkit-backdrop-filter:blur(14px) saturate(112%)}
/* 液态玻璃：流动高光 + 边缘折射 + 厚度 */
.rl-liquid{position:relative;isolation:isolate;overflow:hidden}
.rl-liquid::before{content:"";position:absolute;z-index:0;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(112deg,rgba(255,255,255,.5) 0%,rgba(255,255,255,.06) 26%,transparent 46%,rgba(255,255,255,.14) 68%,transparent 100%)}
.rl-liquid::after{content:"";position:absolute;z-index:0;top:-140%;bottom:-140%;left:-45%;width:30%;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.6),transparent);transform:translateX(-240%) rotate(16deg);opacity:0;
  transition:transform .85s var(--rl-ease),opacity .3s}
.rl-liquid:hover::after{transform:translateX(660%) rotate(16deg);opacity:.9}
html[data-ui-theme="dark"] .rl-liquid::before{background:linear-gradient(112deg,rgba(190,220,255,.14) 0%,rgba(190,220,255,.03) 26%,transparent 48%,rgba(190,220,255,.07) 70%,transparent 100%)}
html[data-ui-theme="dark"] .rl-liquid::after{background:linear-gradient(90deg,transparent,rgba(206,232,255,.3),transparent)}
/* 亚克力细噪点 */
.rl-acrylic::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;opacity:.5;mix-blend-mode:overlay;
  background-image:radial-gradient(rgba(255,255,255,.5) .5px,transparent .6px),radial-gradient(rgba(90,120,150,.32) .5px,transparent .6px);
  background-size:3px 3px,4px 4px;background-position:0 0,1px 2px}
html[data-ui-theme="dark"] .rl-acrylic::after{opacity:.34;mix-blend-mode:soft-light}
/* 雨痕玻璃（新意 1）：静态细水痕 + 缓慢下移的亮痕 */
.rl-streaks{position:relative;overflow:hidden;isolation:isolate}
.rl-streaks>.rl-streak-layer{position:absolute;left:0;right:0;top:-232px;bottom:-232px;pointer-events:none;z-index:-1;
  background-image:repeating-linear-gradient(90deg,transparent 0 47px,rgba(255,255,255,.14) 47px 48.4px,transparent 48.4px 103px,rgba(255,255,255,.07) 103px 104.2px,transparent 104.2px 163px);
  background-size:163px 100%;
  -webkit-mask-image:repeating-linear-gradient(180deg,transparent 0 52px,rgba(0,0,0,.9) 52px 138px,transparent 138px 232px);
  mask-image:repeating-linear-gradient(180deg,transparent 0 52px,rgba(0,0,0,.9) 52px 138px,transparent 138px 232px);
  animation:rlStreakFall 21s linear infinite;opacity:.6}
html[data-ui-theme="dark"] .rl-streaks>.rl-streak-layer{
  background-image:repeating-linear-gradient(90deg,transparent 0 47px,rgba(190,224,255,.16) 47px 48.4px,transparent 48.4px 103px,rgba(190,224,255,.08) 103px 104.2px,transparent 104.2px 163px);
  opacity:.75}
@keyframes rlStreakFall{from{transform:translateY(-232px)}to{transform:translateY(0)}}
/* 漂浮物件容器 */
.rl-objects{position:absolute;inset:0;pointer-events:none}
.rl-obj{position:absolute;border-radius:50%;will-change:transform,opacity;pointer-events:none}
.rl-obj-orb{background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.9),rgba(160,206,238,.4) 45%,rgba(150,180,232,.12) 70%,transparent 76%);box-shadow:0 0 22px rgba(150,200,240,.34)}
.rl-obj-ring{border:1px solid rgba(255,255,255,.6);box-shadow:0 0 16px rgba(170,214,244,.3),inset 0 0 12px rgba(255,255,255,.24)}
.rl-obj-shard{background:linear-gradient(135deg,rgba(255,255,255,.6),rgba(180,214,246,.22));border-radius:32% 68% 46% 54%/48% 38% 62% 52%;box-shadow:0 6px 18px rgba(120,164,206,.2)}
.rl-obj-drop{background:radial-gradient(circle at 38% 32%,rgba(255,255,255,.86),rgba(150,196,236,.34) 52%,transparent 74%);border-radius:50% 50% 50% 50%/62% 62% 38% 38%}
html[data-ui-theme="dark"] .rl-obj-orb{background:radial-gradient(circle at 34% 30%,rgba(206,232,255,.6),rgba(96,146,200,.28) 46%,rgba(70,110,168,.1) 70%,transparent 76%);box-shadow:0 0 20px rgba(96,150,210,.3)}
html[data-ui-theme="dark"] .rl-obj-ring{border-color:rgba(186,218,255,.34);box-shadow:0 0 14px rgba(96,150,210,.26),inset 0 0 12px rgba(160,200,255,.14)}
html[data-ui-theme="dark"] .rl-obj-shard{background:linear-gradient(135deg,rgba(186,218,255,.26),rgba(96,132,190,.14))}
@keyframes rlObjDrift{
  0%{transform:translate3d(0,0,0) rotate(0deg)}
  50%{transform:translate3d(var(--ox,18px),var(--oy,-26px),0) rotate(180deg)}
  100%{transform:translate3d(0,0,0) rotate(360deg)}}

/* ---------- 主菜单：四个入口，各自配色 + 线性图标 ---------- */
#menu .menu-actions{width:min(100%,448px);display:grid;grid-template-columns:1fr 1fr;gap:9px}
#menu .menu-actions .rl-opt{position:relative;display:flex;align-items:center;gap:11px;width:100%;height:60px;min-height:60px;
  padding:0 14px;border-radius:18px;text-align:left;font-size:12px;letter-spacing:.02em;
  background:var(--ui-panel-2);border:1px solid var(--ui-line-soft);box-shadow:var(--sh-2),var(--sh-in);
  backdrop-filter:blur(16px) saturate(114%);-webkit-backdrop-filter:blur(16px) saturate(114%);
  transition:transform .34s var(--rl-ease),box-shadow .34s,border-color .3s,background .3s}
#menu .menu-actions .rl-opt-play{grid-column:1/-1;height:66px;min-height:66px;border-radius:20px}
#menu .menu-actions .rl-opt-theme{grid-column:1/-1}
#menu .menu-actions .rl-opt:hover{transform:translateY(-3px);box-shadow:var(--sh-3),var(--sh-in);border-color:var(--opt-line,rgba(120,170,206,.6))}
#menu .menu-actions .rl-opt:active{transform:translateY(-1px) scale(.995)}
#menu .rl-opt-icon{flex:0 0 38px;width:38px;height:38px;display:grid;place-items:center;border-radius:13px;
  background:var(--opt-chip,rgba(62,147,184,.16));color:var(--opt,rgba(53,137,174,1));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 3px 9px rgba(40,80,120,.1)}
#menu .rl-opt-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
#menu .rl-opt-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
#menu .rl-opt-copy b{font-size:13px;font-weight:660;color:var(--ui-ink);letter-spacing:.01em}
#menu .rl-opt-copy small{font-size:9px;color:var(--ui-muted);line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#menu .rl-opt .btn-arrow{flex:0 0 26px;width:26px;height:26px;display:grid;place-items:center;border-radius:50%;
  background:var(--opt-chip,rgba(62,147,184,.14));color:var(--opt,rgba(53,137,174,1));font-size:13px}
#menu .rl-opt-play{--opt:#3589AE;--opt-chip:rgba(53,137,174,.15);--opt-line:rgba(78,170,206,.66);
  background:linear-gradient(112deg,rgba(255,255,255,.9),rgba(236,246,255,.82) 60%,rgba(250,236,246,.8));border-color:rgba(255,255,255,.9)}
#menu .rl-opt-library{--opt:#6367BE;--opt-chip:rgba(99,103,190,.15);--opt-line:rgba(122,126,214,.6)}
#menu .rl-opt-settings{--opt:#8277B2;--opt-chip:rgba(130,119,178,.16);--opt-line:rgba(152,141,198,.6)}
#menu .rl-opt-theme{--opt:#B96C9C;--opt-chip:rgba(185,108,156,.15);--opt-line:rgba(206,132,178,.6)}
html[data-ui-theme="dark"] #menu .menu-actions .rl-opt{background:var(--ui-panel-2);border-color:var(--ui-line-soft)}
html[data-ui-theme="dark"] #menu .rl-opt-play{--opt:#63BBDC;--opt-chip:rgba(99,187,220,.16);--opt-line:rgba(110,196,228,.6);
  background:linear-gradient(112deg,rgba(38,60,90,.72),rgba(26,42,66,.66) 60%,rgba(52,38,62,.6));border-color:rgba(120,180,220,.28)}
html[data-ui-theme="dark"] #menu .rl-opt-library{--opt:#8E8CD8;--opt-chip:rgba(142,140,216,.16);--opt-line:rgba(150,148,226,.6)}
html[data-ui-theme="dark"] #menu .rl-opt-settings{--opt:#AB9FDD;--opt-chip:rgba(171,159,221,.16);--opt-line:rgba(178,166,228,.6)}
html[data-ui-theme="dark"] #menu .rl-opt-theme{--opt:#D394BA;--opt-chip:rgba(211,148,186,.16);--opt-line:rgba(220,160,196,.6)}
html[data-ui-theme="dark"] #menu .rl-opt-icon{box-shadow:inset 0 1px 0 rgba(180,214,255,.1),0 3px 10px rgba(0,0,0,.4)}
html[data-ui-theme="dark"] #menu .rl-opt-copy b{color:#E4EEFB}
html[data-ui-theme="dark"] #menu .rl-opt-copy small{color:#8FA6BF}
#menu .brand-word{color:var(--ui-ink)}
#menu .menu-copy h1,#menu h1{color:var(--ui-ink);-webkit-text-fill-color:var(--ui-ink)}
#menu .menu-subtitle{color:var(--ui-ink-soft)}
#menu .menu-eyebrow{color:var(--ui-muted)}
#menu .menu-hint{color:var(--ui-muted)}
#menu .key-hint-row kbd{background:var(--ui-panel-3);border-color:var(--ui-line);color:var(--ui-ink-soft);box-shadow:0 2px 0 rgba(150,180,206,.35)}
#menu .key-hint-row span,#menu .hint-secondary{color:var(--ui-muted)}
#menu .menu-footer{color:var(--ui-muted);border-color:var(--ui-line-soft)}
#menu .floating-chip{background:var(--ui-panel-2);border-color:var(--ui-line-soft);color:var(--ui-ink-soft)}
#menu .menu-visual::before{background:radial-gradient(ellipse at 50% 44%,rgba(255,255,255,.72),rgba(178,216,238,.26) 28%,rgba(200,194,238,.13) 52%,transparent 73%)}
html[data-ui-theme="dark"] #menu .menu-visual::before{background:radial-gradient(ellipse at 50% 44%,rgba(150,196,240,.28),rgba(96,140,196,.14) 30%,rgba(110,96,180,.1) 54%,transparent 74%)}
html[data-ui-theme="dark"] #menu .portal-art{filter:drop-shadow(0 20px 38px rgba(0,0,0,.5)) saturate(.92) brightness(.86)}
html[data-ui-theme="dark"] #menu .visual-caption{color:#8FA6BF}
html[data-ui-theme="dark"] #menu .portal-waterline{border-top-color:rgba(96,146,196,.4)}
html[data-ui-theme="dark"] #menu .visual-halo{opacity:.5}

/* ---------- 选曲页 ---------- */
#songselect .page-header{border-bottom-color:var(--ui-line)}
#songselect .header-back{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft);box-shadow:var(--sh-1)}
#songselect .header-back:hover{background:var(--ui-panel-3);border-color:var(--opt-line,rgba(110,175,208,.7));transform:translateX(-3px)}
#songselect .mini-brand{color:var(--ui-ink)}
#songselect .header-note{color:var(--ui-muted)}
#songselect .library-intro h2{color:var(--ui-ink)}
#songselect .library-intro h2 span{color:var(--acc-cyan)}
#songselect .library-intro p{color:var(--ui-ink-soft)}
#songselect .section-eyebrow{color:var(--ui-muted)}
#songselect .library-count{background:var(--ui-panel);border-color:var(--ui-line);box-shadow:var(--sh-2),var(--sh-in);color:var(--ui-ink-soft)}
#songselect .library-count b{color:var(--ui-ink)}
#songselect .library-count small{color:var(--ui-muted)}
#songselect .count-mark{background:linear-gradient(140deg,rgba(190,234,246,.7),rgba(214,206,242,.66));color:var(--acc-cyan)}
html[data-ui-theme="dark"] #songselect .count-mark{background:linear-gradient(140deg,rgba(60,110,150,.6),rgba(80,72,140,.5))}
#songselect .library-main{align-self:start}
#songselect .library-main,#songselect .track-stage,#songselect .library-aside{
  background:var(--ui-panel);border:1px solid var(--ui-line);border-radius:22px;
  box-shadow:var(--sh-3),var(--sh-in);backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat));-webkit-backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat))}
#songselect .library-section-title h3,#songselect .stage-info h3{color:var(--ui-ink)}
#songselect .library-section-title p{color:var(--ui-muted)}
#songselect .section-index{color:var(--ui-muted)}
#songselect .drop-zone{background:var(--ui-sunken);border-color:var(--ui-line);box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}
#songselect .drop-zone:hover,#songselect .drop-zone.drag{background:var(--ui-panel-3);border-color:rgba(78,170,206,.75);box-shadow:var(--sh-2),inset 0 1px 0 rgba(255,255,255,.7)}
#songselect .upload-icon{background:linear-gradient(145deg,rgba(200,236,250,.7),rgba(222,214,244,.6));color:var(--acc-cyan)}
#songselect .upload-main{color:var(--ui-ink-soft)}
#songselect .upload-main b{color:var(--acc-cyan);background:var(--ui-panel-3);border-color:var(--ui-line)}
#songselect .upload-sub,#songselect .folder-import-note{color:var(--ui-muted)}
#songselect .folder-import-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft);box-shadow:var(--sh-1)}
#songselect .folder-import-btn:hover{background:var(--ui-panel-3);border-color:rgba(110,190,220,.7)}
#songselect .song-card{background:var(--ui-panel-2);border-color:var(--ui-line-soft);box-shadow:var(--sh-1)}
#songselect .song-card::before{background:linear-gradient(145deg,rgba(200,236,250,.6),rgba(220,212,244,.55));color:var(--acc-cyan);border-color:var(--ui-line-soft)}
#songselect .song-card:hover{background:var(--ui-panel-3);border-color:rgba(110,175,208,.6);box-shadow:var(--sh-2)}
#songselect .song-card.selected{background:linear-gradient(108deg,rgba(226,244,252,.9),rgba(232,228,250,.82) 72%,rgba(248,230,242,.78));
  border-color:rgba(90,170,206,.7);box-shadow:inset 3px 0 0 rgba(78,168,204,.75),var(--sh-2)}
html[data-ui-theme="dark"] #songselect .song-card.selected{background:linear-gradient(108deg,rgba(38,64,92,.8),rgba(44,42,80,.72) 72%,rgba(66,40,62,.66));border-color:rgba(104,178,214,.5);box-shadow:inset 3px 0 0 rgba(99,187,220,.7),var(--sh-2)}
#songselect .song-card .title{color:var(--ui-ink)}
#songselect .song-card .artist{color:var(--ui-muted)}
#songselect .empty-library{border-color:var(--ui-line);background:var(--ui-panel-2);color:var(--ui-muted)}
#songselect .empty-library>b{color:var(--ui-ink)}
#songselect .empty-library .empty-note{background:linear-gradient(145deg,rgba(210,238,250,.7),rgba(228,220,248,.6));color:var(--acc-cyan);border-color:var(--ui-line)}
#songselect .page-footer{border-top-color:var(--ui-line-soft);color:var(--ui-muted)}
/* 曲目舞台 */
.track-stage::before{background:radial-gradient(ellipse,var(--cover-accent-soft),transparent 68%)}
.stage-heading{color:var(--ui-muted)}
.stage-eyebrow{color:var(--ui-muted)}
.stage-info h3{color:var(--ui-ink)}
.stage-info p{color:var(--ui-ink-soft)}
.stage-facts{border-top-color:var(--ui-line-soft);border-bottom-color:var(--ui-line-soft)}
.stage-facts small{color:var(--ui-muted)}
.stage-facts b{color:var(--ui-ink)}
.stage-choice-label{color:var(--ui-muted)}
.stage-empty{color:var(--ui-muted)}
.cover-frame{border-color:var(--ui-line);box-shadow:var(--sh-4),inset 0 1px 0 rgba(255,255,255,.6)}
.cover-frame:hover{box-shadow:var(--sh-4),0 0 0 1px var(--cover-accent-soft),inset 0 1px 0 rgba(255,255,255,.6)}
.cover-badge{background:rgba(24,42,66,.42)}
/* 暗色下曲绘底板改为深调，避免在深夜暴雨主题里出现刺眼的亮白块 */
html[data-ui-theme="dark"] .cover-frame{background:linear-gradient(135deg,#22314E,#2B3358 48%,#3A2A46);border-color:rgba(150,190,230,.24);box-shadow:var(--sh-4),inset 0 1px 0 rgba(180,214,255,.1)}
html[data-ui-theme="dark"] .cover-halo{background:radial-gradient(circle at 74% 16%,rgba(190,224,255,.3) 1%,transparent 38%),radial-gradient(circle at 26% 88%,rgba(160,196,236,.18),transparent 50%)}
html[data-ui-theme="dark"] .cover-orbit{border-color:rgba(170,208,244,.34);box-shadow:0 0 0 18px rgba(150,190,240,.05),0 0 26px rgba(120,168,220,.2)}
html[data-ui-theme="dark"] .cover-door{background:linear-gradient(95deg,rgba(190,222,255,.18),rgba(150,180,240,.07) 39%,rgba(190,222,255,.18));border-color:rgba(180,214,250,.4);box-shadow:inset 0 0 30px rgba(140,186,240,.22),0 0 30px rgba(110,160,220,.24)}
html[data-ui-theme="dark"] .cover-door::before{border-color:rgba(180,214,250,.26)}
html[data-ui-theme="dark"] .cover-wordmark{color:rgba(226,238,252,.9);text-shadow:0 2px 18px rgba(0,0,0,.6)}
html[data-ui-theme="dark"] .cover-sheen{background:linear-gradient(90deg,transparent 46%,rgba(200,228,255,.16) 50%,transparent 54%)}
html[data-ui-theme="dark"] .cover-frame-line{border-color:rgba(180,214,250,.22)}
/* 难度取色统一规则：所有位置同一套色相 */
.stage-diff{border-color:var(--ui-line);background:var(--ui-panel-2);color:var(--ui-ink-soft)}
.stage-diff[data-diff="easy"]{--d:var(--diff-easy);--db:var(--diff-easy-bg)}
.stage-diff[data-diff="normal"]{--d:var(--diff-normal);--db:var(--diff-normal-bg)}
.stage-diff[data-diff="hard"]{--d:var(--diff-hard);--db:var(--diff-hard-bg)}
.stage-diff[data-diff="expert"]{--d:var(--diff-expert);--db:var(--diff-expert-bg)}
.stage-diff{background:var(--db,var(--ui-panel-2));color:var(--d,var(--ui-ink-soft));border-color:color-mix(in srgb,var(--d,var(--ui-line)) 34%,transparent)}
.stage-diff:hover{transform:translateY(-2px);box-shadow:var(--sh-2);border-color:var(--d,var(--ui-line))}
.stage-diff.selected{background:var(--d,var(--acc-cyan));color:#fff;border-color:var(--d,var(--acc-cyan));box-shadow:0 6px 18px color-mix(in srgb,var(--d,var(--acc-cyan)) 34%,transparent)}
html[data-ui-theme="dark"] .stage-diff.selected{color:#08111E}
.stage-play{border-color:var(--ui-line);background:var(--ui-panel-3);color:var(--ui-ink);box-shadow:var(--sh-2),var(--sh-in)}
.stage-play:hover:not(:disabled){box-shadow:var(--sh-3),var(--sh-in);border-color:var(--cover-accent)}
.stage-play:disabled{opacity:.45}
/* 侧栏工具 */
#songselect .library-aside::before{border-color:var(--ui-line-soft);box-shadow:0 0 0 22px rgba(255,255,255,.05),0 0 0 49px rgba(176,215,231,.035)}
html[data-ui-theme="dark"] #songselect .library-aside::before{box-shadow:0 0 0 22px rgba(150,190,240,.03),0 0 0 49px rgba(150,190,240,.02)}
#songselect .play-mode-bar.mode-workspace-card{border-bottom-color:var(--ui-line-soft)}
#songselect .play-mode-copy b{color:var(--ui-ink)}
#songselect .play-mode-copy small{color:var(--ui-muted)}
#songselect .play-mode-icon{background:linear-gradient(145deg,rgba(205,238,250,.7),rgba(224,216,246,.6));color:var(--acc-cyan)}
#songselect .play-mode-segment{border-color:var(--ui-line);background:var(--ui-sunken)}
#songselect .play-mode-option{color:var(--ui-muted)}
#songselect .play-mode-option.selected{background:var(--ui-panel-3);border-color:var(--ui-line);color:var(--acc-cyan);box-shadow:var(--sh-1),inset 0 1px 0 rgba(255,255,255,.6)}
#songselect .play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,rgba(214,240,250,.85),rgba(238,226,246,.75));color:var(--acc-rose)}
html[data-ui-theme="dark"] #songselect .play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,rgba(40,66,92,.8),rgba(58,42,72,.7))}
#songselect .play-mode-description{color:var(--ui-muted)}
#songselect .resource-card{background:var(--ui-panel-2);border-color:var(--ui-line-soft);box-shadow:var(--sh-1)}
#songselect .resource-card:hover{background:var(--ui-panel-3);border-color:rgba(110,175,208,.6);box-shadow:var(--sh-2)}
#songselect .resource-icon{background:linear-gradient(145deg,rgba(206,238,250,.7),rgba(224,216,246,.6));color:var(--acc-cyan)}
#songselect .resource-icon.pack-icon{background:linear-gradient(145deg,rgba(246,226,238,.7),rgba(226,220,246,.6));color:var(--acc-rose)}
#songselect .resource-text b{color:var(--ui-ink)}
#songselect .resource-text small{color:var(--ui-muted)}
#songselect .resource-arrow{color:var(--acc-cyan)}
#songselect .resource-tip{background:var(--ui-sunken);color:var(--ui-ink-soft)}
#songselect .resource-tip .tip-icon{color:var(--acc-cyan);border-color:var(--ui-line)}
#songselect .library-aside-footer{color:var(--ui-muted);border-top-color:var(--ui-line-soft)}

/* ---------- 设置页 ---------- */
#settings .settings-panel{background:var(--ui-panel);border:1px solid var(--ui-line);border-radius:24px;
  box-shadow:var(--sh-4),var(--sh-in);backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat));-webkit-backdrop-filter:blur(var(--ui-blur)) saturate(var(--ui-sat))}
.settings-intro{border-bottom-color:var(--ui-line-soft)}
.settings-kicker{color:var(--ui-muted)}
#settings .settings-intro h2{color:var(--ui-ink)}
.settings-intro h2 span{color:var(--acc-lilac)}
.settings-intro p{color:var(--ui-ink-soft)}
#settings .setting-item{border-bottom-color:var(--ui-line-soft)}
#settings .setting-item label{color:var(--ui-ink-soft)}
#settings .setting-item .vd{color:var(--acc-cyan)}
#settings .setting-item select{background:var(--ui-panel-3);border-color:var(--ui-line);color:var(--ui-ink);box-shadow:var(--sh-1)}
#settings .quality-hint{color:var(--ui-muted)}
#settings .toggle{background:var(--ui-sunken);border-color:var(--ui-line)}
#settings .toggle.on{background:linear-gradient(90deg,var(--acc-cyan),var(--acc-indigo))}
#settings .settings-panel>.menu-btn{background:var(--ui-panel-3);border-color:var(--ui-line);color:var(--ui-ink);box-shadow:var(--sh-2),var(--sh-in)}
#settings .key-bind-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft)}

/* ---------- 结算页 ---------- */
#result .result-heading{border-bottom-color:var(--ui-line)}
#result .result-kicker{color:var(--ui-muted)}
#result .result-hero{background:var(--ui-panel);border:1px solid var(--ui-line);box-shadow:var(--sh-4),var(--sh-in)}
#result .result-hero::before{background:radial-gradient(ellipse at 50% 40%,rgba(255,255,255,.5),transparent 62%)}
html[data-ui-theme="dark"] #result .result-hero::before{background:radial-gradient(ellipse at 50% 40%,rgba(150,196,240,.14),transparent 62%)}
#result .result-song-title{color:var(--ui-ink)}
#result .result-song-artist,#result .result-judge-label{color:var(--ui-ink-soft)}
#result .result-metric{background:var(--ui-panel-2);border-color:var(--ui-line-soft);box-shadow:var(--sh-2),var(--sh-in)}
#result .result-metric .m-label{color:var(--ui-muted)}
#result .result-metric .m-value{color:var(--ui-ink)}
#result .result-section{background:var(--ui-panel-2);border-color:var(--ui-line-soft);box-shadow:var(--sh-2),var(--sh-in)}
#result .result-section-head h3{color:var(--ui-ink)}
#result .result-section-head span{color:var(--ui-muted)}
#result .result-judgebar{background:var(--ui-sunken)}
#result .result-judgegrid .result-judgecell{background:var(--ui-sunken);border-color:var(--ui-line-soft)}
#result .result-judgegrid .result-judgecell .j-name{color:var(--ui-muted)}
#result .result-judgegrid .result-judgecell .j-count{color:var(--ui-ink)}
#result .result-detail{background:var(--ui-sunken)}
#result .result-detail .d-label{color:var(--ui-muted)}
#result .result-detail .d-value{color:var(--ui-ink)}
#result .result-note{color:var(--ui-muted)}
#result .result-actions .menu-btn{background:var(--ui-panel-3);border-color:var(--ui-line);color:var(--ui-ink);box-shadow:var(--sh-2)}
#result .result-actions .menu-btn.primary{background:linear-gradient(112deg,var(--acc-cyan),var(--acc-indigo));color:#fff;border-color:transparent}
#result .result-rank{text-shadow:none!important}
/* 暗色下 Perfect 的虹彩渐变改为高明度版本，避免深底上读不清 */
html[data-ui-theme="dark"] .val.perfect,html[data-ui-theme="dark"] .result-judgecell .j-count.perfect,html[data-ui-theme="dark"] .result-judgecell .j-name.perfect{
  background:linear-gradient(100deg,#EFCDE2 0%,#F4E2D2 22%,#EDEDC6 42%,#C9EDE3 61%,#C9E2F6 80%,#DAD2F2 100%);-webkit-background-clip:text;background-clip:text;color:transparent!important}
#result .back-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft);box-shadow:var(--sh-1)}

/* ---------- 暂停 ---------- */
#pauseOverlay{background:color-mix(in srgb,var(--ui-deep) 78%,transparent)}
#pauseOverlay h2{color:var(--ui-ink)}
#pauseOverlay .menu-btn{background:var(--ui-panel-3);color:var(--ui-ink);border-color:var(--ui-line);box-shadow:var(--sh-2)}
#pauseOverlay .menu-btn.primary{background:linear-gradient(112deg,var(--acc-cyan),var(--acc-indigo));color:#fff;border-color:transparent}

/* ---------- 主题切换：雨帘拉过（新意 3） ---------- */
.rl-curtain{position:fixed;inset:0;z-index:70;pointer-events:none;opacity:0;visibility:hidden;overflow:hidden}
.rl-curtain.run{visibility:visible;animation:rlCurtainFade 1s ease both}
.rl-curtain-layer{position:absolute;inset:-20% -10%;background:repeating-linear-gradient(90deg,rgba(255,255,255,.0) 0 22px,rgba(255,255,255,.5) 22px 26px,rgba(255,255,255,0) 26px 54px);filter:blur(3px);transform:translateX(-100%)}
.rl-curtain.run .rl-curtain-layer{animation:rlCurtainSweep .92s cubic-bezier(.3,0,.2,1) both}
.rl-curtain-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(255,255,255,.85),rgba(206,222,246,.4) 40%,transparent 74%)}
.rl-curtain.run .rl-curtain-glow{animation:rlCurtainGlow .92s ease both}
@keyframes rlCurtainFade{0%,80%{opacity:1}100%{opacity:0}}
@keyframes rlCurtainSweep{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
@keyframes rlCurtainGlow{0%{opacity:0}46%{opacity:1}100%{opacity:0}}

/* ---------- 暗色下的通用兜底 ---------- */
html[data-ui-theme="dark"] .menu-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink)}
html[data-ui-theme="dark"] .menu-btn.primary{background:linear-gradient(112deg,rgba(52,110,146,.8),rgba(70,74,140,.72));border-color:rgba(120,180,220,.3);color:#EAF3FF}
html[data-ui-theme="dark"] .back-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft)}
html[data-ui-theme="dark"] .diff-btn{background:var(--ui-panel-2);border-color:var(--ui-line);color:var(--ui-ink-soft)}
html[data-ui-theme="dark"] .hud-icon-btn,html[data-ui-theme="dark"] .game-controls .mode-btn{background:rgba(20,32,50,.82);border-color:rgba(150,190,230,.24);color:#DCE9F8}

/* ---------- 自适应 ---------- */
@media(max-width:880px){
  #menu .menu-actions{grid-template-columns:1fr 1fr;width:100%}
  #menu .menu-actions .rl-opt-play{grid-column:1/-1}
  #menu .rl-opt-copy small{display:none}
  #menu .menu-actions .rl-opt{height:54px;min-height:54px;padding:0 12px}
}
@media(max-width:520px){
  #menu .menu-actions{grid-template-columns:1fr}
  #menu .menu-actions .rl-opt-play{grid-column:auto}
  #menu .rl-opt-copy small{display:block}
}
@media(prefers-reduced-motion:reduce){
  .rl-streaks>.rl-streak-layer,.rl-obj,.rl-curtain,.rl-curtain *{animation:none!important;display:none}
}
body.reduce-motion .rl-streaks>.rl-streak-layer,body.reduce-motion .rl-obj,body.reduce-motion .rl-curtain{display:none}
</style>

<script id="door-v177-dual-runtime">
/* v17.7 视觉运行时：双主题、漂浮物件、雨痕玻璃、曲绘取色、主题切换雨帘。
   只读取界面状态；不触碰判定、输入、时钟、音频与谱面解析。 */
(function(){
  const $=id=>document.getElementById(id);
  const root=document.documentElement;
  const curtain=$('rlCurtain');

  /* ---------- 1. 双主题 ---------- */
  function applyUiTheme(theme,animate){
    const next=theme==='dark'?'dark':'light';
    const swap=()=>{
      root.dataset.uiTheme=next;
      if(document.body)document.body.dataset.uiTheme=next;
      const sel=$('uiThemeSelect');if(sel)sel.value=next;
      const lab=$('uiThemeLabel');if(lab)lab.textContent=next==='dark'?'深夜暴雨':'雨光白昼';
      const mlabel=$('menuThemeLabel');if(mlabel)mlabel.textContent=next==='dark'?'雨光白昼':'暗色模式';
      document.dispatchEvent(new CustomEvent('door:uitheme',{detail:{theme:next}}));
    };
    if(!animate||SETTINGS.reduceMotion||document.body.classList.contains('reduce-motion')){swap();return;}
    if(!curtain){swap();return;}
    curtain.classList.remove('run');void curtain.offsetWidth;curtain.classList.add('run');
    clearTimeout(applyUiTheme._t);
    applyUiTheme._t=setTimeout(swap,380);
    setTimeout(()=>curtain.classList.remove('run'),1000);
  }
  window.applyUiTheme=applyUiTheme;
  window.setUiTheme=function(value,animate){
    if(typeof SETTINGS==='undefined')return;
    SETTINGS.uiTheme=value==='dark'?'dark':'light';
    try{localStorage.setItem('rg_settings',JSON.stringify(SETTINGS));}catch(e){}
    applyUiTheme(SETTINGS.uiTheme,animate===true);
  };
  window.toggleUiTheme=function(){
    const next=(SETTINGS&&SETTINGS.uiTheme==='dark')?'light':'dark';
    window.setUiTheme(next,true);
  };
  applyUiTheme(typeof SETTINGS!=='undefined'?SETTINGS.uiTheme:'light',false);

  /* ---------- 2. 雨痕玻璃 + 亚克力质感 ---------- */
  /* 雨痕玻璃只覆盖三块面积最大的面板，控制重绘成本。 */
  const streakTargets=['#songselect .track-stage','#songselect .library-aside','#settings .settings-panel','#result .result-hero'];
  function decoratePanels(){
    streakTargets.forEach(sel=>{
      document.querySelectorAll(sel).forEach(el=>{
        if(!el.classList.contains('rl-streaks')){
          el.classList.add('rl-streaks','rl-acrylic');
          const layer=document.createElement('div');layer.className='rl-streak-layer';
          el.insertBefore(layer,el.firstChild);
        }
      });
    });
  }
  decoratePanels();

  /* ---------- 3. 漂浮物件（按画质分级） ---------- */
  const objects=$('rlObjects');
  const shapeClass=['rl-obj-orb','rl-obj-ring','rl-obj-shard','rl-obj-drop'];
  let objSignature='';
  function buildObjects(){
    if(!objects)return;
    const quality=(typeof SETTINGS!=='undefined'&&SETTINGS.renderQuality)||'low';
    const count=quality==='high'?22:quality==='balanced'?13:7;
    const sig=quality+'|'+count;
    if(sig===objSignature)return;
    objSignature=sig;
    objects.replaceChildren();
    if(typeof SETTINGS!=='undefined'&&(SETTINGS.reduceMotion||document.body.classList.contains('reduce-motion')))return;
    for(let i=0;i<count;i++){
      const el=document.createElement('i');
      const size=quality==='high'?8+Math.random()*34:10+Math.random()*26;
      el.className='rl-obj '+shapeClass[i%shapeClass.length];
      el.style.width=size.toFixed(1)+'px';el.style.height=size.toFixed(1)+'px';
      el.style.left=(Math.random()*96).toFixed(2)+'%';
      el.style.top=(Math.random()*92).toFixed(2)+'%';
      el.style.opacity=(quality==='high'?.34:.24).toFixed(2);
      el.style.setProperty('--ox',(Math.random()*44-22).toFixed(1)+'px');
      el.style.setProperty('--oy',(Math.random()*52-30).toFixed(1)+'px');
      el.style.animation='rlObjDrift '+(22+Math.random()*30).toFixed(1)+'s ease-in-out '+(-Math.random()*30).toFixed(1)+'s infinite';
      objects.appendChild(el);
    }
  }
  buildObjects();
  window.addEventListener('resize',()=>{clearTimeout(buildObjects._t);buildObjects._t=setTimeout(buildObjects,400);},{passive:true});

  /* ---------- 4. 曲绘取色（新意 2）：把曲绘主色映射到环境光与按钮 ---------- */
  function applyCoverAccent(url){
    if(!url){root.style.removeProperty('--cover-accent');root.style.removeProperty('--cover-accent-soft');return;}
    const img=new Image();
    img.onload=()=>{
      try{
        const c=document.createElement('canvas');c.width=18;c.height=18;
        const cx=c.getContext('2d',{willReadFrequently:true});
        cx.drawImage(img,0,0,18,18);
        const d=cx.getImageData(0,0,18,18).data;
        let r=0,g=0,b=0,n=0;
        for(let i=0;i<d.length;i+=4){if(d[i+3]<128)continue;r+=d[i];g+=d[i+1];b+=d[i+2];n++;}
        if(!n)return;
        r=Math.round(r/n);g=Math.round(g/n);b=Math.round(b/n);
        // 压低亮度、抬高饱和度，避免取色过灰或过亮而破坏整体和谐。
        const mx=Math.max(r,g,b)||1,boost=1.28;
        r=Math.min(255,Math.round(r/mx*Math.max(mx,120)*boost/1.35));
        g=Math.min(255,Math.round(g/mx*Math.max(mx,120)*boost/1.35));
        b=Math.min(255,Math.round(b/mx*Math.max(mx,120)*boost/1.35));
        root.style.setProperty('--cover-accent','rgb('+r+','+g+','+b+')');
        root.style.setProperty('--cover-accent-soft','rgba('+r+','+g+','+b+',.22)');
      }catch(e){/* file:// 下画布可能被污染，取色失败时保持默认配色 */}
    };
    img.src=url;
  }
  const coverImg=$('coverImage');
  if(coverImg){
    const sync=()=>{
      const src=coverImg.getAttribute('src')||'';
      if(src===sync._last)return;
      sync._last=src;
      applyCoverAccent(coverImg.hidden?'':src);
    };
    new MutationObserver(sync).observe(coverImg,{attributes:true,attributeFilter:['src','hidden']});
    sync();
  }

  /* ---------- 5. 菜单快捷入口与全局快捷键 ---------- */
  window.gotoImport=function(){
    showScreen('songselect');
    setTimeout(()=>{
      const zone=$('dropZone');if(!zone)return;
      try{zone.scrollIntoView({block:'center',behavior:SETTINGS.reduceMotion?'auto':'smooth'});}catch(e){}
      zone.classList.add('drag');
      setTimeout(()=>zone.classList.remove('drag'),1400);
    },420);
  };
  document.addEventListener('keydown',e=>{
    if(e.key!=='t'&&e.key!=='T')return;
    const tag=(e.target&&e.target.tagName||'').toLowerCase();
    if(tag==='input'||tag==='select'||tag==='textarea')return;
    if(typeof gameState!=='undefined'&&(gameState==='game'||gameState==='paused'||gameState==='transition'))return;
    window.toggleUiTheme();
  });

  /* 画质变化时重建物件，保持数量与档位一致。 */
  document.addEventListener('change',e=>{
    if(e.target&&e.target.id==='qualitySelect')setTimeout(buildObjects,80);
  },true);
})();
</script>

</body>
</html>
