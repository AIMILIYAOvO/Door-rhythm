<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Door v17.4 — Ver.1.0 Rainlight Glass Redesign | 4K Rhythm Game</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
/* v14 responsive guardrails: safe-area-aware full-screen layout and touch-safe feedback */
.screen{padding-top:env(safe-area-inset-top,0px);padding-right:env(safe-area-inset-right,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-left:env(safe-area-inset-left,0px)}
@media (hover:hover) and (pointer:fine){button:hover,.menu-btn:hover,.diff-btn:hover{filter:brightness(1.08)}}
@media (hover:none),(pointer:coarse){button:hover,.menu-btn:hover,.diff-btn:hover{transform:none;box-shadow:none}}
@media (max-width:600px){#game{touch-action:none}.hud-live-footer{max-width:calc(100vw - 16px)}.pause-overlay{max-height:calc(100dvh - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));overflow:auto}}

html,body{width:100%;height:100%;overflow:hidden;background:#0a0e1a;color:#f1f5f9;font-family:"Segoe UI","Microsoft YaHei",system-ui,sans-serif;touch-action:none}
canvas{display:block;position:absolute;top:0;left:0}
.screen{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;z-index:5}
.screen.active{display:flex}

/* ===== 主菜单 ===== */
#menu{background:transparent}
#menuBg{position:absolute;inset:0;z-index:-1}
.menu-content{position:relative;z-index:1;text-align:center}
#menu h1{font-size:clamp(34px,7vw,68px);font-weight:900;letter-spacing:5px;background:linear-gradient(135deg,#67e8f9 0%,#a78bfa 50%,#fb7185 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:6px;filter:drop-shadow(0 0 30px rgba(103,232,249,0.3))}
#menu .sub{color:#64748b;font-size:13px;margin-bottom:36px;letter-spacing:4px}
.menu-btn{width:260px;padding:13px 22px;margin:7px;font-size:15px;font-weight:600;border:1.5px solid #2a3548;border-radius:10px;background:rgba(20,28,48,0.75);color:#e2e8f0;cursor:pointer;transition:all .18s;letter-spacing:1.5px;backdrop-filter:blur(8px)}
.menu-btn:hover{border-color:#67e8f9;background:rgba(103,232,249,0.08);transform:translateY(-2px);box-shadow:0 6px 20px rgba(103,232,249,0.15)}
.menu-btn.primary{border-color:rgba(167,139,250,0.5);background:rgba(167,139,250,0.12)}
.menu-btn.primary:hover{border-color:#a78bfa;background:rgba(167,139,250,0.2);box-shadow:0 6px 24px rgba(167,139,250,0.25)}
.menu-hint{margin-top:28px;color:#3d4a5f;font-size:11px;line-height:2}
.menu-hint kbd{background:#1a2236;border:1px solid #2a3548;border-radius:4px;padding:1px 7px;font-size:10px;color:#7a8ba5}

/* ===== 选歌 ===== */
#songselect{background:#0a0e1a;padding:16px;overflow-y:auto;z-index:5}
.song-header{width:100%;max-width:860px;display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.song-header h2{font-size:22px;font-weight:700}
.song-list{width:100%;max-width:860px;display:flex;flex-direction:column;gap:7px}
.song-card{display:flex;align-items:center;padding:13px 16px;background:rgba(20,28,48,0.7);border:1.5px solid transparent;border-radius:10px;cursor:pointer;transition:all .15s;backdrop-filter:blur(6px)}
.song-card:hover{background:rgba(30,41,66,0.9);border-color:#3d4a5f}
.song-card .info{flex:1;min-width:0}
.song-card .title{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.song-card .artist{font-size:11px;color:#7a8ba5;margin-top:2px}
.song-card .diff{display:flex;gap:5px;margin-left:10px;flex-shrink:0}
.diff-tag{padding:3px 9px;border-radius:5px;font-size:10px;font-weight:700;letter-spacing:.5px}
.diff-easy{background:rgba(80,220,120,0.15);color:#50dc78}
.diff-normal{background:rgba(103,232,249,0.15);color:#67e8f9}
.diff-hard{background:rgba(253,224,71,0.15);color:#fde047}
.diff-expert{background:rgba(251,113,133,0.15);color:#fb7185}
.drop-zone{width:100%;max-width:860px;padding:24px;border:2px dashed #2a3548;border-radius:10px;text-align:center;color:#4a5a75;font-size:13px;margin-bottom:14px;transition:all .2s;cursor:pointer}
.drop-zone.drag{border-color:#67e8f9;background:rgba(103,232,249,0.05);color:#67e8f9}
.back-btn{padding:7px 14px;background:rgba(20,28,48,0.8);border:1px solid #2a3548;border-radius:7px;color:#7a8ba5;cursor:pointer;font-size:12px}
.back-btn:hover{color:#e2e8f0}

/* ===== 游戏HUD ===== */
#gameHUD{position:absolute;top:0;left:0;right:0;pointer-events:none;z-index:10;padding:12px 16px;display:none;justify-content:space-between;align-items:flex-start}
#gameHUD.active{display:flex}
.hud-score{font-size:clamp(22px,4vw,30px);font-weight:900;color:#fde047;text-shadow:0 0 18px rgba(253,224,71,0.35);font-variant-numeric:tabular-nums}
.hud-acc{font-size:clamp(11px,2vw,14px);color:#94a3b8;margin-top:1px;font-variant-numeric:tabular-nums}
.hud-center{text-align:center;position:absolute;left:50%;transform:translateX(-50%)}
.hud-combo{font-size:clamp(36px,7vw,52px);font-weight:900;line-height:1;text-shadow:0 0 25px rgba(167,139,250,0.4);font-variant-numeric:tabular-nums;transition:transform .08s}
.hud-combo.pulse{transform:scale(1.15)}
.hud-combo-label{font-size:10px;color:#4a5a75;letter-spacing:3px;margin-top:3px}
.hud-song{text-align:right;max-width:200px}
.hud-song .t{font-size:13px;font-weight:600;color:#cbd5e1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hud-song .a{font-size:10px;color:#64748b;margin-top:1px}
.auto-badge{position:absolute;top:12px;left:50%;transform:translateX(-50%) translateY(30px);background:rgba(80,220,120,0.15);border:1px solid rgba(80,220,120,0.5);color:#50dc78;padding:3px 12px;border-radius:16px;font-size:11px;font-weight:700;letter-spacing:2px;display:none;z-index:11}
.auto-badge.active{display:block}

/* 进度条 */
.progress-bar{position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(42,53,72,0.5);z-index:10;display:none}
.progress-bar.active{display:block}
.progress-fill{height:100%;background:linear-gradient(90deg,#67e8f9,#a78bfa);width:0%;transition:width .1s linear}

/* 4:3侧面板 */
.side-panel{position:absolute;top:0;bottom:0;width:calc((100vw - min(100vw, 133.33vh)) / 2);background:rgba(10,14,26,0.85);backdrop-filter:blur(10px);z-index:8;display:none;flex-direction:column;padding:60px 16px 20px;gap:14px;overflow:hidden}
.side-panel.active{display:flex}
#leftPanel{left:0;border-right:1px solid rgba(42,53,72,0.5)}
#rightPanel{right:0;border-left:1px solid rgba(42,53,72,0.5)}
.panel-section{background:rgba(20,28,48,0.6);border:1px solid rgba(42,53,72,0.4);border-radius:8px;padding:10px 12px}
.panel-title{font-size:10px;color:#4a5a75;letter-spacing:2px;margin-bottom:8px;text-transform:uppercase}
.judge-row{display:flex;justify-content:space-between;align-items:center;padding:3px 0;font-size:13px}
.judge-row .jl{display:flex;align-items:center;gap:6px}
.judge-dot{width:8px;height:8px;border-radius:2px}
.judge-row .jv{font-weight:700;font-variant-numeric:tabular-nums}
.acc-big{font-size:28px;font-weight:900;text-align:center;font-variant-numeric:tabular-nums;line-height:1}
.acc-label{font-size:10px;color:#4a5a75;text-align:center;margin-top:3px;letter-spacing:1px}
#offsetCanvas{width:100%;height:120px;display:block}
.energy-bar{height:6px;background:rgba(42,53,72,0.5);border-radius:3px;overflow:hidden;margin-top:6px}
.energy-fill{height:100%;background:linear-gradient(90deg,#f05050,#fde047,#50dc78);width:100%;transition:width .2s}

/* 暂停 */
/* v15: legacy pause overlay base moved to final override. */
.pause-overlay.active{display:flex}
.pause-overlay h2{font-size:32px;font-weight:900;margin-bottom:22px;letter-spacing:4px}

/* 结算 */
#result{background:radial-gradient(ellipse at 50% 40%,#141c30 0%,#0a0e1a 70%)}
.result-rank{font-size:clamp(56px,14vw,110px);font-weight:900;margin-bottom:6px;line-height:1}
.result-badges{display:flex;gap:10px;margin-bottom:20px;min-height:28px}
.badge{padding:5px 14px;border-radius:16px;font-size:12px;font-weight:700;letter-spacing:1.5px}
.badge-fc{background:rgba(80,220,120,0.15);color:#50dc78;border:1px solid rgba(80,220,120,0.5)}
.badge-ap{background:rgba(253,224,71,0.15);color:#fde047;border:1px solid rgba(253,224,71,0.5)}
.result-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 36px;margin-bottom:26px}
.stat-row{display:flex;justify-content:space-between;gap:30px;font-size:14px}
.stat-row .label{color:#7a8ba5}
.stat-row .val{font-weight:700;font-variant-numeric:tabular-nums}
.val.perfect{color:#50dc78}.val.great{color:#67e8f9}.val.good{color:#fde047}.val.bad{color:#fb923c}.val.miss{color:#f05050}

/* 设置 */
#settings{background:#0a0e1a;padding:24px;overflow-y:auto;z-index:5}
.settings-panel{width:100%;max-width:480px;background:rgba(20,28,48,0.7);border:1px solid #2a3548;border-radius:14px;padding:22px;backdrop-filter:blur(8px)}
.settings-panel h2{font-size:20px;margin-bottom:18px}
.setting-item{margin-bottom:16px}
.setting-item label{display:block;font-size:12px;color:#7a8ba5;margin-bottom:5px}
.setting-item input[type=range]{width:100%;accent-color:#67e8f9;height:4px}
.setting-item .vd{float:right;color:#67e8f9;font-weight:600;font-size:13px}
.setting-item select{width:100%;padding:7px 10px;background:#141c30;border:1px solid #2a3548;border-radius:7px;color:#e2e8f0;font-size:13px}
.toggle-row{display:flex;justify-content:space-between;align-items:center}
.toggle{width:42px;height:22px;background:#2a3548;border-radius:11px;position:relative;cursor:pointer;transition:background .2s;flex-shrink:0}
.toggle.on{background:#67e8f9}
.toggle::after{content:'';position:absolute;top:2px;left:2px;width:18px;height:18px;background:#f1f5f9;border-radius:50%;transition:transform .2s}
.toggle.on::after{transform:translateX(20px)}


.diff-btn{flex:1;padding:10px;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;letter-spacing:1px}
.diff-btn-easy{background:rgba(80,220,120,0.15);color:#50dc78;border:1px solid rgba(80,220,120,0.3)}
.diff-btn-easy:hover{background:rgba(80,220,120,0.3)}
.diff-btn-normal{background:rgba(103,232,249,0.15);color:#67e8f9;border:1px solid rgba(103,232,249,0.3)}
.diff-btn-normal:hover{background:rgba(103,232,249,0.3)}
.diff-btn-hard{background:rgba(253,224,71,0.15);color:#fde047;border:1px solid rgba(253,224,71,0.3)}
.diff-btn-hard:hover{background:rgba(253,224,71,0.3)}
.diff-btn-expert{background:rgba(251,113,133,0.15);color:#fb7185;border:1px solid rgba(251,113,133,0.3)}
.diff-btn-expert:hover{background:rgba(251,113,133,0.3)}

/* 加载 */
.loading{position:absolute;inset:0;background:rgba(10,14,26,0.95);display:none;flex-direction:column;align-items:center;justify-content:center;z-index:100}
.loading.active{display:flex}
.spinner{width:36px;height:36px;border:3px solid #2a3548;border-top-color:#67e8f9;border-radius:50%;animation:spin .9s linear infinite;margin-bottom:14px}
@keyframes spin{to{transform:rotate(360deg)}}
.loading p{color:#7a8ba5;font-size:13px}

/* 模式切换按钮（游戏内） */
.mode-btn{position:absolute;top:12px;right:12px;z-index:12;width:32px;height:32px;border-radius:8px;background:rgba(20,28,48,0.7);border:1px solid #2a3548;color:#7a8ba5;font-size:14px;cursor:pointer;display:none;align-items:center;justify-content:center;pointer-events:auto}
.mode-btn.active{display:flex}
.mode-btn:hover{color:#e2e8f0;border-color:#3d4a5f}

/* 【v5】键盘键位绑定 */
.key-bind-btn{flex:1;padding:9px 0;background:#141c30;border:1px solid #2a3548;border-radius:8px;color:#e2e8f0;font-size:15px;font-weight:700;cursor:pointer;transition:all .15s;letter-spacing:1px}
.key-bind-btn:hover{border-color:#67e8f9;color:#67e8f9}
.key-bind-btn.capturing{border-color:#fde047;color:#fde047;animation:bindBlink 1s infinite}
@keyframes bindBlink{50%{opacity:.35}}
#audioHint{position:absolute;top:84px;left:50%;transform:translateX(-50%);background:rgba(253,224,71,0.12);border:1px solid rgba(253,224,71,0.45);color:#fde047;padding:7px 16px;border-radius:16px;font-size:12px;letter-spacing:1px;z-index:15;display:none;pointer-events:none;white-space:nowrap}
#dbgLog{position:absolute;top:92px;right:14px;z-index:16;font-size:11px;color:#94a3b8;font-family:Consolas,monospace;line-height:1.7;text-align:right;display:none;pointer-events:none;text-shadow:0 1px 2px #000}

/* ===== v8 UI refinement ===== */
:root{color-scheme:dark;--ui-border:rgba(148,163,184,.16);--ui-glass:rgba(15,23,42,.78);--ui-cyan:#67e8f9;--ui-violet:#a78bfa}
button,select,input{font:inherit}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--ui-cyan);outline-offset:3px}
.screen{padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right));padding-top:max(12px,env(safe-area-inset-top));padding-bottom:max(12px,env(safe-area-inset-bottom))}
.menu-content{width:min(92vw,560px);padding:clamp(20px,4vw,38px);border:1px solid rgba(148,163,184,.12);border-radius:24px;background:linear-gradient(145deg,rgba(15,23,42,.68),rgba(10,14,26,.4));box-shadow:0 24px 90px rgba(0,0,0,.24);backdrop-filter:blur(18px)}
#menu h1{font-size:clamp(36px,8vw,70px);letter-spacing:clamp(2px,.6vw,6px)}
.menu-btn{min-height:46px;border-radius:12px;transition:transform .16s,border-color .16s,background .16s,box-shadow .16s}
.menu-btn:active,.back-btn:active,.diff-btn:active{transform:scale(.985)}
.song-card{border-color:var(--ui-border);box-shadow:0 6px 20px rgba(0,0,0,.08)}
.song-card.selected{border-color:rgba(103,232,249,.6);background:rgba(103,232,249,.075)}
.drop-zone{border-radius:14px;min-height:82px;display:flex;align-items:center;justify-content:center;line-height:1.8}
.settings-panel{border-color:var(--ui-border);box-shadow:0 20px 60px rgba(0,0,0,.2)}
.setting-item{padding-bottom:2px}
.setting-item input[type=range]{cursor:pointer}
.toggle{outline-offset:3px}
#game{touch-action:none;overscroll-behavior:contain}
#dbgLog{display:none}
#pauseOverlay{padding:20px max(18px,env(safe-area-inset-right)) 20px max(18px,env(safe-area-inset-left))}
.result-stats{width:min(90vw,420px);gap:9px 24px}

/* ===== v9：结果页与低延迟视觉系统 ===== */
#result{justify-content:flex-start;align-items:center;overflow-y:auto;overscroll-behavior:contain;padding:clamp(16px,3vh,30px) 14px 28px;gap:0}
.result-wrap{width:min(100%,920px);margin:auto 0;display:flex;flex-direction:column;align-items:stretch;gap:16px;padding:clamp(10px,2vw,22px) 0}
.result-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid var(--ui-border);padding:0 4px 14px}
.result-kicker{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#64748b}
.result-song-title{font-size:clamp(18px,3vw,26px);font-weight:800;line-height:1.25;overflow-wrap:anywhere}
.result-song-artist{font-size:12px;color:#8ea0b9;margin-top:5px}
.result-hero{display:grid;grid-template-columns:minmax(100px,180px) 1fr;align-items:center;gap:20px;padding:20px;border:1px solid var(--ui-border);border-radius:20px;background:linear-gradient(140deg,rgba(30,41,59,.78),rgba(15,23,42,.72));box-shadow:0 18px 48px rgba(0,0,0,.18)}
.result-rank{font-size:clamp(72px,12vw,112px);text-align:center;font-weight:950;line-height:.95;margin:0;letter-spacing:-5px}
.result-hero-meta{min-width:0}
.result-badges{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 0;min-height:0}
.result-judge-label{font-size:11px;color:#8ea0b9;margin-top:10px}
.result-metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.result-metric{min-width:0;padding:14px 15px;border:1px solid var(--ui-border);border-radius:14px;background:rgba(20,28,48,.65)}
.result-metric .m-label{font-size:11px;color:#8292aa;margin-bottom:7px}
.result-metric .m-value{font-size:clamp(18px,2.5vw,27px);font-weight:850;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.result-section{padding:17px;border:1px solid var(--ui-border);border-radius:16px;background:rgba(15,23,42,.52)}
.result-section-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:13px}
.result-section-head h3{font-size:13px;font-weight:750;letter-spacing:.4px}
.result-section-head span{font-size:10px;color:#64748b}
.result-judgebar{height:12px;display:flex;overflow:hidden;border-radius:99px;background:#202b40;margin-bottom:14px;gap:2px}
.result-judgebar span{display:block;min-width:0;transition:width .2s}
.result-judgegrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.result-judgecell{background:rgba(30,41,59,.58);border-radius:10px;padding:10px 9px;min-width:0}
.result-judgecell .j-name{font-size:10px;color:#8190a6}
.result-judgecell .j-count{font-size:21px;font-weight:850;margin-top:5px;font-variant-numeric:tabular-nums}
.result-judgecell .j-rate{font-size:10px;color:#64748b;margin-top:3px}
.result-detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.result-detail{display:flex;flex-direction:column;gap:6px;padding:11px 12px;background:rgba(30,41,59,.42);border-radius:10px;min-width:0}
.result-detail .d-label{font-size:10px;color:#8292aa}
.result-detail .d-value{font-size:16px;font-weight:750;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.result-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding-top:2px}
.result-actions .menu-btn{margin:0}
.result-note{color:#64748b;font-size:10px;line-height:1.7;text-align:center}
.quality-hint{font-size:10px;color:#64748b;line-height:1.7;margin-top:5px}
@media(max-width:600px){
  #result{padding:10px 10px 20px;justify-content:flex-start}
  .result-wrap{gap:10px;padding:8px 0}
  .result-heading{padding-bottom:10px}
  .result-hero{grid-template-columns:88px 1fr;gap:12px;padding:14px;border-radius:15px}
  .result-rank{font-size:70px;letter-spacing:-3px}
  .result-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .result-metric{padding:11px 12px}
  .result-metric .m-value{font-size:22px}
  .result-section{padding:12px}
  .result-judgegrid{gap:5px}
  .result-judgecell{padding:8px 6px}
  .result-judgecell .j-count{font-size:18px}
  .result-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
  .result-detail{padding:10px}
  .result-actions{display:grid;grid-template-columns:1fr 1fr;width:100%}
  .result-actions .menu-btn{width:100%;padding:12px 8px;font-size:12px}
}
@media(min-width:601px) and (max-height:760px){.result-wrap{gap:10px}.result-hero{padding:14px}.result-section{padding:12px}}

@media(max-width:600px){
  #songselect{padding:12px 10px;justify-content:flex-start;padding-top:max(14px,env(safe-area-inset-top))}
  .song-header h2{font-size:18px}.song-header{margin-top:6px}
  .song-card{padding:12px 10px}.song-card .title{font-size:14px}.song-card .diff{gap:3px;margin-left:5px}.diff-tag{padding:3px 5px;font-size:9px}
  .drop-zone{padding:12px;font-size:12px}
  #settings{padding:12px 10px;justify-content:flex-start}
  .settings-panel{padding:18px 16px;margin:auto 0}
  .side-panel{padding:60px 6px 12px;gap:7px}.panel-section{padding:7px 6px}.judge-row{font-size:11px}.acc-big{font-size:22px}
  .result-stats{gap:8px 16px}.stat-row{font-size:12px;gap:14px}
  .hud-song{max-width:30vw}.hud-song .t{font-size:11px}.hud-song .a{font-size:9px}
}


/* ==========================================================
   Door v10 · SOFT PORTAL design system
   Visual layer only: keep judgement/input logic unchanged.
   ========================================================== */
:root{
  color-scheme:light;
  --paper:#F7FBFF;
  --surface:#FFFFFF;
  --surface-soft:#F1F8FD;
  --surface-blue:#E8F6FC;
  --surface-pink:#FFF0F6;
  --ink:#293B52;
  --ink-soft:#526B83;
  --text-muted:#8296A9;
  --line:#DCE9F2;
  --line-strong:#C8DDEB;
  --blue:#55B7D4;
  --blue-deep:#278DB5;
  --pink:#E79ABF;
  --pink-deep:#C86F9B;
  --lilac:#A39BE5;
  --mint:#80CFC0;
  --ui-border:rgba(88,132,162,.17);
  --ui-glass:rgba(255,255,255,.86);
  --ui-cyan:#55B7D4;
  --ui-violet:#A39BE5;
  --shadow-soft:0 18px 48px rgba(71,127,158,.10);
}
html,body{background:var(--paper);color:var(--ink);font-family:Inter,"Aptos","Segoe UI","Microsoft YaHei","PingFang SC",system-ui,sans-serif;}
button,select,input{color:inherit}
button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid #4FAFCF;outline-offset:3px}
.screen{padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right));}

/* Home */
#menu{background:transparent;align-items:center;justify-content:center;overflow:auto;touch-action:pan-y}
.menu-content{width:min(1120px,100%);min-height:min(690px,calc(100vh - 32px));padding:clamp(22px,4vw,54px) clamp(20px,5vw,64px) 18px;border:1px solid rgba(188,218,234,.72);border-radius:30px;background:rgba(255,255,255,.72);box-shadow:0 24px 80px rgba(78,137,169,.10);backdrop-filter:blur(12px);display:grid;grid-template-columns:minmax(320px,.95fr) minmax(300px,1.05fr);grid-template-rows:1fr auto;gap:18px 30px;text-align:left;position:relative;overflow:hidden;}
.menu-content:before{content:"";position:absolute;width:440px;height:440px;right:-190px;top:-220px;border-radius:50%;background:radial-gradient(circle,rgba(196,235,249,.58),rgba(196,235,249,0) 68%);pointer-events:none}
.menu-copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-width:0;padding:8px 0 18px}
.brand-lockup{display:flex;align-items:center;gap:10px;margin-bottom:42px;color:#376785}
.brand-icon{width:39px;height:39px;display:block;color:#5CBAD7}
.brand-word{font-size:25px;font-weight:800;letter-spacing:-1.2px;color:#2F4C63}
.menu-eyebrow,.section-eyebrow{display:flex;align-items:center;gap:8px;color:#7797AA;font-size:10px;font-weight:750;letter-spacing:2.1px;text-transform:uppercase}
.eyebrow-dot{width:6px;height:6px;border-radius:50%;background:#E7A1C4;box-shadow:0 0 0 4px rgba(231,161,196,.16)}
#menu h1{margin:20px 0 12px;font-size:clamp(46px,5.8vw,76px);font-weight:760;letter-spacing:-3.5px;line-height:.98;background:none;color:#2B4158;-webkit-text-fill-color:currentColor;filter:none;text-shadow:none}
#menu h1 em{font-style:normal;color:#4AA9CB;position:relative}
#menu h1 em:after{content:"";position:absolute;height:8px;left:2px;right:0;bottom:-6px;border-radius:9px;background:linear-gradient(90deg,#9ADFF1,#F1BED6);opacity:.82}
.menu-subtitle{max-width:360px;margin:11px 0 28px;color:#71879A;font-size:14px;line-height:1.9;letter-spacing:.15px}
.menu-actions{width:min(100%,360px);display:flex;flex-direction:column;align-items:stretch;gap:10px}
.menu-btn{width:260px;min-height:47px;margin:0;padding:13px 18px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.9);color:#49647C;box-shadow:0 4px 14px rgba(74,123,151,.045);font-size:13px;font-weight:700;letter-spacing:.35px;backdrop-filter:none;display:inline-flex;align-items:center;justify-content:center;gap:14px;transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease}
.menu-actions .menu-btn{width:100%;justify-content:space-between;padding:14px 18px}
.menu-btn:hover{transform:translateY(-1px);border-color:#9CCFE2;background:#F9FDFF;box-shadow:0 8px 18px rgba(74,145,177,.09)}
.menu-btn.primary{background:linear-gradient(110deg,#B6EAF7,#F1D5E6);border-color:transparent;color:#29495F;box-shadow:0 8px 20px rgba(116,192,219,.14)}
.menu-btn.primary:hover{background:linear-gradient(110deg,#A8E4F4,#F0C9DD);border-color:transparent;box-shadow:0 10px 24px rgba(116,192,219,.2)}
.menu-btn.secondary{background:rgba(255,255,255,.7)}
.btn-arrow{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;background:rgba(255,255,255,.52);font-size:17px;line-height:1}
.button-symbol{font-size:17px;color:#76BFD8}
.menu-hint{width:100%;margin-top:30px;color:#8397A9;font-size:11px;line-height:1.9;letter-spacing:0}
.key-hint-row{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.key-hint-row kbd,.menu-hint kbd{display:inline-flex;align-items:center;justify-content:center;min-width:26px;min-height:24px;padding:1px 6px;border:1px solid #D8E7F0;border-radius:7px;background:#FFFFFF;color:#5C7890;font-size:10px;font-family:inherit;box-shadow:0 2px 0 #E7F0F6}
.key-hint-row span{margin:0 8px 0 3px;color:#8397A9;font-size:10px}
.key-hint-row i{height:12px;width:1px;background:#D8E5ED;margin:0 5px}
.hint-secondary{margin-top:8px;color:#9AAABA;font-size:10px}
.menu-visual{position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;min-height:400px;overflow:hidden;border-radius:24px;background:linear-gradient(145deg,rgba(231,247,253,.72),rgba(255,241,247,.75));border:1px solid rgba(209,232,242,.68)}
.menu-visual:after{content:"";position:absolute;inset:18px;border:1px solid rgba(255,255,255,.74);border-radius:18px;pointer-events:none}
.portal-art{position:relative;z-index:2;width:min(100%,420px);height:auto;max-height:470px;filter:drop-shadow(0 12px 20px rgba(86,163,195,.10));}
.visual-halo{position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}
.halo-blue{width:250px;height:250px;top:4%;left:0;background:radial-gradient(circle,rgba(132,220,242,.52),rgba(132,220,242,0) 72%)}
.halo-pink{width:250px;height:250px;right:-2%;bottom:0;background:radial-gradient(circle,rgba(242,181,210,.44),rgba(242,181,210,0) 72%)}
.portal-orbit{position:absolute;border:1px solid rgba(113,190,218,.25);border-radius:50%;width:320px;height:320px;z-index:1;pointer-events:none}
.orbit-one{transform:rotate(-24deg) scaleX(.72);}
.orbit-two{transform:rotate(38deg) scaleX(.9) scaleY(.88);border-color:rgba(231,161,196,.25)}
.visual-caption{position:absolute;bottom:26px;left:0;right:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:9px;color:#82A0B3;font-size:9px;letter-spacing:2px;font-weight:700}
.caption-line{width:22px;height:1px;background:#B7DCEB}
.floating-chip{position:absolute;z-index:4;padding:9px 12px;background:rgba(255,255,255,.83);border:1px solid rgba(255,255,255,.92);border-radius:12px;color:#66879E;font-size:9px;letter-spacing:1.1px;font-weight:750;box-shadow:0 8px 20px rgba(79,134,163,.07)}
.chip-top{top:14%;right:7%}.chip-bottom{bottom:15%;left:6%}
.chip-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#7CCBBB;margin-right:5px}
.chip-wave{font-size:15px;color:#D88EB5;vertical-align:-1px;margin-right:3px}
.menu-footer{grid-column:1/-1;display:flex;justify-content:space-between;gap:12px;padding-top:14px;border-top:1px solid #E4EEF4;color:#9AABBA;font-size:9px;font-weight:650;letter-spacing:1.4px}

/* Song library and external beatmap directory */
#songselect{background:transparent;align-items:stretch;justify-content:flex-start;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;padding-top:max(14px,env(safe-area-inset-top));padding-bottom:20px}
.song-page-shell{width:min(1190px,calc(100% - 32px));margin:16px auto;display:flex;flex-direction:column;gap:24px;min-height:100%;border:1px solid rgba(190,210,226,.62);border-radius:24px;padding:clamp(18px,2.5vw,28px);}
.page-header{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:48px;border-bottom:1px solid rgba(190,215,230,.72);padding:0 2px 14px}
.header-back{flex-shrink:0}
.mini-brand{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:800;letter-spacing:-.5px;color:#2F4C63}
.mini-brand-mark{display:grid;place-items:center;width:29px;height:29px;border-radius:10px;color:#357E9C;background:linear-gradient(145deg,#C2EDF8,#F7D5E6);font-weight:850;font-size:18px}
.header-note{color:#91A6B6;font-size:9px;font-weight:750;letter-spacing:1.5px}
.back-btn{min-height:35px;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.74);color:#688199;font-size:11px;font-weight:700;transition:background .15s,border-color .15s}
.back-btn:hover{color:#35536A;border-color:#BBDDEB;background:white}
.library-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:0}
.library-intro h2{margin-top:7px;font-size:clamp(34px,5vw,52px);line-height:1.08;letter-spacing:-1.7px;font-weight:780;color:#2C455C}
.library-intro h2 span{color:#55B7D4}
.library-intro p{margin-top:10px;color:#7D92A5;font-size:13px;line-height:1.7}
.library-count{display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid #DEEBF3;border-radius:13px;background:rgba(255,255,255,.68);color:#628096}
.count-mark{display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:#E5F5FC;color:#60B7D4;font-size:20px}
.library-count b{display:block;font-size:17px;color:#34546B;line-height:1.2}.library-count small{display:block;margin-top:3px;font-size:9px;color:#8BA0B1}
.library-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start;flex:1}
.library-main,.library-aside{min-width:0}
.library-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}
.library-section-title h3{font-size:15px;letter-spacing:.1px;color:#354F65;font-weight:800}
.library-section-title p{font-size:10px;color:#92A5B4;margin-top:4px}
.section-index{color:#A7C5D5;font-size:10px;font-weight:800;letter-spacing:1.5px}
.drop-zone{width:100%;max-width:none;min-height:114px;margin-bottom:16px;padding:18px;display:grid;grid-template-columns:44px 1fr;grid-template-rows:auto auto;justify-items:start;align-content:center;column-gap:13px;row-gap:5px;text-align:left;border:1px dashed #A9D6E7;border-radius:17px;background:rgba(255,255,255,.7);color:#587A91;transition:border-color .16s,background .16s;cursor:pointer}
.drop-zone:hover,.drop-zone.drag{border-color:#58B5D3;background:rgba(234,249,255,.92);color:#3C91B2}
.upload-icon{grid-row:1/3;width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(145deg,#D7F4FC,#F9DCEC);color:#489DBD;font-size:25px;font-weight:450}
.upload-main{font-weight:780;font-size:13px;color:#3D5E74;align-self:end}.upload-main b{color:#4DACC9;background:#E7F6FC;padding:3px 6px;border-radius:5px;font-size:10px}
.upload-sub{font-size:10px;color:#8AA2B4;align-self:start}
.song-list{width:100%;max-width:none;display:flex;flex-direction:column;gap:9px}
.song-card{padding:15px 16px;background:rgba(255,255,255,.85);border:1px solid #E0EBF2;border-radius:15px;box-shadow:0 5px 18px rgba(70,120,150,.035);transition:border-color .15s,background .15s,transform .15s;backdrop-filter:none}
.song-card:hover{background:#FFF;border-color:#B7DFED;transform:translateY(-1px)}
.song-card.selected{border-color:#8CCFE3;background:linear-gradient(110deg,#F4FCFF,#FFF7FB);box-shadow:0 6px 18px rgba(90,170,202,.08)}
.song-card .title{font-size:14px;font-weight:780;color:#344E64;letter-spacing:.05px}
.song-card .artist{font-size:10px;color:#8BA0B1;margin-top:5px}
.song-card .diff{gap:5px;margin-left:10px;flex-wrap:wrap;justify-content:flex-end}
.diff-tag{padding:4px 8px;border-radius:7px;font-size:9px;font-weight:800;letter-spacing:.5px}
.diff-easy{background:#E6F7EE;color:#438A67}.diff-normal{background:#E5F5FB;color:#347F9B}.diff-hard{background:#FFF4D9;color:#99721E}.diff-expert{background:#FCE7F1;color:#B95F8C}
.diff-btn{padding:11px 10px;border-radius:10px;font-size:11px;letter-spacing:.15px;cursor:pointer;min-width:0;transition:transform .15s,background .15s,border-color .15s}
.diff-btn-easy{background:#E8F7EF;color:#438A67;border:1px solid #CFECDD}.diff-btn-normal{background:#E6F6FC;color:#347F9B;border:1px solid #CAE9F4}.diff-btn-hard{background:#FFF5DE;color:#99721E;border:1px solid #F3E4B9}.diff-btn-expert{background:#FCEAF2;color:#B95F8C;border:1px solid #F2D4E2}
.diff-btn:hover{transform:translateY(-1px);filter:brightness(.985)}
.empty-library{padding:36px 22px;text-align:center;border:1px dashed #DBE8F0;border-radius:16px;background:rgba(255,255,255,.48);color:#849BAC;line-height:1.8}
.empty-note{display:grid;place-items:center;width:48px;height:48px;margin:0 auto 13px;border-radius:16px;background:linear-gradient(145deg,#DDF5FC,#FDEAF3);color:#69B8D2;font-size:25px}
.empty-library>b{display:block;font-size:14px;color:#506F85;margin-bottom:6px}
.empty-library p{max-width:390px;margin:0 auto;font-size:11px}
.empty-library strong{color:#4DACC9}.empty-library span{display:block;margin-top:9px;color:#A0B1BE;font-size:10px}
.library-aside{padding:17px;border:1px solid rgba(208,228,239,.85);border-radius:18px;background:rgba(255,255,255,.65);box-shadow:0 10px 30px rgba(78,130,157,.04)}
.library-aside .library-section-title{margin-bottom:15px}
.resource-card{display:flex;align-items:center;gap:10px;padding:11px 9px;margin-bottom:8px;border:1px solid #E3EDF3;border-radius:12px;background:rgba(255,255,255,.8);color:inherit;text-decoration:none;transition:border-color .15s,background .15s,transform .15s;min-width:0}
.resource-card:hover{border-color:#B8DCE9;background:white;transform:translateY(-1px)}
.resource-primary{background:linear-gradient(110deg,#ECF9FD,#FFF5FA);border-color:#D4EAF3}
.resource-icon{display:grid;place-items:center;flex:0 0 36px;width:36px;height:36px;border-radius:11px;font-weight:850;font-size:13px}
.sayo-icon{background:#E3F7FC;color:#3F95B4}.official-icon{background:#EDF0FF;color:#666AB3;font-size:12px}.pack-icon{background:#FFF0F6;color:#C36C94;font-size:10px}
.resource-text{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1}
.resource-text b{font-size:11px;color:#3F5A70}.resource-text small{font-size:9px;color:#8FA3B3;line-height:1.5}
.resource-arrow{align-self:center;color:#83ADC0;font-size:16px}
.resource-tip{display:flex;align-items:flex-start;gap:9px;padding:11px 10px;margin-top:13px;border-radius:11px;background:#F3F8FB;color:#8298A9}
.tip-icon{display:grid;place-items:center;flex:0 0 17px;width:17px;height:17px;border-radius:50%;background:#DCEFF7;color:#5797B3;font-size:10px;font-weight:800}
.resource-tip p{font-size:9px;line-height:1.8}.resource-tip b{color:#55758A}
.library-aside-footer{display:flex;align-items:center;gap:7px;margin-top:13px;color:#A0B0BD;font-size:8px;font-weight:750;letter-spacing:1.25px}
.tiny-orb{width:5px;height:5px;border-radius:50%;background:#9DCFE1}
.page-footer{display:flex;justify-content:space-between;gap:10px;border-top:1px solid rgba(190,215,230,.72);padding-top:12px;color:#A0AFBB;font-size:8px;font-weight:700;letter-spacing:1.3px}

/* Settings, panels, gameplay HUD and results */
#settings{background:transparent;overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;justify-content:flex-start}
.settings-panel{width:100%;max-width:620px;margin:auto;padding:clamp(20px,3vw,32px);border:1px solid #E0EBF2;border-radius:22px;background:rgba(255,255,255,.88);box-shadow:var(--shadow-soft);backdrop-filter:blur(12px)}
.settings-panel h2{font-size:25px;letter-spacing:-.8px;color:#304C63;margin-bottom:7px}
.settings-panel h2:after{content:"TUNE YOUR DOOR";display:block;margin-top:6px;color:#97AAB9;font-size:9px;font-weight:750;letter-spacing:1.8px}
.setting-item{margin:0;padding:14px 0;border-bottom:1px solid #EEF3F7}
.setting-item:last-of-type{border-bottom:0}
.setting-item label{display:block;font-size:12px;font-weight:700;color:#587186;margin-bottom:8px}
.setting-item .vd{color:#438EAB;font-size:12px;font-weight:800}
.setting-item input[type=range]{width:100%;accent-color:#63BCD7;height:5px;cursor:pointer}
.setting-item select{width:100%;min-height:39px;padding:9px 12px;border:1px solid #DDE9F1;border-radius:10px;background:#F9FCFE;color:#4C667A;font-size:12px;outline-offset:2px}
.setting-item select option{background:#FFFFFF;color:#293B52}
.quality-hint{color:#8BA0B0;font-size:10px;line-height:1.8;margin-top:7px}
.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:16px}
.toggle-row label{margin:0;flex:1}
.toggle{width:43px;height:24px;background:#D8E5ED;border-radius:99px;position:relative;cursor:pointer;transition:background .16s ease;flex-shrink:0}
.toggle.on{background:#75C7DF}
.toggle:after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;background:#FFF;border-radius:50%;box-shadow:0 1px 4px rgba(47,81,104,.18);transition:transform .16s ease}
.toggle.on:after{transform:translateX(19px)}
.key-bind-btn{background:#F7FBFE;border:1px solid #DCE9F1;border-radius:10px;color:#58788E;min-height:41px}
.key-bind-btn:hover{border-color:#A9D8E7;color:#388FAE}.key-bind-btn.capturing{border-color:#E8A5C6;color:#B75D89;animation:bindBlink 1s infinite}
.back-btn{font-weight:750}
#gameHUD{padding:14px 18px}
.hud-score{color:#9A741B;text-shadow:none;letter-spacing:-.6px}
.hud-acc{color:#71879A}
.hud-combo{color:#324D64;text-shadow:none}
.hud-combo-label{color:#88A0B2;font-size:9px;letter-spacing:2.3px}
.hud-song .t{color:#425D73}.hud-song .a{color:#8AA0B1}
.progress-bar{height:3px;background:rgba(133,173,195,.19)}
.progress-fill{background:linear-gradient(90deg,#65C7E0,#E8A5C6);transition:none}
.side-panel{background:rgba(248,252,255,.94);border-color:#DCEAF2;backdrop-filter:none;box-shadow:0 0 25px rgba(74,127,156,.035);padding-top:68px}
#leftPanel{border-right-color:#DCEAF2}#rightPanel{border-left-color:#DCEAF2}
.panel-section{background:#FFF;border:1px solid #E1ECF3;border-radius:12px;box-shadow:0 4px 14px rgba(78,130,157,.035)}
.panel-title,.acc-label{color:#8DA3B4}
.judge-row{color:#60788D}.judge-row .jv{color:#3B5A70}
.energy-bar{background:#EDF3F7}.energy-fill{background:linear-gradient(90deg,#E39BB9,#D5B76F,#7EC9B9)}
.mode-btn{border-color:#D7E6EF;background:rgba(255,255,255,.91);color:#5A93AA;border-radius:11px;box-shadow:0 4px 14px rgba(69,121,149,.09)}
.pause-overlay{background:rgba(242,249,253,.90);backdrop-filter:blur(10px)}
.pause-overlay h2{color:#2D4A61;letter-spacing:-.5px}
.auto-badge{background:#E4F8EE;border-color:#B7E4CD;color:#438A67}
#audioHint{background:#FFF4DB;border:1px solid #F0DDAF;color:#8E6C22;box-shadow:0 6px 24px rgba(131,108,54,.08)}
#dbgLog{color:#4C6A80;text-shadow:none}

/* Result report, keeping every existing metric */
#result{background:linear-gradient(135deg,#F8FCFF 0%,#F1F8FD 52%,#FFF5FA 100%);color:var(--ink)}
.result-heading{border-bottom-color:#DCE9F1}
.result-kicker{color:#7C9AAF;letter-spacing:2.4px}
.result-heading .back-btn{flex-shrink:0}
.result-hero{border-color:#DCEAF2;border-radius:21px;background:linear-gradient(125deg,rgba(255,255,255,.96),rgba(238,249,253,.94) 55%,rgba(255,244,249,.94));box-shadow:0 12px 32px rgba(76,131,159,.075)}
.result-rank{filter:none;text-shadow:none!important;letter-spacing:-4px}
.result-song-title{color:#2D485F}
.result-song-artist{color:#8197A8}
.result-judge-label{color:#8499A9}
.result-metric{background:rgba(255,255,255,.88);border-color:#E0EBF2;border-radius:13px;box-shadow:0 5px 17px rgba(73,125,152,.035)}
.result-metric .m-label{color:#8499A9}.result-metric .m-value{color:#36556D}
.result-metric:nth-child(1) .m-value{color:#9B7A24}.result-metric:nth-child(2) .m-value{color:#378DAA}.result-metric:nth-child(3) .m-value{color:#C2769C}
.result-section{background:rgba(255,255,255,.85);border-color:#E0EBF2;border-radius:15px;box-shadow:0 5px 18px rgba(73,125,152,.035)}
.result-section-head h3{color:#3B586F}.result-section-head span{color:#8CA0B0}
.result-judgebar{background:#EDF3F7;gap:2px}
.result-judgegrid .result-judgecell{background:#F6FAFC;border:1px solid #EAF1F5;border-radius:10px}
.result-judgecell .j-name{color:#859AAA;font-weight:750;letter-spacing:.55px}
.result-judgecell .j-count{color:#3E5A70}
.result-judgecell .j-count.perfect{color:#258B70}.result-judgecell .j-count.great{color:#278DB5}.result-judgecell .j-count.good{color:#A87919}.result-judgecell .j-count.bad{color:#C66B33}.result-judgecell .j-count.miss{color:#CB526C}
.result-judgecell .j-rate{color:#94A6B4}
.result-detail{background:#F6FAFC;border:1px solid #EAF1F5;border-radius:10px}
.result-detail .d-label{color:#8A9EAE}.result-detail .d-value{color:#3B586F}
.result-note{color:#90A2B1}
.badge{border-radius:9px;letter-spacing:.65px;font-size:10px;padding:5px 9px}
.badge-fc{background:#E6F7EF;color:#438A67;border:1px solid #CBE9D8}.badge-ap{background:#FFF5D9;color:#97751E;border:1px solid #F0E2B8}

/* Loading and responsive */
.loading{background:rgba(247,251,255,.96);backdrop-filter:blur(10px)}
.spinner{border-color:#DFEDF4;border-top-color:#59B6D4}
.loading p{color:#6E899D}
@media(max-width:780px){
  .menu-content{min-height:0;grid-template-columns:1fr;grid-template-rows:auto auto auto;gap:14px;padding:25px 22px 15px;border-radius:24px}
  .menu-copy{padding:4px 0 0}.brand-lockup{margin-bottom:28px}
  #menu h1{font-size:clamp(46px,12vw,67px);margin-top:16px;letter-spacing:-2.7px}
  .menu-subtitle{font-size:12px;margin:11px 0 20px}
  .menu-actions{width:100%;flex-direction:row;gap:9px}.menu-actions .menu-btn{flex:1;min-width:0;padding:12px 13px;font-size:12px}
  .menu-hint{margin-top:20px}.menu-visual{min-height:250px;max-height:280px;grid-row:2}.portal-art{max-height:280px;width:auto;max-width:100%}.portal-orbit{width:210px;height:210px}.visual-caption{bottom:16px}.chip-top{top:12%;right:5%}.chip-bottom{bottom:17%;left:5%}.floating-chip{font-size:8px;padding:7px 9px}
  .menu-footer{grid-row:3;font-size:8px;flex-wrap:wrap}.menu-footer span:nth-child(2){display:none}
  .song-page-shell{gap:19px}.library-layout{grid-template-columns:1fr;gap:20px}.library-aside{padding:15px}.library-aside .resource-card{margin-bottom:7px}.page-header{gap:10px}.header-note{font-size:8px;letter-spacing:.9px}.mini-brand{font-size:15px}.library-intro h2{font-size:37px}
  .drop-zone{min-height:95px}.song-card{gap:8px;padding:13px 12px}.song-card .diff{max-width:42%;}
  .settings-panel{margin:8px 0 16px}
  .side-panel{padding:60px 6px 12px;gap:7px}.panel-section{padding:7px 6px}.judge-row{font-size:11px}.acc-big{font-size:22px}
}
@media(max-width:420px){
  .screen{padding-left:10px;padding-right:10px}
  .menu-content{padding:22px 16px 13px}.brand-lockup{margin-bottom:25px}.menu-visual{min-height:220px}.menu-hint{font-size:10px}.key-hint-row{gap:4px}.key-hint-row span{margin-right:4px}
  .header-note{display:none}.page-header{justify-content:flex-start}.mini-brand{margin-left:auto;margin-right:auto}.header-back span{display:none}
  .library-count{padding:8px 10px}.library-intro{align-items:center}.library-intro p{max-width:230px;font-size:11px}.song-card .diff{max-width:45%}.diff-tag{padding:3px 5px;font-size:8px}
}
html,body{touch-action:auto}
#game{touch-action:none}
#bgCanvas{pointer-events:none}
#result{touch-action:pan-y}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
}
body.reduce-motion *,body.reduce-motion *::before,body.reduce-motion *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
body.reduce-motion .portal-orbit,body.reduce-motion .visual-halo{opacity:.45}
body.reduce-motion .menu-content:before{opacity:.55}
body.reduce-motion .song-card:hover,body.reduce-motion .resource-card:hover,body.reduce-motion .menu-btn:hover{transform:none}


/* ==========================================================
   Door v11 · DARK PORTAL / CRYSTAL NOTES
   Design-only layer: core judgement, input and score logic unchanged.
   ========================================================== */
:root{
  color-scheme:dark;
  --paper:#080F1D;--surface:#111B2D;--surface-soft:#131F33;--surface-blue:#182A40;--surface-pink:#2B1D33;
  --ink:#E7EEF9;--ink-soft:#BDCBDD;--text-muted:#8297B2;--line:rgba(132,169,207,.20);--line-strong:rgba(145,187,224,.32);
  --blue:#6CC6E7;--blue-deep:#3C91B9;--pink:#D58CB5;--pink-deep:#B86C96;--lilac:#A8A0F0;--mint:#78CFC3;
  --ui-border:rgba(144,184,223,.19);--ui-glass:rgba(15,25,42,.78);--ui-cyan:#79D6F2;--ui-violet:#B4A5F7;
  --shadow-soft:0 18px 48px rgba(0,0,0,.24);
}
html,body{background:#080F1D;color:#E3ECF8}
body{background-image:radial-gradient(ellipse at 18% 12%,rgba(44,91,137,.12),transparent 42%),radial-gradient(ellipse at 85% 83%,rgba(111,54,105,.10),transparent 38%)}
#menu,#songselect,#settings{background:transparent;color:var(--ink)}
.menu-content{border-color:rgba(133,176,218,.22);background:linear-gradient(145deg,rgba(15,27,46,.88),rgba(10,18,32,.82));box-shadow:0 28px 90px rgba(0,0,0,.28);backdrop-filter:blur(22px) saturate(118%)}
.menu-content:before{background:radial-gradient(circle,rgba(74,139,182,.20),rgba(74,139,182,0) 70%)}
.brand-lockup,.brand-word{color:#B8CEE2}
.brand-icon{color:#72CBE8}
.menu-eyebrow,.section-eyebrow{color:#8099B4}
.eyebrow-dot{background:#C888AD;box-shadow:0 0 0 4px rgba(200,136,173,.12)}
#menu h1{color:#EDF5FF;-webkit-text-fill-color:#EDF5FF}
#menu h1 em{color:#8ED2EC}
#menu h1 em:after{background:linear-gradient(90deg,rgba(108,198,231,.7),rgba(213,140,181,.65));opacity:.62}
.menu-subtitle{color:#A4B5CB}
.menu-btn{border-color:rgba(137,174,211,.22);background:rgba(223,237,255,.045);color:#D6E4F3;box-shadow:0 6px 18px rgba(0,0,0,.13);backdrop-filter:blur(14px)}
.menu-btn:hover{border-color:rgba(115,203,234,.52);background:rgba(99,170,213,.11);box-shadow:0 8px 24px rgba(0,0,0,.20)}
.menu-btn.primary{background:linear-gradient(110deg,rgba(48,112,145,.92),rgba(111,66,112,.88));border-color:rgba(162,207,237,.25);color:#F1F7FF;box-shadow:0 8px 24px rgba(18,71,102,.24)}
.menu-btn.primary:hover{background:linear-gradient(110deg,rgba(58,130,163,.96),rgba(128,79,126,.93));border-color:rgba(178,222,246,.38)}
.menu-btn.secondary{background:rgba(223,237,255,.035)}
.btn-arrow{background:rgba(222,239,255,.09);color:#BCD5E9}
.button-symbol{color:#7DCEE9}
.menu-hint,.hint-secondary{color:#7D92AD}
.key-hint-row kbd,.menu-hint kbd{border-color:rgba(137,177,216,.24);background:rgba(218,234,255,.07);color:#C1D4E8;box-shadow:0 2px 0 rgba(0,0,0,.16)}
.key-hint-row span{color:#8199B3}.key-hint-row i{background:rgba(138,176,213,.22)}
.menu-visual{background:linear-gradient(145deg,rgba(25,48,75,.78),rgba(35,25,51,.72));border-color:rgba(134,181,222,.22);box-shadow:inset 0 1px 0 rgba(237,248,255,.07)}
.menu-visual:after{border-color:rgba(197,224,246,.15)}
.portal-art{filter:drop-shadow(0 16px 26px rgba(0,0,0,.26)) saturate(.82) brightness(.78)}
.halo-blue{background:radial-gradient(circle,rgba(69,158,205,.25),rgba(69,158,205,0) 72%)}
.halo-pink{background:radial-gradient(circle,rgba(181,94,146,.20),rgba(181,94,146,0) 72%)}
.portal-orbit{border-color:rgba(100,176,217,.20)}.orbit-two{border-color:rgba(211,135,183,.18)}
.visual-caption{color:#809AB4}.caption-line{background:rgba(122,187,220,.48)}
.floating-chip{background:rgba(15,27,45,.82);border-color:rgba(169,206,238,.19);color:#A9C1D9;box-shadow:0 8px 24px rgba(0,0,0,.20);backdrop-filter:blur(16px)}
.chip-dot{background:#70C7B6}.chip-wave{color:#D18AB0}
.menu-footer{border-top-color:rgba(132,169,207,.16);color:#7188A4}
.page-header{border-bottom-color:rgba(132,169,207,.18)}
.mini-brand{color:#D9E7F7}.mini-brand-mark{color:#D8ECFA;background:linear-gradient(145deg,rgba(68,132,164,.65),rgba(115,67,108,.62));border:1px solid rgba(163,204,234,.20)}
.header-note{color:#7289A6}.back-btn{border-color:rgba(137,177,216,.21);background:rgba(19,32,51,.70);color:#A8BED4;backdrop-filter:blur(12px)}
.back-btn:hover{color:#EEF6FF;border-color:rgba(109,198,230,.46);background:rgba(37,65,91,.8)}
.library-intro h2{color:#E6EFFA}.library-intro h2 span{color:#79CBE6}.library-intro p{color:#8FA5BE}
.library-count{border-color:rgba(137,177,216,.19);background:rgba(18,31,50,.75);color:#B0C6DC;backdrop-filter:blur(16px)}
.library-count b{color:#DFECFA}.library-count small{color:#8198B3}.count-mark{background:rgba(86,166,201,.15);color:#81CFE8}
.library-section-title h3{color:#DAE8F7}.library-section-title p{color:#7F96B0}.section-index{color:#6388A9}
.drop-zone{border-color:rgba(109,190,222,.36);background:rgba(17,34,54,.72);color:#A9C5DA;box-shadow:inset 0 1px 0 rgba(235,248,255,.035);backdrop-filter:blur(14px)}
.drop-zone:hover,.drop-zone.drag{border-color:rgba(113,211,239,.68);background:rgba(40,75,99,.62);color:#E0F5FF}
.upload-icon{background:linear-gradient(145deg,rgba(60,133,166,.45),rgba(133,76,119,.42));color:#A1DFF2;border:1px solid rgba(166,214,238,.15)}
.upload-main{color:#D4E4F2}.upload-main b{color:#9BDDF1;background:rgba(71,156,190,.16)}.upload-sub{color:#829CB5}
.song-card{background:rgba(15,27,45,.76);border-color:rgba(128,168,207,.16);box-shadow:0 8px 22px rgba(0,0,0,.13);backdrop-filter:blur(14px)}
.song-card:hover{background:rgba(25,42,65,.88);border-color:rgba(113,197,228,.37)}
.song-card.selected{border-color:rgba(106,203,232,.58);background:linear-gradient(110deg,rgba(36,88,119,.45),rgba(82,49,83,.30));box-shadow:0 8px 22px rgba(0,0,0,.19)}
.song-card .title{color:#E0ECF8}.song-card .artist{color:#849CB5}
.diff-easy{background:rgba(82,169,125,.14);color:#91D8B1}.diff-normal{background:rgba(72,166,205,.14);color:#90D9F0}.diff-hard{background:rgba(218,179,88,.14);color:#F0D28A}.diff-expert{background:rgba(205,105,158,.15);color:#E9A6C8}
.diff-btn-easy{background:rgba(82,169,125,.14);color:#91D8B1;border-color:rgba(98,192,145,.25)}.diff-btn-normal{background:rgba(72,166,205,.14);color:#90D9F0;border-color:rgba(99,193,226,.25)}.diff-btn-hard{background:rgba(218,179,88,.14);color:#F0D28A;border-color:rgba(223,192,114,.25)}.diff-btn-expert{background:rgba(205,105,158,.15);color:#E9A6C8;border-color:rgba(221,135,179,.26)}
.empty-library{border-color:rgba(128,168,207,.19);background:rgba(14,27,45,.57);color:#8BA2BB}.empty-library b{color:#D4E5F3}.empty-library strong{color:#90D7EE}
.library-aside{border-color:rgba(132,172,212,.17);background:rgba(13,25,42,.62);box-shadow:0 10px 30px rgba(0,0,0,.14);backdrop-filter:blur(18px)}
.library-aside h3,.resource-text b{color:#D5E5F4}.library-aside p,.resource-text small{color:#829AB4}.resource-card{border-color:rgba(129,171,212,.17);background:rgba(20,35,56,.76);box-shadow:0 6px 18px rgba(0,0,0,.11)}.resource-card:hover{border-color:rgba(111,198,229,.4);background:rgba(28,49,73,.86)}.resource-arrow{color:#76B9D7}.resource-tip{background:rgba(69,111,143,.14);color:#8DAAC1}.resource-tip b{color:#D4E7F5}.tip-icon{background:rgba(91,167,202,.18);color:#8CD9F0}.library-aside-footer{color:#718AA4}.tiny-orb{background:#79CFEA}.page-footer{border-top-color:rgba(132,169,207,.16);color:#7187A2}
#settings{background:transparent;color:var(--ink)}
.settings-panel{border-color:rgba(134,173,213,.20);background:rgba(13,25,42,.82);box-shadow:0 22px 68px rgba(0,0,0,.24);backdrop-filter:blur(20px) saturate(120%)}
.settings-panel h2{color:#E1EDF9}.settings-panel h2:after{color:#718BA7}.setting-item{border-bottom-color:rgba(134,173,213,.13)}.setting-item label{color:#AABED2}.setting-item .vd{color:#82D2EC}
.setting-item select{border-color:rgba(134,173,213,.24);background:rgba(9,19,34,.78);color:#DBE9F7}.setting-item select option{background:#111B2D;color:#DDEAF7}.quality-hint{color:#849CB6}
.toggle{background:#35465C}.toggle.on{background:#4A9BB8}.toggle:after{background:#F0F7FF;box-shadow:0 1px 5px rgba(0,0,0,.25)}
.key-bind-btn{background:rgba(18,33,53,.88);border-color:rgba(134,173,213,.22);color:#C5D9EC}.key-bind-btn:hover{border-color:rgba(110,204,233,.55);color:#9BE1F4}.key-bind-btn.capturing{border-color:#D68DB8;color:#F1B6D4}
#gameHUD{color:#EAF2FC}.hud-score{color:#F0F4FF;text-shadow:0 2px 16px rgba(123,168,221,.18)}.hud-acc{color:#A4B7CE}.hud-combo{color:#D9D2FF;text-shadow:0 2px 16px rgba(160,142,234,.18)}.hud-combo-label{color:#8198B4}.hud-song .t{color:#E0EAF8}.hud-song .a{color:#8299B4}
.progress-bar{background:rgba(109,147,188,.16)}.progress-fill{background:linear-gradient(90deg,#63BADA,#B18FE0,#D18AB5)}
.side-panel{background:rgba(8,16,29,.90);border-color:rgba(120,161,203,.18);backdrop-filter:blur(18px);box-shadow:0 0 28px rgba(0,0,0,.17)}
#leftPanel{border-right-color:rgba(120,161,203,.18)}#rightPanel{border-left-color:rgba(120,161,203,.18)}
.panel-section{background:rgba(19,32,51,.78);border-color:rgba(125,166,207,.16);box-shadow:inset 0 1px 0 rgba(240,248,255,.025)}
.panel-title,.acc-label{color:#7F96B1}.judge-row{color:#B0C3D8}.judge-row .jv{color:#DBE8F6}.energy-bar{background:rgba(100,132,170,.18)}.energy-fill{background:linear-gradient(90deg,#D8799B,#D8B66D,#6BC9B9)}
.mode-btn{border-color:rgba(133,176,216,.23);background:rgba(14,27,45,.84);color:#9CCBE2;box-shadow:0 5px 18px rgba(0,0,0,.22);backdrop-filter:blur(12px)}.mode-btn:hover{color:#EAF7FF;border-color:rgba(115,205,235,.48)}
/* v15: legacy pause colors moved to final override. */
.auto-badge{background:rgba(77,165,126,.15);border-color:rgba(107,208,156,.35);color:#9AE0B8}
#audioHint{background:rgba(157,112,51,.17);border:1px solid rgba(231,194,117,.35);color:#F0D28A;box-shadow:0 6px 24px rgba(0,0,0,.18)}#dbgLog{color:#A6B9D1;text-shadow:0 1px 3px #000}
#result{background:radial-gradient(ellipse at 50% 10%,rgba(34,56,86,.65),transparent 55%),linear-gradient(145deg,#0B1424 0%,#080F1D 58%,#12101F 100%);color:var(--ink)}
.result-heading{border-bottom-color:rgba(132,169,207,.17)}.result-kicker{color:#7E9CB8}.result-hero{border-color:rgba(136,177,216,.22);background:linear-gradient(125deg,rgba(22,39,62,.92),rgba(16,29,48,.91) 55%,rgba(43,26,46,.86));box-shadow:0 16px 42px rgba(0,0,0,.22);backdrop-filter:blur(18px)}
.result-rank{filter:none;text-shadow:none!important;letter-spacing:-4px}.result-song-title{color:#E2EDF9}.result-song-artist,.result-judge-label{color:#869DB7}
.result-metric{background:rgba(20,35,56,.78);border-color:rgba(131,172,211,.17);box-shadow:0 7px 20px rgba(0,0,0,.12);backdrop-filter:blur(14px)}.result-metric .m-label{color:#849AB4}.result-metric .m-value{color:#DFEBF8}.result-metric:nth-child(1) .m-value{color:#F0D28A}.result-metric:nth-child(2) .m-value{color:#8ED9EF}.result-metric:nth-child(3) .m-value{color:#E4A4C6}
.result-section{background:rgba(16,29,47,.82);border-color:rgba(130,171,211,.17);box-shadow:0 7px 22px rgba(0,0,0,.13);backdrop-filter:blur(14px)}.result-section-head h3{color:#D7E6F5}.result-section-head span{color:#8299B4}
.result-judgebar{background:rgba(106,139,177,.15)}.result-judgegrid .result-judgecell{background:rgba(23,39,61,.86);border-color:rgba(126,168,208,.14)}.result-judgecell .j-name{color:#859BB5}.result-judgecell .j-count{color:#DFEAF7}.result-judgecell .j-count.great{color:#7BD7F1}.result-judgecell .j-count.good{color:#F0D17A}.result-judgecell .j-count.bad{color:#F0A071}.result-judgecell .j-count.miss{color:#F17899}
.result-judgecell .j-count.perfect,.result-judgecell .j-name.perfect,.val.perfect{background:linear-gradient(100deg,#F28CC5 0%,#F2C79D 22%,#E9E89A 42%,#8BE0D0 61%,#8DCBF7 80%,#B8A1FF 100%);-webkit-background-clip:text;background-clip:text;color:transparent!important}
.result-judgecell .j-rate{color:#8BA0B8}.result-detail{background:rgba(22,38,59,.78);border-color:rgba(126,168,208,.15)}.result-detail .d-label{color:#8198B2}.result-detail .d-value{color:#D8E6F5}.result-note{color:#8096B0}
.badge-fc{background:rgba(79,170,125,.14);color:#95D8B2;border-color:rgba(102,197,149,.27)}.badge-ap{background:rgba(219,181,84,.13);color:#F0D38A;border-color:rgba(226,196,111,.25)}
.result-actions .menu-btn,.result .menu-btn{box-shadow:0 8px 20px rgba(0,0,0,.15)}
.loading{background:rgba(6,12,23,.95);backdrop-filter:blur(14px)}.spinner{border-color:rgba(140,177,214,.18);border-top-color:#74CBE8}.loading p{color:#A0B5CB}
/* The external gallery lives on the dark glass theme too. */
.resource-icon{background:rgba(74,134,173,.18);color:#9BDCF0}.resource-icon.search-icon{background:rgba(74,134,173,.18);color:#9BDCF0}.resource-icon.pack-icon{background:rgba(179,98,147,.17);color:#E2A4C6}
@media(max-width:780px){.menu-content{background:linear-gradient(145deg,rgba(15,27,46,.92),rgba(10,18,32,.87))}.menu-visual{background:linear-gradient(145deg,rgba(25,48,75,.78),rgba(35,25,51,.72))}}
@media(prefers-reduced-transparency:reduce){.menu-content,.menu-visual,.floating-chip,.song-card,.settings-panel,.side-panel,.result-hero,.result-section{backdrop-filter:none!important}}



/* ==========================================================
   Door v12 · Rounded Glass + Live HUD
   Light shell / dark playfield; no judgement-core changes.
   ========================================================== */
:root{color-scheme:light;--ink:#30465D;--ink-soft:#5E748B;--text-muted:#8295A8;--line:#D8E5EF;--blue:#64B9D8;--pink:#D99DBD;--lilac:#A9A0DE}
html,body{background:#E7EEF5;color:#30465D}
#bgCanvas{z-index:0;pointer-events:none}
#game{z-index:1;visibility:hidden;opacity:0;transition:opacity 220ms cubic-bezier(.22,.68,.2,1);will-change:opacity}
#game.game-canvas-visible{visibility:visible;opacity:1}
.screen.active{animation:doorPageEnter 240ms cubic-bezier(.2,.65,.25,1) both}
@keyframes doorPageEnter{from{opacity:0;transform:translateY(8px) scale(.997)}to{opacity:1;transform:translateY(0) scale(1)}}
#menu,#songselect,#settings,#result{color:#30465D;background:rgba(231,238,245,.78)}
#menu{background:transparent}
.menu-content{border-color:rgba(180,205,223,.82);background:rgba(247,251,255,.78);box-shadow:0 22px 70px rgba(69,113,145,.12);backdrop-filter:blur(22px) saturate(118%)}
.menu-copy{color:#30465D}.brand-lockup,.brand-word{color:#35556E}.menu-eyebrow,.section-eyebrow{color:#7C95AA}.menu-subtitle{color:#647C92}.menu-hint{color:#8396A9}.key-hint-row kbd{background:rgba(255,255,255,.78);border-color:#D8E5EF;color:#52728B;box-shadow:0 2px 5px rgba(57,95,125,.06)}.hint-secondary{color:#8C9DAE}
.menu-btn{border-color:#D5E4EF;background:rgba(255,255,255,.86);color:#46647D;box-shadow:0 5px 16px rgba(67,111,143,.08);border-radius:999px}
.menu-btn.primary{background:linear-gradient(110deg,#78C5E0,#9ABDE7);border-color:rgba(111,180,211,.58);color:#173D58;box-shadow:0 9px 22px rgba(91,161,195,.18)}
.menu-btn.primary:hover{background:linear-gradient(110deg,#8BD0E8,#A9C8EE);border-color:#79BDD8;box-shadow:0 10px 24px rgba(91,161,195,.22)}
.menu-btn.secondary{background:rgba(255,255,255,.7);border-color:#D7E5EF;color:#547087}
.menu-visual{background:radial-gradient(circle at 50% 42%,rgba(179,220,238,.42),rgba(239,223,236,.26) 42%,rgba(244,249,253,.28) 72%);border-color:rgba(193,215,229,.72)}
.portal-art{filter:drop-shadow(0 14px 25px rgba(73,130,160,.16)) saturate(.82) brightness(1)}
.visual-halo.halo-blue{background:radial-gradient(circle,rgba(104,190,221,.2),transparent 72%)}.visual-halo.halo-pink{background:radial-gradient(circle,rgba(219,151,189,.17),transparent 72%)}
.portal-orbit{border-color:rgba(98,172,205,.24)}.orbit-two{border-color:rgba(206,141,176,.22)}
.floating-chip{background:rgba(250,253,255,.82);border-color:rgba(181,208,226,.75);color:#56758E;box-shadow:0 8px 24px rgba(75,119,149,.09);backdrop-filter:blur(16px)}
.menu-footer,.page-footer{border-color:rgba(168,194,214,.6);color:#879AAD}.page-header{border-color:rgba(168,194,214,.58)}
.mini-brand{color:#36566F}.mini-brand-mark{color:#39708B;background:linear-gradient(145deg,#D5EFF8,#F5E4EF);border-color:#C6DFEA}
.header-note{color:#8499AC}.back-btn{border-color:#D7E4EE;background:rgba(250,253,255,.78);color:#668096;backdrop-filter:blur(12px)}.back-btn:hover{color:#31536B;border-color:#A8D4E5;background:#F8FCFF}
#songselect{background:rgba(231,238,245,.78);overflow-y:auto;overscroll-behavior:contain;padding: max(14px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(20px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left))}
.song-page-shell{width:min(1190px,calc(100% - 0px));margin:16px auto;background:rgba(248,251,254,.62);border:1px solid rgba(190,210,226,.62);border-radius:24px;padding:clamp(18px,2.5vw,28px);color:#30465D;backdrop-filter:blur(10px)}
.library-intro h2{color:#30465D}.library-intro h2 span{color:#4EA9C9}.library-intro p{color:#6F8498}
.library-count{border-color:#D7E4EE;background:rgba(255,255,255,.76);color:#58758D;backdrop-filter:blur(12px)}.library-count b{color:#304F68}.library-count small{color:#8A9CAF}.count-mark{background:#E0F1F8;color:#4B9FC1}
.library-section-title h3{color:#3A536B}.library-section-title p{color:#8194A7}.section-index{color:#78A5BC}
.drop-zone{border-color:rgba(105,176,204,.42);background:rgba(250,253,255,.74);color:#6C8BA2;box-shadow:inset 0 1px 0 rgba(255,255,255,.8);backdrop-filter:blur(12px)}.drop-zone:hover,.drop-zone.drag{border-color:#78C4DF;background:rgba(230,247,253,.9);color:#3D819F}
.upload-icon{background:linear-gradient(145deg,#DDF3FA,#F6E6F0);color:#528EAA;border-color:#D6E8F1}.upload-main{color:#496982}.upload-main b{color:#4B9FBE;background:#E4F4FA}.upload-sub{color:#889BAE}
.song-card{background:rgba(255,255,255,.78);border-color:rgba(190,211,226,.72);box-shadow:0 5px 18px rgba(63,103,132,.06);backdrop-filter:blur(12px)}.song-card:hover{background:rgba(255,255,255,.96);border-color:#ACD9E8}.song-card.selected{border-color:rgba(90,175,209,.64);background:linear-gradient(110deg,rgba(220,242,250,.93),rgba(249,231,240,.88));box-shadow:0 8px 20px rgba(71,136,165,.11)}.song-card .title{color:#304C63}.song-card .artist{color:#7D91A4}
.diff-easy{background:rgba(110,184,143,.15);color:#3C8A65}.diff-normal{background:rgba(77,174,207,.15);color:#358CAD}.diff-hard{background:rgba(223,189,104,.18);color:#977222}.diff-expert{background:rgba(212,130,171,.17);color:#A95380}
.diff-btn-easy{background:#EDF8F0;color:#39855D;border-color:#CFE8D8}.diff-btn-normal{background:#EAF7FB;color:#3589A8;border-color:#CDE9F2}.diff-btn-hard{background:#FBF6E8;color:#947222;border-color:#ECE0BC}.diff-btn-expert{background:#FAEDF4;color:#A7537D;border-color:#EED2E1}
.empty-library{border-color:#D7E4ED;background:rgba(250,253,255,.72);color:#8296A8}.empty-library b{color:#435F77}.empty-library strong{color:#4B9FBE}
.library-aside{border-color:rgba(188,210,226,.72);background:rgba(248,252,255,.76);box-shadow:0 10px 28px rgba(68,111,140,.08);backdrop-filter:blur(16px)}.library-aside h3,.resource-text b{color:#3B566E}.library-aside p,.resource-text small{color:#8297A9}.resource-card{border-color:#DCE8F0;background:rgba(255,255,255,.75);box-shadow:0 5px 16px rgba(64,103,130,.045)}.resource-card:hover{border-color:#B2DDEB;background:#FFFFFF}.resource-arrow{color:#579CB8}.resource-tip{background:#EAF4F8;color:#7792A5}.resource-tip b{color:#496A82}.tip-icon{background:#D8EDF5;color:#4D98B7}.library-aside-footer{color:#8EA1B1}.tiny-orb{background:#75C5D9}
.play-mode-bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:0 0 18px;padding:13px 16px;border:1px solid rgba(187,210,225,.74);border-radius:18px;background:rgba(250,253,255,.78);box-shadow:0 6px 18px rgba(64,103,130,.05);backdrop-filter:blur(14px)}
.play-mode-copy{display:flex;align-items:center;gap:10px;min-width:150px;flex:1}.play-mode-icon{display:flex;width:36px;height:36px;align-items:center;justify-content:center;border-radius:12px;background:linear-gradient(145deg,#DFF3FA,#F8E8F0);color:#4E92AF}.play-mode-icon svg,.play-mode-option svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.play-mode-copy b{display:block;font-size:12px;color:#3E5A72}.play-mode-copy small{display:block;font-size:10px;color:#8B9DAE;margin-top:3px}
.play-mode-segment{display:flex;gap:4px;padding:4px;border:1px solid #DDE8F0;border-radius:999px;background:rgba(235,243,249,.86)}.play-mode-option{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:8px 13px;border:1px solid transparent;border-radius:999px;background:transparent;color:#7890A4;font-size:11px;font-weight:700;cursor:pointer;transition:background .18s,border-color .18s,color .18s,transform .18s}.play-mode-option.selected{background:#FFFFFF;border-color:#CDE4EF;color:#3A718C;box-shadow:0 3px 9px rgba(62,111,142,.10)}.play-mode-option#autoModeBtn.selected{background:linear-gradient(110deg,#E0F3F9,#F8EAF1);color:#8F5E7C;border-color:#E5CBD9}.mode-option-dot{width:6px;height:6px;border-radius:50%;background:#A8BAC8}.play-mode-option.selected .mode-option-dot{background:#64B8D3;box-shadow:0 0 0 3px rgba(100,184,211,.13)}.play-mode-option#autoModeBtn.selected .mode-option-dot{background:#D18EB0;box-shadow:0 0 0 3px rgba(209,142,176,.13)}.play-mode-description{width:100%;margin-top:-5px;padding-left:47px;color:#91A2B2;font-size:10px}
#settings{background:rgba(231,238,245,.84);overflow-y:auto;overscroll-behavior:contain;color:#30465D}.settings-panel{border-color:rgba(189,209,224,.78);background:rgba(250,253,255,.83);box-shadow:0 18px 55px rgba(64,105,134,.10);backdrop-filter:blur(20px) saturate(115%)}.settings-panel h2{color:#304B63}.setting-item label{color:#617A91}.setting-item .vd{color:#4CA4C4}.setting-item select{border-color:#D8E5EE;background:rgba(255,255,255,.88);color:#38566F}.setting-item select option{background:#F8FBFE;color:#38566F}.quality-hint{color:#8B9CAE}.toggle{background:#D1DDE7}.toggle.on{background:#69BCD7}.toggle:after{background:#FFFFFF;box-shadow:0 1px 5px rgba(54,88,113,.18)}.key-bind-btn{background:rgba(255,255,255,.82);border-color:#D8E5EF;color:#43647C}.key-bind-btn:hover{border-color:#8AC8DD;color:#3C91B2}.key-bind-btn.capturing{border-color:#D49ABC;color:#B56992}
#result{background:radial-gradient(ellipse at 12% 8%,rgba(174,219,238,.32),transparent 42%),radial-gradient(ellipse at 88% 82%,rgba(230,190,213,.27),transparent 46%),rgba(231,238,245,.92);color:#30465D}.result-heading{border-color:#D6E3ED}.result-kicker{color:#7B93A7}.result-hero{border-color:rgba(185,208,224,.85);background:linear-gradient(130deg,rgba(250,253,255,.94),rgba(237,246,251,.90) 58%,rgba(250,238,245,.88));box-shadow:0 14px 35px rgba(62,103,131,.10);backdrop-filter:blur(16px)}.result-song-title{color:#344F67}.result-song-artist,.result-judge-label{color:#8296A8}.result-metric{background:rgba(255,255,255,.8);border-color:#DAE6EF;box-shadow:0 5px 16px rgba(63,103,131,.05);backdrop-filter:blur(10px)}.result-metric .m-label{color:#8295A7}.result-metric .m-value{color:#37546C}.result-metric:nth-child(1) .m-value{color:#9A7C31}.result-metric:nth-child(2) .m-value{color:#3B93B0}.result-metric:nth-child(3) .m-value{color:#B86F98}.result-section{background:rgba(250,253,255,.76);border-color:#D9E5EE;box-shadow:0 6px 20px rgba(62,103,131,.05);backdrop-filter:blur(12px)}.result-section-head h3{color:#425D75}.result-section-head span{color:#899BAC}.result-judgebar{background:#E1EAF1}.result-judgecell{background:#F0F5F9}.result-judgecell .j-name{color:#879AAB}.result-judgecell .j-count{color:#38556D}.result-judgecell .j-rate{color:#8C9CAC}.result-detail{background:rgba(237,244,249,.82)}.result-detail .d-label{color:#879AAA}.result-detail .d-value{color:#3C5870}.result-note{color:#8498AA}.badge-auto{background:rgba(101,174,204,.13);color:#3B829E;border:1px solid rgba(101,174,204,.3)}
.val.perfect,.result-judgecell .j-count.perfect,.result-judgecell .j-name.perfect{background:linear-gradient(100deg,#D99FC5 0%,#E4C4B0 22%,#D8D8A8 42%,#9FD5CB 61%,#9DC9E4 80%,#B6A8E0 100%);-webkit-background-clip:text;background-clip:text;color:transparent!important}
.progress-bar{background:rgba(35,61,86,.2)}.progress-fill{background:linear-gradient(90deg,#63BADA,#9DA4E0,#D19AB9)}
/* New live data HUD */
#gameHUD{padding:12px 154px 10px 16px;gap:12px;align-items:flex-start;color:#EAF2FC;pointer-events:none}
.hud-left{min-width:110px}.hud-score-label{font-size:8px;font-weight:750;letter-spacing:2px;color:#829BB7;margin-bottom:2px}.hud-score{font-size:clamp(20px,3.3vw,28px);letter-spacing:-.6px;color:#F0F5FC;text-shadow:0 2px 15px rgba(107,170,214,.14)}.hud-acc{color:#9CB2C9;font-size:11px}.hud-center{top:12px}.hud-combo{color:#D4CAE9;text-shadow:0 2px 16px rgba(169,143,217,.16)}.hud-combo-label{color:#8499B2}.hud-song{max-width:clamp(100px,21vw,220px);padding-top:3px}.hud-song .t{color:#E4EEF9}.hud-song .a,.hud-difficulty{color:#8EA5BD}.hud-difficulty{font-size:9px;letter-spacing:1px;margin-top:4px}
.game-controls{position:absolute;top:12px;right:12px;z-index:16;display:none;gap:6px;align-items:center;pointer-events:auto}.game-controls.active{display:flex}.hud-icon-btn,.game-controls .mode-btn{position:static;width:34px;height:34px;flex:0 0 34px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(139,176,209,.28);border-radius:50%;background:rgba(19,34,54,.82);color:#C8DCEE;box-shadow:0 5px 16px rgba(0,0,0,.16);backdrop-filter:blur(12px);cursor:pointer;pointer-events:auto;transition:background .16s,border-color .16s,transform .16s}
.hud-icon-btn svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.hud-icon-btn:hover,.game-controls .mode-btn:hover{background:rgba(39,63,91,.94);border-color:rgba(126,202,232,.58);transform:translateY(-1px)}.game-controls .mode-btn{font-size:15px;padding:0}.game-controls .mode-btn.active{display:flex}
.auto-badge{top:62px;left:50%;transform:translateX(-50%);padding:5px 12px;border-radius:999px;background:rgba(61,116,93,.22);border-color:rgba(122,200,163,.32);color:#A7DEC0;letter-spacing:1.3px;font-size:9px;box-shadow:0 3px 12px rgba(0,0,0,.08)}
.hud-details-panel{position:absolute;z-index:15;display:none;top:59px;left:50%;transform:translateX(-50%);width:min(470px,calc(100vw - 28px));padding:13px;border:1px solid rgba(144,181,213,.25);border-radius:18px;background:rgba(13,25,42,.91);box-shadow:0 14px 34px rgba(0,0,0,.2);backdrop-filter:blur(18px) saturate(115%);pointer-events:auto;color:#DDEAF8}.hud-details-panel.active{display:block;animation:hudPanelEnter .18s ease-out both}@keyframes hudPanelEnter{from{opacity:0;transform:translate(-50%,-5px)}to{opacity:1;transform:translate(-50%,0)}}
.hud-details-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:11px}.hud-details-heading b{display:block;font-size:12px;color:#E7F1FC;margin-top:3px}.hud-details-kicker{display:block;font-size:8px;letter-spacing:1.7px;color:#7894B1}.hud-mode-pill{border:1px solid rgba(130,178,210,.24);border-radius:999px;padding:4px 8px;font-size:8px;letter-spacing:1.1px;color:#A6D8E9;background:rgba(91,154,190,.11)}
.hud-judge-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}.hud-judge-chip{min-width:0;padding:8px 5px;border:1px solid rgba(145,177,207,.14);border-radius:10px;background:rgba(255,255,255,.035);text-align:center}.hud-judge-chip span{display:block;font-size:8px;letter-spacing:.45px;color:#8DA5BD}.hud-judge-chip b{display:block;font-size:17px;margin-top:4px;font-variant-numeric:tabular-nums;color:#E1ECF9}.hud-judge-chip.perfect b{color:#D5CBEA}.hud-judge-chip.great b{color:#8BD8EE}.hud-judge-chip.good b{color:#EAD18C}.hud-judge-chip.bad b{color:#ECA982}.hud-judge-chip.miss b{color:#EB8FA5}
.hud-live-footer{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:10px;padding-top:9px;border-top:1px solid rgba(145,177,207,.13);font-size:9px;color:#829AB3}.hud-live-footer b{color:#D3E4F3;font-variant-numeric:tabular-nums}.hud-details-progress{display:flex;align-items:center;gap:10px;margin-top:10px;color:#849BB2;font-size:9px}.hud-details-track{height:3px;flex:1;border-radius:99px;background:rgba(139,170,200,.16);overflow:hidden}.hud-details-track i{display:block;width:0;height:100%;background:linear-gradient(90deg,#76C4DF,#B4A1D8);border-radius:99px;transition:width .12s linear}
.side-panel{background:rgba(8,16,29,.88);backdrop-filter:blur(15px)}
/* Rounded action/setting controls also match the new pill note design. */
.settings-panel{border-radius:24px}.setting-item select,.key-bind-btn{border-radius:13px}.toggle{border-radius:999px}.back-btn{border-radius:999px}.resource-card{border-radius:15px}.diff-btn{border-radius:999px}
@media(max-width:700px){
 #gameHUD{padding:10px 126px 8px 10px;gap:6px}.hud-left{min-width:78px}.hud-score{font-size:clamp(18px,5vw,24px)}.hud-score-label{font-size:7px}.hud-acc{font-size:9px}.hud-center{top:12px}.hud-combo{font-size:clamp(28px,7vw,38px)}.hud-combo-label{font-size:8px;letter-spacing:1.7px}.hud-song{max-width:22vw;padding-top:2px}.hud-song .t{font-size:10px}.hud-song .a{display:none}.hud-difficulty{font-size:8px}.game-controls{right:8px;top:9px;gap:4px}.hud-icon-btn,.game-controls .mode-btn{width:30px;height:30px;flex-basis:30px}.hud-icon-btn svg{width:15px;height:15px}.hud-details-panel{top:51px;width:calc(100vw - 18px);padding:10px}.hud-judge-grid{gap:4px}.hud-judge-chip{padding:7px 2px}.hud-judge-chip span{font-size:7px}.hud-judge-chip b{font-size:15px}.play-mode-bar{gap:8px;padding:11px 12px}.play-mode-copy{min-width:120px}.play-mode-description{padding-left:0;margin-top:0}.play-mode-segment{width:100%}.play-mode-option{flex:1}.menu-content{border-radius:22px}
}
/* v15: obsolete mobile HUD positioning removed; final layout is defined below. */
@media(prefers-reduced-motion:reduce){.screen.active,.screen.active.screen-enter,.hud-details-panel.active{animation:none!important}#game{transition:none!important}.menu-btn,.play-mode-option,.hud-icon-btn,.game-controls .mode-btn{transition:none!important}}
body.reduce-motion .screen.active,body.reduce-motion .screen.active.screen-enter,body.reduce-motion .hud-details-panel.active{animation:none!important}


/* ==========================================================
   Door v13 · Harmony Portal — global consistency + new systems
   ========================================================== */
:root{--blue:#75C5E1;--pink:#D79ABF;--lilac:#A69BDE;--mint:#83C9BC;--deep:#25364B;--ui-radius:18px;--ui-gap:12px}
button,.menu-btn,.back-btn,.diff-btn,.resource-card,.song-card,.settings-panel,.result-section,.result-hero,.hud-details-panel,.pause-overlay{transition:background-color .18s ease,border-color .18s ease,box-shadow .18s ease,transform .18s ease,color .18s ease}
button:hover,.menu-btn:hover,.back-btn:hover,.diff-btn:hover,.resource-card:hover{filter:brightness(1.035);border-color:rgba(91,174,207,.62);box-shadow:0 8px 24px rgba(72,142,177,.14);transform:translateY(-1px)}
button:active,.menu-btn:active,.back-btn:active,.diff-btn:active,.resource-card:active{transform:translateY(0) scale(.99)}
.song-card{border-radius:22px!important;overflow:hidden}.song-card .diff{gap:8px!important;flex-wrap:wrap}.diff-btn{margin:0!important;min-height:40px;padding:9px 15px!important;border-radius:999px!important;box-shadow:0 2px 8px rgba(59,94,123,.06)}
.pause-overlay{gap:12px!important;padding:clamp(22px,4vw,34px)!important;border-radius:26px!important;min-width:min(340px,calc(100vw - 32px));box-shadow:0 24px 80px rgba(3,10,22,.38)}
.pause-overlay button{width:100%;margin:0!important;min-height:46px;border-radius:16px!important;display:flex;align-items:center;justify-content:center}
.hud-song{max-width:min(31vw,390px)}.hud-meta-badges{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:5px;pointer-events:none}.auto-badge{position:static!important;display:none!important;margin:0!important;padding:4px 8px;border-radius:999px;background:rgba(117,197,225,.14);border:1px solid rgba(117,197,225,.42);color:#BDEBFA;font-size:9px;letter-spacing:.8px;line-height:1.2;box-shadow:none!important}.auto-badge.active{display:inline-flex!important;align-items:center}.best-delta{display:inline-flex;align-items:center;min-height:20px;padding:3px 8px;border:1px solid rgba(166,155,222,.3);border-radius:999px;background:rgba(166,155,222,.10);font-size:9px;color:#D8D0FF;font-variant-numeric:tabular-nums;white-space:nowrap}
.survival-hud{display:none;position:absolute;top:74px;left:50%;transform:translateX(-50%);width:min(360px,42vw);z-index:10;padding:7px 10px 9px;border:1px solid rgba(132,190,218,.25);border-radius:15px;background:rgba(16,29,47,.68);backdrop-filter:blur(10px);pointer-events:none}.survival-hud.active{display:block}.survival-label{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;color:#C8DCEC;font-size:9px;letter-spacing:1px}.survival-label b{font-size:10px;font-variant-numeric:tabular-nums}.survival-track{height:7px;border-radius:999px;overflow:hidden;background:rgba(220,235,248,.12);box-shadow:inset 0 1px 2px rgba(0,0,0,.24)}.survival-track i{display:block;width:100%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#D79ABF 0%,#A69BDE 48%,#83C9BC 100%);box-shadow:0 0 10px rgba(117,197,225,.24);transition:width .16s ease,filter .16s ease}.survival-hud.low .survival-track i{background:linear-gradient(90deg,#D982A3,#E9B8C7);filter:saturate(1.12)}
#game{transition:opacity .48s ease,filter .48s ease!important}body.door-enter-play #game{filter:brightness(.55) saturate(.88)}.screen.active{animation:doorV13Enter .32s cubic-bezier(.2,.7,.2,1) both}@keyframes doorV13Enter{from{opacity:0;transform:translateY(7px) scale(.996);filter:blur(2px)}to{opacity:1;transform:translateY(0) scale(1);filter:blur(0)}}
#bgCanvas{opacity:.78}body.reduce-motion #bgCanvas{opacity:.25}.hud-details-panel{border-radius:22px!important}.hud-judge-chip,.hud-details-track,.progress-bar{border-radius:999px!important}.setting-item.toggle-row{align-items:center;gap:16px}.toggle{flex:0 0 42px}
@media(max-width:600px){.survival-hud{top:67px;width:min(260px,58vw);padding:6px 8px}.hud-song{max-width:34vw}.hud-meta-badges{gap:4px}.best-delta{font-size:8px;padding:3px 6px}.auto-badge{font-size:8px;padding:3px 6px}.pause-overlay{width:calc(100vw - 36px);min-width:0}.pause-overlay button{min-height:48px}.song-card .diff{gap:6px!important}.diff-btn{min-height:38px;padding:8px 11px!important}}
@media(prefers-reduced-motion:reduce){button,.menu-btn,.back-btn,.diff-btn,.resource-card,.song-card,.settings-panel,.result-section,.result-hero,.hud-details-panel,.pause-overlay,#game,.screen{transition:none!important;animation:none!important}}

/* =========================================================
   Door v15 · FINAL OVERRIDE
   本区块是当前生效视觉的唯一权威来源。
   上方历史规则仅为兼容保留；修改视觉时优先在此追加。
   ========================================================= */
.menu-actions .menu-btn{width:100%;justify-content:space-between}
.song-card.selected{box-shadow:0 8px 22px rgba(90,170,202,.16)}
.settings-panel,.settings-panel select,.settings-panel .key-bind-btn{border-radius:14px}
.result-rank{font-weight:950;letter-spacing:-4px}
.result-judgebar span{background-image:none}
.result-judgecell .j-count.great{color:#278DB5}
.result-judgecell .j-count.good{color:#A87919}
.result-judgecell .j-count.bad{color:#C66B33}
.result-judgecell .j-count.miss{color:#CB526C}
.side-panel{background:rgba(8,16,29,.88)}

/* A · HUD details panel positioning */
.hud-details-panel{
  left:50%;transform:translateX(-50%);
  width:min(470px,calc(100vw - 28px));box-sizing:border-box;
}

/* B · Unified light-glass pause menu */
.pause-overlay{
  position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;
  z-index:20;padding:clamp(22px,4vw,34px);gap:12px;
  min-width:min(340px,calc(100vw - 32px));
  background:rgba(242,249,253,.92);
  backdrop-filter:blur(18px) saturate(115%);
  box-shadow:0 24px 80px rgba(64,105,134,.14);
  border:1px solid rgba(189,209,224,.6);
  border-radius:26px;
}
.pause-overlay.active{display:flex}
.pause-overlay h2{font-size:32px;font-weight:900;color:#304B63;letter-spacing:-.5px;margin-bottom:6px}
.pause-overlay .menu-btn{
  width:100%;margin:0;min-height:46px;
  background:rgba(255,255,255,.86);border:1px solid #D5E4EF;color:#46647D;
  border-radius:16px;box-shadow:0 5px 16px rgba(67,111,143,.08);
}
.pause-overlay .menu-btn:hover{
  background:#F9FDFF;border-color:#9CCFE2;
  box-shadow:0 8px 18px rgba(74,145,177,.09)
}
.pause-overlay .menu-btn.primary{
  background:linear-gradient(110deg,#78C5E0,#9ABDE7);
  border-color:rgba(111,180,211,.58);color:#173D58
}
/* The older ID selector had higher specificity than .pause-overlay. */
#pauseOverlay{padding:clamp(22px,4vw,34px)}

/* C · Compact, three-part play HUD */
#gameHUD{
  padding:12px 154px 10px 16px;
  gap:12px;
  align-items:flex-start;
  pointer-events:none;
}
.hud-pill{
  padding:9px 14px 10px;
  border-radius:16px;
  background:rgba(247,251,255,.86);
  border:1px solid rgba(189,209,224,.72);
  box-shadow:0 8px 22px rgba(64,105,134,.10);
  backdrop-filter:blur(18px) saturate(115%);
}
.hud-pill-left{min-width:110px;text-align:left}
.hud-pill-center{
  position:absolute;top:12px;left:50%;transform:translateX(-50%);
  text-align:center;padding:6px 20px 8px;min-width:92px;
}
.hud-pill-right{
  text-align:right;max-width:clamp(100px,21vw,220px);
  margin-left:auto;padding-top:9px;
}
.hud-score-label{color:#8A98AB}
.hud-score{color:#9A741B;text-shadow:none;letter-spacing:-.6px}
.hud-acc{color:#64748B}
.hud-combo{color:#4C3E7E;text-shadow:none}
.hud-combo-label{color:#8296A8}
.hud-pill-right .t{display:block;font-size:13px;font-weight:600;color:#30465D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hud-pill-right .a{font-size:10px;color:#64748B;margin-top:1px}
.hud-pill-right .hud-difficulty{color:#8296A8}
.hud-pill-right .hud-meta-badges{justify-content:flex-end}
.hud-pill-right .auto-badge{background:#E4F8EE;border-color:#B7E4CD;color:#438A67}
.hud-pill-right .best-delta{background:#F0EDFC;border-color:#D8D0F2;color:#695C9C}
@media(max-width:700px){
  #gameHUD{padding:10px 126px 8px 10px;gap:6px}
  .hud-pill{padding:6px 10px 7px;border-radius:13px}
  .hud-pill-left{min-width:78px}
  .hud-pill-center{top:9px;padding:4px 14px 6px;min-width:72px}
  .hud-pill-right{max-width:34vw;padding-top:5px}
  .hud-score{font-size:clamp(18px,5vw,24px)}
  .hud-score-label{font-size:7px}
  .hud-acc{font-size:9px}
  .hud-combo{font-size:clamp(28px,7vw,38px)}
  .hud-combo-label{font-size:8px;letter-spacing:1.7px}
  .hud-pill-right .t{font-size:9px}
  .hud-pill-right .a,.hud-pill-right .hud-difficulty{display:none}
}
/* On narrow portrait screens, put song metadata on its own row instead of behind COMBO. */
@media(max-width:700px){
  .hud-pill-right{position:absolute;top:74px;left:10px;right:126px;max-width:none;padding:6px 10px 7px}
  .survival-hud{top:130px}
}

/* D · Fold runtime sampling by default */
.result-section-collapsible>summary{cursor:pointer;list-style:none;user-select:none;margin-bottom:0}
.result-section-collapsible>summary::-webkit-details-marker{display:none}
.result-section-collapsible .chev{display:inline-block;margin-left:4px;font-style:normal;transition:transform .18s;color:#8CA0B0}
.result-section-collapsible[open] .chev{transform:rotate(180deg)}
.result-section-collapsible[open]>summary{margin-bottom:13px}
.result-section-collapsible>summary:hover h3{color:#304B63}

/* F · Small landscape touch devices and safe-area-aware scrolling */
@media (orientation:landscape) and (max-width:900px) {
  #gameHUD{
    padding-top:max(8px,env(safe-area-inset-top));
    padding-left:max(8px,env(safe-area-inset-left));
    padding-right:max(96px,env(safe-area-inset-right));
    gap:5px;
  }
  /* Keep the song title and mode badges below the centered combo in landscape too. */
  .hud-pill-right{position:absolute;top:62px;left:auto;right:max(96px,env(safe-area-inset-right));width:min(320px,calc(100vw - 160px));max-width:none;padding:5px 8px 6px}
  .survival-hud{top:112px}
  .hud-pill{padding:5px 8px 6px;border-radius:11px}
  .hud-pill-left{min-width:70px}
  .hud-pill-center{top:max(6px,env(safe-area-inset-top));padding:3px 10px 4px;min-width:64px}
  .hud-pill-right{max-width:29vw;padding-top:4px}
  .hud-score{font-size:clamp(16px,3.2vw,22px)}
  .hud-score-label{font-size:7px}
  .hud-acc{font-size:8px}
  .hud-combo{font-size:clamp(24px,5.5vw,32px)}
  .hud-combo-label{font-size:7px;letter-spacing:1px}
  .hud-pill-right .t{font-size:8px}
  .hud-pill-right .a,.hud-pill-right .hud-difficulty{display:none}
  .hud-details-panel{
    max-height:calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 20px);
    overflow-y:auto;overscroll-behavior:contain;
  }
  .pause-overlay{
    max-height:calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 24px);
    overflow-y:auto;box-sizing:border-box;
  }
  #result,.settings-panel{
    max-height:calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 16px);
    overflow-y:auto;overscroll-behavior:contain;
  }
  /* #result already owns vertical scrolling in this source version; avoid adding a nested result scroller. */
}
@media (orientation:landscape) and (max-width:900px) and (max-height:430px) {
  .hud-pill-center{top:4px}
  .hud-pill-right{top:60px}
  .survival-hud{top:106px}
  .hud-pill{padding-top:4px;padding-bottom:4px}
  .pause-overlay{padding:12px 18px;gap:7px;border-radius:18px}
  .pause-overlay h2{font-size:24px;margin-bottom:2px}
}

/* ============================================================
   v15.1 UI FIX（2026-10-12）
   仅视觉层修复：标题隐形 / 滑块黑轨 / 选歌页溢出 / 矮横屏菜单 /
   暂停重设计 / HUD 压侧面板与横屏重叠 / 结算深色格 / 配色统一 /
   手机竖屏按钮堆叠 / 控制按钮对比度。
   判定·输入·音频·谱面解析逻辑均未改动。
   ============================================================ */
:root{--sideW:0px}

/* P0-1 主菜单标题：v11 深色主题遗留白字（含 -webkit-text-fill-color），浅底上隐形，改回深色墨蓝 */
#menu h1{color:#2B4158;-webkit-text-fill-color:#2B4158}
#menu h1 em{color:#4AA9CB;-webkit-text-fill-color:#4AA9CB}

/* P0-2 自定义 range 滑块：轨道不再使用浏览器近黑默认渲染 */
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:24px;background:transparent;cursor:pointer;outline:none}
input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:linear-gradient(to right,#63BCD7 0%,#63BCD7 var(--fill,50%),#D8E2EC var(--fill,50%),#D8E2EC 100%)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:19px;height:19px;border-radius:50%;background:#FFFFFF;border:2px solid #63BCD7;box-shadow:0 1px 5px rgba(64,132,160,.35);margin-top:-6.5px;transition:transform .12s}
input[type=range]:active::-webkit-slider-thumb{transform:scale(1.12)}
input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:#D8E2EC}
input[type=range]::-moz-range-progress{height:6px;border-radius:3px;background:#63BCD7}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;background:#FFFFFF;border:2px solid #63BCD7;box-shadow:0 1px 5px rgba(64,132,160,.35)}

/* P1-5 暂停：整屏近白改深色半透遮罩 + 居中窄列，透出游戏画面 */
.pause-overlay{background:rgba(7,12,24,.66);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);gap:11px;padding:24px}
.pause-overlay h2{color:#EDF5FF;margin-bottom:10px;text-shadow:0 2px 20px rgba(0,0,0,.4)}
.pause-overlay .menu-btn{width:min(320px,86vw);padding:12px 18px}

/* P1-6 桌面 4:3 布局：收窄 HUD 容器（三个胶囊随之进入游玩区），
   body 级浮层（控制按钮/数据面板/血条/进度条）按侧栏宽内缩 */
#gameHUD{left:var(--sideW,0px);right:var(--sideW,0px)}
.game-controls{right:calc(10px + var(--sideW,0px))}
.hud-details-panel{right:calc(56px + var(--sideW,0px))}
.survival-hud{left:calc(12px + var(--sideW,0px));right:calc(12px + var(--sideW,0px))}
.progress-bar{left:var(--sideW,0px);right:var(--sideW,0px)}
/* 手机竖屏通栏歌曲胶囊：HUD 已收窄，内部位移保持原值即可 */
@media (max-width:600px){
  .hud-pill-right{top:74px;left:10px;right:126px}
}

/* P2-12 游戏内控制按钮在深色舞台上的对比度 */
.game-icon-btn,.mode-btn{border-color:rgba(190,220,245,.32);background:rgba(13,24,42,.62);color:#DCEBFF;box-shadow:0 2px 10px rgba(0,0,0,.28)}
.game-icon-btn:hover,.mode-btn:hover{border-color:rgba(190,220,245,.6);background:rgba(25,42,68,.8)}

/* P1-8 结算判定格：覆盖 v11 高特异性深色块，统一为浅色玻璃 */
.result-judgegrid .result-judgecell{background:#F2F7FB;border:1px solid #DCE7F0;border-radius:12px;padding:10px 8px}
.result-judgegrid .result-judgecell .j-name{color:#6E8299}
.result-judgegrid .result-judgecell .j-rate{color:#8497AC}

/* P2-11 演奏模式卡片：图标加深、说明文字不再压边框线 */
.play-mode-icon{background:linear-gradient(135deg,#D9EAF4,#C7DBEC);border-color:#BFD4E4;color:#4F6E8C}
.play-mode-description{margin-top:4px;color:#6E8299}

/* P0-3 手机竖屏（≤700px）：选歌页防溢出 + 设置页防横向溢出 */
@media (max-width:700px){
  .play-mode-bar{padding:11px 12px;gap:9px;flex-wrap:wrap}
  .play-mode-copy{width:100%;min-width:0;flex:none}
  .play-mode-segment{width:100%;min-width:0;flex:none}
  .play-mode-option{flex:1 1 0;min-width:0;padding:8px 6px;gap:4px;font-size:11px;letter-spacing:.2px}
  .play-mode-description{padding-left:0;text-align:center;width:100%}
  .library-count{transform:scale(.86);transform-origin:right top}
  #settings{padding:12px}
  .settings-panel{width:100%;max-width:560px}
  .key-bind-btn{min-width:0;padding-left:2px;padding-right:2px}
}
/* P2-11b 手机竖屏菜单两按钮纵向堆叠 */
@media (max-width:780px){
  .menu-actions{flex-direction:column}
  .menu-actions .menu-btn{width:100%}
}

/* P1-7 矮横屏手机（≤520px 高）：游戏 HUD 歌曲胶囊下移收窄，不再与 COMBO 重叠 */
@media (max-height:520px) and (orientation:landscape){
  .hud-pill-right{top:50px;right:92px;width:min(262px,42vw);min-width:0;padding:8px 11px}
  .hud-pill-right .t{font-size:10.5px}
  .hud-pill-right .a{font-size:8.5px}
  .hud-pill-right .hud-difficulty{font-size:8.5px;padding:1px 6px}
  .hud-pill-center{top:7px;padding:6px 13px}
  .hud-combo{font-size:19px}
  .hud-pill-left{padding:6px 11px}
  .hud-score{font-size:17px}
  .game-controls{top:7px;gap:5px}
  .hud-details-panel{top:46px}
}

/* P0-4 矮横屏手机主菜单：压缩留白，全部内容必须落在一屏内 */
@media (max-height:520px) and (orientation:landscape){
  #menu{padding:8px}
  .menu-content{width:min(1180px,calc(100vw - 20px));min-height:0;height:calc(100vh - 16px);padding:8px 22px;gap:10px;grid-template-rows:auto 1fr auto;align-items:stretch;border-radius:20px}
  .menu-copy{min-height:0;align-self:center}
  .menu-visual{min-height:0;align-self:center}
  .brand-lockup{margin-bottom:5px}
  .brand-icon{width:28px;height:28px}
  .brand-word{font-size:18px}
  .menu-eyebrow{margin-bottom:5px;font-size:9px;letter-spacing:2.4px}
  #menu h1{font-size:clamp(20px,4.4vh,27px);line-height:1.04;margin:0 0 6px}
  .menu-subtitle{font-size:11px;margin-bottom:7px}
  .menu-actions{margin:5px 0 7px;gap:7px}
  .menu-btn{padding:8px 16px;font-size:12px}
  .menu-hint{margin-top:4px;line-height:1.5;transform:scale(.9);transform-origin:left center}
  .menu-hint .hint-secondary{display:none}
  .menu-visual .portal-art{max-height:26vh}
  .floating-chip{transform:scale(.82)}
  .visual-caption{margin-top:5px;font-size:8px}
  .menu-footer{margin-top:2px;padding-top:5px;font-size:8px}
  .menu-footer span:nth-child(2){display:none}
}

/* P1-8b 结算判定格在窄竖屏不裁切 */
@media (max-width:560px){
  .result-judgegrid{gap:5px}
  .result-judgegrid .result-judgecell{padding:7px 3px;border-radius:9px}
  .result-judgecell .j-name{font-size:8px;letter-spacing:.3px}
  .result-judgecell .j-count{font-size:14px}
  .result-judgecell .j-rate{font-size:9px}
}


/* Door v15.1 · targeted visual fixes (judgement/input/audio/chart logic untouched) */
#songselect{padding-top:max(14px,env(safe-area-inset-top));padding-right:max(16px,env(safe-area-inset-right));padding-bottom:max(20px,env(safe-area-inset-bottom));padding-left:max(16px,env(safe-area-inset-left))}
#songselect>.song-page-shell{width:min(1190px,100%);max-width:1190px;margin:16px auto;border:1px solid rgba(190,210,226,.62);border-radius:24px;padding:clamp(18px,2.5vw,28px);overflow:visible}
.song-card.expanded{border-radius:22px 22px 0 0!important}
.song-difficulty-expand{display:flex;gap:8px;padding:10px 16px;background:rgba(240,247,252,.72);border:1px solid rgba(190,210,226,.55);border-top:0;border-radius:0 0 22px 22px;margin-top:-1px}.song-card.expanded+.song-difficulty-expand{background:rgba(240,247,252,.72);border:1px solid rgba(190,210,226,.55);border-top:0;border-radius:0 0 22px 22px}
.survival-hud{display:none;position:static;inset:auto;transform:none;width:100%;max-width:none;z-index:auto;margin:0;padding:8px 10px;border:1px solid rgba(132,190,218,.25);border-radius:15px;background:rgba(16,29,47,.68);backdrop-filter:blur(10px);pointer-events:none;flex:0 0 auto}
.survival-hud.active{display:block}
#rightPanel .survival-hud{order:2}
#rightPanel .panel-section:first-child{order:1;flex:1;min-height:0}
/* In full-screen layouts, expose only the active gauge from the hidden side-panel container. */
#rightPanel:has(#survivalHUD.active):not(.active){display:contents}
#rightPanel:not(.active)>.panel-section{display:none!important}
#rightPanel:not(.active) #survivalHUD.active{position:fixed;top:74px;left:50%;right:auto;transform:translateX(-50%);width:min(360px,42vw);z-index:10}
#rightPanel .panel-section:nth-of-type(2){order:3}
#rightPanel .panel-section:nth-of-type(3){order:4}
.hud-pill{padding:6px 12px 7px}
.hud-combo{font-size:clamp(28px,5.5vw,40px)}
.hud-pill-right{max-width:clamp(90px,16vw,160px)}
@media(max-width:700px){.hud-pill-right{max-width:clamp(90px,16vw,160px)}.hud-pill-right .a,.hud-pill-right .hud-difficulty{display:block;font-size:8px}.hud-pill-right .t{font-size:9px}.hud-pill-right .hud-meta-badges{gap:3px}.best-delta{font-size:8px;padding:3px 6px}.auto-badge{font-size:8px;padding:3px 6px}}
@media(max-width:520px){#songselect>.song-page-shell{padding:16px;border-radius:20px}.song-page-shell{gap:18px}.library-intro{align-items:flex-start;flex-direction:column}.library-layout{gap:16px}}



/* ==========================================================
   Door v17 · Rainlit Portal
   UI/raster scheduling only; judging and input semantics remain frozen.
   ========================================================== */
#gameHUD{justify-content:center;align-items:flex-start;padding:0;left:0;right:0;top:0;pointer-events:none}
.hud-pill-center{position:absolute;top:7px;left:50%;transform:translateX(-50%);min-width:0;padding:0 8px;background:transparent;border:0;border-radius:0;box-shadow:none;backdrop-filter:none;text-align:center}
.hud-combo{font-size:clamp(24px,3.4vw,30px);font-weight:780;line-height:1;color:#D9D5F5;text-shadow:0 1px 10px rgba(162,157,235,.22);font-variant-numeric:tabular-nums}
.hud-combo.pulse{transform:scale(1.08)}
.hud-combo-label{font-size:8px;color:#91A6BB;letter-spacing:2px;margin-top:2px}
#leftPanel,#rightPanel{padding:58px 10px 12px;gap:8px}
#leftPanel .panel-section,#rightPanel .panel-section{border-radius:13px;border-color:rgba(135,173,202,.20);padding:9px 10px;background:rgba(17,31,48,.76);box-shadow:0 6px 20px rgba(1,10,19,.08)}
#leftPanel .panel-title,#rightPanel .panel-title{display:flex;align-items:center;gap:6px;font-size:9px;letter-spacing:1.4px;color:#91A8BE;margin-bottom:6px;text-transform:none}
.tiny-line-icon{width:12px;height:12px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.panel-score-value{font-size:clamp(19px,2vw,25px);font-weight:850;font-variant-numeric:tabular-nums;letter-spacing:-.5px;color:#E8CC88;line-height:1.05;margin:0 0 5px}
#leftPanel .acc-big{font-size:25px;line-height:1;margin-top:5px}
#leftPanel .acc-label{font-size:9px;letter-spacing:1.2px;color:#95AABF}
#leftPanel .judge-row{font-size:12px;padding:3px 0}
#leftPanel .panel-judgement-summary{flex:1;min-height:0}
#rightPanel .panel-song-meta{flex:0 0 auto;min-height:78px}
.panel-song-title{font-size:12px;font-weight:760;line-height:1.35;color:#EAF2FA;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.panel-song-artist{font-size:10px;line-height:1.4;color:#91A7BD;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.panel-song-difficulty{font-size:9px;color:#A9BDE0;margin-top:4px;letter-spacing:.6px}
.panel-meta-badges,.details-song-badges{display:flex;flex-wrap:wrap;align-items:center;gap:5px;margin-top:6px}
.panel-song-meta .auto-badge,.hud-details-song .auto-badge{position:static;top:auto;left:auto;transform:none;display:none;z-index:auto;font-size:8px;letter-spacing:1px;padding:2px 7px;border-radius:99px}
.panel-song-meta .auto-badge.active,.hud-details-song .auto-badge.active{display:inline-flex}
.panel-song-meta .best-delta,.hud-details-song .best-delta{display:inline-block;font-size:9px;padding:2px 7px;border-radius:99px;white-space:normal;line-height:1.3}
#rightPanel .panel-offset-section{flex:1 1 auto;min-height:70px;display:flex;flex-direction:column}
#rightPanel #offsetCanvas{height:100%;min-height:64px;max-height:220px;flex:1}
.panel-runtime-summary{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:center}
.runtime-item{min-width:0;display:flex;flex-direction:column;gap:4px}
.runtime-item .panel-title{margin:0!important}
.runtime-item>b{font-size:12px;color:#C5D9EC;font-variant-numeric:tabular-nums}
#panelFps{color:#92DFCE!important}
#gameHUD .hud-combo-label{color:#9BAFC2}
.hud-details-panel{max-width:min(470px,calc(100vw - 24px));border-radius:18px;box-shadow:0 18px 60px rgba(0,0,0,.22)}
.hud-details-score-row{display:grid;grid-template-columns:1fr 1fr .8fr;gap:7px;margin:12px 0 10px}
.detail-stat{display:flex;flex-direction:column;gap:4px;min-width:0;padding:9px 10px;border:1px solid rgba(148,177,205,.17);border-radius:11px;background:rgba(117,151,188,.07)}
.detail-stat>span{font-size:8px;color:#8EA6BE;letter-spacing:1px}
.detail-stat>b{font-size:clamp(13px,2vw,17px);color:#E9D19A;font-variant-numeric:tabular-nums;white-space:nowrap}
.hud-details-song{padding:10px 11px;border:1px solid rgba(148,177,205,.17);border-radius:12px;background:rgba(117,151,188,.055);min-width:0}
.hud-details-song>div:first-child{display:flex;flex-direction:column;min-width:0}
#detailSongTitle{font-size:12px;color:#ECF4FB;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#detailSongArtist,#detailDifficulty{font-size:10px;color:#93A9BF;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#detailDifficulty{display:block;color:#B5BDE8;margin-top:5px}
.folder-import-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;width:100%;margin:-3px 0 14px}
.folder-import-btn,.sound-preview-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:8px 12px;border:1px solid rgba(85,166,198,.28);border-radius:11px;background:rgba(113,181,204,.09);color:#4B8FAA;font-size:12px;font-weight:700;cursor:pointer;transition:background .16s,border-color .16s,transform .16s}
.folder-import-btn svg,.sound-preview-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.folder-import-btn:hover,.sound-preview-btn:hover{background:rgba(113,181,204,.16);border-color:rgba(85,166,198,.52)}
.folder-import-note{font-size:10px;color:#879BAF;line-height:1.4}
.sound-preview-btn{margin-top:8px;min-height:30px;padding:6px 10px;font-size:11px}
.song-card.selected{outline:1px solid rgba(108,177,207,.26);outline-offset:1px}
.song-card:focus-visible{outline:2px solid #78CFE4;outline-offset:3px}
/* The light play theme is an atmospheric palette, not a wash over the notes. */
body.play-theme-light #leftPanel,body.play-theme-light #rightPanel{background:rgba(235,244,249,.93);border-color:rgba(70,110,139,.18);color:#2D475D;box-shadow:0 10px 32px rgba(62,104,132,.10)}
body.play-theme-light #leftPanel .panel-section,body.play-theme-light #rightPanel .panel-section{background:rgba(255,255,255,.72);border-color:rgba(75,121,151,.18);box-shadow:0 4px 12px rgba(72,109,135,.04)}
body.play-theme-light #leftPanel .panel-title,body.play-theme-light #rightPanel .panel-title{color:#6F8BA0}
body.play-theme-light #leftPanel .judge-row,body.play-theme-light #rightPanel .panel-song-title{color:#304C63}
body.play-theme-light .panel-song-artist{color:#6E879B}
body.play-theme-light .panel-song-difficulty{color:#756FB0}
body.play-theme-light .runtime-item>b{color:#3D6378}
body.play-theme-light #panelFps{color:#2A927E!important}
body.play-theme-light #leftPanel .acc-label{color:#6F8BA0}
body.play-theme-light .survival-hud{background:rgba(255,255,255,.72);border-color:rgba(75,121,151,.20);color:#34536A}
body.play-theme-light .hud-details-panel{background:rgba(244,249,252,.97);border-color:rgba(73,123,154,.2);color:#2B465B;box-shadow:0 16px 48px rgba(43,77,100,.18)}
body.play-theme-light .hud-details-heading b,body.play-theme-light #detailSongTitle{color:#2E4C62}
body.play-theme-light .hud-details-kicker,body.play-theme-light .detail-stat>span{color:#7894A7}
body.play-theme-light .detail-stat,.play-theme-light .hud-details-song{background:rgba(222,236,245,.48);border-color:rgba(77,123,154,.16)}
body.play-theme-light .detail-stat>b{color:#795D1C}
body.play-theme-light #detailSongArtist,body.play-theme-light #detailDifficulty{color:#738BA1}
body.play-theme-light .hud-combo{color:#68569B;text-shadow:0 1px 8px rgba(112,96,164,.12)}
body.play-theme-light .hud-combo-label{color:#69839B}
/* Door-inspired portal transition: light water mist flows into the dark stage. */
.portal-transition{position:fixed;inset:0;z-index:120;display:none;align-items:center;justify-content:center;overflow:hidden;pointer-events:auto;background:#EDF6FB;color:#F5FAFE}
.portal-transition.active{display:flex}
.portal-transition-wash{position:absolute;inset:-12%;background:radial-gradient(ellipse at 50% 46%,rgba(255,255,255,.98) 0%,rgba(218,240,249,.9) 26%,rgba(219,204,231,.56) 54%,rgba(237,246,251,1) 100%);transform:scale(1);opacity:1}
.portal-transition-door{position:absolute;width:min(32vw,250px);height:min(54vh,390px);min-width:125px;min-height:205px;border:2px solid rgba(110,194,218,.86);border-radius:50% 50% 32% 32% / 28% 28% 14% 14%;box-shadow:0 0 0 8px rgba(255,255,255,.22),0 0 34px rgba(98,184,211,.25),inset 0 0 30px rgba(255,255,255,.55);transform:scale(.4) rotate(-2deg);opacity:.2}
.portal-door-inner{position:absolute;inset:10px;border:1px solid rgba(226,169,205,.82);border-radius:inherit;background:linear-gradient(180deg,rgba(255,255,255,.46),rgba(159,205,231,.22) 54%,rgba(169,126,191,.12));box-shadow:inset 0 0 24px rgba(255,255,255,.38)}
.portal-door-glint{position:absolute;top:12%;bottom:15%;left:50%;width:1px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.95),transparent);box-shadow:0 0 12px rgba(255,255,255,.8)}
.portal-transition-ripple{position:absolute;width:25vmin;height:25vmin;border:1px solid rgba(105,186,211,.42);border-radius:50%;transform:scale(.2);opacity:0}
.ripple-a{box-shadow:0 0 0 18px rgba(255,255,255,.1),0 0 0 40px rgba(133,190,219,.06)}
.ripple-b{border-color:rgba(221,164,199,.42);width:40vmin;height:40vmin}
.portal-transition-copy{position:absolute;top:calc(50% + min(31vh,220px));display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;color:#EAF3FA;text-shadow:0 1px 12px rgba(6,18,33,.24);transform:translateY(12px)}
.portal-transition-mark{font-size:8px;letter-spacing:3px;font-weight:750;opacity:.8}
.portal-transition-copy b{font-size:clamp(17px,2.7vw,24px);font-weight:650;letter-spacing:4px}
.portal-transition-copy i{width:46px;height:1px;background:linear-gradient(90deg,transparent,#9BD8EA,#DEA9C9,transparent)}
.portal-transition.run .portal-transition-wash{animation:doorWash .78s cubic-bezier(.4,0,.2,1) forwards}
.portal-transition.run .portal-transition-door{animation:doorSweep .78s cubic-bezier(.65,0,.25,1) forwards}
.portal-transition.run .ripple-a{animation:rippleSweep .74s .06s ease-out forwards}
.portal-transition.run .ripple-b{animation:rippleSweep .76s .12s ease-out forwards}
.portal-transition.run .portal-transition-copy{animation:portalCopyIn .5s .38s ease-out forwards}
.portal-transition.leaving{animation:portalOverlayExit .34s ease-out forwards}
@keyframes doorWash{0%{background:radial-gradient(ellipse at 50% 46%,#fff 0%,#DDF0F8 35%,#F6E8F0 70%,#EDF6FB 100%);opacity:1}55%{background:radial-gradient(ellipse at 50% 45%,#769FBA 0%,#334F70 35%,#17283E 74%,#111D30 100%);opacity:1}100%{background:radial-gradient(ellipse at 50% 45%,#14253B 0%,#0B1727 48%,#080F1C 100%);opacity:1}}
@keyframes doorSweep{0%{transform:scale(.35) rotate(-2deg);opacity:.25;border-color:rgba(110,194,218,.8)}48%{transform:scale(1.1) rotate(1deg);opacity:1;border-color:rgba(211,174,216,.85)}100%{transform:scale(5.4) rotate(5deg);opacity:0;border-color:rgba(183,204,235,.12)}}
@keyframes rippleSweep{0%{transform:scale(.2);opacity:0}25%{opacity:.72}100%{transform:scale(5.4);opacity:0}}
@keyframes portalCopyIn{0%{opacity:0;transform:translateY(12px)}100%{opacity:.88;transform:translateY(0)}}
@keyframes portalOverlayExit{to{opacity:0;visibility:hidden}}
@media(max-width:700px){
  #leftPanel,#rightPanel{padding:50px 5px 9px;gap:6px}
  #leftPanel .panel-section,#rightPanel .panel-section{padding:7px 6px;border-radius:10px}
  #leftPanel .panel-title,#rightPanel .panel-title{font-size:8px;letter-spacing:.7px}
  .panel-score-value{font-size:18px}
  #leftPanel .acc-big{font-size:19px}
  #leftPanel .judge-row{font-size:10px;padding:2px 0}
  .panel-song-title{font-size:10px}.panel-song-artist{font-size:9px}
  .panel-runtime-summary{grid-template-columns:1fr;gap:5px}
  .runtime-item>b{font-size:10px}
  .hud-details-score-row{grid-template-columns:1fr 1fr;}
  .detail-stat:last-child{grid-column:1/-1}
  .portal-transition-copy{top:calc(50% + 31vw)}
}
@media(prefers-reduced-motion:reduce){.portal-transition.run .portal-transition-wash,.portal-transition.run .portal-transition-door,.portal-transition.run .ripple-a,.portal-transition.run .ripple-b,.portal-transition.run .portal-transition-copy{animation-duration:.01ms!important}}

</style>

<style id="door-v17-1-ver1-polish">
:root{
  --door-ice:rgba(202,235,248,.72);
  --door-lilac:rgba(216,202,245,.52);
  --door-rose:rgba(245,204,224,.42);
  --door-ease:cubic-bezier(.2,.72,.22,1);
}
html,body{font-family:"Avenir Next","PingFang SC","Segoe UI","Microsoft YaHei",system-ui,sans-serif;font-kerning:normal}
/* Typography stays subordinate to the scene: compact titles, restrained tracking, no huge display type. */
#menu .menu-copy h1{font-size:clamp(25px,2.6vw,35px);font-weight:620;line-height:1.18;letter-spacing:.002em;margin:0 0 10px;filter:drop-shadow(0 1px 10px rgba(125,179,214,.10));white-space:nowrap}
#menu .menu-copy h1 br{display:none}
#menu .menu-copy h1 em:after{display:none}
#menu .menu-copy h1 em{font-style:normal;color:rgba(91,150,179,.88);-webkit-text-fill-color:currentColor;background:none}
#menu .menu-subtitle{font-size:clamp(11px,.95vw,13px);letter-spacing:.045em;line-height:1.75;margin-bottom:25px;color:#6c8296}
#menu .menu-eyebrow{font-size:9px;letter-spacing:.15em}
#menu .brand-word{font-size:22px;letter-spacing:.015em;font-weight:650}
#menu .menu-hint{font-size:10px;letter-spacing:.01em}
#menu .key-hint-row kbd{font-size:10px}
.library-intro h2{font-size:clamp(27px,3.2vw,38px);letter-spacing:-.035em;font-weight:680}
.library-section-title h3{font-weight:690;letter-spacing:0}
#gameHUD .hud-song .t{font-weight:600;letter-spacing:.005em}
#gameHUD .hud-combo{font-weight:500;letter-spacing:-.025em;text-shadow:0 0 20px rgba(173,222,247,.18)}
.result-song-title{font-weight:680;letter-spacing:-.012em}
.result-rank{font-weight:800;letter-spacing:-.04em}
/* A subtle, layered sense of air: no layout shifts and no hit-area overlays. */
#songselect,#settings,#result{background-color:#E7EEF5;background-image:radial-gradient(ellipse at 16% 18%,rgba(146,210,230,.17),transparent 43%),radial-gradient(ellipse at 86% 79%,rgba(231,173,205,.13),transparent 46%);background-size:160% 160%,145% 145%;background-position:0% 12%,100% 88%;animation:doorPageLightFlow 28s ease-in-out infinite alternate}
.menu-content{isolation:isolate}
.menu-content:before{animation:doorAmbientBloom 19s ease-in-out infinite alternate;transform-origin:center}
.menu-visual{isolation:isolate}
.menu-visual .visual-halo{animation:doorHaloBreath 11s ease-in-out infinite alternate}
.menu-visual .halo-pink{animation-delay:-5s}
.menu-visual .portal-orbit{will-change:transform}
.menu-visual .orbit-one{animation:doorOrbitOne 64s linear infinite}
.menu-visual .orbit-two{animation:doorOrbitTwo 82s linear infinite}
.menu-visual .portal-art{transform-origin:50% 60%;animation:doorPortalFloat 7.5s ease-in-out infinite}
.menu-visual .floating-chip{animation:doorChipFloat 8s ease-in-out infinite}
.menu-visual .chip-bottom{animation-delay:-3.7s}
.menu-visual:before{content:"";position:absolute;z-index:2;top:-25%;bottom:-25%;left:-42%;width:20%;pointer-events:none;opacity:.38;mix-blend-mode:screen;background:linear-gradient(90deg,transparent,rgba(255,255,255,.46),rgba(188,225,244,.2),transparent);transform:skewX(-20deg);animation:doorGlassSweep 13s ease-in-out infinite}
.menu-visual:after{pointer-events:none}
.menu-btn,.back-btn,.diff-btn,.play-mode-option,.hud-icon-btn,.game-controls .mode-btn,.resource-card,.song-card{transition-property:color,background,border-color,box-shadow,transform,opacity;transition-duration:.24s;transition-timing-function:var(--door-ease)}
@media(hover:hover) and (pointer:fine){
  .menu-btn:hover,.back-btn:hover,.diff-btn:hover,.play-mode-option:hover,.hud-icon-btn:hover,.game-controls .mode-btn:hover{transform:translateY(-1px)}
  .song-card:hover{transform:translateY(-1px);box-shadow:0 9px 24px rgba(69,125,159,.09)}
  .resource-card:hover{transform:translateX(2px)}
}
/* The song selection layout itself is intentionally unchanged; only polish its response and surface motion. */
.song-card.selected{box-shadow:inset 0 0 0 1px rgba(138,194,220,.14),0 7px 22px rgba(83,136,167,.055)}
.drop-zone{transition:border-color .22s var(--door-ease),background .22s var(--door-ease),box-shadow .22s var(--door-ease)}
.drop-zone:hover,.drop-zone.drag{box-shadow:0 0 0 4px rgba(128,194,219,.07)}
.screen.active{will-change:opacity,transform;backface-visibility:hidden}
@keyframes doorPageLightFlow{0%{background-position:0% 12%,100% 88%}100%{background-position:35% 55%,65% 35%}}
@keyframes doorAmbientBloom{0%{transform:translate3d(-1.5%,0,0) scale(.98);opacity:.58}100%{transform:translate3d(1.8%,1.2%,0) scale(1.025);opacity:.95}}
@keyframes doorHaloBreath{0%{transform:translate3d(-4px,3px,0) scale(.94);opacity:.58}100%{transform:translate3d(7px,-5px,0) scale(1.06);opacity:.92}}
@keyframes doorOrbitOne{from{transform:rotate(-24deg) scaleX(.72)}to{transform:rotate(336deg) scaleX(.72)}}
@keyframes doorOrbitTwo{from{transform:rotate(38deg) scaleX(.9) scaleY(.88)}to{transform:rotate(398deg) scaleX(.9) scaleY(.88)}}
@keyframes doorPortalFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes doorChipFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
@keyframes doorGlassSweep{0%,54%{left:-42%;opacity:0}65%{opacity:.34}83%{left:128%;opacity:.19}100%{left:128%;opacity:0}}
@media(max-width:600px){
  #menu .menu-copy h1{font-size:clamp(23px,6.2vw,29px);letter-spacing:0}
  #menu .menu-subtitle{margin-bottom:17px;font-size:11px}
  #menu .brand-word{font-size:20px}
  .menu-visual:before{width:28%;animation-duration:16s}
}
@media(prefers-reduced-motion:reduce){
  #songselect,#settings,#result{animation:none!important}
  .menu-content:before,.menu-visual .visual-halo,.menu-visual .portal-orbit,.menu-visual .portal-art,.menu-visual .floating-chip,.menu-visual:before{animation:none!important}
  .menu-btn,.back-btn,.diff-btn,.play-mode-option,.hud-icon-btn,.game-controls .mode-btn,.resource-card,.song-card{transition:none!important}
}
body.reduce-motion .menu-content:before,body.reduce-motion .menu-visual .visual-halo,body.reduce-motion .menu-visual .portal-orbit,body.reduce-motion .menu-visual .portal-art,body.reduce-motion .menu-visual .floating-chip,body.reduce-motion .menu-visual:before{animation:none!important}
</style>

</head>
<body>

<canvas id="bgCanvas"></canvas>
<canvas id="game" aria-label="Door 游玩区域"></canvas>

<!-- v17.6 环境层与转场层：纯装饰，pointer-events:none，不参与任何判定、输入或计时 -->
<div class="rl-ambient" id="rlAmbient" aria-hidden="true">
  <div class="rl-field rl-field-ice"></div><div class="rl-field rl-field-lilac"></div><div class="rl-field rl-field-rose"></div>
  <div class="rl-ribbon rl-ribbon-a"></div><div class="rl-ribbon rl-ribbon-b"></div><div class="rl-ribbon rl-ribbon-c"></div>
  <div class="rl-rain rl-rain-a"></div><div class="rl-rain rl-rain-b"></div><div class="rl-rain rl-rain-c"></div><div class="rl-rain rl-rain-d"></div>
  <div class="rl-waterline"></div>
  <div class="rl-vignette"></div>
  <div class="rl-objects" id="rlObjects"></div>
</div>
<div class="rl-curtain" id="rlCurtain" aria-hidden="true">
  <div class="rl-curtain-glow"></div>
  <div class="rl-curtain-layer"></div>
  <div class="rl-curtain-layer"></div>
</div>
<div class="rl-transit" id="rlTransit" aria-hidden="true">
  <div class="rl-transit-wash"></div>
  <div class="rl-transit-arch"></div>
  <div class="rl-transit-core"></div>
  <div class="rl-transit-sweep"></div>
  <div class="rl-transit-copy"><b id="rlTransitTitle">DOOR</b><span id="rlTransitSub">CROSSING THE THRESHOLD</span></div>
</div>

<!-- 4:3侧面板：左侧呈现本局成绩，右侧呈现曲目信息与运行状态 -->
<div class="side-panel" id="leftPanel">
  <div class="panel-section panel-score-summary">
    <div class="panel-title"><svg class="tiny-line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15v-4M12 15V7M16 15V9"/></svg>本局分数</div>
    <div class="panel-score-value" id="panelScore">0</div>
    <div class="acc-big" id="panelAcc" style="color:#BFE8DC">100.00</div>
    <div class="acc-label">ACCURACY %</div>
  </div>
  <div class="panel-section panel-judgement-summary">
    <div class="panel-title">判定统计</div>
    <div class="judge-row"><span class="jl"><span class="judge-dot" style="background:#C5A7F4"></span>Perfect</span><span class="jv" id="pPerfect" style="color:#C5A7F4">0</span></div>
    <div class="judge-row"><span class="jl"><span class="judge-dot" style="background:#72D2F0"></span>Great</span><span class="jv" id="pGreat" style="color:#72D2F0">0</span></div>
    <div class="judge-row"><span class="jl"><span class="judge-dot" style="background:#F1D17B"></span>Good</span><span class="jv" id="pGood" style="color:#F1D17B">0</span></div>
    <div class="judge-row"><span class="jl"><span class="judge-dot" style="background:#F0A071"></span>Bad</span><span class="jv" id="pBad" style="color:#F0A071">0</span></div>
    <div class="judge-row"><span class="jl"><span class="judge-dot" style="background:#F17899"></span>Miss</span><span class="jv" id="pMiss" style="color:#F17899">0</span></div>
  </div>
</div>
<div class="side-panel" id="rightPanel">
  <div class="panel-section panel-song-meta">
    <div class="panel-title"><svg class="tiny-line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13M9 9l12-2M5 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm12-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>正在播放</div>
    <div class="panel-song-title" id="hudSongTitle">未选择曲目</div>
    <div class="panel-song-artist" id="hudSongArtist"></div>
    <div class="panel-song-difficulty" id="hudDifficulty"></div>
    <div class="panel-meta-badges"><div class="auto-badge" id="autoBadge">AUTO PLAY</div><span class="best-delta" id="bestDelta">BEST —</span></div>
  </div>
  <div class="panel-section panel-offset-section">
    <div class="panel-title">时间偏差 (ms)</div>
    <canvas id="offsetCanvas"></canvas>
  </div>
  <div class="survival-hud" id="survivalHUD" aria-live="polite"><div class="survival-label"><span>✦ LIFE</span><b id="survivalValue">100%</b></div><div class="survival-track"><i id="survivalFill"></i></div></div>
  <div class="panel-section panel-runtime-summary">
    <div class="runtime-item"><span class="panel-title">判定档位</span><b id="panelJudge">标准</b></div>
    <div class="runtime-item"><span class="panel-title">实际绘制帧率</span><b id="panelFps">— FPS</b></div>
  </div>
</div>

<!-- HUD：顶部只保留小型连击提示，避免覆盖音符与轨道 -->
<div id="gameHUD" aria-label="当前连击">
  <div class="hud-pill hud-pill-center">
    <div class="hud-combo" id="hudCombo">0</div>
    <div class="hud-combo-label">COMBO</div>
  </div>
</div>

<div class="game-controls" id="gameControls" aria-label="游戏控制">
  <button class="hud-icon-btn" id="hudDetailsBtn" type="button" onclick="toggleHudDetails()" aria-expanded="false" aria-controls="hudDetailsPanel" title="实时数据"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 16v-4M12 16V8M16 16v-6M20 16V3"/></svg></button>
  <button class="hud-icon-btn" id="hudPauseBtn" type="button" onclick="pauseGame()" title="暂停游戏（Esc）"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg></button>
  <button class="mode-btn" id="modeBtn" onclick="toggleLayout()" title="切换画面布局" aria-label="切换画面布局">⛶</button>
</div>
<div class="hud-details-panel" id="hudDetailsPanel" aria-hidden="true">
  <div class="hud-details-heading"><div><span class="hud-details-kicker">LIVE ANALYTICS</span><b>实时判定数据</b></div><span class="hud-mode-pill" id="hudModeLabel">MANUAL</span></div>
  <div class="hud-details-score-row">
    <div class="detail-stat"><span>SCORE</span><b id="hudScore">0</b></div>
    <div class="detail-stat"><span>ACCURACY</span><b id="hudAcc">100.00%</b></div>
    <div class="detail-stat"><span>RENDER FPS</span><b id="detailFps">— FPS</b></div>
  </div>
  <div class="hud-details-song">
    <div><b id="detailSongTitle">未选择曲目</b><span id="detailSongArtist"></span></div>
    <span id="detailDifficulty"></span>
    <div class="details-song-badges"><span class="auto-badge" id="detailAutoBadge">AUTO PLAY</span><span class="best-delta" id="detailBestDelta">BEST —</span></div>
  </div>
  <div class="hud-judge-grid">
    <div class="hud-judge-chip perfect"><span>PERFECT</span><b id="hudPerfect">0</b></div>
    <div class="hud-judge-chip great"><span>GREAT</span><b id="hudGreat">0</b></div>
    <div class="hud-judge-chip good"><span>GOOD</span><b id="hudGood">0</b></div>
    <div class="hud-judge-chip bad"><span>BAD</span><b id="hudBad">0</b></div>
    <div class="hud-judge-chip miss"><span>MISS</span><b id="hudMiss">0</b></div>
  </div>
  <div class="hud-live-footer"><span>已结算 <b id="hudJudgedCount">0 / 0</b></span><span>近 60 次偏差 <b id="hudMeanOffset">—</b></span><span>进行中 Hold <b id="hudHoldCount">0</b></span></div>
  <div class="hud-details-progress"><span id="hudProgressLabel">谱面进度</span><div class="hud-details-track"><i id="hudDetailsProgress"></i></div></div>
</div>
<div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div>

<div class="pause-overlay" id="pauseOverlay">
  <h2>暂停</h2>
  <button class="menu-btn" onclick="resumeGame()">继续 (Esc)</button>
  <button class="menu-btn" onclick="restartGame()">重新开始 (R)</button>
  <button class="menu-btn" onclick="quitToSongSelect()">返回选歌 (Q)</button>
</div>

<!-- Door 主菜单：Soft Portal -->
<div class="screen active" id="menu">
  <div class="home-atmosphere" aria-hidden="true">
    <div class="home-lightfield field-ice"></div><div class="home-lightfield field-lilac"></div>
    <div class="home-light-ribbon ribbon-one"></div><div class="home-light-ribbon ribbon-two"></div>
    <div class="home-rain-thread thread-one"></div><div class="home-rain-thread thread-two"></div><div class="home-rain-thread thread-three"></div>
    <div class="home-waterline"></div>
  </div>
  <div class="menu-content door-home-stage">
    <div class="home-eyeline" aria-hidden="true"><span>DOOR / PORTAL 01</span><span>RAINLIGHT ARCHIVE · 4K</span></div>
    <div class="menu-copy">
      <div class="brand-lockup">
        <svg class="brand-icon" viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 42V13a5 5 0 0 1 5-5h22a5 5 0 0 1 5 5v29" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M16 42V17a2 2 0 0 1 2-2h14v27" fill="currentColor" opacity=".16"/>
          <path d="M16 42V17a2 2 0 0 1 2-2h14v27" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="27.5" cy="29" r="1.5" fill="currentColor"/>
        </svg>
        <span class="brand-word">Door</span>
      </div>
      <div class="menu-eyebrow"><span class="eyebrow-dot"></span> 4-KEY RHYTHM GAME</div>
      <h1>Open your <em>sound.</em></h1>
      <p class="menu-subtitle">越过门扉，让每一个音符找到自己的位置。</p>
      <div class="menu-actions">
        <button class="menu-btn primary rl-opt rl-opt-play" onclick="showScreen('songselect')">
          <span class="rl-opt-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 21V6.4A2.4 2.4 0 0 1 9.4 4h5.2A2.4 2.4 0 0 1 17 6.4V21"/><path d="M10.4 21V8.6h3.2V21"/><circle cx="13.1" cy="14.6" r=".9"/><path d="M4.6 21h14.8"/></svg></span>
          <span class="rl-opt-copy"><b>开始游玩</b><small>选择曲目并进入门扉</small></span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="menu-btn secondary rl-opt rl-opt-library" onclick="gotoImport()">
          <span class="rl-opt-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 15.5V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2.5"/><path d="M12 3.6v11.2"/><path d="M8.2 10.9 12 14.7l3.8-3.8"/></svg></span>
          <span class="rl-opt-copy"><b>导入谱面</b><small>直接前往 .osz 与文件夹导入</small></span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="menu-btn secondary rl-opt rl-opt-settings" onclick="showScreen('settings')">
          <span class="rl-opt-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8h14M5 16h14"/><circle cx="9.4" cy="8" r="2.1"/><circle cx="14.6" cy="16" r="2.1"/></svg></span>
          <span class="rl-opt-copy"><b>设置</b><small>速度、判定与画面</small></span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="menu-btn ghost rl-opt rl-opt-theme" id="menuThemeBtn" onclick="toggleUiTheme()" title="切换界面明暗（T）">
          <span class="rl-opt-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19.4 15.1A7.6 7.6 0 0 1 8.9 4.6a7.8 7.8 0 1 0 10.5 10.5Z"/></svg></span>
          <span class="rl-opt-copy"><b id="menuThemeLabel">暗色模式</b><small>深夜暴雨 / 雨光白昼</small></span>
          <span class="btn-arrow" aria-hidden="true">◐</span>
        </button>
      </div>
      <div class="menu-hint">
        <div class="key-hint-row"><kbd id="keyHintK1">D</kbd><kbd id="keyHintK2">F</kbd><kbd id="keyHintK3">J</kbd><kbd id="keyHintK4">K</kbd><span>键盘击打</span><i></i><kbd>ESC</kbd><span>暂停</span></div>
        <div class="hint-secondary">支持触屏点击 · 导入 osu!mania 4K 谱面</div>
      </div>
    </div>
    <div class="menu-visual" aria-hidden="true">
      <div class="visual-halo halo-blue"></div><div class="visual-halo halo-pink"></div>
      <div class="portal-orbit orbit-one"></div><div class="portal-orbit orbit-two"></div>
      <svg class="portal-art" viewBox="0 0 420 480">
        <defs>
          <linearGradient id="portalFill" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8EDFF4"/><stop offset=".52" stop-color="#C8E9FB"/><stop offset="1" stop-color="#F4B9D7"/></linearGradient>
          <linearGradient id="portalStroke" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#65C5E5"/><stop offset="1" stop-color="#E7A1C5"/></linearGradient>
        </defs>
        <ellipse cx="212" cy="420" rx="112" ry="18" fill="#9ACCE5" opacity=".18"/>
        <path d="M92 414V151C92 76 145 35 212 35S332 76 332 151V414" fill="none" stroke="url(#portalStroke)" stroke-width="3" opacity=".85"/>
        <path d="M116 414V153C116 92 154 60 212 60S308 92 308 153V414Z" fill="url(#portalFill)" opacity=".36"/>
        <path d="M137 414V156C137 106 165 83 212 83S287 106 287 156V414Z" fill="url(#portalFill)" opacity=".7"/>
        <path d="M154 414V161C154 120 176 103 212 103S270 120 270 161V414Z" fill="#FFFFFF" opacity=".74"/>
        <path d="M174 414V165C174 140 188 128 212 128S250 140 250 165V414Z" fill="url(#portalFill)" opacity=".9"/>
        <path d="M212 130V414" stroke="#FFFFFF" stroke-width="1.6" opacity=".8"/>
        <circle cx="247" cy="285" r="4" fill="#E7A1C5"/><circle cx="247" cy="285" r="1.4" fill="#FFFFFF"/>
        <path d="M72 115l5 14 14 5-14 5-5 14-5-14-14-5 14-5z" fill="#F0A5C9"/>
        <path d="M342 193l3.5 9.5 9.5 3.5-9.5 3.5-3.5 9.5-3.5-9.5-9.5-3.5 9.5-3.5z" fill="#79CDE8"/>
        <circle cx="95" cy="285" r="4" fill="#A9A1EC"/><circle cx="338" cy="327" r="3" fill="#F1B0CE"/>
        <path d="M135 52q-16 10-22 26M296 76q14 9 20 23" fill="none" stroke="#A7DDF0" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <div class="visual-caption"><span class="caption-line"></span><span>YOUR NEXT NOTE IS WAITING</span></div>
      <div class="floating-chip chip-top"><span class="chip-dot"></span> CLEAR · LIGHT · FLOW</div>
      <div class="floating-chip chip-bottom"><span class="chip-wave">♫</span> FIND YOUR RHYTHM</div>
    </div>
    <div class="menu-footer"><span>DOOR / RAINLIGHT GLASS</span><span>PLAY AT YOUR OWN PACE</span><span>v17.7 · RAINLIGHT DUAL</span></div>
  </div>
</div>

<!-- 选曲与谱面导航 -->
<div class="screen" id="songselect">
  <div class="song-page-shell door-library-workspace">
    <header class="page-header">
      <button class="back-btn header-back" onclick="showScreen('menu')" aria-label="返回主菜单">← <span>主菜单</span></button>
      <div class="mini-brand"><span class="mini-brand-mark">D</span><span>Door</span></div>
      <div class="header-note">DOOR / LIBRARY</div>
    </header>
    <div class="library-hero-wrap">
      <div class="library-hero-orbit" aria-hidden="true"></div>
      <section class="library-intro">
      <div><div class="section-eyebrow">YOUR MUSIC SPACE</div><h2>曲目<span>库</span></h2><p>选择一首曲目，或导入你喜欢的 4K 谱面。</p></div>
      <div class="library-count"><span class="count-mark">♫</span><span><b id="songCount">0</b><small>首已导入</small></span></div>
    </section>
      <div class="library-hero-note" aria-hidden="true"><span class="hero-note-mark">✦</span><span>YOUR NEXT<br/>FAVOURITE TRACK</span></div>
    </div>
    <div class="library-layout">
      <section class="library-main">
        <div class="library-section-title"><div><h3>我的曲目</h3><p>本地谱面 · 点击卡片选择难度</p></div><span class="section-index">01</span></div>
        <div class="drop-zone" id="dropZone">
          <span class="upload-icon" aria-hidden="true">↑</span>
          <span class="upload-main">导入谱面 <b>.osz</b></span>
          <span class="upload-sub">将文件拖到这里，或点击选择文件</span>
        </div>
        <div class="folder-import-row">
          <button type="button" class="folder-import-btn" id="chooseFolderBtn" onclick="event.stopPropagation();chooseChartFolder()">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5A2.5 2.5 0 0 1 6 5h4l2 2h6a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 18 19H6a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M4 10h16"/></svg>
            选择谱面文件夹
          </button>
          <span class="folder-import-note">只读取你选择的目录，可包含多首曲目</span>
        </div>
        <input type="file" id="fileInput" accept=".osz" style="display:none">
        <input type="file" id="folderInput" webkitdirectory directory multiple style="display:none">
        <div class="song-list" id="songList"></div>
      </section>
      <section class="track-stage" aria-label="当前曲目" aria-live="polite">
        <div class="stage-heading"><span>SELECTED TRACK</span><span class="stage-heading-mark" aria-hidden="true">✧</span></div>
        <div class="cover-frame" id="coverFrame">
          <img class="cover-image" id="coverImage" alt="" hidden>
          <div class="cover-fallback" id="coverFallback">
            <div class="cover-halo"></div><div class="cover-orbit"></div>
            <div class="cover-door"><i></i></div>
            <div class="cover-wordmark">DOOR</div>
          </div>
          <div class="cover-sheen" aria-hidden="true"></div>
          <div class="cover-frame-line" aria-hidden="true"></div>
          <div class="cover-badge" id="coverBadge">DECORATIVE COVER</div>
        </div>
        <div class="stage-info">
          <div class="stage-eyebrow">IN THE ARCHIVE <span>✦</span> 4-KEY MANIA</div>
          <h3 id="stageTitle">等待下一首歌</h3>
          <p id="stageArtist">从左侧导入谱面，让音乐在此展开。</p>
          <div class="stage-facts">
            <div><small>BPM</small><b id="stageBpm">—</b></div>
            <div><small>NOTES</small><b id="stageNotes">—</b></div>
            <div><small>CHARTS</small><b id="stageCharts">—</b></div>
          </div>
          <div class="stage-choice-label">CHOOSE YOUR DIFFICULTY <span>→</span></div>
          <div class="stage-difficulties" id="stageDifficulties"><span class="stage-empty">导入谱面后选择难度</span></div>
          <button type="button" class="stage-play" id="stagePlay" disabled><span>进入演奏</span><span aria-hidden="true">↗</span></button>
        </div>
      </section>
      <aside class="library-aside">
<section class="play-mode-bar mode-workspace-card" aria-label="游玩模式">
      <div class="play-mode-copy"><span class="play-mode-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 8V5.8A2.8 2.8 0 0 1 10.8 3h2.4A2.8 2.8 0 0 1 16 5.8V8M6.5 8h11A2.5 2.5 0 0 1 20 10.5v6A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-6A2.5 2.5 0 0 1 6.5 8Z"/><path d="M8.5 12v3M7 13.5h3M15.5 12.7h.01M17 15.1h.01"/></svg></span><span><b>演奏模式</b><small>开始曲目之前选择</small></span></div>
      <div class="play-mode-segment" role="group" aria-label="选择演奏模式">
        <button type="button" id="manualModeBtn" class="play-mode-option" aria-pressed="true" onclick="setPlayMode(false)"><span class="mode-option-dot"></span>手动演奏</button>
        <button type="button" id="autoModeBtn" class="play-mode-option" aria-pressed="false" onclick="setPlayMode(true)"><span class="mode-option-dot"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7V5.8A2.8 2.8 0 0 1 11.8 3h.4A2.8 2.8 0 0 1 15 5.8V7M7 7h10a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-5a3 3 0 0 1 3-3Z"/><path d="M8.5 11v3M7 12.5h3M15.5 11.7h.01M17 14h.01"/></svg>AutoPlay</button>
      </div>
      <div class="play-mode-description" id="playModeDescription">手动击打 · 使用当前键位或触屏操作</div>
    </section>

        <div class="library-section-title"><div><h3>谱面导航</h3><p>在外部站点查找并下载谱面</p></div><span class="section-index">02</span></div>
        <a class="resource-card resource-primary" href="https://osu.sayobot.cn/" target="_blank" rel="noopener noreferrer">
          <span class="resource-icon sayo-icon">夜</span><span class="resource-text"><b>小夜镜像站</b><small>中文检索 · 谱面下载 · 第三方镜像</small></span><span class="resource-arrow">↗</span>
        </a>
        <a class="resource-card" href="https://osu.ppy.sh/beatmapsets" target="_blank" rel="noopener noreferrer">
          <span class="resource-icon official-icon">O!</span><span class="resource-text"><b>osu! 官方谱面</b><small>按歌曲、作者与模式检索</small></span><span class="resource-arrow">↗</span>
        </a>
        <a class="resource-card" href="https://osu.ppy.sh/beatmaps/packs?type=tournament" target="_blank" rel="noopener noreferrer">
          <span class="resource-icon pack-icon">4K</span><span class="resource-text"><b>官方比赛曲包</b><small>包含 osu!mania 4K 图池</small></span><span class="resource-arrow">↗</span>
        </a>
        <div class="resource-tip"><span class="tip-icon">i</span><p>下载后将 <b>.osz</b> 文件导入左侧。Door 目前仅识别 osu!mania 的 4K 谱面；外部站点的访问速度取决于你的网络环境。</p></div>
        <div class="library-aside-footer"><span class="tiny-orb"></span> CURATED LINKS · OPEN IN NEW TAB</div>
      </aside>
    </div>
    <footer class="page-footer"><span>DOOR / RAINLIGHT GLASS</span><span>4K ONLY · OSU!MANIA FORMAT</span></footer>
  </div>
</div>

<!-- 设置 -->
<div class="screen" id="settings">
  <div class="settings-panel">
    <div class="settings-intro"><span class="settings-kicker">DOOR / PERSONAL SPACE</span><h2>调校你的<span>节奏.</span></h2><p>界面明暗、下落速度与判定都从这里开始。</p></div>
    <div class="setting-item">
      <label>界面主题 <span class="vd" id="uiThemeLabel">雨光白昼</span></label>
      <select id="uiThemeSelect" onchange="setUiTheme(this.value,true)">
        <option value="light">雨光白昼 · 明亮清透</option>
        <option value="dark">深夜暴雨 · 阴郁冷光</option>
      </select>
      <div class="quality-hint">只改变菜单、选曲、设置与结算的界面明暗，不改变演奏舞台与判定。</div>
    </div>
    <div class="setting-item">
      <label>下落速度 <span class="vd" id="speedVal">3.0x</span></label>
      <input type="range" id="speedSlider" min="1" max="8" step="0.1" value="3">
    </div>
    <div class="setting-item">
      <label>判定偏移 (ms) <span class="vd" id="offsetVal">0</span></label>
      <input type="range" id="offsetSlider" min="-200" max="200" step="5" value="0">
    </div>
    <div class="setting-item">
      <label>音乐音量 <span class="vd" id="volVal">80%</span></label>
      <input type="range" id="volSlider" min="0" max="100" step="5" value="80">
    </div>
    <div class="setting-item">
      <label>按键音效音量 <span class="vd" id="sfxVal">60%</span></label>
      <input type="range" id="sfxSlider" min="0" max="100" step="5" value="60">
      <button type="button" class="sound-preview-btn" onclick="previewHitSound()"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6l-5 4H4Z"/><path d="M16 9a5 5 0 0 1 0 6M18.5 6.5a8.5 8.5 0 0 1 0 11"/></svg>试听打击音效</button>
    </div>
    <div class="setting-item">
      <label>画面布局</label>
      <select id="layoutSelect" onchange="SETTINGS.layout=this.value;saveSettings();applyLayout()">
        <option value="auto">自动（手机全屏/电脑4:3）</option>
        <option value="fullscreen">全屏</option>
        <option value="43">4:3 居中（数据面板）</option>
      </select>
    </div>
    <div class="setting-item">
      <label>演奏背景风格</label>
      <select id="playThemeSelect" onchange="onPlayThemeChange(this.value)">
        <option value="dark">深色雨夜 · 深海蓝黑</option>
        <option value="light">明亮雨雾 · 雾白蓝灰</option>
      </select>
   <div class="play-theme-preview" id="playThemePreview" data-theme="dark" aria-live="polite">
    <div class="theme-preview-copy"><span>演奏舞台预览</span><b id="playThemePreviewLabel">深色雨夜</b></div>
    <div class="theme-preview-track" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="preview-note preview-note-a"></span><span class="preview-note preview-note-b"></span><span class="preview-hold"></span></div>
   </div>
      <div class="quality-hint">只改变演奏舞台与数据面板的明暗，不修改判定与音符速度。</div>
    </div>
    <div class="setting-item">
      <label>绘制帧率上限</label>
      <select id="frameLimitSelect" onchange="onFrameLimitChange(this.value)">
        <option value="unlimited">不主动限帧（跟随屏幕刷新）</option>
        <option value="30">30 FPS</option>
        <option value="60">60 FPS</option>
        <option value="90">90 FPS</option>
        <option value="120">120 FPS</option>
        <option value="144">144 FPS</option>
        <option value="165">165 FPS</option>
        <option value="240">240 FPS</option>
      </select>
      <div class="quality-hint">只限制画布绘制频率。输入队列、判定与音频同步仍按原循环执行。</div>
    </div>
    <div class="setting-item">
      <label>判定难度 <span class="vd" id="judgePresetLabel">标准</span></label>
      <select id="judgeSelect" onchange="onJudgePresetChange(this.value)">
        <option value="easy">宽松 — 新手友好</option>
        <option value="normal">标准</option>
        <option value="hard">严格 — 接近 osu!mania</option>
        <option value="extreme">极限 — 职业级</option>
      </select>
      <div style="font-size:11px;color:#5a6b85;margin-top:5px" id="judgeWindowInfo">Perfect ±45ms · Great ±90ms · Good ±140ms · Bad ±190ms</div>
    </div>
    <div class="setting-item">
      <label>键盘键位（电脑） <span class="vd" id="keyPresetLabel">D F J K</span></label>
      <select id="keyPresetSelect" onchange="onKeyPresetChange(this.value)">
        <option value="dfjk">D F J K（默认）</option>
        <option value="sdkl">S D K L</option>
        <option value="arrows">方向键 ←↓↑→</option>
        <option value="custom">自定义</option>
      </select>
      <div style="display:flex;gap:6px;margin-top:8px">
        <button class="key-bind-btn" onclick="startKeyBind(0)">D</button>
        <button class="key-bind-btn" onclick="startKeyBind(1)">F</button>
        <button class="key-bind-btn" onclick="startKeyBind(2)">J</button>
        <button class="key-bind-btn" onclick="startKeyBind(3)">K</button>
      </div>
      <div style="font-size:11px;color:#5a6b85;margin-top:5px">点击按键按钮，再按下想绑定的键（手机端无需设置）</div>
    </div>
    <div class="setting-item toggle-row"><label>显示判定文字</label><div class="toggle on" id="judgeTextToggle" role="switch" tabindex="0" aria-checked="true" onclick="toggleJudgeText()"></div></div>
    <div class="setting-item toggle-row"><label>按键音效</label><div class="toggle on" id="sfxToggle" role="switch" tabindex="0" aria-checked="true" onclick="toggleSfx()"></div></div>
    <div class="setting-item toggle-row"><label>触屏滑动切轨 <span style="display:block;font-size:10px;color:#64748b;margin-top:3px">默认关闭，避免手指轻微移动误触相邻轨道</span></label><div class="toggle" id="slideInputToggle" role="switch" tabindex="0" aria-checked="false" onclick="toggleSlideInput()"></div></div>
    <div class="setting-item toggle-row"><label>多押提示 <span style="display:block;font-size:10px;color:var(--text-muted);margin-top:3px">同一时刻需要同时击打多条轨道时显示轻量提示</span></label><div class="toggle on" id="multiPressToggle" role="switch" tabindex="0" aria-checked="true" onclick="toggleMultiPressHint()"></div></div>
    <div class="setting-item toggle-row"><label>生存血条 <span style="display:block;font-size:10px;color:var(--text-muted);margin-top:3px">开启后 Bad / Miss 会扣除生命值，归零进入失败结算</span></label><div class="toggle" id="survivalGaugeToggle" role="switch" tabindex="0" aria-checked="false" onclick="toggleSurvivalGauge()"></div></div>
    <div class="setting-item"><label>画面质量 <span class="vd" id="qualityLabel">低延迟</span></label><select id="qualitySelect" onchange="onQualityChange(this.value)"><option value="low">低延迟（推荐，优先稳定帧率）</option><option value="balanced">均衡</option><option value="high">高画质</option></select><div class="quality-hint">低延迟模式降低画布分辨率、粒子数量与发光效果，不改变判定窗口或音符速度。</div></div>
    <div class="setting-item toggle-row"><label>减少动态效果 <span style="display:block;font-size:10px;color:var(--text-muted);margin-top:3px">降低背景运动与装饰反馈，不影响判定</span></label><div class="toggle" id="motionToggle" role="switch" tabindex="0" aria-checked="false" onclick="toggleReduceMotion()"></div></div>
    <button class="menu-btn" style="width:100%;margin-top:10px" onclick="showScreen('menu')">返回</button>
  </div>
</div>

<!-- 结算 v9：完整成绩概览、判定分布、时序表现、谱面构成与性能采样 -->
<div class="screen" id="result">
  <div class="result-wrap">
    <header class="result-heading">
      <div><div class="result-kicker">PLAY RESULT / 结算报告</div><div style="font-size:11px;color:#8ea0b9;margin-top:5px">本局成绩 · 本地统计</div></div>
      <button class="back-btn" onclick="quitToSongSelect()">← 返回选歌</button>
    </header>
    <section class="result-hero">
      <div class="result-rank" id="resultRank">S</div>
      <div class="result-hero-meta">
        <div class="result-song-title" id="resultSongTitle">未知曲目</div>
        <div class="result-song-artist" id="resultSongArtist">未知曲师 · 难度 --</div>
        <div class="result-badges" id="resultBadges"></div>
        <div class="result-judge-label">判定档位：<span id="resultJudge" style="color:#2E8FAF;font-weight:700">标准</span> · <span id="resultClearRate">通关率 100%</span></div>
      </div>
    </section>
    <section class="result-metric-grid">
      <div class="result-metric"><div class="m-label">最终分数</div><div class="m-value" id="resultScore">0</div></div>
      <div class="result-metric"><div class="m-label">准确率</div><div class="m-value" id="resultAcc">100.00%</div></div>
      <div class="result-metric"><div class="m-label">最大连击</div><div class="m-value" id="resultCombo">0</div></div>
      <div class="result-metric"><div class="m-label">总音符</div><div class="m-value" id="resultTotal">0</div></div>
    </section>
    <section class="result-section">
      <div class="result-section-head"><h3>判定分布</h3><span id="resultJudgedCount">0 / 0 已结算</span></div>
      <div class="result-judgebar" id="resultJudgeBar" aria-label="判定分布图"></div>
      <div class="result-judgegrid">
        <div class="result-judgecell"><div class="j-name">PERFECT</div><div class="j-count perfect" id="resultPerfect">0</div><div class="j-rate" id="resultPerfectRate">0%</div></div>
        <div class="result-judgecell"><div class="j-name">GREAT</div><div class="j-count great" id="resultGreat">0</div><div class="j-rate" id="resultGreatRate">0%</div></div>
        <div class="result-judgecell"><div class="j-name">GOOD</div><div class="j-count good" id="resultGood">0</div><div class="j-rate" id="resultGoodRate">0%</div></div>
        <div class="result-judgecell"><div class="j-name">BAD</div><div class="j-count bad" id="resultBad">0</div><div class="j-rate" id="resultBadRate">0%</div></div>
        <div class="result-judgecell"><div class="j-name">MISS</div><div class="j-count miss" id="resultMiss">0</div><div class="j-rate" id="resultMissRate">0%</div></div>
      </div>
    </section>
    <section class="result-section">
      <div class="result-section-head"><h3>击打时序</h3><span>以判定时间为基准，负值为早，正值为晚</span></div>
      <div class="result-detail-grid">
        <div class="result-detail"><span class="d-label">平均偏差</span><span class="d-value" id="resultMeanError">—</span></div>
        <div class="result-detail"><span class="d-label">中位偏差</span><span class="d-value" id="resultMedianError">—</span></div>
        <div class="result-detail"><span class="d-label">偏差标准差</span><span class="d-value" id="resultTimingSpread">—</span></div>
        <div class="result-detail"><span class="d-label">偏早判定</span><span class="d-value" id="resultEarly">0</span></div>
        <div class="result-detail"><span class="d-label">偏晚判定</span><span class="d-value" id="resultLate">0</span></div>
        <div class="result-detail"><span class="d-label">参与统计的命中</span><span class="d-value" id="resultTimingSamples">0</span></div>
      </div>
    </section>
    <section class="result-section">
      <div class="result-section-head"><h3>谱面与连击</h3><span>Tap / Hold 分项</span></div>
      <div class="result-detail-grid">
        <div class="result-detail"><span class="d-label">Tap 数量</span><span class="d-value" id="resultTapTotal">0</span></div>
        <div class="result-detail"><span class="d-label">Hold 数量</span><span class="d-value" id="resultHoldTotal">0</span></div>
        <div class="result-detail"><span class="d-label">Hold 失误</span><span class="d-value" id="resultHoldBreaks">0</span></div>
        <div class="result-detail"><span class="d-label">单音符得分</span><span class="d-value" id="resultScorePerNote">0</span></div>
        <div class="result-detail"><span class="d-label">全连状态</span><span class="d-value" id="resultComboStatus">—</span></div>
        <div class="result-detail"><span class="d-label">连击中断次数</span><span class="d-value" id="resultComboBreaks">0</span></div>
      </div>
    </section>
    <details class="result-section result-section-collapsible">
  <summary class="result-section-head">
    <h3>本机运行采样</h3>
    <span>用于定位卡顿 · 点击展开 <i class="chev" aria-hidden="true">▾</i></span>
  </summary>
  <div class="result-detail-grid" style="margin-top:13px">
    <div class="result-detail"><span class="d-label">平均帧率</span><span class="d-value" id="resultAvgFps">—</span></div>
    <div class="result-detail"><span class="d-label">慢帧数（≥25ms）</span><span class="d-value" id="resultSlowFrames">0</span></div>
    <div class="result-detail"><span class="d-label">最大帧间隔</span><span class="d-value" id="resultMaxFrame">—</span></div>
  </div>
</details>
    <div class="result-actions">
      <button class="menu-btn primary" onclick="restartGame()">再来一次 (R)</button>
      <button class="menu-btn" onclick="quitToSongSelect()">返回选歌 (Q)</button>
    </div>
    <div class="result-note">时序统计只纳入成功判定的音符；Hold 使用头部与尾部偏差之和。运行采样受浏览器、显示器刷新率和后台负载影响。</div>
  </div>
</div>

<div id="audioHint">音乐被浏览器拦截：点击屏幕任意位置恢复</div>
<div id="dbgLog"></div>
<div class="loading" id="loading"><div class="spinner"></div><p id="loadingText">加载中...</p></div>
<div class="portal-transition" id="portalTransition" aria-hidden="true">
  <div class="portal-transition-wash"></div>
  <div class="portal-transition-ripple ripple-a"></div><div class="portal-transition-ripple ripple-b"></div>
  <div class="portal-transition-door"><span class="portal-door-inner"></span><span class="portal-door-glint"></span></div>
  <div class="portal-transition-copy"><span class="portal-transition-mark">DOOR · RAINLIT PORTAL</span><b>穿过雨幕</b><i></i></div>
</div>

<script>
