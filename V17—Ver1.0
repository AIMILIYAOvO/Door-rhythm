 #menu .menu-content.door-home-stage{width:min(980px,100%);grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:8px 26px;padding-inline:20px;}
 #menu .menu-visual{min-height:460px;}
 #songselect .library-layout{grid-template-columns:minmax(0,1fr) minmax(250px,292px);gap:15px;}
 #songselect .library-aside{padding:14px;}
}
